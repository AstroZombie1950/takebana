# ОС и редакторы
.DS_Store
*.swp
.idea/
.vscode/

# Рабочая папка: черновики, архивы, секреты клиента. В репозиторий не идёт.
/temp
/docs
# Документы для клиента, лежащие в корне: планы, сметы, отчёты
/*.html

# Зависимости
node_modules/

# Секреты
.env
.env.*
!.env.example
*.pem
*.key
certs/

# Пользовательский контент (переезжает в объектное хранилище)
server/public/uploads/
# прежний путь загрузок заведений: до 4 сентября multer писал сюда, мимо public
server/uploads/

# Медиа-конвейер
server/media/
server/live/
# папка, которую app.js создаёт при старте: сегменты веб-стрима и плейлисты
server/**/*.m3u8
# сегменты MPEG-TS (не путать с TypeScript — потому и с путём)
server/**/hls/*.ts
server/**/segment*.ts

# Логи и рантайм
logs/
*.log
npm-debug.log*
pids/
*.pid

# ── Копия для локальной разработки: cp server/.env.example server/.env ──
# Боевые значения в .env, который никогда не коммитится.

# Сервер
PORT=3000
NODE_ENV=development

# Режим запуска HTTP-сервера. Это НЕ флаг «включить медиасервер» — это выбор транспорта:
#   http  — обычный HTTP (локальная разработка)
#   local — HTTPS с самоподписанными сертификатами, откат на HTTP если их нет
#   prod  — HTTP за обратным прокси nginx, TLS терминируется в nginx
# Значение также утекает в шаблоны страницы эфира (streamingRouter.js).
# В режиме prod оно же включает secure-флаг у сессионной cookie и trust proxy.
START_SERVER=http

# Секрет для подписи сессионных cookie. Сгенерировать: openssl rand -hex 32
# Обязателен: при START_SERVER=prod или NODE_ENV=production пустое значение
# останавливает запуск, чтобы сессии не подписывались известным ключом.
SESSION_SECRET=

# База
MONGODB_URI=mongodb://127.0.0.1:27017/webcabar

# Daily.co — ретранслятор для звонков, веб-эфиров и камер заведений (utils/daily.js)
# ВНИМАНИЕ: старый ключ клиента передавался мессенджером — считаем скомпрометированным,
# перевыпустить перед первым запуском на новом сервере. Ключ же подписывает токены
# входа в комнаты: после перевыпуска старые токены перестают действовать.
DAILY_API_KEY=
# Поддомен аккаунта: https://<DAILY_DOMAIN>.daily.co. Обязателен — запасного
# значения в коде больше нет (раньше подставлялся чужой webcatravel).
DAILY_DOMAIN=

# Сколько гостей пускать к камере заведения (комната Daily). В комнате
# веб-эфира только ведущий — зрители смотрят HLS. Потолок задаёт тариф: на текущем
# плане значение выше 20 отбивается ошибкой 'cannot be set to that value with
# your current plan', и комната не создаётся вообще. Поднимать вместе с тарифом.
DAILY_MAX_PARTICIPANTS=20

# Свой TURN (coturn, ops/coturn/turnserver.conf) — запасной путь звонков мимо
# Daily (utils/turn.js). Без TURN_SECRET и TURN_HOST звонки идут только через
# Daily. Секрет совпадает со static-auth-secret в конфиге coturn.
TURN_SECRET=
TURN_HOST=

# Свой приём видео — MediaMTX (ops/mediamtx/): камера заведения вещает
# по WHIP и раздаётся по WHEP, вместо комнаты Daily на каждого зрителя.
# Обе переменные вместе включают его; убрать их — камеры тут же
# возвращаются на Daily, перезапуск не нужен.
# MTX_PUBLIC — адрес для браузера (через nginx, location /mtx/),
# MTX_API — служебный API на петле: идёт ли камера и сколько смотрят.
MTX_PUBLIC=
MTX_API=http://127.0.0.1:9997

# Google OAuth (Google Cloud Console → OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Полный URL колбэка, например http://localhost:3000/auth/google/callback
CALLBACKURL=

# Письма сайта — восстановление пароля (utils/mail.js), через HTTP API Resend.
# На бою без всех трёх значений ссылки «Забыли пароль?» нет. Локально без ключа
# письмо печатается в консоль сервера.
# RESEND_API_KEY — ключ Resend; домен отправителя подтверждается там же
#   (записи DKIM и SPF в DNS takebana.com).
# MAIL_FROM — отправитель, В КАВЫЧКАХ: "Takebana <no-reply@takebana.com>".
#   Без кавычек угловые скобки ломают всё, что читает .env шеллом
#   (ops/smoke.sh, запуск зондов через `set -a && . ./.env`); dotenv сам
#   по себе кавычки снимает и работает с любым вариантом.
# PUBLIC_URL — адрес сайта для ссылок в письмах, canonical и OG-тегов
#   страниц, без / в конце: https://takebana.com (utils/site.js). Берётся
#   не из запроса: подставной Host превратил бы письмо в ссылку на чужой сайт.
RESEND_API_KEY=
MAIL_FROM=
PUBLIC_URL=

# Секрет для подписи публикации в RTMP. Сгенерировать: openssl rand -hex 32
#
# Зачем. Ключ трансляции виден каждому зрителю — по нему собирается адрес
# воспроизведения. Без этого секрета вещать в чужой эфир может любой, кто
# открывал страницу трансляции. С секретом одного ключа мало: node-media-server
# требует подпись, а её показывает только владельцу на его странице.
#
# ВНИМАНИЕ: включение меняет то, что вещатель вставляет в OBS в поле
# «Ключ потока» — там появляется хвост ?sign=... Действующим вещателям надо
# заново скопировать ключ со страницы своего эфира.
# Пустое значение = проверка выключена, поведение как раньше.
RTMP_PUBLISH_SECRET=

# Сколько дней живёт подпись. По истечении вещатель открывает страницу эфира
# и копирует ключ заново.
RTMP_SIGN_TTL_DAYS=30

# Путь к ffmpeg для транскода RTMP → HLS (utils/hls.js). Пусто — берётся ffmpeg
# из PATH, и на сервере это верно: его ставит ops/provision.sh. Задавать только
# там, где ffmpeg лежит не в PATH.
FFMPEG_PATH=

# CDN перед раздачей HLS, без / в конце: https://live.takebana.com. Зритель
# берёт плейлист и сегменты оттуда, CDN — с nginx (/live/). Пусто — зритель
# смотрит со своего домена, как без CDN. Предпросмотр у ведущего всегда
# со своего домена.
HLS_BASE_URL=

# Записи эфиров («Сохранить запись» при завершении эфира) — Bunny Storage
# (utils/storage.js). Видео на диске VPS не храним: час записи — ~1,2 ГБ.
# BUNNY_STORAGE_ZONE — имя зоны хранилища;
# BUNNY_STORAGE_KEY — пароль зоны (FTP & API Access → Password), не ключ аккаунта;
# BUNNY_STORAGE_ENDPOINT — адрес API региона зоны: https://storage.bunnycdn.com
#   (Франкфурт, в панели зоны — Access) или региональный, например
#   https://uk.storage.bunnycdn.com. Обязательно с https://;
# RECORDINGS_CDN_URL — pull zone, подключённая к зоне хранилища, без / в конце:
#   https://vod.takebana.com.
# На бою без всех четырёх записи выключены — кнопки «Сохранить запись» нет.
# Локально без них записи лежат в public/uploads/recordings.
# Удалённая запись снимается и с кэша CDN — для этого нужен BUNNY_API_KEY
# ниже: без него файл уходит из хранилища, но по прямой ссылке играет до
# истечения кэша pull zone (у записей — месяц).
# FTP-логин и FTP-хост, пароль «только чтение» — коду не нужны.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_ENDPOINT=
RECORDINGS_CDN_URL=
# Записи в нескольких качествах (utils/recordingHls.js): HLS 720/480/360,
# MP4 после этого удаляется. На бою включается только on — и только после
# того, как в pull zone записей включены заголовки CORS для m3u8 и ts
# (Pull zone → Headers → Add CORS headers, расширения: m3u8, ts): без них
# Chrome плейлист с CDN не откроет, а MP4 уже не будет. Локально — включено,
# off выключает.
RECORDING_HLS=

# Сверка расходов на вкладке «Расходы» панели (utils/usage.js) и сброс кэша
# CDN при удалении записи (utils/storage.js).
# BUNNY_API_KEY — ключ аккаунта (Account → API), не ключ зоны хранения:
# у того нет прав ни на статистику, ни на сброс кэша. BUNNY_PULL_ZONE_ID — номер pull zone,
# без него трафик считается по всему аккаунту.
BUNNY_API_KEY=
BUNNY_PULL_ZONE_ID=
# Цена участнико-минуты Daily в долларах по тарифу заказчика. Пусто — панель
# показывает только минуты.
DAILY_USD_PER_MINUTE=
# Цены для вкладки «Хранилище» (routes/admin/storage.js). Пусто — цены
# калькулятора (views/calc.html): хранение Bunny $0,01 за ГБ в месяц за копию,
# трафик $0,01 за ГБ (Европа). Число копий панель берёт из настроек зоны
# по BUNNY_API_KEY. HOSTING_USD_PER_MONTH — месяц сервера; пусто — панель
# не пишет его цену, только место на диске.
BUNNY_USD_PER_GB=
BUNNY_USD_PER_GB_TRAFFIC=
HOSTING_USD_PER_MONTH=

# Поиск адреса заведения: адрес → точка на карте и обратно (utils/geocode.js).
# Пусто — общественный поиск OpenStreetMap (Nominatim): ключа не просит,
# но просит не чаще запроса в секунду и не «на каждую букву» — очередь, кэш
# и запрос по нажатию в коде уже есть. Адрес для связи Nominatim требует
# в заголовке: без него возможен 403. Поставщика можно сменить на совместимый
# по API (LocationIQ и другие сборки Nominatim) — тогда здесь его адрес.
GEOCODER_URL=
GEOCODER_CONTACT=

# Частота запросов адреса с одного IP за 5 минут (middleware/rateLimit.js).
RATE_LIMIT_GEOCODE=40

# Локальный HTTPS (самоподписанные сертификаты). Если файлов нет — поднимется HTTP.
SSL_KEY_PATH=
SSL_CERT_PATH=

# Ограничение частоты попыток входа и регистрации (middleware/rateLimit.js).
# Лимит входа висит на /login, /update-password и /admin/updatePassword —
# это все пути, где проверяется пароль.
# Значения по умолчанию: 10 попыток входа за 15 минут, 5 регистраций за час.
# При отладке можно поднять, чтобы не заблокировать себе вход опечатками.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5

# Уборка мёртвых эфиров.
# Умолчания в коде другие (5 минут и 30 дней) — они срабатывают, только
# если переменные не заданы; здесь значения, с которыми работаем.
STREAM_CLEANUP_ACTIVE_TTL_MINUTES=120
STREAM_CLEANUP_INACTIVE_TTL_DAYS=7

# Сколько хранятся журналы панели: действия (кто вошёл, что сделал) и ошибки.
# Уборку делает сама MongoDB по TTL-индексу. Важно: срок вшит в индекс при
# первом запуске, и смена значения здесь его не переписывает — после правки
# индекс нужно удалить, тогда он пересоздастся с новым сроком:
#   db.auditlogs.dropIndex({ at: 1 })   db.errorlogs.dropIndex({ lastAt: 1 })
AUDIT_TTL_DAYS=180
ERRORLOG_TTL_DAYS=90

# RTMP и FFMPEG_WAY больше не упоминаются в коде вообще: закомментированные
# блоки, где они встречались, удалены 4 сентября. Задавать не нужно.

# Пуш-уведомления (utils/push.js). Пара VAPID генерируется ОДИН РАЗ:
#   cd server && npx web-push generate-vapid-keys
# Менять нельзя: подписки устройств привязаны к публичному ключу, новая пара
# обнуляет их все. Публичный уходит в браузер, приватный — только сюда.
# VAPID_SUBJECT — почта проекта в виде mailto:..., её требует Apple.
# Без всех трёх пуши выключены, и это не ошибка: сайт работает как раньше.
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=

# Аналитика (views/partials/metrics.ejs, docs/seo/).
# METRIKA_ID — номер счётчика Яндекс Метрики, только цифры; на бою 113013752.
#   Пусто — ни счётчика, ни уведомления о cookie: локально и в зондах так
#   и оставлять, иначе своя разработка попадает в статистику сайта.
#   Вебвизор выключен в коде, не в кабинете Метрики.
METRIKA_ID=

# Язык без cookie `lang` (utils/i18n.js). Пусто — по языку браузера:
#   русский, если он у человека первым, иначе английский (основной, его видит
#   поиск). ru или en — всегда этот язык: так гоняются зонды (безголовый
#   Chrome шлёт en-US, а ждут русский — temp/run-probes.sh ставит ru).
SITE_LANG=

<%
  // Иконки групп — оформление этой страницы, в таксономию они не входят.
  // Категории, подкатегории и города — config/catalog.js.
  var groupIcons = {
    entertainment: '<path d="M9 5.2l1.1 3.7L13.8 10l-3.7 1.1L9 14.8l-1.1-3.7L4.2 10l3.7-1.1L9 5.2Z"></path><path d="M17.5 13.5l.6 2 2 .6-2 .6-.6 2-.6-2-2-.6 2-.6.6-2Z"></path>',
    business: '<rect x="3" y="7" width="18" height="13"></rect><path d="M9 7V5h6v2"></path><path d="M3 13h18"></path>'
  };
  var groups = category === 'popular' ? Object.keys(catalog.CATEGORIES) : [category];
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<% if (category === 'popular') { %>
<%# «Популярное» — главная сайта: её адрес и пересылают, отсюда карточка
    для соцсетей и мессенджеров. %>
<%- include('partials/tkHead', { titleKey: 'page.home.title', descriptionKey: 'page.home.description' }) %>
<link rel="canonical" href="https://takebana.com/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Takebana">
<meta property="og:title" content="Takebana — платформа прямых эфиров для бизнеса">
<meta property="og:description" content="Производители, заведения, блогеры и эксперты выходят в прямой эфир, чтобы продавать, вдохновлять и отвечать на вопросы без посредников.">
<meta property="og:url" content="https://takebana.com/">
<meta property="og:image" content="https://takebana.com/img/og-cover.jpg">
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Takebana">
<meta property="og:locale" content="ru_RU">
<meta property="og:locale:alternate" content="en_US">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Takebana — платформа прямых эфиров для бизнеса">
<meta name="twitter:description" content="Производители, заведения, блогеры и эксперты выходят в прямой эфир, чтобы продавать, вдохновлять и отвечать на вопросы без посредников.">
<meta name="twitter:image" content="https://takebana.com/img/og-cover.jpg">
<meta name="twitter:image:alt" content="Takebana">
<% } else { %>
<%- include('partials/tkHead', { titleKey: 'page.' + category + '.title' }) %>
<% } %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/catalog.css">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-cat">

      <% if (showIntro) { %>
      <%# Гостю, который пришёл впервые, — что это за сервис. Крестик ставит
          cookie tk_intro=0 (catalog.js), и сервер плашку больше не рисует. %>
      <aside class="tk-intro" id="tkIntro" aria-labelledby="tkIntroTitle">
        <div class="tk-intro__body">
          <p class="tk-intro__h" id="tkIntroTitle" data-i18n="intro.title"><%- t('intro.title') %></p>
          <p class="tk-intro__p" data-i18n="intro.text"><%- t('intro.text') %></p>
        </div>
        <a href="/about" class="tk-btn tk-btn--primary tk-btn--sm tk-intro__more" data-i18n="intro.more"><%- t('intro.more') %></a>
        <button type="button" class="tk-intro__close" id="tkIntroClose" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
        </button>
      </aside>
      <% } %>

      <!-- Шапка страницы -->
      <div class="tk-cat__hero">
        <div>
          <p class="tk-kicker">Live Streaming Platform</p>

          <%# Ключ словаря содержит заголовок целиком, вместе с категорией
              и переносом. Раньше он висел на подзаголовке, и после applyLang
              строка «ПРЯМЫЕ ТРАНСЛЯЦИИ» печаталась на экране дважды. %>
          <h1 class="tk-cat__h1" data-i18n="<%= page.i18n %>"><%- t(page.i18n) %></h1>

          <p class="tk-cat__lede" data-i18n="catalog.lede"><%- t('catalog.lede') %></p>

          <div class="tk-cat__stats">
            <span class="tk-stat">
              <span class="tk-stat__num"><%= totalStreamsCount %></span>
              <span data-i18n="catalog.streamers"><%- t('catalog.streamers') %></span>
            </span>
            <span class="tk-stat">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M8.1 16.4a5.5 5.5 0 0 1 7.8 0"></path><path d="M4.9 12.9a10 10 0 0 1 14.2 0"></path><path d="M1.4 9.4a15 15 0 0 1 21.2 0"></path><path d="M12 20h.01"></path></svg>
              <span data-i18n="catalog.onlineNow"><%- t('catalog.onlineNow') %></span>
            </span>
          </div>
        </div>

        <!-- Авторы -->
        <%# Трое авторов: сначала те, кто в эфире, потом популярные и новые
            (utils/authors.js). Пустых аккаунтов и забаненных здесь больше нет,
            как и кнопки «Показать ещё»: за остальными — страница /authors. %>
        <% if (users.length) { %>
        <section>
          <p class="tk-kicker" data-i18n="authors.kicker"><%- t('authors.kicker') %></p>

          <div class="tk-rec__list">
            <% users.forEach(function (user) { %>
            <a href="<%= user.stream ? '/stream/' + user.stream._id : '/userPage/' + user._id %>" class="tk-rec__item" data-presence-user="<%= user._id %>">
              <div class="tk-rec__ava"<% if (!user.avatarStyle.url) { %> data-bg="<%= user.avatarStyle.gradient %>"<% } %>>
                <% if (user.avatarStyle.url) { %>
                  <img src="<%= user.avatarStyle.url %>" alt="" loading="lazy">
                <% } else { %>
                  <%= user.avatarStyle.initial %>
                <% } %>
                <%# Поля status / isStreaming / hasActiveStream в модели нет —
                    метка «в эфире» по ним не загоралась никогда. Присутствие
                    берётся из isOnline и дальше живёт на сокете, как в панели. %>
                <span class="presence-dot <%= user.isOnline ? 'presence-online' : 'presence-offline' %>"></span>
              </div>
              <div class="tk-rec__body">
                <p class="tk-rec__name"><%= user.displayName %></p>
                <% if (user.stream) { %>
                <p class="tk-rec__state"><span class="tk-person__live" data-i18n="authors.liveMark"><%- t('authors.liveMark') %></span> · <%= user.stream.viewers %></p>
                <% } else { %>
                <p class="tk-rec__state" data-presence-text>
                  <% if (user.isOnline) { %><span data-i18n="common.online"><%- t('common.online') %></span><% } else { %><span data-i18n="common.offline"><%- t('common.offline') %></span><% } %>
                </p>
                <% } %>
              </div>
            </a>
            <% }); %>
          </div>

          <a href="/authors" class="tk-rec__more">
            <span data-i18n="authors.all"><%- t('authors.all') %></span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
          </a>
        </section>
        <% } %>
      </div>

      <%# Фильтры — обычная GET-форма: без скрипта она уходит перезагрузкой,
          и адрес с фильтрами можно отправить другому человеку. Со скриптом
          catalog.js подменяет только сетку, адрес из data-grid. %>
      <form id="catFilters" action="<%= base %>" method="get" data-grid="/streaming/<%= category %>/grid">

      <!-- Категории контента -->
      <section class="tk-cat__sec">
        <p class="tk-kicker" data-i18n="catalog.categories"><%- t('catalog.categories') %></p>

        <div class="tk-groups">
          <% groups.forEach(function (code) { var cat = catalog.CATEGORIES[code]; %>
          <div class="tk-group" role="group" aria-label="<%= ta(cat.i18n, cat.name) %>">
            <div class="tk-group__head">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" aria-hidden="true"><%- groupIcons[code] %></svg>
              <div>
                <p class="tk-group__name" data-i18n="<%= cat.i18n %>"><%= ta(cat.i18n, cat.name) %></p>
                <p class="tk-group__note" data-i18n="<%= cat.noteI18n %>"><%= ta(cat.noteI18n, cat.note) %></p>
              </div>
            </div>
            <div class="tk-tags">
              <% cat.subs.forEach(function (sub) { %>
              <label class="tk-tag"><input type="checkbox" name="sub" value="<%= sub.code %>"<%= filters.subs.includes(sub.code) ? ' checked' : '' %>><span<% if (sub.i18n) { %> data-i18n="<%= sub.i18n %>"<% } %>><%= ta(sub.i18n, sub.name) %></span></label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
      </section>

      <!-- Активные трансляции -->
      <section class="tk-cat__sec">
        <h2 class="tk-cat__h2" data-i18n="catalog.popular"><%- t('catalog.popular') %></h2>
        <p class="tk-cat__note" data-i18n="catalog.discover"><%- t('catalog.discover') %></p>

        <div class="tk-cat__bar">
          <label class="tk-cat__ctl">
            <span class="tk-form__label" data-i18n="common.city"><%- t('common.city') %></span>
            <select name="city" class="tk-field tk-select">
              <option value="" data-i18n="common.allCities"><%- t('common.allCities') %></option>
              <% catalog.CITIES.forEach(function (city) { %>
              <option value="<%= city.code %>"<%= filters.city === city.code ? ' selected' : '' %> data-i18n="<%= city.i18n %>"><%= ta(city.i18n, city.name) %></option>
              <% }); %>
            </select>
          </label>

          <label class="tk-cat__ctl">
            <span class="tk-form__label" data-i18n="catalog.sort"><%- t('catalog.sort') %></span>
            <select name="sort" class="tk-field tk-select">
              <option value="" data-i18n="catalog.sortViewers"><%- t('catalog.sortViewers') %></option>
              <option value="new"<%= filters.sort === 'new' ? ' selected' : '' %> data-i18n="catalog.sortNew"><%- t('catalog.sortNew') %></option>
            </select>
          </label>

          <%# Нужна только без скрипта: со скриптом фильтр применяется сразу
              при смене значения, и catalog.js кнопку убирает. %>
          <button type="submit" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="common.show"><%- t('common.show') %></button>
          <a href="<%= base %>" class="tk-cat__reset" data-reset<%= filtered ? '' : ' hidden' %> data-i18n="common.resetFilters"><%- t('common.resetFilters') %></a>
        </div>

        <div class="tk-cat__results" id="catResults">
          <%- include('partials/catalogGrid') %>
        </div>
      </section>

      </form>

    </div>
  </main>
</div>

<script src="/catalog.js"></script>
</body>
</html>

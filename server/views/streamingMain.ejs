<%
  // Иконки групп — оформление этой страницы, в таксономию они не входят.
  // Категории, подкатегории и города — config/catalog.js.
  var groupIcons = {
    entertainment: '<path d="M9 5.2l1.1 3.7L13.8 10l-3.7 1.1L9 14.8l-1.1-3.7L4.2 10l3.7-1.1L9 5.2Z"></path><path d="M17.5 13.5l.6 2 2 .6-2 .6-.6 2-.6-2-2-.6 2-.6.6-2Z"></path>',
    business: '<rect x="3" y="7" width="18" height="13"></rect><path d="M9 7V5h6v2"></path><path d="M3 13h18"></path>'
  };
  var groups = category === 'popular' ? Object.keys(catalog.CATEGORIES) : [category];
%>
<!DOCTYPE html>
<html lang="ru">
<head>
<%- include('partials/tkHead', { title: title + ' — Takebana' }) %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/catalog.css">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-cat">

      <!-- Шапка страницы -->
      <div class="tk-cat__hero">
        <div>
          <p class="tk-kicker">Live Streaming Platform</p>

          <%# Ключ словаря содержит заголовок целиком, вместе с категорией
              и переносом. Раньше он висел на подзаголовке, и после applyLang
              строка «ПРЯМЫЕ ТРАНСЛЯЦИИ» печаталась на экране дважды. %>
          <h1 class="tk-cat__h1" data-i18n="<%= page.i18n %>">
            Прямые трансляции:<br><%= page.title %>
          </h1>

          <p class="tk-cat__lede" data-i18n="catalog.lede">
            Откройте для себя захватывающий мир прямых трансляций.
            Смотрите, общайтесь и делитесь яркими моментами вместе с тысячами зрителей.
          </p>

          <div class="tk-cat__stats">
            <span class="tk-stat">
              <span class="tk-stat__num"><%= totalStreamsCount %></span>
              <span data-i18n="catalog.streamers">Стримеров</span>
            </span>
            <span class="tk-stat">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M8.1 16.4a5.5 5.5 0 0 1 7.8 0"></path><path d="M4.9 12.9a10 10 0 0 1 14.2 0"></path><path d="M1.4 9.4a15 15 0 0 1 21.2 0"></path><path d="M12 20h.01"></path></svg>
              <span data-i18n="catalog.onlineNow">Онлайн</span>
            </span>
          </div>
        </div>

        <!-- Рекомендации -->
        <section>
          <p class="tk-kicker" data-i18n="catalog.recommendations">Рекомендации</p>

          <%# Роут отдаёт четверых, в макете показаны трое. Остальные лежат
              скрытыми, их раскрывает «Показать ещё»: раньше эта кнопка
              не делала ничего. %>
          <div class="tk-rec__list">
            <% users.forEach(function (user, i) { %>
            <a href="/userPage/<%= user._id %>" class="tk-rec__item<%= i > 2 ? ' hidden' : '' %>" data-presence-user="<%= user._id %>">
              <div class="tk-rec__ava"<% if (!user.avatarStyle.url) { %> data-bg="<%= user.avatarStyle.gradient %>"<% } %>>
                <% if (user.avatarStyle.url) { %>
                  <img src="<%= user.avatarStyle.url %>" alt="" loading="lazy">
                <% } else { %>
                  <%= user.avatarStyle.initial %>
                <% } %>
                <%# Поля status / isStreaming / hasActiveStream в модели нет —
                    метка «в эфире» по ним не загоралась никогда. Присутствие
                    берётся из isOnline и дальше живёт на сокете, как в панели. %>
                <span class="presence-dot <%= user.isOnline ? 'presence-online' : 'presence-offline' %>"></span>
              </div>
              <div class="tk-rec__body">
                <p class="tk-rec__name"><%= user.displayName %></p>
                <p class="tk-rec__state" data-presence-text>
                  <% if (user.isOnline) { %><span data-i18n="common.online">онлайн</span><% } else { %><span data-i18n="common.offline">оффлайн</span><% } %>
                </p>
              </div>
            </a>
            <% }); %>
          </div>

          <% if (users.length > 3) { %>
          <button type="button" class="tk-rec__more" id="showMoreUsers">
            <span data-i18n="catalog.showMore">Показать ещё</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <% } %>
        </section>
      </div>

      <%# Фильтры — обычная GET-форма: без скрипта она уходит перезагрузкой,
          и адрес с фильтрами можно отправить другому человеку. Со скриптом
          catalog.js подменяет только сетку, адрес из data-grid. %>
      <form id="catFilters" action="<%= base %>" method="get" data-grid="/streaming/<%= category %>/grid">

      <!-- Категории контента -->
      <section class="tk-cat__sec">
        <p class="tk-kicker" data-i18n="catalog.categories">Категории контента</p>

        <div class="tk-groups">
          <% groups.forEach(function (code) { var cat = catalog.CATEGORIES[code]; %>
          <div class="tk-group" role="group" aria-label="<%= cat.name %>">
            <div class="tk-group__head">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" aria-hidden="true"><%- groupIcons[code] %></svg>
              <div>
                <p class="tk-group__name" data-i18n="<%= cat.i18n %>"><%= cat.name %></p>
                <p class="tk-group__note" data-i18n="<%= cat.noteI18n %>"><%= cat.note %></p>
              </div>
            </div>
            <div class="tk-tags">
              <% cat.subs.forEach(function (sub) { %>
              <label class="tk-tag"><input type="checkbox" name="sub" value="<%= sub.code %>"<%= filters.subs.includes(sub.code) ? ' checked' : '' %>><span<% if (sub.i18n) { %> data-i18n="<%= sub.i18n %>"<% } %>><%= sub.name %></span></label>
              <% }); %>
            </div>
          </div>
          <% }); %>
        </div>
      </section>

      <!-- Активные трансляции -->
      <section class="tk-cat__sec">
        <h2 class="tk-cat__h2" data-i18n="catalog.popular">Популярные трансляции</h2>
        <p class="tk-cat__note" data-i18n="catalog.discover">Откройте для себя лучший контент прямо сейчас</p>

        <div class="tk-cat__bar">
          <label class="tk-cat__ctl">
            <span class="tk-form__label" data-i18n="common.city">Город</span>
            <select name="city" class="tk-field tk-select">
              <option value="" data-i18n="common.allCities">Все города</option>
              <% catalog.CITIES.forEach(function (city) { %>
              <option value="<%= city.code %>"<%= filters.city === city.code ? ' selected' : '' %> data-i18n="<%= city.i18n %>"><%= city.name %></option>
              <% }); %>
            </select>
          </label>

          <label class="tk-cat__ctl">
            <span class="tk-form__label" data-i18n="catalog.sort">Сортировка</span>
            <select name="sort" class="tk-field tk-select">
              <option value="" data-i18n="catalog.sortViewers">По зрителям</option>
              <option value="new"<%= filters.sort === 'new' ? ' selected' : '' %> data-i18n="catalog.sortNew">Сначала новые</option>
            </select>
          </label>

          <%# Нужна только без скрипта: со скриптом фильтр применяется сразу
              при смене значения, и catalog.js кнопку убирает. %>
          <button type="submit" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="common.show">Показать</button>
          <a href="<%= base %>" class="tk-cat__reset" data-reset<%= filtered ? '' : ' hidden' %> data-i18n="common.resetFilters">Сбросить фильтры</a>
        </div>

        <div class="tk-cat__results" id="catResults">
          <%- include('partials/catalogGrid') %>
        </div>
      </section>

      </form>

    </div>
  </main>
</div>

<script src="/catalog.js"></script>
</body>
</html>

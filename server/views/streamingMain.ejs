<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%# Разделы — в индексе (docs/seo/DECISIONS.md): у раздела свой вводный
    текст, описание, блок «о разделе» внизу и записи под эфирами, поэтому
    и без эфиров страница не пустая. Фильтры (?sub=, ?city=) в canonical
    не попадают — у всех комбинаций один адрес раздела. Главная с 28.09 —
    свой шаблон, home.ejs. %>
<%- include('partials/tkHead', { titleKey: 'page.' + category + '.title', descriptionKey: 'page.' + category + '.description', seo: { path: '/streaming/' + category,
      jsonld: [ld.page({ type: 'CollectionPage', path: '/streaming/' + category, name: ta('page.' + category + '.title'), description: ta('page.' + category + '.description') }),
               ld.crumbs([['Takebana', '/'], [ta(page.i18n), '/streaming/' + category]])] } }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/catalog.css') %>">
<%# Карточки записей (.tk-recard) — как в поиске, стили там же. %>
<link rel="stylesheet" href="<%= asset('/css/profile.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-cat">

      <% if (showIntro) { %>
      <%# Гостю, который пришёл впервые, — что это за сервис. Крестик ставит
          cookie tk_intro=0 (catalog.js), и сервер плашку больше не рисует. %>
      <aside class="tk-intro" id="tkIntro" aria-labelledby="tkIntroTitle">
        <div class="tk-intro__body">
          <p class="tk-intro__h" id="tkIntroTitle" data-i18n="intro.title"><%- t('intro.title') %></p>
          <p class="tk-intro__p" data-i18n="intro.text"><%- t('intro.text') %></p>
        </div>
        <a href="/about" class="tk-btn tk-btn--primary tk-btn--sm tk-intro__more" data-i18n="intro.more"><%- t('intro.more') %></a>
        <button type="button" class="tk-intro__close" id="tkIntroClose" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
        </button>
      </aside>
      <% } %>

      <%- include('partials/catTabs', { current: category }) %>

      <%# Раздел с 02.10 — одной строкой: название, сколько в эфире и фильтры,
          под ней вводка и сразу эфиры. Прежде первый экран занимали
          статичные блоки — шапка с метриками, трое авторов и рамка
          «Категории контента» с тегами, — и эфиры уходили под сгиб даже
          тогда, когда они были. Авторы — в левой панели (/authors),
          подкатегории — выпадашкой. Фильтры — обычная GET-форма: без
          скрипта уходит перезагрузкой, и адрес с фильтрами можно отправить
          другому человеку; со скриптом catalog.js подменяет только сетку,
          адрес из data-grid. %>
      <form id="catFilters" action="<%= base %>" method="get" data-grid="/streaming/<%= category %>/grid">
      <section>
        <div class="tk-home__head">
          <%# Заголовок — только название раздела: ключ словаря на самом h1,
              а не на подзаголовке, иначе после applyLang он печатался дважды.
              Счётчик — рядом, не внутри: заголовок для поисковика без числа. %>
          <div class="tk-home__title">
            <h1 class="tk-home__h1" data-i18n="<%= page.i18n %>"><%- t(page.i18n) %></h1>
            <%- include('partials/liveCount', { count: streams.length }) %>
          </div>
          <div class="tk-home__bar">
            <select name="sub" class="tk-field tk-select" aria-label="<%= ta('catalog.sub') %>" data-i18n-aria="catalog.sub">
              <option value="" data-i18n="catalog.allSubs"><%- t('catalog.allSubs') %></option>
              <% catalog.CATEGORIES[category].subs.forEach(function (sub) { %>
              <option value="<%= sub.code %>"<%= filters.subs.includes(sub.code) ? ' selected' : '' %> data-i18n="<%= sub.i18n %>"><%= ta(sub.i18n, sub.name) %></option>
              <% }); %>
            </select>
            <select name="city" class="tk-field tk-select" aria-label="<%= ta('common.city') %>" data-i18n-aria="common.city">
              <option value="" data-i18n="common.allCities"><%- t('common.allCities') %></option>
              <% catalog.CITIES.forEach(function (city) { %>
              <option value="<%= city.code %>"<%= filters.city === city.code ? ' selected' : '' %> data-i18n="<%= city.i18n %>"><%= ta(city.i18n, city.name) %></option>
              <% }); %>
            </select>
            <select name="sort" class="tk-field tk-select" aria-label="<%= ta('catalog.sort') %>" data-i18n-aria="catalog.sort">
              <option value="" data-i18n="catalog.sortViewers"><%- t('catalog.sortViewers') %></option>
              <option value="new"<%= filters.sort === 'new' ? ' selected' : '' %> data-i18n="catalog.sortNew"><%- t('catalog.sortNew') %></option>
            </select>
            <%# Нужна только без скрипта: со скриптом фильтр применяется сразу
                при смене значения, и catalog.js кнопку убирает. %>
            <button type="submit" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="common.show"><%- t('common.show') %></button>
            <a href="<%= base %>" class="tk-cat__reset" data-reset<%= filtered ? '' : ' hidden' %> data-i18n="common.resetFilters"><%- t('common.resetFilters') %></a>
          </div>
        </div>

        <p class="tk-cat__lede" data-i18n="cat.<%= category %>Lede"><%- t('cat.' + category + 'Lede') %></p>

        <div class="tk-cat__results" id="catResults">
          <%- include('partials/catalogGrid') %>
        </div>
      </section>
      </form>

      <% if (recordings.length) { %>
      <!-- Записи: есть и тогда, когда в эфире никого -->
      <section class="tk-cat__sec">
        <h2 class="tk-cat__h2" data-i18n="catalog.recordings"><%- t('catalog.recordings') %></h2>
        <div class="tk-recs">
          <% recordings.forEach(function (rec) { %><%- include('partials/recCard', { rec: rec }) %><% }); %>
        </div>
      </section>
      <% } %>

      <%# О разделе: для человека, который пришёл из поиска. Подразделы —
          ссылками на фильтр этого же раздела. %>
      <%- include('partials/aboutBlock', { base: 'cat.' + category + 'About', rows: ['about.how', 'about.after'], chipsLabel: 'about.subs',
            chips: catalog.CATEGORIES[category].subs.map(function (s) { return { href: '/streaming/' + category + '?sub=' + s.code, i18n: s.i18n }; }) }) %>

    </div>
  </main>
</div>

<script defer src="<%= asset('/catalog.js') %>"></script>
</body>
</html>

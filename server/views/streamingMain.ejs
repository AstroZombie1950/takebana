<%
  // Подписи категорий для метки на карточке. Роут отдаёт код ('business'),
  // а не текст, и раньше он так и выводился в карточке как есть.
  var catLabels = {
    business:      { lng: '85', name: 'Бизнес' },
    entertainment: { lng: '84', name: 'Развлечения' }
  };
%>
<!DOCTYPE html>
<html lang="ru">
<head>
<%- include('partials/tkHead', { title: title + ' — Takebana' }) %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/catalog.css">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-cat">

      <!-- Шапка страницы -->
      <div class="tk-cat__hero">
        <div>
          <p class="tk-kicker">Live Streaming Platform</p>

          <%# Ключ словаря содержит заголовок целиком, вместе с категорией
              и переносом. Раньше он висел на подзаголовке, и после applyLang
              строка «ПРЯМЫЕ ТРАНСЛЯЦИИ» печаталась на экране дважды. %>
          <h1 class="tk-cat__h1" lng="<%= categoryConfig.lng %>">
            Прямые трансляции:<br><%= categoryConfig.title %>
          </h1>

          <p class="tk-cat__lede" lng="169">
            Откройте для себя захватывающий мир прямых трансляций.
            Смотрите, общайтесь и делитесь яркими моментами вместе с тысячами зрителей.
          </p>

          <div class="tk-cat__stats">
            <span class="tk-stat">
              <span class="tk-stat__num"><%= totalStreamsCount %></span>
              <span lng="164">Стримеров</span>
            </span>
            <span class="tk-stat">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M8.1 16.4a5.5 5.5 0 0 1 7.8 0"></path><path d="M4.9 12.9a10 10 0 0 1 14.2 0"></path><path d="M1.4 9.4a15 15 0 0 1 21.2 0"></path><path d="M12 20h.01"></path></svg>
              <span lng="89">Онлайн</span>
            </span>
          </div>
        </div>

        <!-- Рекомендации -->
        <section>
          <p class="tk-kicker" lng="165">Рекомендации</p>

          <%# Роут отдаёт четверых, в макете показаны трое. Остальные лежат
              скрытыми, их раскрывает «Показать ещё»: раньше эта кнопка
              не делала ничего. %>
          <div class="tk-rec__list">
            <% users.forEach(function (user, i) { %>
            <a href="/userPage/<%= user._id %>" class="tk-rec__item<%= i > 2 ? ' hidden' : '' %>" data-presence-user="<%= user._id %>">
              <div class="tk-rec__ava"<% if (!user.avatarStyle.url) { %> data-bg="<%= user.avatarStyle.gradient %>"<% } %>>
                <% if (user.avatarStyle.url) { %>
                  <img src="<%= user.avatarStyle.url %>" alt="" loading="lazy">
                <% } else { %>
                  <%= user.avatarStyle.initial %>
                <% } %>
                <%# Поля status / isStreaming / hasActiveStream в модели нет —
                    метка «в эфире» по ним не загоралась никогда. Присутствие
                    берётся из isOnline и дальше живёт на сокете, как в панели. %>
                <span class="presence-dot <%= user.isOnline ? 'presence-online' : 'presence-offline' %>"></span>
              </div>
              <div class="tk-rec__body">
                <p class="tk-rec__name"><%= user.displayName %></p>
                <p class="tk-rec__state" data-presence-text>
                  <% if (user.isOnline) { %><span lng="159">онлайн</span><% } else { %><span lng="160">оффлайн</span><% } %>
                </p>
              </div>
            </a>
            <% }); %>
          </div>

          <% if (users.length > 3) { %>
          <button type="button" class="tk-rec__more" id="showMoreUsers">
            <span lng="166">Показать ещё</span>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
          </button>
          <% } %>
        </section>
      </div>

      <!-- Категории контента -->
      <% if (category === 'popular' || category === 'entertainment' || category === 'business') { %>
      <section class="tk-cat__sec">
        <p class="tk-kicker" lng="170">Категории контента</p>

        <div class="tk-groups">
          <% if (category === 'popular' || category === 'entertainment') { %>
          <div class="tk-group">
            <div class="tk-group__head">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" aria-hidden="true"><path d="M9 5.2l1.1 3.7L13.8 10l-3.7 1.1L9 14.8l-1.1-3.7L4.2 10l3.7-1.1L9 5.2Z"></path><path d="M17.5 13.5l.6 2 2 .6-2 .6-.6 2-.6-2-2-.6 2-.6.6-2Z"></path></svg>
              <div>
                <p class="tk-group__name" lng="84">Развлечения</p>
                <p class="tk-group__note" lng="157">Игры, музыка, творчество</p>
              </div>
            </div>
            <div class="tk-tags">
              <button type="button" class="tk-tag" data-filter="podcasts" aria-pressed="false" lng="92">Подкасты</button>
              <button type="button" class="tk-tag" data-filter="tourism" aria-pressed="false" lng="93">Туризм</button>
              <button type="button" class="tk-tag" data-filter="creative" aria-pressed="false" lng="94">Креатив</button>
              <button type="button" class="tk-tag" data-filter="music" aria-pressed="false" lng="95">Музыка</button>
            </div>
          </div>
          <% } %>

          <% if (category === 'popular' || category === 'business') { %>
          <div class="tk-group">
            <div class="tk-group__head">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" aria-hidden="true"><rect x="3" y="7" width="18" height="13"></rect><path d="M9 7V5h6v2"></path><path d="M3 13h18"></path></svg>
              <div>
                <p class="tk-group__name" lng="85">Бизнес</p>
                <p class="tk-group__note" lng="158">Презентации, обучение</p>
              </div>
            </div>
            <div class="tk-tags">
              <button type="button" class="tk-tag" data-filter="real_estate" aria-pressed="false" lng="96">Недвижимость</button>
              <button type="button" class="tk-tag" data-filter="services" aria-pressed="false" lng="97">Услуги</button>
              <button type="button" class="tk-tag" data-filter="education" aria-pressed="false" lng="98">Образование</button>
              <button type="button" class="tk-tag" data-filter="auto" aria-pressed="false" lng="99">Авто</button>
              <button type="button" class="tk-tag" data-filter="horeca" aria-pressed="false">HoReCa</button>
              <button type="button" class="tk-tag" data-filter="manufacturing" aria-pressed="false" lng="100">Производство</button>
            </div>
          </div>
          <% } %>
        </div>
      </section>
      <% } %>

      <!-- Активные трансляции -->
      <section class="tk-cat__sec">
        <h2 class="tk-cat__h2" lng="102">Популярные трансляции</h2>
        <p class="tk-cat__note" lng="172">Откройте для себя лучший контент прямо сейчас</p>

        <% if (streams.length > 0) { %>
        <div class="tk-grid">
          <% streams.forEach(function (stream, index) { %>
          <a href="/stream/<%= stream.streamId %>" class="tk-card" style="animation-delay: <%= index * 70 %>ms">
            <div class="tk-card__shot">
              <% if (stream.thumbnail && stream.thumbnail !== 'default-thumbnail.png') { %>
                <img src="<%= stream.thumbnail %>" alt="" loading="lazy">
              <% } else { %>
                <svg viewBox="0 0 24 24" width="46" height="46" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" aria-hidden="true"><path d="M15 10l4.55-2.28A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.9L15 14"></path><rect x="3" y="6" width="12" height="12"></rect></svg>
              <% } %>

              <% if (stream.isActive) { %>
              <span class="tk-card__live">LIVE</span>
              <% } %>

              <span class="tk-card__eyes">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M1.5 12S5 5.5 12 5.5 22.5 12 22.5 12 19 18.5 12 18.5 1.5 12 1.5 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                <%= stream.viewers %>
              </span>
            </div>

            <div class="tk-card__body">
              <div class="tk-card__ava"<% if (!stream.user.avatarStyle.url) { %> data-bg="<%= stream.user.avatarStyle.gradient %>"<% } %>>
                <% if (stream.user.avatarStyle.url) { %>
                  <img src="<%= stream.user.avatarStyle.url %>" alt="" loading="lazy">
                <% } else { %>
                  <%= stream.user.avatarStyle.initial %>
                <% } %>
              </div>

              <div class="tk-card__text">
                <h3 class="tk-card__title"><%= stream.title %></h3>
                <p class="tk-card__who"><%= stream.user.displayName %></p>
                <% var label = catLabels[stream.category]; %>
                <% if (label) { %>
                  <span class="tk-card__cat" lng="<%= label.lng %>"><%= label.name %></span>
                <% } else if (stream.category) { %>
                  <span class="tk-card__cat"><%= stream.category %></span>
                <% } %>
              </div>
            </div>
          </a>
          <% }); %>
        </div>
        <% } else { %>
        <div class="tk-empty">
          <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" aria-hidden="true"><path d="M15 10l4.55-2.28A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.9L15 14"></path><rect x="3" y="6" width="12" height="12"></rect></svg>
          <p class="tk-empty__h" lng="175">Нет активных стримов</p>
          <p class="tk-empty__p" lng="176">В данный момент нет активных трансляций в этой категории. Станьте первым!</p>
          <button type="button" class="tk-btn tk-btn--primary tk-btn--sm" id="start-stream-btn" lng="177">Стать первым</button>
        </div>
        <% } %>
      </section>

    </div>
  </main>
</div>

<script src="/catalog.js"></script>
<script src="/lang.js"></script>
</body>
</html>

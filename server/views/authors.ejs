<%#
  Авторы (/authors). Четыре группы, пустые не рисуются: на старте авторов мало,
  и пустой заголовок хуже его отсутствия. Кого показывать — utils/authors.js.

  Карточка человека — та же, что в результатах поиска (css/search.css),
  поэтому файл подключён здесь же.
%>
<%
  var blocks = [
    { key: 'live',     items: groups.live,     i18n: 'authors.live',     note: 'authors.liveNote',     all: '/authors/all?show=live' },
    { key: 'popular',  items: groups.popular,  i18n: 'authors.popular',  note: 'authors.popularNote',  all: '/authors/all?sort=popular' },
    { key: 'fresh',    items: groups.fresh,    i18n: 'authors.fresh',    note: 'authors.freshNote',    all: '/authors/all' },
    { key: 'recorded', items: groups.recorded, i18n: 'authors.recorded', note: 'authors.recordedNote', all: '/authors/all?show=recordings' }
  ].filter(function (b) { return b.items.length; });
%>
<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="<%= themeOn %>"<% if (theme === 'auto') { %> data-theme-auto<% } %>>
<head>
<%# В индексе, когда есть хоть одна группа; пустая — нет. %>
<%- include('partials/tkHead', { titleKey: 'page.authors.title', descriptionKey: 'page.authors.description', seo: { path: '/authors', robots: blocks.length ? '' : 'noindex, follow',
      jsonld: [ld.page({ type: 'CollectionPage', path: '/authors', name: ta('page.authors.title'), description: ta('page.authors.description') }),
               ld.crumbs([['Takebana', '/'], [ta('authors.h1'), '/authors']])] } }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/catalog.css') %>">
<link rel="stylesheet" href="<%= asset('/css/search.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-search">

      <p class="tk-kicker" data-i18n="authors.kicker"><%- t('authors.kicker') %></p>
      <h1 class="tk-search__h1" data-i18n="authors.h1"><%- t('authors.h1') %></h1>
      <p class="tk-search__note" data-i18n="authors.lede"><%- t('authors.lede') %></p>
      <%# Все списком, с фильтрами (04.10): группы ниже — по 12 человек,
          остальных отсюда не найти. %>
      <a href="/authors/all" class="tk-btn tk-btn--outline tk-btn--sm tk-authors__all" data-i18n="authors.all"><%- t('authors.all') %></a>

      <% if (!blocks.length) { %>
      <%# Никто ещё не выходил в эфир: советовать некого, зато можно позвать. %>
      <div class="tk-empty">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"></path></svg>
        <p class="tk-empty__h" data-i18n="authors.emptyTitle"><%- t('authors.emptyTitle') %></p>
        <p class="tk-empty__p" data-i18n="authors.emptyText"><%- t('authors.emptyText') %></p>
        <a href="/studio" class="tk-btn tk-btn--primary tk-btn--sm" data-i18n="catalog.emptyCta"><%- t('catalog.emptyCta') %></a>
      </div>
      <% } %>

      <% blocks.forEach(function (block) { %>
      <section class="tk-search__sec">
        <div class="tk-search__head">
          <h2 class="tk-search__h2" data-i18n="<%= block.i18n %>"><%- t(block.i18n) %></h2>
          <span class="tk-note" data-i18n="<%= block.note %>"><%- t(block.note) %></span>
          <a href="<%= block.all %>" class="tk-authors__more" data-i18n="authors.allShort"><%- t('authors.allShort') %></a>
        </div>

        <div class="tk-people">
          <% block.items.forEach(function (person) { %>
          <%# У тех, кто в эфире, карточка ведёт прямо в эфир — за этим сюда
              и приходят; у остальных — на страницу автора. %>
          <%- include('partials/personCard', { person: person, href: person.stream ? '/stream/' + person.stream._id : '' }) %>
          <% }); %>
        </div>
      </section>
      <% }); %>

      <%# О странице: для пришедшего из поиска — как у разделов каталога. %>
      <%- include('partials/aboutBlock', { base: 'authors.about', rows: ['about.who', 'about.follow'], chipsLabel: 'about.sections',
            chips: Object.keys(catalog.CATEGORIES).map(function (code) { return { href: '/streaming/' + code, i18n: catalog.CATEGORIES[code].i18n }; }) }) %>

    </div>
  </main>
</div>
</body>
</html>

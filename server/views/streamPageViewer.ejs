        </div>

        <!-- Ярлычок чата для мобильных -->
        <div class="chat-tab xl:hidden" id="chatTab">
            <div class="flex flex-col items-center text-gray-600">
                <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a9.863 9.863 0 01-4.906-1.285A1.001 1.001 0 017 19L3 20l1-4a8.969 8.969 0 01-1.285-4.906C2.715 5.582 6.297 2 10.715 2S21 7.582 21 12z"></path>
                </svg>

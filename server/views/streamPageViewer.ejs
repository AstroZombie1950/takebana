        <!-- Overlay для мобильного чата -->
        <div class="chat-overlay xl:hidden" id="chatOverlay"></div>

        <!-- Подключаем необходимые библиотеки -->
        <script src="https://cdnjs.cloudflare.com/ajax/libs/peerjs/1.5.2/peerjs.min.js"></script>
        <script src="https://cdn.socket.io/4.8.0/socket.io.min.js"></script>
        <% if (stream.streamType==='obs-stream' ) { %>
            <!-- flv.js для воспроизведения HTTP-FLV -->
            <script src="https://cdn.jsdelivr.net/npm/flv.js@1.6.2/dist/flv.min.js"></script>
        <% } %>
            
            
            
                <script src="/lang.js"></script>

                <script>
                    // Глобальные переменные
                    const streamKey = "<%= streamKey %>";
                    const streamUrl = "<%= streamUrl %>";
                    const isStreamer = false;
                    const serverEnv = '<%= start_server_env || "local" %>';
                    let lastMessageTime = null;
                    let socket;
                    let currentStreamType = document.body?.dataset?.streamType || '';
                    let currentIsActive = document.body?.dataset?.streamActive === '1';
                    let currentDailyRoomName = document.body?.dataset?.dailyRoomName || '';

                    console.log('=== VIEWER PAGE DEBUG ===');
                    console.log('User is not a streamer');
                    console.log('Stream type:', currentStreamType);
                    console.log('Stream provider:', document.body?.dataset?.streamProvider);
                    console.log('Stream active:', currentIsActive);
                    console.log('Stream ID:', document.body?.dataset?.streamId);
                    console.log('StreamKey from template:', streamKey);
                    console.log('StreamKey type:', typeof streamKey);
                    console.log('StreamKey length:', streamKey ? streamKey.length : 0);
                    
                    // Проверяем что streamKey не пустой
                    if (!streamKey || streamKey === 'undefined' || streamKey === 'null' || streamKey === '') {
                        console.error('[Viewer] ERROR: streamKey is empty or undefined!');
                        console.error('[Viewer] Raw streamKey value:', streamKey);
                    } else {
                        console.log('[Viewer] StreamKey is valid:', streamKey);
                    }

                    // Инициализация Socket.IO
                    console.log('[Viewer] Initializing socket with serverEnv:', serverEnv);
                    if (serverEnv == 'prod') {
                        socket = io('https://takebana.com', {
                            transports: ['websocket'],
                            reconnection: true,
                            reconnectionDelay: 1000,
                            reconnectionAttempts: 5
                        });
                    }
                    if (serverEnv == 'local') {
                        socket = io('https://localhost:3000', {
                            transports: ['websocket'],
                            reconnection: true,
                            reconnectionDelay: 1000,
                            reconnectionAttempts: 5,
                            rejectUnauthorized: false // Для self-signed SSL
                        });
                    }
                    
                    // Регистрируем обработчики ДО подключения
                    console.log('[Viewer] Registering event handlers before connection...');

                    // Сервер может уведомить о смене типа/активности стрима (например, когда OBS реально начал publish).
                    // В этом случае перезагружаем страницу, чтобы заменить плеер.
                    const badge = document.getElementById('streamTypeBadge');
                    const shouldReload = (next, prev) => {
                        if (!next) return false;
                        const nextType = next.streamType;
                        const nextIsActive = typeof next.isActive === 'boolean' ? next.isActive : undefined;
                        const nextRoom = next.dailyRoomName;

                        // reload on streamType change
                        if (nextType && nextType !== prev.streamType) return true;
                        // reload on active state change
                        if (typeof nextIsActive === 'boolean' && nextIsActive !== prev.isActive) return true;
                        // reload on daily room change
                        if (nextRoom && nextRoom !== prev.dailyRoomName) return true;
                        return false;
                    };

                    // Функция для присоединения к комнате стрима
                    const joinStreamRoom = () => {
                        if (!streamKey || streamKey === 'undefined' || streamKey === 'null' || streamKey === '') {
                            console.error('[Viewer] Cannot join: streamKey is invalid!', streamKey);
                            return;
                        }
                        
                        if (!socket.connected) {
                            console.warn('[Viewer] Socket not connected, cannot join stream room');
                            return;
                        }
                        
                        console.log('[Viewer] Emitting join-stream-room, socket.connected:', socket.connected, 'socket.id:', socket.id);
                        socket.emit('join-stream-room', streamKey, (response) => {
                            console.log('[Viewer] join-stream-room callback response:', response);
                        });
                        console.log('[Viewer] Sent join-stream-room event with key:', streamKey);
                    };

                    // Простая логика: при подключении сразу join в комнату стрима
                    socket.on('connect', () => {
                        console.log('[Viewer] Socket connected! Socket ID:', socket.id);
                        console.log('[Viewer] Socket connected state:', socket.connected);
                        console.log('[Viewer] Attempting to join stream room with key:', streamKey);
                        
                        // Небольшая задержка чтобы убедиться что socket полностью подключен
                        setTimeout(() => {
                            joinStreamRoom();
                        }, 100);
                    });

                    socket.on('stream:update', (data) => {
                        try {
                            if (!data || data.streamKey !== streamKey) return;
                            console.log('[Viewer] stream:update received', data);
                            const prev = { streamType: currentStreamType, isActive: currentIsActive, dailyRoomName: currentDailyRoomName };

                            // if need reload — do it BEFORE mutating current* (иначе сравнение ломается)
                            if (shouldReload(data, prev)) {
                                console.log('[Viewer] reload due to update', { prev, next: data });
                                window.location.reload();
                                return;
                            }

                            // otherwise just update local state + badge
                            if (data.streamType) {
                                currentStreamType = data.streamType;
                                if (badge) badge.textContent = (data.streamType === 'obs-stream' ? 'OBS' : (data.streamType === 'daily-stream' ? 'WEB' : data.streamType));
                            }
                            if (typeof data.isActive === 'boolean') currentIsActive = data.isActive;
                            if (data.dailyRoomName) currentDailyRoomName = data.dailyRoomName;
                        } catch (e) {}
                    });
                    
                    // Если socket уже подключен (например, при переподключении), сразу присоединяемся
                    if (socket.connected) {
                        console.log('[Viewer] Socket already connected, joining immediately');
                        setTimeout(() => {
                            joinStreamRoom();
                        }, 100);
                    }
                    
                    socket.on('connect_error', (error) => {
                        console.error('[Viewer] Socket connection error:', error);
                    });
                    
                    socket.on('disconnect', (reason) => {
                        console.log('[Viewer] Socket disconnected, reason:', reason);
                    });
                    
                    socket.on('reconnect', (attemptNumber) => {
                        console.log('[Viewer] Socket reconnected after', attemptNumber, 'attempts');
                        // При переподключении снова присоединяемся к комнате
                        if (streamKey && streamKey !== 'undefined' && streamKey !== 'null' && streamKey !== '') {
                            setTimeout(() => {
                                socket.emit('join-stream-room', streamKey);
                                console.log('[Viewer] Re-sent join-stream-room after reconnect');
                            }, 100);
                        }
                    });
                    
                    // Регистрируем обработчик ДО подключения, чтобы не пропустить события
                    console.log('[Viewer] Registering viewers-count-updated handler...');
                    
                    // Обновление счетчика зрителей
                    socket.on('viewers-count-updated', (data) => {
                        console.log('[Viewer] ===== VIEWERS COUNT UPDATED EVENT RECEIVED =====');
                        console.log('[Viewer] Full data:', JSON.stringify(data, null, 2));
                        console.log('[Viewer] Received viewers count:', data);
                        console.log('[Viewer] Comparing streamKey - received:', data.streamKey, 'local:', streamKey, 'match:', data.streamKey === streamKey);
                        if (data.streamKey === streamKey) {
                            // Пробуем обновить через .viewers-number (вложенный span)
                            const viewersNumber = document.querySelector('.viewers-number');
                            const countElement = document.querySelector('.online__pepole-count');
                            
                            console.log('[Viewer] Count element found:', !!countElement);
                            console.log('[Viewer] Viewers number element found:', !!viewersNumber);
                            
                            if (viewersNumber) {
                                // Обновляем число зрителей
                                const oldText = viewersNumber.textContent;
                                viewersNumber.textContent = data.count;
                                console.log('[Viewer] Updated viewers-number from', oldText, 'to', data.count);
                            } else if (countElement) {
                                // Fallback: обновляем весь элемент
                                const oldText = countElement.textContent;
                                countElement.textContent = `${data.count} зрителей`;
                                console.log('[Viewer] Updated count element from', oldText, 'to', countElement.textContent);
                            } else {
                                console.error('[Viewer] ERROR: Neither .viewers-number nor .online__pepole-count element found!');
                                // Попробуем найти через другой селектор
                                const allCountElements = document.querySelectorAll('[class*="pepole"], [class*="viewer"]');
                                console.log('[Viewer] Found potential count elements:', allCountElements.length);
                            }
                        } else {
                            console.warn('[Viewer] StreamKey mismatch! Received:', data.streamKey, 'Expected:', streamKey);
                        }
                    });

                    // Основная инициализация DOM
                    document.addEventListener('DOMContentLoaded', function () {
                        // Управление адаптивным чатом
                        const chatTab = document.getElementById('chatTab');
                        const chatContainer = document.querySelector('.chat-container');
                        const chatOverlay = document.getElementById('chatOverlay');
                        const closeChatBtn = document.querySelector('.close-chat-btn');

                        function openChat() {
                            if (chatContainer && chatOverlay) {
                                chatOverlay.style.display = 'block';
                                chatContainer.classList.add('open');
                                document.body.style.overflow = 'hidden';
                            }
                        }

                        function closeChat() {
                            if (chatContainer && chatOverlay) {
                                chatContainer.classList.remove('open');
                                chatOverlay.style.display = 'none';
                                document.body.style.overflow = '';
                            }
                        }

                        if (chatTab) {
                            chatTab.addEventListener('click', openChat);
                        }

                        if (closeChatBtn) {
                            closeChatBtn.addEventListener('click', closeChat);
                        }

                        if (chatOverlay) {
                            chatOverlay.addEventListener('click', closeChat);
                        }

                        // Закрытие чата по Escape
                        document.addEventListener('keydown', function(e) {
                            if (e.key === 'Escape' && window.innerWidth < 1280) {
                                closeChat();
                            }
                        });
                    });

                    // ========== ТАЙМЕР ВРЕМЕНИ СУЩЕСТВОВАНИЯ СТРИМА ==========
                    // Функция для форматирования времени
                    function formatDuration(seconds) {
                        const hours = String(Math.floor(seconds / 3600)).padStart(2, '0');
                        const minutes = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
                        const secs = String(seconds % 60).padStart(2, '0');
                        return `${hours}:${minutes}:${secs}`;
                    }

                    document.addEventListener('DOMContentLoaded', function() {
                        const durationElement = document.getElementById('streamDuration');
                        
                        // Всегда показываем время существования стрима с момента создания
                        const streamCreatedTime = new Date('<%= stream.createdAt.toISOString() %>').getTime();
                        
                        function updateDuration() {
                            const now = new Date().getTime();
                            let diffSeconds = Math.floor((now - streamCreatedTime) / 1000);
                            
                            if (diffSeconds < 0) diffSeconds = 0;
                            
                            if (durationElement) {
                                durationElement.textContent = formatDuration(diffSeconds);
                            }
                        }
                        
                        // Обновлять каждую секунду
                        updateDuration(); // Первоначальный вызов
                        setInterval(updateDuration, 1000);
                    });

                    <% if (stream.streamType === 'obs-stream') { %>
                    // Инициализация плеера для OBS (HTTP-FLV)
                    document.addEventListener('DOMContentLoaded', function () {
                        const video = document.getElementById('video');
                        if (!video) {
                            console.log('[OBS/FLV] Video element not found, skipping flv.js init');
                            return;
                        }

                        // Мьютим для автоплея в браузерах
                        video.muted = true;

                        const flvUrl = `/live/${streamKey}.flv`;
                        console.log('[OBS/FLV] Trying to play:', flvUrl);

                        if (window.flvjs && flvjs.isSupported()) {
                            let flvPlayer = flvjs.createPlayer({
                                type: 'flv',
                                url: flvUrl,
                                isLive: true,
                            }, {
                                enableStashBuffer: false,
                                stashInitialSize: 128,
                            });

                            flvPlayer.attachMediaElement(video);
                            flvPlayer.load();

                            // Попытка autoplay
                            flvPlayer.play().catch((e) => {
                                console.warn('[OBS/FLV] Autoplay blocked:', e);
                            });

                            flvPlayer.on(flvjs.Events.ERROR, (type, detail, info) => {
                                console.error('[OBS/FLV] Player error:', { type, detail, info });
                            });

                            // Ретрай: при переключении типа стрима иногда FLV еще не готов.
                            // Пытаемся переподключить плеер раз в 2 секунды, максимум 30 секунд.
                            let retryLeft = 15;
                            const retry = async () => {
                                if (retryLeft <= 0) return;
                                retryLeft--;
                                try {
                                    // Проверяем доступность потока
                                    const r = await fetch(flvUrl, { method: 'HEAD', cache: 'no-store' });
                                    if (!r.ok) return;
                                    console.log('[OBS/FLV] stream is reachable, reloading player');
                                    try {
                                        flvPlayer.pause();
                                        flvPlayer.unload();
                                        flvPlayer.detachMediaElement();
                                        flvPlayer.destroy();
                                    } catch (_) {}
                                    flvPlayer = flvjs.createPlayer({ type: 'flv', url: flvUrl, isLive: true }, { enableStashBuffer: false, stashInitialSize: 128 });
                                    flvPlayer.attachMediaElement(video);
                                    flvPlayer.load();
                                    flvPlayer.play().catch(() => {});
                                } catch (_) {}
                            };
                            const retryTimer = setInterval(retry, 2000);
                            setTimeout(() => clearInterval(retryTimer), 30000);

                            window.addEventListener('beforeunload', () => {
                                try {
                                    flvPlayer.pause();
                                    flvPlayer.unload();
                                    flvPlayer.detachMediaElement();
                                    flvPlayer.destroy();
                                } catch (_) {}
                            });
                        } else {
                            console.error('[OBS/FLV] flv.js is not supported in this browser');
                        }
                    });
                    <% } %>

                    <% if (stream.streamType === 'daily-stream') { %>
                    // ========== DAILY.CO VIEWER CLASS ==========
                    class DailyViewer {
                        constructor() {
                            console.log('🎥 DailyViewer инициализируется...');
                            console.log('🔍 window.DailyIframe доступен:', typeof window.DailyIframe !== 'undefined');
                            this.callObject = null;
                            this.authToken = null;
                            this.isConnected = false;
                            this.streamId = '<%= stream._id %>';
                            this.roomName = null;
                            this.init();
                        }

                        init() {
                            this.initElements();
                            this.connectToStream();
                        }

                        initElements() {
                            this.remoteVideo = document.getElementById('remoteVideo');
                            this.backupVideo = document.getElementById('backupVideo');
                            this.remoteAudio = document.getElementById('remoteAudio');
                            this.remoteVideoContainer = document.getElementById('remoteVideoContainer');
                            this.statusElement = document.querySelector('#dailyStatus div');
                            this.volumeControl = document.getElementById('volumeControl');
                            this.volumeSlider = document.getElementById('volumeSlider');
                            this.volumeValue = document.getElementById('volumeValue');
                            this.muteButton = document.getElementById('muteButton');
                            console.log('✅ Элементы найдены:', {
                                remoteVideo: !!this.remoteVideo,
                                backupVideo: !!this.backupVideo,
                                remoteAudio: !!this.remoteAudio,
                                container: !!this.remoteVideoContainer,
                                status: !!this.statusElement,
                                volumeControl: !!this.volumeControl
                            });
                            
                            // Инициализация управления громкостью
                            this.initVolumeControl();
                            

                        }

                        async connectToStream() {
                            try {
                                this.updateStatus('Поиск активной комнаты...');
                                
                                // 1. Получаем данные комнаты стрима
                                const roomResponse = await fetch(`/api/get-stream-room/${this.streamId}`);
                                if (!roomResponse.ok) {
                                    throw new Error('Комната стрима не найдена');
                                }
                                
                                const roomData = await roomResponse.json();
                                if (!roomData.success || !roomData.roomName) {
                                    throw new Error('Стрим не активен или комната не создана');
                                }
                                
                                this.roomName = roomData.roomName;
                                this.roomUrl = roomData.roomUrl || roomData.roomURL || roomData.url || null;
                                console.log('🏠 Комната найдена:', this.roomName);
                                
                                // 2. Получаем токен зрителя
                                this.updateStatus('Получение токена...');
                                const tokenResponse = await fetch('/api/get-token', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        roomName: this.roomName,
                                        role: 'viewer'
                                    })
                                });
                                
                                if (!tokenResponse.ok) {
                                    throw new Error('Ошибка получения токена');
                                }
                                
                                const tokenData = await tokenResponse.json();
                                if (!tokenData.success) {
                                    throw new Error(tokenData.message || 'Токен не получен');
                                }
                                
                                this.authToken = tokenData.token;
                                console.log('🎫 Токен зрителя получен');
                                
                                // 3. Подключаемся к комнате
                                this.updateStatus('Подключение к стриму...');
                                
                                // Проверяем что Daily.co библиотека загружена
                                if (typeof window.DailyIframe === 'undefined') {
                                    throw new Error('Daily.co библиотека не загружена');
                                }
                                
                                this.callObject = window.DailyIframe.createCallObject();
                                
                                this.setupEventListeners();
                                
                                // Важно: подключаемся по реальному URL комнаты, который вернул бэкенд (Daily API).
                                // Это предотвращает поломку, если daily subdomain ещё webcatravel, а не takebana.
                                const joinUrl = this.roomUrl || `https://webcatravel.daily.co/${this.roomName}`;
                                await this.callObject.join({
                                    url: joinUrl,
                                    token: this.authToken
                                });
                                
                                console.log('🔗 Подключен к стриму как зритель');
                                this.isConnected = true;
                                this.updateStatus('Подключен к стриму');
                                
                            } catch (error) {
                                console.error('❌ Ошибка подключения к стриму:', error);
                                this.updateStatus('Ошибка: ' + error.message);
                            }
                        }

                        setupEventListeners() {
                            // Участник присоединился
                            this.callObject.on('participant-joined', (event) => {
                                console.log('👤 Участник присоединился:', event.participant.user_name || 'Гость');
                            });

                            // Участник покинул
                            this.callObject.on('participant-left', (event) => {
                                console.log('👋 Участник покинул:', event.participant.user_name || 'Гость');
                            });

                            // Получен удаленный трек (видео или аудио)
                            this.callObject.on('track-started', (event) => {
                                console.log('📹 Новый трек:', event.participant.user_name, event.track.kind);
                                console.log('🎬 Track details:', {
                                    kind: event.track.kind,
                                    id: event.track.id,
                                    enabled: event.track.enabled,
                                    readyState: event.track.readyState,
                                    muted: event.track.muted
                                });
                                
                                if (!event.participant.local) {
                                    if (event.track.kind === 'video') {
                                        // Показываем видео стримера
                                        console.log('📺 Отображаем видео стримера');
                                        console.log('🎬 Video track:', event.track);
                                        console.log('🖥️ Remote video element:', this.remoteVideo);
                                        
                                        if (this.remoteVideo) {
                                            const mediaStream = new MediaStream([event.track]);
                                            console.log('📡 MediaStream создан:', mediaStream);
                                            console.log('📡 MediaStream tracks:', mediaStream.getTracks());
                                            console.log('📐 Video dimensions:', event.track.getSettings());
                                            console.log('📐 Track settings:', {
                                                width: event.track.getSettings().width,
                                                height: event.track.getSettings().height,
                                                frameRate: event.track.getSettings().frameRate,
                                                aspectRatio: event.track.getSettings().aspectRatio
                                            });
                                            
                                            // Устанавливаем srcObject
                                            this.remoteVideo.srcObject = mediaStream;
                                            
                                            // Принудительно обновляем стили
                                            this.forceVideoDisplay();
                                            
                                            // Добавляем обработчики событий для отладки
                                            this.remoteVideo.addEventListener('loadedmetadata', () => {
                                                console.log('📺 Видео метаданные загружены');
                                                console.log('📏 Размеры видео:', this.remoteVideo.videoWidth, 'x', this.remoteVideo.videoHeight);
                                            });
                                            
                                            this.remoteVideo.addEventListener('canplay', () => {
                                                console.log('🎬 Видео готово к воспроизведению');
                                            });
                                            
                                            this.remoteVideo.addEventListener('playing', () => {
                                                console.log('▶️ Видео воспроизводится');
                                            });
                                            
                                            this.remoteVideo.addEventListener('error', (e) => {
                                                console.error('❌ Ошибка видео элемента:', e);
                                                console.error('❌ Video error details:', this.remoteVideo.error);
                                            });
                                            
                                            this.remoteVideo.addEventListener('stalled', () => {
                                                console.warn('⚠️ Видео застряло');
                                            });
                                            
                                            // Попытка автозапуска
                                            const isMobile = window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                                            
                                            // Для мобильных устройств сначала пробуем с muted
                                            if (isMobile) {
                                                this.remoteVideo.muted = true;
                                                console.log('📱 Мобильное устройство - запуск видео без звука (звук через audio элемент)');
                                            }
                                            
                                            this.remoteVideo.play()
                                                .then(() => {
                                                    console.log('✅ Видео успешно запущено');
                                                    this.updateStatus('Воспроизведение стрима');
                                                    
                                                    // Проверяем состояние видео через 2 секунды
                                                    setTimeout(() => {
                                                        this.checkVideoState();
                                                    }, 2000);
                                                })
                                                .catch(e => {
                                                    console.warn('⚠️ Autoplay заблокирован:', e);
                                                    console.log('🔍 Запуск видео в muted режиме (звук через audio элемент)...');
                                                    this.remoteVideo.muted = true;
                                                    this.remoteVideo.play()
                                                        .then(() => {
                                                            console.log('✅ Видео запущено (звук через отдельный audio элемент)');
                                                            this.updateStatus('Воспроизведение стрима');
                                                            
                                                            // Проверяем состояние видео через 2 секунды
                                                            setTimeout(() => {
                                                                this.checkVideoState();
                                                            }, 2000);
                                                        })
                                                        .catch(e2 => {
                                                            console.warn('⚠️ Не удалось запустить даже без звука:', e2);
                                                            this.showPlayButton();
                                                        });
                                                });
                                        } else {
                                            console.error('❌ remoteVideo элемент не найден!');
                                        }
                                    } else if (event.track.kind === 'audio') {
                                        // Обрабатываем аудио трек
                                        console.log('🔊 Аудио трек получен');
                                        
                                        if (this.remoteAudio) {
                                            const audioStream = new MediaStream([event.track]);
                                            this.remoteAudio.srcObject = audioStream;
                                            this.remoteAudio.style.display = 'block';
                                            
                                            // Настройки аудио
                                            this.remoteAudio.volume = 1.0;
                                            this.remoteAudio.muted = false;
                                            
                                            // Показываем контроль громкости
                                            if (this.volumeControl) {
                                                this.volumeControl.style.display = 'block';
                                                this.volumeControl.style.opacity = '1';
                                            }
                                            
                                            // Обновляем статус когда аудио готово
                                            this.updateStatus('Воспроизведение стрима');
                                            
                                            // Запускаем аудио
                                            this.remoteAudio.play()
                                                .then(() => {
                                                    console.log('✅ Аудио запущено');
                                                })
                                                .catch(e => {
                                                    console.warn('⚠️ Ошибка автозапуска аудио:', e);
                                                    // Попробуем запустить с пользовательским взаимодействием
                                                    this.showAudioPlayButton();
                                                });
                                        }
                                    }
                                }
                            });

                            // Видео трек остановлен
                            this.callObject.on('track-stopped', (event) => {
                                console.log('⏹️ Трек остановлен:', event.participant.user_name, event.track.kind);
                                
                                if (!event.participant.local) {
                                    if (event.track.kind === 'video') {
                                        if (this.remoteVideo) {
                                            this.remoteVideo.style.display = 'none';
                                            this.remoteVideo.srcObject = null;
                                            this.updateStatus('Стрим остановлен');
                                        }
                                    } else if (event.track.kind === 'audio') {
                                        if (this.remoteAudio) {
                                            this.remoteAudio.style.display = 'none';
                                            this.remoteAudio.srcObject = null;
                                            console.log('🔇 Аудио остановлено');
                                        }
                                        
                                        // Скрываем контроль громкости
                                        if (this.volumeControl) {
                                            this.volumeControl.style.display = 'none';
                                        }
                                    }
                                }
                            });

                            // Ошибки
                            this.callObject.on('error', (event) => {
                                console.error('❌ Daily.co ошибка:', event.errorMsg);
                                this.updateStatus('Ошибка: ' + event.errorMsg);
                            });

                            // Подключение установлено
                            this.callObject.on('joined-meeting', (event) => {
                                console.log('✅ Успешно подключились как зритель');
                                this.updateStatus('В стриме');
                            });
                        }

                        updateStatus(message) {
                            if (this.statusElement) {
                                this.statusElement.textContent = message;
                            }
                            console.log('[DailyViewer]', message);
                        }
                        
                        showPlayButton() {
                            // Создаем кнопку для ручного запуска видео
                            const playButton = document.createElement('button');
                            playButton.innerHTML = '▶️ Нажмите для воспроизведения';
                            playButton.style.cssText = `
                                position: absolute;
                                top: 50%;
                                left: 50%;
                                transform: translate(-50%, -50%);
                                background: rgba(0,0,0,0.8);
                                color: white;
                                border: none;
                                padding: 15px 30px;
                                border-radius: 10px;
                                font-size: 16px;
                                cursor: pointer;
                                z-index: 1000;
                            `;
                            
                            playButton.onclick = () => {
                                // Пробуем основной видео элемент
                                this.forceVideoDisplay();
                                this.remoteVideo.play()
                                    .then(() => {
                                        console.log('✅ Видео запущено вручную');
                                        playButton.remove();
                                        this.updateStatus('Воспроизведение стрима');
                                    })
                                    .catch(e => {
                                        console.warn('⚠️ Основной видео элемент не работает, пробуем резервный:', e);
                                        this.switchToBackupVideo();
                                        playButton.remove();
                                    });
                            };
                            
                            this.remoteVideoContainer.appendChild(playButton);
                        }
                        
                        showAudioPlayButton() {
                            // Показываем контроль громкости вместо кнопки
                            if (this.volumeControl) {
                                this.volumeControl.style.display = 'block';
                                this.volumeControl.style.opacity = '1';
                            }
                        }
                        
                        initVolumeControl() {
                            if (!this.volumeSlider || !this.volumeValue || !this.muteButton || !this.remoteAudio) {
                                return;
                            }
                            
                            // Устанавливаем начальные значения
                            this.volumeSlider.value = 100;
                            this.volumeValue.textContent = '100';
                            this.remoteAudio.volume = 1.0;
                            this.remoteAudio.muted = false;
                            
                            // Обработчик изменения ползунка
                            this.volumeSlider.addEventListener('input', (e) => {
                                const volume = e.target.value / 100;
                                this.remoteAudio.volume = volume;
                                this.volumeValue.textContent = `${e.target.value}`;
                                
                                // Обновляем иконку кнопки mute
                                this.updateMuteButton();
                                
                                // Обновляем градиент ползунка
                                this.updateSliderGradient(e.target.value);
                            });
                            
                            // Обработчик кнопки mute
                            this.muteButton.addEventListener('click', () => {
                                this.remoteAudio.muted = !this.remoteAudio.muted;
                                this.updateMuteButton();
                                
                                if (this.remoteAudio.muted) {
                                    this.volumeSlider.value = 0;
                                    this.volumeValue.textContent = '0';
                                    this.updateSliderGradient(0);
                                } else {
                                    const currentVolume = Math.round(this.remoteAudio.volume * 100);
                                    this.volumeSlider.value = currentVolume;
                                    this.volumeValue.textContent = `${currentVolume}`;
                                    this.updateSliderGradient(currentVolume);
                                }
                            });
                        }
                        
                        updateMuteButton() {
                            if (!this.muteButton || !this.remoteAudio) return;
                            
                            const svg = this.muteButton.querySelector('svg');
                            if (!svg) return;
                            
                            if (this.remoteAudio.muted || this.remoteAudio.volume === 0) {
                                // Иконка выключенного звука
                                svg.innerHTML = `
                                    <path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.617.794L4.5 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.5l3.883-3.794a1 1 0 011.617.794zM12.293 7.293a1 1 0 011.414 0L15 8.586l1.293-1.293a1 1 0 111.414 1.414L16.414 10l1.293 1.293a1 1 0 01-1.414 1.414L15 11.414l-1.293 1.293a1 1 0 01-1.414-1.414L13.586 10l-1.293-1.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                `;
                            } else if (this.remoteAudio.volume < 0.5) {

<%#
  Страница зрителя. Вёрстка на дизайн-системе, стили общие со страницей
  ведущего — /css/stream.css. Сняты Tailwind, sweetalert, video-js и шрифты
  Inter/Urbanist: первый не нужен, остальные не вызывались ни строкой.
  socket.io грузит шапка локальной копией, второй раз с CDN он не нужен.
%>
<!DOCTYPE html>
<html lang="ru">
<head>
<%- include('partials/tkHead', { title: stream.title + ' — Takebana' }) %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/stream.css">

</head>

<body class="tk-app"
      data-stream-id="<%= stream._id %>"
      data-stream-type="<%= stream.streamType %>"
      data-stream-provider="<%= stream.streamProvider %>"
      data-stream-active="<%= stream.isActive ? '1' : '0' %>"
      data-daily-room-name="<%= (stream.dailyRoom && stream.dailyRoom.name) ? stream.dailyRoom.name : '' %>">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-live tk-live--viewer">
      <div class="tk-live__grid">

        <section class="tk-live__col">
          <div class="tk-live__player video-player-area" id="viewerPlayerContainer">
            <%# Плеер выбирается по типу эфира, а не по isActive: флаг успевает
                обновиться уже после того, как поток пошёл. %>
            <% if (stream.streamType === 'obs-stream') { %>
              <video id="video" class="video-contain-mobile" controls autoplay muted playsinline webkit-playsinline></video>

            <% } else if (stream.streamType === 'daily-stream') { %>
              <div id="remoteVideoContainer" class="tk-live__daily">
                <video id="remoteVideo" class="video-contain-mobile" autoplay playsInline webkit-playsinline x5-playsinline x5-video-player-type="h5" style="display: none;"></video>
                <video id="backupVideo" class="video-contain-mobile tk-live__video--backup" autoplay playsInline webkit-playsinline x5-playsinline x5-video-player-type="h5" style="display: none;"></video>
                <audio id="remoteAudio" autoplay style="display: none;"></audio>

                <div class="tk-live__volume" id="volumeControl" style="display: none;">
                  <button type="button" id="muteButton" aria-label="Звук">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4V5Z"></path><path d="M16 9.5a3.5 3.5 0 010 5"></path></svg>
                  </button>
                  <input type="range" id="volumeSlider" class="volume-slider" min="0" max="100" value="100" aria-label="Громкость">
                  <span id="volumeValue">100</span>
                  <button type="button" id="fullscreenButton" title="На весь экран" aria-label="На весь экран">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M4.5 9V4.5H9M15 4.5h4.5V9M4.5 15v4.5H9M15 19.5h4.5V15"></path></svg>
                  </button>
                </div>

                <div class="tk-live__daily-status" id="dailyStatus">Подключение к эфиру…</div>
              </div>

            <% } else { %>
              <div class="tk-live__hint tk-live__hint--paused">
                <% if (stream.thumbnail) { %>
                  <img class="tk-live__thumb" src="<%= stream.thumbnail %>" alt="">
                <% } %>
                <p class="tk-live__hint-title" lng="128">Эфир приостановлен</p>
                <p lng="129">Трансляция продолжится, как только ведущий вернётся в эфир.</p>
              </div>
            <% } %>

            <span class="tk-live__type" id="streamTypeBadge"><%= stream.streamType === 'obs-stream' ? 'OBS' : (stream.streamType === 'daily-stream' ? 'WEB' : stream.streamType) %></span>
          </div>

          <!-- Информация об эфире -->
          <div class="tk-live__info stream-info">
            <h1 class="tk-live__title stream-title"><%= stream.title %></h1>

            <div class="tk-live__meta stream-meta">
              <div class="tk-live__author author-section">
                <a href="/userPage/<%= user._id %>" class="tk-live__avatar avatar"<% if (!user.avatarStyle.url) { %> style="background: <%= user.avatarStyle.gradient %>;"<% } %>>
                  <% if (user.avatarStyle.url) { %>
                    <img src="<%= user.avatarStyle.url %>" alt="<%= user.displayName %>">
                  <% } else { %>
                    <%= user.avatarStyle.initial %>
                  <% } %>
                </a>

                <div class="author-info">
                  <a href="/userPage/<%= user._id %>" class="tk-live__author-name author-name"><%= user.displayName %></a>

                  <div class="tk-live__author-acts subscribe-section">
                    <% if (isSubscribed) { %>
                      <button type="button" class="tk-btn tk-btn--outline tk-btn--xs unsubscribe-btn js-unsubscribe" lng="130">Отписаться</button>
                    <% } else { %>
                      <button type="button" class="tk-btn tk-btn--primary tk-btn--xs subscribe-btn js-subscribe" lng="91">Подписаться</button>
                    <% } %>

                    <%# Жалоба на эфир: окно живёт в общем партиале шапки. %>
                    <button type="button" class="tk-btn tk-btn--ghost tk-btn--xs"
                            data-report="stream"
                            data-report-id="<%= stream._id %>"
                            data-report-name="<%= stream.title %>">Пожаловаться</button>
                  </div>
                </div>
              </div>

              <div class="tk-live__stats stats-section">
                <span class="tk-live__stat live-indicator">
                  <i class="stream-indicator"></i>
                  <span class="live-text">Онлайн</span>
                  <span id="streamDuration" class="duration-text">00:00:00</span>
                </span>

                <span class="tk-live__stat viewer-count">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg>
                  <span class="online__pepole-count">
                    <span class="viewers-number"><%= stream.viewers %></span>
                    <% const _v = Number(stream.viewers) || 0, _d10 = _v % 10, _d100 = _v % 100;
                       const _vw = (_d10 === 1 && _d100 !== 11) ? 'зритель'
                                 : (_d10 >= 2 && _d10 <= 4 && (_d100 < 12 || _d100 > 14)) ? 'зрителя' : 'зрителей'; %>
                    <span class="viewers-text"><%= _vw %></span>
                  </span>
                </span>
              </div>
            </div>

            <% if (stream.description) { %>
              <p class="tk-live__desc stream-description"><%= stream.description %></p>
            <% } %>
          </div>
        </section>

        <!-- Чат -->
        <aside class="tk-live__chat chat-container chat__box">
          <div class="tk-live__chat-head">
            <h2 lng="135">Чат трансляции</h2>
            <button type="button" class="tk-live__chat-close close-chat-btn" aria-label="Закрыть чат">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
            </button>
          </div>

          <div class="wrapper__masseg">
            <div class="messeg-box"></div>

            <div class="input__messeng-box">
              <textarea class="tk-field input__messeng" rows="1" lng="218" placeholder="Сообщение..." maxlength="140"></textarea>
              <button type="button" class="tk-btn tk-btn--primary tk-btn--sm starting__buttone" lng="109">Отправить</button>
            </div>
            <p class="tk-live__limit">Максимум 140 символов</p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>

<button type="button" class="tk-live__chat-tab" id="chatTab" aria-label="Чат">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 12a8 8 0 01-11.5 7.2L4 21l1.8-5.5A8 8 0 1121 12Z"></path></svg>
  <span>Чат</span>
</button>
<div class="tk-live__chat-overlay" id="chatOverlay"></div>

<% if (stream.streamType === 'obs-stream') { %>
<script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.17/dist/hls.min.js"></script>
<% } %>
                <script src="/lang.js"></script>

                <script>
                    // Глобальные переменные
                    const streamKey = "<%= streamKey %>";
                    const streamUrl = "<%= streamUrl %>";
                    const isStreamer = false;
                    const serverEnv = '<%= start_server_env || "local" %>';
                    let lastMessageTime = null;
                    let socket;
                    let currentStreamType = document.body?.dataset?.streamType || '';
                    let currentIsActive = document.body?.dataset?.streamActive === '1';
                    let currentDailyRoomName = document.body?.dataset?.dailyRoomName || '';

                    console.log('=== VIEWER PAGE DEBUG ===');
                    console.log('User is not a streamer');
                    console.log('Stream type:', currentStreamType);
                    console.log('Stream provider:', document.body?.dataset?.streamProvider);
                    console.log('Stream active:', currentIsActive);
                    console.log('Stream ID:', document.body?.dataset?.streamId);
                    console.log('StreamKey from template:', streamKey);
                    console.log('StreamKey type:', typeof streamKey);
                    console.log('StreamKey length:', streamKey ? streamKey.length : 0);
                    
                    // Проверяем что streamKey не пустой
                    if (!streamKey || streamKey === 'undefined' || streamKey === 'null' || streamKey === '') {
                        console.error('[Viewer] ERROR: streamKey is empty or undefined!');
                        console.error('[Viewer] Raw streamKey value:', streamKey);
                    } else {
                        console.log('[Viewer] StreamKey is valid:', streamKey);
                    }

                    // Инициализация Socket.IO
                    console.log('[Viewer] Initializing socket with serverEnv:', serverEnv);
                    // Адрес берём из самой страницы, а не из зашитых строк.
                    // Раньше здесь было две ветки: 'prod' → https://takebana.com и 'local' →
                    // https://localhost:3000. Ветки для 'http' (наш режим локальной разработки)
                    // не было вообще — socket оставался undefined, и первый же socket.on(...)
                    // ронял весь скрипт страницы: ни чата, ни счётчика зрителей, ни реакции на
                    // смену типа эфира. Плюс зашитый боевой домен ломал бы проверку сервера
                    // по IP до переключения DNS.
                    socket = io(window.location.origin, {
                        transports: ['websocket'],
                        reconnection: true,
                        reconnectionDelay: 1000,
                        reconnectionAttempts: 5
                    });
                    
                    // Регистрируем обработчики ДО подключения
                    console.log('[Viewer] Registering event handlers before connection...');

                    // Сервер может уведомить о смене типа/активности стрима (например, когда OBS реально начал publish).
                    // В этом случае перезагружаем страницу, чтобы заменить плеер.
                    const badge = document.getElementById('streamTypeBadge');
                    const shouldReload = (next, prev) => {
                        if (!next) return false;
                        const nextType = next.streamType;
                        const nextIsActive = typeof next.isActive === 'boolean' ? next.isActive : undefined;
                        const nextRoom = next.dailyRoomName;

                        // reload on streamType change
                        if (nextType && nextType !== prev.streamType) return true;
                        // reload on active state change
                        if (typeof nextIsActive === 'boolean' && nextIsActive !== prev.isActive) return true;
                        // reload on daily room change
                        if (nextRoom && nextRoom !== prev.dailyRoomName) return true;
                        return false;
                    };

                    // Функция для присоединения к комнате стрима
                    const joinStreamRoom = () => {
                        if (!streamKey || streamKey === 'undefined' || streamKey === 'null' || streamKey === '') {
                            console.error('[Viewer] Cannot join: streamKey is invalid!', streamKey);
                            return;
                        }
                        
                        if (!socket.connected) {
                            console.warn('[Viewer] Socket not connected, cannot join stream room');
                            return;
                        }
                        
                        console.log('[Viewer] Emitting join-stream-room, socket.connected:', socket.connected, 'socket.id:', socket.id);
                        socket.emit('join-stream-room', streamKey, (response) => {
                            console.log('[Viewer] join-stream-room callback response:', response);
                            // Добираем пропущенное только после входа в комнату: иначе
                            // сообщение между запросом и входом потерялось бы.
                            if (typeof fetchNewMessages === 'function') fetchNewMessages();
                        });
                        console.log('[Viewer] Sent join-stream-room event with key:', streamKey);
                    };

                    // Простая логика: при подключении сразу join в комнату стрима
                    socket.on('connect', () => {
                        console.log('[Viewer] Socket connected! Socket ID:', socket.id);
                        console.log('[Viewer] Socket connected state:', socket.connected);
                        console.log('[Viewer] Attempting to join stream room with key:', streamKey);
                        
                        // Небольшая задержка чтобы убедиться что socket полностью подключен
                        setTimeout(() => {
                            joinStreamRoom();
                        }, 100);
                    });

                    socket.on('stream:update', (data) => {
                        try {
                            if (!data || data.streamKey !== streamKey) return;
                            console.log('[Viewer] stream:update received', data);
                            const prev = { streamType: currentStreamType, isActive: currentIsActive, dailyRoomName: currentDailyRoomName };

                            // if need reload — do it BEFORE mutating current* (иначе сравнение ломается)
                            if (shouldReload(data, prev)) {
                                console.log('[Viewer] reload due to update', { prev, next: data });
                                window.location.reload();
                                return;
                            }

                            // otherwise just update local state + badge
                            if (data.streamType) {
                                currentStreamType = data.streamType;
                                if (badge) badge.textContent = (data.streamType === 'obs-stream' ? 'OBS' : (data.streamType === 'daily-stream' ? 'WEB' : data.streamType));
                            }
                            if (typeof data.isActive === 'boolean') currentIsActive = data.isActive;
                            if (data.dailyRoomName) currentDailyRoomName = data.dailyRoomName;
                        } catch (e) {}
                    });
                    
                    // Если socket уже подключен (например, при переподключении), сразу присоединяемся
                    if (socket.connected) {
                        console.log('[Viewer] Socket already connected, joining immediately');
                        setTimeout(() => {
                            joinStreamRoom();
                        }, 100);
                    }
                    
                    socket.on('connect_error', (error) => {
                        console.error('[Viewer] Socket connection error:', error);
                    });
                    
                    socket.on('disconnect', (reason) => {
                        console.log('[Viewer] Socket disconnected, reason:', reason);
                    });
                    
                    socket.on('reconnect', (attemptNumber) => {
                        console.log('[Viewer] Socket reconnected after', attemptNumber, 'attempts');
                        // При переподключении снова присоединяемся к комнате
                        if (streamKey && streamKey !== 'undefined' && streamKey !== 'null' && streamKey !== '') {
                            setTimeout(() => {
                                socket.emit('join-stream-room', streamKey, () => {
                                    // После обрыва добираем всё, что пришло, пока связи не было.
                                    if (typeof fetchNewMessages === 'function') fetchNewMessages();
                                });
                                console.log('[Viewer] Re-sent join-stream-room after reconnect');
                            }, 100);
                        }
                    });
                    
                    // Регистрируем обработчик ДО подключения, чтобы не пропустить события
                    console.log('[Viewer] Registering viewers-count-updated handler...');
                    
                    // Склонение слова «зритель». В шаблоне стояло жёсткое «зрителей»,
                    // поэтому при одном зрителе выходило «1 зрителей».
                    function viewersWord(n) {
                        n = Math.abs(Number(n) || 0);
                        const d10 = n % 10, d100 = n % 100;
                        if (d10 === 1 && d100 !== 11) return 'зритель';
                        if (d10 >= 2 && d10 <= 4 && (d100 < 12 || d100 > 14)) return 'зрителя';
                        return 'зрителей';
                    }
                    function setViewersCount(n) {
                        const num = document.querySelector('.viewers-number');
                        const word = document.querySelector('.viewers-text');
                        if (num) num.textContent = n;
                        if (word) word.textContent = viewersWord(n);
                    }
                    // Обновление счетчика зрителей
                    socket.on('viewers-count-updated', (data) => {
                        console.log('[Viewer] ===== VIEWERS COUNT UPDATED EVENT RECEIVED =====');
                        console.log('[Viewer] Full data:', JSON.stringify(data, null, 2));
                        console.log('[Viewer] Received viewers count:', data);
                        console.log('[Viewer] Comparing streamKey - received:', data.streamKey, 'local:', streamKey, 'match:', data.streamKey === streamKey);
                        if (data.streamKey === streamKey) {
                            // Пробуем обновить через .viewers-number (вложенный span)
                            const viewersNumber = document.querySelector('.viewers-number');
                            const countElement = document.querySelector('.online__pepole-count');
                            
                            console.log('[Viewer] Count element found:', !!countElement);
                            console.log('[Viewer] Viewers number element found:', !!viewersNumber);
                            
                            if (viewersNumber) {
                                // Обновляем число зрителей
                                const oldText = viewersNumber.textContent;
                                setViewersCount(data.count);
                                console.log('[Viewer] Updated viewers-number from', oldText, 'to', data.count);
                            } else if (countElement) {
                                // Fallback: обновляем весь элемент
                                const oldText = countElement.textContent;
                                countElement.textContent = `${data.count} зрителей`;
                                console.log('[Viewer] Updated count element from', oldText, 'to', countElement.textContent);
                            } else {
                                console.error('[Viewer] ERROR: Neither .viewers-number nor .online__pepole-count element found!');
                                // Попробуем найти через другой селектор
                                const allCountElements = document.querySelectorAll('[class*="pepole"], [class*="viewer"]');
                                console.log('[Viewer] Found potential count elements:', allCountElements.length);
                            }
                        } else {
                            console.warn('[Viewer] StreamKey mismatch! Received:', data.streamKey, 'Expected:', streamKey);
                        }
                    });

                    // Основная инициализация DOM
                    document.addEventListener('DOMContentLoaded', function () {
                        // Управление адаптивным чатом
                        const chatTab = document.getElementById('chatTab');
                        const chatContainer = document.querySelector('.chat-container');
                        const chatOverlay = document.getElementById('chatOverlay');
                        const closeChatBtn = document.querySelector('.close-chat-btn');

                        function openChat() {
                            if (chatContainer && chatOverlay) {
                                chatOverlay.style.display = 'block';
                                chatContainer.classList.add('open');
                                document.body.style.overflow = 'hidden';
                            }
                        }

                        function closeChat() {
                            if (chatContainer && chatOverlay) {
                                chatContainer.classList.remove('open');
                                chatOverlay.style.display = 'none';
                                document.body.style.overflow = '';
                            }
                        }

                        if (chatTab) {
                            chatTab.addEventListener('click', openChat);
                        }

                        if (closeChatBtn) {
                            closeChatBtn.addEventListener('click', closeChat);
                        }

                        if (chatOverlay) {
                            chatOverlay.addEventListener('click', closeChat);
                        }

                        // Закрытие чата по Escape
                        document.addEventListener('keydown', function(e) {
                            if (e.key === 'Escape' && window.innerWidth < 1280) {
                                closeChat();
                            }
                        });
                    });

                    // ========== ТАЙМЕР ВРЕМЕНИ СУЩЕСТВОВАНИЯ СТРИМА ==========
                    // Функция для форматирования времени
                    function formatDuration(seconds) {
                        const hours = String(Math.floor(seconds / 3600)).padStart(2, '0');
                        const minutes = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
                        const secs = String(seconds % 60).padStart(2, '0');
                        return `${hours}:${minutes}:${secs}`;
                    }

                    document.addEventListener('DOMContentLoaded', function() {
                        const durationElement = document.getElementById('streamDuration');
                        
                        // Время в эфире — с выхода в эфир (startedAt), а не с создания
                        // записи. У неидущего эфира таймер стоит на нуле; о старте
                        // придёт stream:update, и страница перезагрузится.
                        const startedAt = <%- JSON.stringify(stream.isActive && stream.startedAt ? stream.startedAt : null) %>;
                        if (!startedAt) return;
                        const streamCreatedTime = new Date(startedAt).getTime();
                        
                        function updateDuration() {
                            const now = new Date().getTime();
                            let diffSeconds = Math.floor((now - streamCreatedTime) / 1000);
                            
                            if (diffSeconds < 0) diffSeconds = 0;
                            
                            if (durationElement) {
                                durationElement.textContent = formatDuration(diffSeconds);
                            }
                        }
                        
                        // Обновлять каждую секунду
                        updateDuration(); // Первоначальный вызов
                        setInterval(updateDuration, 1000);
                    });

                    <% if (stream.streamType === 'obs-stream') { %>
                    // Плеер OBS-эфира: HLS.
                    //
                    // Раньше здесь был HTTP-FLV через flv.js. На iPhone он не играл и
                    // играть не мог: flv.js собирает поток через Media Source Extensions,
                    // а в Safari на iOS их нет. HLS Safari проигрывает нативно, остальным
                    // браузерам его собирает hls.js — тоже через MSE, но там они есть.
                    document.addEventListener('DOMContentLoaded', function () {
                        const video = document.getElementById('video');
                        if (!video) {
                            console.log('[OBS/HLS] Video element not found');
                            return;
                        }

                        const hlsUrl = `/live/${streamKey}/index.m3u8`;

                        // Оба атрибута обязательны на iOS: без muted браузер не даст
                        // автозапуск, без playsinline видео уходит в полноэкранный плеер.
                        video.muted = true;
                        video.playsInline = true;
                        video.setAttribute('playsinline', '');

                        let player = null;

                        // Плейлист появляется не сразу: ffmpeg дописывает index.m3u8 только
                        // после первых сегментов — через несколько секунд после старта эфира.
                        async function waitForPlaylist(attempts) {
                            for (let i = 0; i < attempts; i++) {
                                try {
                                    const r = await fetch(hlsUrl, { method: 'HEAD', cache: 'no-store' });
                                    if (r.ok) return true;
                                } catch (_) { /* эфир ещё не поднялся */ }
                                await new Promise((next) => setTimeout(next, 2000));
                            }
                            return false;
                        }

                        function playNative() {
                            console.log('[OBS/HLS] нативный HLS:', hlsUrl);
                            video.src = hlsUrl;
                            video.play().catch((e) => console.warn('[OBS/HLS] автозапуск заблокирован:', e));
                        }

                        function playWithHlsJs() {
                            console.log('[OBS/HLS] hls.js:', hlsUrl);
                            player = new Hls({
                                lowLatencyMode: true,
                                liveSyncDurationCount: 3,  // держимся у живого края, а не у начала окна
                                backBufferLength: 30,      // не копим прошлое: эфир, а не запись
                            });
                            player.loadSource(hlsUrl);
                            player.attachMedia(video);
                            player.on(Hls.Events.MANIFEST_PARSED, () => {
                                video.play().catch((e) => console.warn('[OBS/HLS] автозапуск заблокирован:', e));
                            });
                            player.on(Hls.Events.ERROR, (_evt, data) => {
                                if (!data.fatal) return;
                                // Сеть и медиа чинятся на месте; всё остальное — только пересозданием.
                                if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
                                    console.warn('[OBS/HLS] сетевая ошибка, переподключаемся');
                                    player.startLoad();
                                } else if (data.type === Hls.ErrorTypes.MEDIA_ERROR) {
                                    console.warn('[OBS/HLS] ошибка медиа, восстанавливаем');
                                    player.recoverMediaError();
                                } else {
                                    console.error('[OBS/HLS] фатальная ошибка:', data);
                                    player.destroy();
                                    player = null;
                                }
                            });
                        }

                        (async () => {
                            if (!await waitForPlaylist(30)) {
                                console.error('[OBS/HLS] плейлист не появился за минуту:', hlsUrl);
                                return;
                            }
                            // Порядок важен: Safari умеет и то и другое, но нативный
                            // плеер на iOS экономнее и не требует MSE.
                            if (video.canPlayType('application/vnd.apple.mpegurl')) {
                                playNative();
                            } else if (window.Hls && Hls.isSupported()) {
                                playWithHlsJs();
                            } else {
                                console.error('[OBS/HLS] браузер не умеет HLS ни нативно, ни через hls.js');
                            }
                        })();

                        window.addEventListener('beforeunload', () => {
                            if (player) {
                                try { player.destroy(); } catch (_) {}
                            }
                        });
                    });
                    <% } %>

                    <% if (stream.streamType === 'daily-stream') { %>
                    // ========== DAILY.CO VIEWER CLASS ==========
                    class DailyViewer {
                        constructor() {
                            console.log('🎥 DailyViewer инициализируется...');
                            this.session = null;
                            this.streamId = '<%= stream._id %>';
                            this.init();
                        }

                        init() {
                            this.initElements();
                            this.connectToStream();
                        }

                        initElements() {
                            this.remoteVideo = document.getElementById('remoteVideo');
                            this.backupVideo = document.getElementById('backupVideo');
                            this.remoteAudio = document.getElementById('remoteAudio');
                            this.remoteVideoContainer = document.getElementById('remoteVideoContainer');
                            this.statusElement = document.querySelector('#dailyStatus div');
                            this.volumeControl = document.getElementById('volumeControl');
                            this.volumeSlider = document.getElementById('volumeSlider');
                            this.volumeValue = document.getElementById('volumeValue');
                            this.muteButton = document.getElementById('muteButton');
                            console.log('✅ Элементы найдены:', {
                                remoteVideo: !!this.remoteVideo,
                                backupVideo: !!this.backupVideo,
                                remoteAudio: !!this.remoteAudio,
                                container: !!this.remoteVideoContainer,
                                status: !!this.statusElement,
                                volumeControl: !!this.volumeControl
                            });
                            
                            // Инициализация управления громкостью
                            this.initVolumeControl();
                            

                        }

                        connectToStream() {
                            // У неактивного эфира комнаты нет по определению, и запрос
                            // за токеном гарантированно вернул бы отказ. Не ходим: о старте
                            // придёт stream:update, и страница перезагрузится.
                            if (document.body.dataset.streamActive !== '1') {
                                this.updateStatus('Эфир не идёт — ждём начала');
                                return;
                            }
                            const STATUS = {
                                connecting: 'Подключение к эфиру…',
                                live: 'В эфире',
                                reconnecting: 'Связь прервалась, переподключаемся…',
                                ended: 'Эфир недоступен'
                            };
                            this.session = TKDaily.connect({
                                send: false,
                                access: () => TKDaily.requestAccess('/api/get-token', { streamId: this.streamId }),
                                onTrack: (track, p, on) => {
                                    if (p.local) return;
                                    if (on) this.onTrackStarted(track); else this.onTrackStopped(track);
                                },
                                onState: (state) => this.updateStatus(STATUS[state])
                            });
                        }

                        onTrackStarted(track) {
                            if (track.kind === 'video') {
                                if (!this.remoteVideo) return;
                                // Звук идёт отдельным элементом, поэтому картинка всегда
                                // без звука — такую пускает автозапуск любого браузера.
                                this.remoteVideo.muted = true;
                                this.remoteVideo.srcObject = new MediaStream([track]);
                                this.forceVideoDisplay();
                                this.remoteVideo.play()
                                    .then(() => setTimeout(() => this.checkVideoState(), 2000))
                                    .catch(() => this.showPlayButton());
                                return;
                            }
                            if (!this.remoteAudio) return;
                            this.remoteAudio.srcObject = new MediaStream([track]);
                            this.remoteAudio.muted = false;
                            if (this.volumeControl) {
                                this.volumeControl.style.display = 'block';
                                this.volumeControl.style.opacity = '1';
                            }
                            this.remoteAudio.play().catch(() => this.showAudioPlayButton());
                        }

                        onTrackStopped(track) {
                            if (track.kind === 'video') {
                                if (this.remoteVideo) {
                                    this.remoteVideo.style.display = 'none';
                                    this.remoteVideo.srcObject = null;
                                }
                                return;
                            }
                            if (this.remoteAudio) this.remoteAudio.srcObject = null;
                            if (this.volumeControl) this.volumeControl.style.display = 'none';
                        }

                        updateStatus(message) {
                            if (this.statusElement) {
                                this.statusElement.textContent = message;
                            }
                            console.log('[DailyViewer]', message);
                        }
                        
                        showPlayButton() {
                            // Создаем кнопку для ручного запуска видео
                            const playButton = document.createElement('button');
                            playButton.innerHTML = '▶️ Нажмите для воспроизведения';
                            playButton.style.cssText = `
                                position: absolute;
                                top: 50%;
                                left: 50%;
                                transform: translate(-50%, -50%);
                                background: rgba(0,0,0,0.8);
                                color: white;
                                border: none;
                                padding: 15px 30px;
                                border-radius: 10px;
                                font-size: 16px;
                                cursor: pointer;
                                z-index: 1000;
                            `;
                            
                            playButton.onclick = () => {
                                // Пробуем основной видео элемент
                                this.forceVideoDisplay();
                                this.remoteVideo.play()
                                    .then(() => {
                                        console.log('✅ Видео запущено вручную');
                                        playButton.remove();
                                        this.updateStatus('Воспроизведение стрима');
                                    })
                                    .catch(e => {
                                        console.warn('⚠️ Основной видео элемент не работает, пробуем резервный:', e);
                                        this.switchToBackupVideo();
                                        playButton.remove();
                                    });
                            };
                            
                            this.remoteVideoContainer.appendChild(playButton);
                        }
                        
                        showAudioPlayButton() {
                            // Показываем контроль громкости вместо кнопки
                            if (this.volumeControl) {
                                this.volumeControl.style.display = 'block';
                                this.volumeControl.style.opacity = '1';
                            }
                        }
                        
                        initVolumeControl() {
                            if (!this.volumeSlider || !this.volumeValue || !this.muteButton || !this.remoteAudio) {
                                return;
                            }
                            
                            // Устанавливаем начальные значения
                            this.volumeSlider.value = 100;
                            this.volumeValue.textContent = '100';
                            this.remoteAudio.volume = 1.0;
                            this.remoteAudio.muted = false;
                            
                            // Обработчик изменения ползунка
                            this.volumeSlider.addEventListener('input', (e) => {
                                const volume = e.target.value / 100;
                                this.remoteAudio.volume = volume;
                                this.volumeValue.textContent = `${e.target.value}`;
                                
                                // Обновляем иконку кнопки mute
                                this.updateMuteButton();
                                
                                // Обновляем градиент ползунка
                                this.updateSliderGradient(e.target.value);
                            });
                            
                            // Обработчик кнопки mute
                            this.muteButton.addEventListener('click', () => {
                                this.remoteAudio.muted = !this.remoteAudio.muted;
                                this.updateMuteButton();
                                
                                if (this.remoteAudio.muted) {
                                    this.volumeSlider.value = 0;
                                    this.volumeValue.textContent = '0';
                                    this.updateSliderGradient(0);
                                } else {
                                    const currentVolume = Math.round(this.remoteAudio.volume * 100);
                                    this.volumeSlider.value = currentVolume;
                                    this.volumeValue.textContent = `${currentVolume}`;
                                    this.updateSliderGradient(currentVolume);
                                }
                            });
                        }
                        
                        updateMuteButton() {
                            if (!this.muteButton || !this.remoteAudio) return;
                            
                            const svg = this.muteButton.querySelector('svg');
                            if (!svg) return;
                            
                            if (this.remoteAudio.muted || this.remoteAudio.volume === 0) {
                                // Иконка выключенного звука
                                svg.innerHTML = `
                                    <path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.617.794L4.5 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.5l3.883-3.794a1 1 0 011.617.794zM12.293 7.293a1 1 0 011.414 0L15 8.586l1.293-1.293a1 1 0 111.414 1.414L16.414 10l1.293 1.293a1 1 0 01-1.414 1.414L15 11.414l-1.293 1.293a1 1 0 01-1.414-1.414L13.586 10l-1.293-1.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                `;
                            } else if (this.remoteAudio.volume < 0.5) {
                                // Иконка тихого звука
                                svg.innerHTML = `
                                    <path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.617.794L4.5 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.5l3.883-3.794a1 1 0 011.617.794zM12.293 7.293a1 1 0 011.414 0L15 8.586l1.293-1.293a1 1 0 111.414 1.414L16.414 10l1.293 1.293a1 1 0 01-1.414 1.414L15 11.414l-1.293 1.293a1 1 0 01-1.414-1.414L13.586 10l-1.293-1.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    <path d="M13.5 8.5a.5.5 0 01.5.5v2a.5.5 0 01-.5.5h-1a.5.5 0 01-.5-.5V9a.5.5 0 01.5-.5h1z"></path>
                                `;
                            } else {
                                // Иконка громкого звука
                                svg.innerHTML = `
                                    <path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.617.794L4.5 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.5l3.883-3.794a1 1 0 011.617.794zM12.293 7.293a1 1 0 011.414 0L15 8.586l1.293-1.293a1 1 0 111.414 1.414L16.414 10l1.293 1.293a1 1 0 01-1.414 1.414L15 11.414l-1.293 1.293a1 1 0 01-1.414-1.414L13.586 10l-1.293-1.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    <path d="M13.5 8.5a.5.5 0 01.5.5v2a.5.5 0 01-.5.5h-1a.5.5 0 01-.5-.5V9a.5.5 0 01.5-.5h1z"></path>
                                    <path d="M15.5 7.5a.5.5 0 01.5.5v4a.5.5 0 01-.5.5h-1a.5.5 0 01-.5-.5V8a.5.5 0 01.5-.5h1z"></path>
                                `;
                            }
                        }
                        
                        updateSliderGradient(value) {
                            if (!this.volumeSlider) return;
                            
                            const percentage = value;
                            this.volumeSlider.style.background = `linear-gradient(to right, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.8) ${percentage}%, rgba(255,255,255,0.3) ${percentage}%, rgba(255,255,255,0.3) 100%)`;
                        }
                        

                        
                        forceVideoDisplay() {
                            // Принудительно обновляем стили видео
                            if (this.remoteVideo) {
                                console.log('🔧 Принудительное обновление стилей видео...');
                                
                                // Удаляем все классы и стили
                                this.remoteVideo.className = '';
                                this.remoteVideo.removeAttribute('style');
                                
                                // Определяем мобильное устройство
                                const isMobile = window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                                
                                // Базовые стили
                                const baseStyles = {
                                    display: 'block',
                                    width: '100%',
                                    height: '100%',
                                    objectFit: 'cover',
                                    position: 'absolute',
                                    top: '0',
                                    left: '0',
                                    zIndex: '10',
                                    backgroundColor: 'transparent'
                                };
                                
                                // Дополнительные стили для мобильных
                                if (isMobile) {
                                    Object.assign(baseStyles, {
                                        '-webkit-transform': 'translateZ(0)',
                                        transform: 'translateZ(0)',
                                        '-webkit-backface-visibility': 'hidden',
                                        backfaceVisibility: 'hidden'
                                    });
                                    console.log('📱 Применяются мобильные стили для видео');
                                }
                                
                                // Устанавливаем стили
                                Object.assign(this.remoteVideo.style, baseStyles);
                                
                                // Добавляем классы Tailwind
                                this.remoteVideo.classList.add('w-full', 'h-full', 'object-cover');
                                
                                console.log('🔧 Стили обновлены:', this.remoteVideo.style.cssText);
                            }
                        }
                        
                        checkVideoState() {
                            if (this.remoteVideo) {
                                const isMobile = window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                                
                                console.log('🔍 Проверка состояния видео...');
                                console.log('📺 Video state:', {
                                    readyState: this.remoteVideo.readyState,
                                    networkState: this.remoteVideo.networkState,
                                    paused: this.remoteVideo.paused,
                                    ended: this.remoteVideo.ended,
                                    currentTime: this.remoteVideo.currentTime,
                                    duration: this.remoteVideo.duration,
                                    videoWidth: this.remoteVideo.videoWidth,
                                    videoHeight: this.remoteVideo.videoHeight,
                                    display: window.getComputedStyle(this.remoteVideo).display,
                                    visibility: window.getComputedStyle(this.remoteVideo).visibility,
                                    opacity: window.getComputedStyle(this.remoteVideo).opacity,
                                    isMobile: isMobile
                                });
                                
                                // Если видео не воспроизводится, но должно
                                if (this.remoteVideo.paused && this.remoteVideo.readyState >= 2) {
                                    console.log('🔄 Попытка перезапуска видео...');
                                    this.remoteVideo.play().catch(e => {
                                        console.warn('⚠️ Не удалось перезапустить видео:', e);
                                    });
                                }
                                
                                // Если видео имеет нулевые размеры
                                if (this.remoteVideo.videoWidth === 0 || this.remoteVideo.videoHeight === 0) {
                                    console.warn('⚠️ Видео имеет нулевые размеры, принудительно обновляем стили...');
                                    this.forceVideoDisplay();
                                    
                                    // Если основной видео элемент не работает, пробуем резервный
                                    setTimeout(() => {
                                        if (this.remoteVideo.videoWidth === 0 || this.remoteVideo.videoHeight === 0) {
                                            console.log('🔄 Переключаемся на резервный видео элемент...');
                                            this.switchToBackupVideo();
                                        }
                                    }, 1000);
                                }
                                
                                // Дополнительные проверки для мобильных устройств
                                if (isMobile) {
                                    console.log('📱 Мобильная проверка видео...');
                                    
                                    // Проверяем, что видео имеет правильные размеры для мобильных
                                    const computedStyle = window.getComputedStyle(this.remoteVideo);
                                    if (computedStyle.width === '0px' || computedStyle.height === '0px') {
                                        console.warn('📱 Видео имеет нулевые размеры на мобильном, принудительно обновляем...');
                                        this.forceVideoDisplay();
                                    }
                                    
                                    // Проверяем, что видео не скрыто
                                    if (computedStyle.display === 'none' || computedStyle.visibility === 'hidden') {
                                        console.warn('📱 Видео скрыто на мобильном, показываем...');
                                        this.forceVideoDisplay();
                                    }
                                }
                            }
                            
                            // Проверка состояния аудио
                            if (this.remoteAudio) {
                                // Если аудио не воспроизводится, но должно
                                if (this.remoteAudio.paused && this.remoteAudio.readyState >= 2) {
                                    this.remoteAudio.play().catch(e => {
                                        console.warn('⚠️ Не удалось перезапустить аудио:', e);
                                    });
                                }
                                
                                // Проверяем громкость и muted состояние
                                if (this.remoteAudio.volume === 0) {
                                    this.remoteAudio.volume = 1.0;
                                }
                                
                                if (this.remoteAudio.muted) {
                                    this.remoteAudio.muted = false;
                                }
                            }
                        }
                        
                        switchToBackupVideo() {
                            if (this.backupVideo && this.remoteVideo.srcObject) {
                                console.log('🔄 Переключение на резервный видео элемент...');
                                
                                // Скрываем основной видео элемент
                                this.remoteVideo.style.display = 'none';
                                
                                // Настраиваем резервный видео элемент
                                this.backupVideo.srcObject = this.remoteVideo.srcObject;
                                this.forceBackupVideoDisplay();
                                
                                // Запускаем резервный видео элемент
                                this.backupVideo.play()
                                    .then(() => {
                                        console.log('✅ Резервный видео элемент запущен');
                                        this.updateStatus('Воспроизведение стрима (резервный)');
                                    })
                                    .catch(e => {
                                        console.warn('⚠️ Не удалось запустить резервный видео элемент:', e);
                                        this.showPlayButton();
                                    });
                            }
                        }
                        
                        forceBackupVideoDisplay() {
                            if (this.backupVideo) {
                                console.log('🔧 Настройка резервного видео элемента...');
                                
                                // Удаляем все классы и стили
                                this.backupVideo.className = '';
                                this.backupVideo.removeAttribute('style');
                                
                                // Определяем мобильное устройство
                                const isMobile = window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                                
                                // Базовые стили
                                const baseStyles = {
                                    display: 'block',
                                    width: '100%',
                                    height: '100%',
                                    objectFit: 'cover',
                                    position: 'absolute',
                                    top: '0',
                                    left: '0',
                                    zIndex: '15',
                                    backgroundColor: 'transparent'
                                };
                                
                                // Дополнительные стили для мобильных
                                if (isMobile) {
                                    Object.assign(baseStyles, {
                                        '-webkit-transform': 'translateZ(0)',
                                        transform: 'translateZ(0)',
                                        '-webkit-backface-visibility': 'hidden',
                                        backfaceVisibility: 'hidden'
                                    });
                                    console.log('📱 Применяются мобильные стили для резервного видео');
                                }
                                
                                // Устанавливаем стили
                                Object.assign(this.backupVideo.style, baseStyles);
                                
                                // Добавляем классы Tailwind
                                this.backupVideo.classList.add('w-full', 'h-full', 'object-cover');
                                
                                console.log('🔧 Резервный видео элемент настроен:', this.backupVideo.style.cssText);
                            }
                        }
                    }

                    // Инициализация зрителя для Daily.co стримов
                    document.addEventListener('DOMContentLoaded', () => {
                        console.log('🎬 Инициализация DailyViewer...');
                        new DailyViewer();
                        
                        // Обработчик изменения ориентации для мобильных

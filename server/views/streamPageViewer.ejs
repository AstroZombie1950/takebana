<%#
  Страница зрителя. Оба типа эфира зритель смотрит через HLS (/tk-hls.js):
  OBS шлёт RTMP на наш приём сам, веб-эфир туда отдаёт комната Daily
  (utils/webLive.js) — в комнату зритель не входит.

  Сцена — картинка и чат. На широком экране чат справа, на телефоне под
  картинкой, во весь экран — картинка и чат, больше ничего. Общее
  с пультом ведущего — в partials и /tk-stream.js, своё — /tk-viewer.js.
%>
<% var playable = stream.isActive && (stream.streamType === 'obs-stream' || stream.streamType === 'daily-stream'); %>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { title: stream.title + ' — Takebana' }) %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/stream.css">
</head>

<body class="tk-app tk-app--stage"
      data-stream-id="<%= stream._id %>"
      data-stream-key="<%= streamKey %>"
      data-hls-base="<%= hlsBase %>"
      data-user-id="<%= currentUser._id %>"
      data-streamer-id="<%= user._id %>"
      data-stream-type="<%= stream.streamType %>"
      data-stream-active="<%= stream.isActive ? '1' : '0' %>"
      data-started-at="<%= stream.isActive && stream.startedAt ? new Date(stream.startedAt).toISOString() : '' %>">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-live tk-live--viewer">
      <div class="tk-live__grid" id="stage">
        <section class="tk-live__col">
          <div class="tk-live__player" id="player">
            <%# Идущему эфиру — плеер, неидущему — карточка паузы. Плеер под
                карточкой не ждём: после остановки он доигрывал бы хвост
                плейлиста и прятал карточку. О старте придёт stream:update. %>
            <% if (playable) { %>
              <video id="video" class="video-fit-contain" controls autoplay muted playsinline></video>
            <% } else { %>
              <div class="tk-live__hint tk-live__hint--paused" id="viewerIdle">
                <% if (stream.thumbnail) { %>
                  <img class="tk-live__thumb" src="<%= stream.thumbnail %>" alt="">
                <% } %>
                <p class="tk-live__hint-title" data-i18n="viewer.pausedTitle"><%- t('viewer.pausedTitle') %></p>
                <p data-i18n="viewer.pausedText"><%- t('viewer.pausedText') %></p>
              </div>
            <% } %>

            <%- include('partials/streamBadges', { state: stream.isActive ? 'live' : 'paused' }) %>

            <button type="button" class="tk-live__fs" data-fullscreen aria-pressed="false" aria-label="<%= ta('stream.fullscreen') %>" data-i18n-aria="stream.fullscreen" title="<%= ta('stream.fullscreen') %>" data-i18n-title="stream.fullscreen">
              <svg class="tk-live__fs-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4.5 9V4.5H9M15 4.5h4.5V9M4.5 15v4.5H9M15 19.5h4.5V15"></path></svg>
              <svg class="tk-live__fs-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M9 4.5V9H4.5M19.5 9H15V4.5M9 19.5V15H4.5M15 19.5V15h4.5"></path></svg>
            </button>
          </div>

          <%- include('partials/streamInfo', { isStreamer: false }) %>
        </section>

        <%- include('partials/streamChat') %>
      </div>
    </div>
  </main>
</div>

<%# socket.io грузит шапка. Плеер HLS — только идущему эфиру. %>
<% if (playable) { %><script src="/tk-hls.js"></script><% } %>
<script src="/tk-stream.js"></script>
<script src="/tk-viewer.js"></script>
</body>
</html>

                    // ========== ОБРАБОТЧИКИ ДЛЯ ПОДПИСКИ ==========
                    // Найдём кнопку "Подписаться" или "Отписаться" после загрузки страницы
                    let subscribeButton = document.querySelector('.js-subscribe');
                    let unsubscribeButton = document.querySelector('.js-unsubscribe');

                    // Функция для подписки
                    async function handleSubscribe() {
                        const userId = '<%= user._id %>'; // ID стримера

                        // Отправляем запрос на подписку
                        const response = await fetch('/subscribe', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ userId }), // Отправляем ID стримера
                        });

                        if (response.ok) {
                            alert('Вы успешно подписались на стримера!');

                            // Обновляем интерфейс
                            updateSubscriptionStatus('unsubscribe');
                        } else {
                            const errorData = await response.json();
                            alert(`Ошибка: ${errorData.message}`);
                        }
                    }

                    // Функция для отписки
                    async function handleUnsubscribe() {
                        const userId = '<%= user._id %>'; // ID стримера

                        // Отправляем запрос на отписку
                        const response = await fetch('/unsubscribe', {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ userId }),
                        });

                        if (response.ok) {
                            alert('Вы успешно отписались от стримера!');

                            // Обновляем интерфейс
                            updateSubscriptionStatus('subscribe');
                        } else {
                            const errorData = await response.json();
                            alert(`Ошибка: ${errorData.message}`);
                        }
                    }

                    // Функция для обновления интерфейса (переключение между "Подписаться" и "Отписаться")
                    function updateSubscriptionStatus(status) {
                        if (status === 'subscribe') {
                            // Удаляем старые обработчики
                            unsubscribeButton.removeEventListener('click', handleUnsubscribe);

                            // Меняем кнопку на "Подписаться"
                            unsubscribeButton.textContent = 'Подписаться';
                            unsubscribeButton.classList.remove('js-unsubscribe');
                            unsubscribeButton.classList.add('js-subscribe');

                            // Заново добавляем обработчик для подписки
                            subscribeButton = document.querySelector('.js-subscribe');
                            subscribeButton.addEventListener('click', handleSubscribe);
                        } else if (status === 'unsubscribe') {
                            // Удаляем старые обработчики
                            subscribeButton.removeEventListener('click', handleSubscribe);

                            // Меняем кнопку на "Отписаться"
                            subscribeButton.textContent = 'Отписаться';
                            subscribeButton.classList.remove('js-subscribe');
                            subscribeButton.classList.add('js-unsubscribe');

                            // Заново добавляем обработчик для отписки
                            unsubscribeButton = document.querySelector('.js-unsubscribe');
                            unsubscribeButton.addEventListener('click', handleUnsubscribe);
                        }
                    }

                    // Если на странице есть кнопка "Подписаться", добавляем обработчик для подписки
                    if (subscribeButton) {
                        subscribeButton.addEventListener('click', handleSubscribe);
                    }

                    // Если на странице есть кнопка "Отписаться", добавляем обработчик для отписки
                    if (unsubscribeButton) {
                        unsubscribeButton.addEventListener('click', handleUnsubscribe);
                    }

                    // ========== ОБРАБОТЧИКИ ДЛЯ ЧАТА (ДЛЯ ВСЕХ) ==========
                    // Кнопка отправки сообщения
                    const sendButton = document.querySelector('.starting__buttone');
                    const messageInput = document.querySelector('.input__messeng');

                    if (sendButton && messageInput) {
                        sendButton.addEventListener('click', sendMessage);

                        // Отправка по Enter
                        messageInput.addEventListener('keypress', function (event) {
                            if (event.key === 'Enter' && !event.shiftKey) {
                                event.preventDefault();
                                sendMessage();
                            }
                        });
                    }

                    // Функция отправки сообщения в чат
                    async function sendMessage() {
                        const messageContent = messageInput.value.trim();
                        const streamId = '<%= stream._id %>';
                        const userId = '<%= currentUser._id %>';
                        const username = '<%= currentUser.displayName %>';

                        if (messageContent === '') {
                            return; // Не отправляем пустое сообщение
                        }

                        // Проверка длины сообщения
                        if (messageContent.length > 140) {
                            alert('Ошибка: Сообщение не должно превышать 140 символов');
                            return;
                        }

                        try {
                            // Отправка сообщения на бэкенд
                            const response = await fetch('/chat/message', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    streamId,
                                    userId,
                                    username,
                                    message: messageContent
                                }),
                            });

                            if (response.ok) {
                                messageInput.value = ''; // Очищаем поле ввода
                            } else {
                                console.error('Ошибка отправки сообщения');
                                alert('Ошибка при отправке сообщения');
                            }
                        } catch (error) {
                            console.error('Ошибка при отправке сообщения:', error);
                            alert('Произошла ошибка при отправке сообщения');
                        }
                    }

                    // ========== ЗАГРУЗКА НОВЫХ СООБЩЕНИЙ В ЧАТ (ДЛЯ ВСЕХ) ==========
                    // Функция для подгрузки новых сообщений
                    async function fetchNewMessages() {
                        const streamId = '<%= stream._id %>'; // Получаем ID стрима

                        try {
                            // Запрашиваем сообщения, которые были созданы после последнего сообщения
                            const url = `/api/chat/messages/new?streamId=${streamId}&lastMessageTime=${lastMessageTime || ''}`;

                            const response = await fetch(url);

                            if (response.ok) {
                                const newMessages = await response.json();

                                if (newMessages.length > 0) {
                                    const messageBox = document.querySelector('.messeg-box');

                                    // Добавляем каждое новое сообщение в конец чата
                                    newMessages.forEach(message => {
                                        const messageElement = document.createElement('div');
                                        messageElement.classList.add('chat-message', 'p-3', 'rounded-xl', 'bg-gray-50');

                                        // Определяем цвет имени пользователя
                                        const isCurrentUser = message.userId === '<%= currentUser._id %>';
                                        const nameColorClass = isCurrentUser ? 'text-green-600' : 'text-blue-600';

                                        messageElement.innerHTML = `
                                <div class="flex items-start space-x-3">
                                    <div class="flex-1">
                                        <p class="text-sm">
                                            <span class="${nameColorClass} font-semibold">${escapeHtml(message.username)}:</span>
                                            <span class="text-gray-900 ml-2">${escapeHtml(message.message)}</span>
                                        </p>
                                        <p class="text-xs text-gray-500 mt-1">${new Date(message.createdAt).toLocaleTimeString()}</p>
                                    </div>
                                </div>
                            `;

                                        messageBox.appendChild(messageElement);

                                        // Плавная прокрутка вниз к новому сообщению
                                        messageBox.scrollTo({
                                            top: messageBox.scrollHeight,
                                            behavior: 'smooth'
                                        });
                                    });

                                    // Обновляем время последнего сообщения только если новые сообщения действительно пришли
                                    lastMessageTime = newMessages[newMessages.length - 1].createdAt;
                                }
                            } else {
                                console.error('❌ Ошибка при получении новых сообщений, статус:', response.status);
                                const errorText = await response.text();
                                console.error('❌ Текст ошибки:', errorText);
                            }
                        } catch (error) {
                            console.error('❌ Ошибка при запросе новых сообщений:', error);
                        }
                    }

                    // ========== ИНИЦИАЛИЗАЦИЯ ЧАТА ДЛЯ ВСЕХ ПОЛЬЗОВАТЕЛЕЙ (В КОНЦЕ) ==========
                    // Инициализация — ставим время последнего сообщения после загрузки страницы
                    document.addEventListener('DOMContentLoaded', function () {
                        const messages = document.querySelectorAll('.chat-message');

                        if (messages.length > 0) {
                            lastMessageTime = messages[messages.length - 1].dataset.timestamp || null;
                        } else {
                            lastMessageTime = null;
                        }

                        // Прокручиваем чат вниз при загрузке страницы
                        const messageBox = document.querySelector('.messeg-box');
                        if (messageBox) {
                            setTimeout(() => {
                                messageBox.scrollTo({
                                    top: messageBox.scrollHeight,
                                    behavior: 'smooth'
                                });
                            }, 500); // Небольшая задержка для загрузки контента
                        }

                        // Проверяем что функция fetchNewMessages доступна
                        if (typeof fetchNewMessages === 'function') {
                            // Запускаем периодическую загрузку новых сообщений каждые 2 секунды
                            const chatInterval = setInterval(fetchNewMessages, 2000);

                            // Первая загрузка сразу
                            setTimeout(fetchNewMessages, 1000);
                        } else {
                            console.error("❌ Функция fetchNewMessages не найдена!");
                        }
                    });

                </script>

            <script>
                // Мобильная оптимизация видео
                document.addEventListener('DOMContentLoaded', function() {
                    const isMobile = window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                    
                    if (isMobile) {
                        console.log('📱 Применяем мобильную оптимизацию видео');
                        
                        // Функция для оптимизации видео элементов
                        function optimizeVideoForMobile(video) {
                            if (video) {
                                video.style.objectFit = 'contain';
                                video.style.objectPosition = 'center';
                                video.style.background = '#000';
                                video.setAttribute('webkit-playsinline', 'true');
                                video.setAttribute('playsinline', 'true');
                                console.log('📱 Видео оптимизировано для мобильного:', video.id);
                            }
                        }
                        
                        // Оптимизируем существующие видео
                        const remoteVideo = document.getElementById('remoteVideo');
                        const backupVideo = document.getElementById('backupVideo');
                        
                        optimizeVideoForMobile(remoteVideo);
                        optimizeVideoForMobile(backupVideo);
                        
                        // Наблюдаем за новыми видео элементами
                        const observer = new MutationObserver(function(mutations) {
                            mutations.forEach(function(mutation) {
                                mutation.addedNodes.forEach(function(node) {
                                    if (node.nodeType === 1) { // Element node
                                        const videos = node.tagName === 'VIDEO' ? [node] : node.querySelectorAll('video');
                                        videos.forEach(optimizeVideoForMobile);
                                    }
                                });
                            });
                        });
                        
                        observer.observe(document.body, {
                            childList: true,
                            subtree: true
                        });
                        
                        // Обработка изменения ориентации
                        window.addEventListener('orientationchange', function() {
                            setTimeout(function() {
                                const videos = document.querySelectorAll('video');
                                videos.forEach(optimizeVideoForMobile);
                                console.log('📱 Видео переоптимизировано после поворота экрана');
                            }, 500);
                        });
                    }
                });
            </script>

            <script>

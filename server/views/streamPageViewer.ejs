                  // Daily видео
                  var remoteVideo = document.getElementById('remoteVideo');
                  var backupVideo = document.getElementById('backupVideo');
                  [remoteVideo, backupVideo].forEach(function(v){
                    if (v) {
                      v.style.objectFit = isMobile ? 'contain' : 'cover';
                      v.style.objectPosition = 'center';
                      v.style.background = '#000';
                    }
                  });

                  // video.js внутренняя tech-нода
                  var tech = document.querySelector('.video-js .vjs-tech');
                  if (tech) {
                    tech.style.objectFit = isMobile ? 'contain' : '';
                    tech.style.objectPosition = isMobile ? 'center' : '';
                    tech.style.background = isMobile ? '#000' : '';
                  }
                } catch (e) { console.warn('applyMobilePlayerSizing error', e); }
              }
              window.addEventListener('resize', applyMobilePlayerSizing);
              document.addEventListener('DOMContentLoaded', applyMobilePlayerSizing);

              // Полноэкранный режим
              function getActiveVideoElement() {
                var el = document.getElementById('remoteVideo');
                if (el && el.style.display !== 'none') return el;
                el = document.getElementById('backupVideo');
                if (el && el.style.display !== 'none') return el;
                var tech = document.querySelector('.video-js .vjs-tech');
                return tech || document.getElementById('viewerPlayerContainer');
              }
              function toggleFullscreenViewer() {
                try {
                  var container = document.getElementById('viewerPlayerContainer');
                  var activeVideo = getActiveVideoElement();
                  var doc = document;
                  if (!doc.fullscreenElement && !doc.webkitFullscreenElement) {
                    if (container.requestFullscreen) container.requestFullscreen();
                    else if (container.webkitRequestFullscreen) container.webkitRequestFullscreen();
                    else if (activeVideo && activeVideo.webkitEnterFullscreen) activeVideo.webkitEnterFullscreen();
                  } else {
                    if (doc.exitFullscreen) doc.exitFullscreen();
                    else if (doc.webkitExitFullscreen) doc.webkitExitFullscreen();
                  }
                } catch(e) { console.warn('fullscreen error', e); }
              }
              document.addEventListener('DOMContentLoaded', function(){
                var fsBtn = document.getElementById('fullscreenButton');
                if (fsBtn) fsBtn.addEventListener('click', toggleFullscreenViewer);
              });
            })();
            </script>
</body>

</html>
<%#
  Страница зрителя. Плеер — по типу эфира: OBS смотрят через HLS
  (/tk-hls.js), веб-эфир — участником комнаты Daily (/tk-daily.js). Общее
  с пультом ведущего — шапка эфира, чат, счётчик и таймер — в
  partials/streamInfo, partials/streamChat и /tk-stream.js.
%>
<!DOCTYPE html>
<html lang="ru">
<head>
<%- include('partials/tkHead', { title: stream.title + ' — Takebana' }) %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/stream.css">
</head>

<body class="tk-app"
      data-stream-id="<%= stream._id %>"
      data-stream-key="<%= streamKey %>"
      data-user-id="<%= currentUser._id %>"
      data-streamer-id="<%= user._id %>"
      data-stream-type="<%= stream.streamType %>"
      data-stream-active="<%= stream.isActive ? '1' : '0' %>"
      data-started-at="<%= stream.isActive && stream.startedAt ? new Date(stream.startedAt).toISOString() : '' %>">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-live tk-live--viewer">
      <div class="tk-live__grid">

        <section class="tk-live__col">
          <div class="tk-live__player video-player-area" id="viewerPlayerContainer">
            <%# Плеер выбирается по типу эфира, а не по isActive: флаг успевает
                обновиться уже после того, как поток пошёл. %>
            <% if (stream.streamType === 'obs-stream') { %>
              <video id="video" class="video-fit-contain" controls autoplay muted playsinline></video>

            <% } else if (stream.streamType === 'daily-stream') { %>
              <div class="tk-live__daily">
                <%# Картинка и звук — разными элементами: видео без звука автозапуск
                    пропускает всегда, звук браузер может придержать до нажатия. %>
                <video id="remoteVideo" class="video-fit-cover" autoplay muted playsinline style="display: none;"></video>
                <audio id="remoteAudio" autoplay></audio>

                <div class="tk-live__volume" id="volumeControl" style="display: none;">
                  <button type="button" id="muteButton" aria-label="Звук" data-i18n-aria="viewer.sound" aria-pressed="false">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4V5Z"></path><path d="M16 9.5a3.5 3.5 0 010 5"></path></svg>
                  </button>
                  <input type="range" id="volumeSlider" class="volume-slider" min="0" max="100" value="100" aria-label="Громкость" data-i18n-aria="viewer.volume">
                  <span id="volumeValue">100</span>
                  <button type="button" id="fullscreenButton" title="На весь экран" aria-label="На весь экран" data-i18n-title="stream.fullscreen" data-i18n-aria="stream.fullscreen">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M4.5 9V4.5H9M15 4.5h4.5V9M4.5 15v4.5H9M15 19.5h4.5V15"></path></svg>
                  </button>
                </div>

                <div class="tk-live__daily-status" id="dailyStatus">Подключение к эфиру…</div>
              </div>

            <% } else { %>
              <div class="tk-live__hint tk-live__hint--paused">
                <% if (stream.thumbnail) { %>
                  <img class="tk-live__thumb" src="<%= stream.thumbnail %>" alt="">
                <% } %>
                <p class="tk-live__hint-title" data-i18n="viewer.pausedTitle">Эфир приостановлен</p>
                <p data-i18n="viewer.pausedText">Трансляция продолжится, как только ведущий вернётся в эфир.</p>
              </div>
            <% } %>

            <span class="tk-live__type" id="streamTypeBadge"><%= stream.streamType === 'obs-stream' ? 'OBS' : (stream.streamType === 'daily-stream' ? 'WEB' : stream.streamType) %></span>
          </div>

          <%- include('partials/streamInfo', { isStreamer: false }) %>
        </section>

        <%- include('partials/streamChat') %>
      </div>
    </div>
  </main>
</div>

<%# socket.io и tk-daily.js грузит шапка. Плеер HLS нужен только OBS-эфиру. %>
<% if (stream.streamType === 'obs-stream') { %>
<script src="/tk-hls.js"></script>
<% } %>
<script src="/tk-stream.js"></script>
<script>
(function () {
  const data = document.body.dataset;
  const player = document.getElementById('viewerPlayerContainer');
  const active = data.streamActive === '1';

  // Тип эфира, его старт и остановка меняют сам плеер — на месте он не
  // перестраивается, страница перезагружается.
  TKStream.onUpdate((u) => {
    if ((u.streamType && u.streamType !== data.streamType) ||
        (typeof u.isActive === 'boolean' && u.isActive !== active)) {
      location.reload();
    }
  });

  // Подписка на ведущего: одна кнопка, состояние — в её классе.
  const subBtn = document.querySelector('.js-subscribe, .js-unsubscribe');
  subBtn.addEventListener('click', async () => {
    const subscribe = subBtn.classList.contains('js-subscribe');
    try {
      const r = await fetch(subscribe ? '/subscribe' : '/unsubscribe', {
        method: subscribe ? 'POST' : 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ userId: data.streamerId }),
      });
      if (!r.ok) {
        const b = await r.json().catch(() => ({}));
        toast('Ошибка: ' + (b.message || 'HTTP ' + r.status), 'error');
        return;
      }
    } catch (_) {
      toast('Нет связи — попробуйте ещё раз', 'error');
      return;
    }
    toast(subscribe ? 'Вы успешно подписались на стримера!' : 'Вы успешно отписались от стримера!', 'ok');
    subBtn.classList.toggle('js-subscribe', !subscribe);
    subBtn.classList.toggle('js-unsubscribe', subscribe);
    subBtn.classList.toggle('tk-btn--primary', !subscribe);
    subBtn.classList.toggle('tk-btn--outline', subscribe);
    subBtn.setAttribute('lng', subscribe ? '130' : '91');
    subBtn.textContent = subscribe ? (t('130') || 'Отписаться') : (t('91') || 'Подписаться');
  });

  if (data.streamType === 'obs-stream') {
    // OBS-эфир — HLS, тот же плеер, что у предпросмотра ведущего.
    const hlsUrl = `/live/${data.streamKey}/index.m3u8`;
    TKHls.play(document.getElementById('video'), hlsUrl, {
      attempts: 30,
      onGiveUp: () => console.error('[hls] плейлист не появился за минуту:', hlsUrl),
    });
    return;
  }
  if (data.streamType !== 'daily-stream') return;

  // ── Веб-эфир: зритель — участник комнаты Daily, только на приём ──
  const video = document.getElementById('remoteVideo');
  const audio = document.getElementById('remoteAudio');
  const t = (key, arg) => (window.t ? window.t(key, arg) : '');
  const status = document.getElementById('dailyStatus');
  const volume = document.getElementById('volumeControl');
  const slider = document.getElementById('volumeSlider');
  const level = document.getElementById('volumeValue');
  const muteBtn = document.getElementById('muteButton');

  // Строку статуса пишет скрипт, поэтому ключ переезжает на сам элемент:
  // общий переключатель языка перерисовывает всё с data-i18n, и статичный
  // ключ в разметке затирал бы то, что здесь поставлено.
  const say = (key) => {
    if (key) status.setAttribute('data-i18n', key);
    else status.removeAttribute('data-i18n');
    status.textContent = key ? t(key) : '';
    status.style.display = key ? '' : 'none';
  };

  // Автозапуск придержан браузером — ждём первого нажатия по плееру.
  let waitingTap = false;
  function resumeOnTap() {
    if (waitingTap) return;
    waitingTap = true;
    say('viewer.tapForSound');
    player.addEventListener('click', () => {
      waitingTap = false;
      say('');
      video.play().catch(() => {});
      audio.play().catch(() => {});
    }, { once: true });
  }

  slider.addEventListener('input', () => {
    audio.volume = slider.value / 100;
    audio.muted = slider.value === '0';
    level.textContent = slider.value;
  });
  muteBtn.addEventListener('click', () => {
    audio.muted = !audio.muted;
    if (!audio.muted && audio.volume === 0) audio.volume = 1;
    const v = audio.muted ? 0 : Math.round(audio.volume * 100);
    slider.value = v;
    level.textContent = v;
    muteBtn.setAttribute('aria-pressed', String(audio.muted));
  });
  document.getElementById('fullscreenButton').addEventListener('click', () => TKStream.fullscreen(player, video));

  // У неидущего эфира комнаты нет, и токен вернул бы отказ. Не ходим:
  // о старте придёт stream:update, и страница перезагрузится.
  if (!active) {
    say('viewer.idle');
    return;
  }

  const STATUS = {
    connecting: 'viewer.connecting',
    live: '',
    reconnecting: 'viewer.reconnecting',
    ended: 'viewer.ended',
  };
  TKDaily.connect({
    send: false,
    access: () => TKDaily.requestAccess('/api/get-token', { streamId: data.streamId }),
    onTrack: (track, p, on) => {
      if (p.local) return;
      const el = track.kind === 'video' ? video : audio;
      TKDaily.attach(el, on ? track : null);
      if (el === video) video.style.display = on ? 'block' : 'none';
      else volume.style.display = on ? '' : 'none';
      if (on) el.play().catch(resumeOnTap);
    },
    onState: (state) => {
      if (state in STATUS) say(STATUS[state]);
    },
  });
})();
</script>
</body>
</html>

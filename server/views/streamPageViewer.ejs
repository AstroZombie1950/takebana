                    <% } %>

                    // ========== ОБРАБОТЧИКИ ДЛЯ ПОДПИСКИ ==========
                    // Найдём кнопку "Подписаться" или "Отписаться" после загрузки страницы
                    let subscribeButton = document.querySelector('.js-subscribe');
                    let unsubscribeButton = document.querySelector('.js-unsubscribe');

                    // Функция для подписки
                    async function handleSubscribe() {
                        const userId = '<%= user._id %>'; // ID стримера

                        // Отправляем запрос на подписку
                        const response = await fetch('/subscribe', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ userId }), // Отправляем ID стримера
                        });

                        if (response.ok) {
                            toast('Вы успешно подписались на стримера!', 'ok');

                            // Обновляем интерфейс
                            updateSubscriptionStatus('unsubscribe');
                        } else {
                            const errorData = await response.json();
                            toast(`Ошибка: ${errorData.message}`, 'error');
                        }
                    }

                    // Функция для отписки
                    async function handleUnsubscribe() {
                        const userId = '<%= user._id %>'; // ID стримера

                        // Отправляем запрос на отписку
                        const response = await fetch('/unsubscribe', {
                            method: 'DELETE',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ userId }),
                        });

                        if (response.ok) {
                            toast('Вы успешно отписались от стримера!', 'ok');

                            // Обновляем интерфейс
                            updateSubscriptionStatus('subscribe');
                        } else {
                            const errorData = await response.json();
                            toast(`Ошибка: ${errorData.message}`, 'error');
                        }
                    }

                    // Функция для обновления интерфейса (переключение между "Подписаться" и "Отписаться")
                    function updateSubscriptionStatus(status) {
                        if (status === 'subscribe') {
                            // Удаляем старые обработчики
                            unsubscribeButton.removeEventListener('click', handleUnsubscribe);

                            // Меняем кнопку на "Подписаться"
                            unsubscribeButton.textContent = 'Подписаться';
                            unsubscribeButton.classList.remove('js-unsubscribe');
                            unsubscribeButton.classList.add('js-subscribe');

                            // Заново добавляем обработчик для подписки
                            subscribeButton = document.querySelector('.js-subscribe');
                            subscribeButton.addEventListener('click', handleSubscribe);
                        } else if (status === 'unsubscribe') {
                            // Удаляем старые обработчики
                            subscribeButton.removeEventListener('click', handleSubscribe);

                            // Меняем кнопку на "Отписаться"
                            subscribeButton.textContent = 'Отписаться';
                            subscribeButton.classList.remove('js-subscribe');
                            subscribeButton.classList.add('js-unsubscribe');

                            // Заново добавляем обработчик для отписки
                            unsubscribeButton = document.querySelector('.js-unsubscribe');
                            unsubscribeButton.addEventListener('click', handleUnsubscribe);
                        }
                    }

                    // Если на странице есть кнопка "Подписаться", добавляем обработчик для подписки
                    if (subscribeButton) {
                        subscribeButton.addEventListener('click', handleSubscribe);
                    }

                    // Если на странице есть кнопка "Отписаться", добавляем обработчик для отписки
                    if (unsubscribeButton) {
                        unsubscribeButton.addEventListener('click', handleUnsubscribe);
                    }

                    // ========== ОБРАБОТЧИКИ ДЛЯ ЧАТА (ДЛЯ ВСЕХ) ==========
                    // Кнопка отправки сообщения
                    const sendButton = document.querySelector('.starting__buttone');
                    const messageInput = document.querySelector('.input__messeng');

                    if (sendButton && messageInput) {
                        sendButton.addEventListener('click', sendMessage);

                        // Отправка по Enter
                        messageInput.addEventListener('keypress', function (event) {
                            if (event.key === 'Enter' && !event.shiftKey) {
                                event.preventDefault();
                                sendMessage();
                            }
                        });
                    }

                    // Функция отправки сообщения в чат
                    async function sendMessage() {
                        const messageContent = messageInput.value.trim();
                        const streamId = '<%= stream._id %>';
                        const userId = '<%= currentUser._id %>';
                        const username = '<%= currentUser.displayName %>';

                        if (messageContent === '') {
                            return; // Не отправляем пустое сообщение
                        }

                        // Проверка длины сообщения
                        if (messageContent.length > 140) {
                            toast('Ошибка: Сообщение не должно превышать 140 символов', 'error');
                            return;
                        }

                        try {
                            // Отправка сообщения на бэкенд
                            const response = await fetch('/chat/message', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    streamId,
                                    userId,
                                    username,
                                    message: messageContent
                                }),
                            });

                            if (response.ok) {
                                messageInput.value = ''; // Очищаем поле ввода
                            } else {
                                console.error('Ошибка отправки сообщения');
                                toast('Ошибка при отправке сообщения', 'error');
                            }
                        } catch (error) {
                            console.error('Ошибка при отправке сообщения:', error);
                            toast('Произошла ошибка при отправке сообщения', 'error');
                        }
                    }

                    // ========== ЧАТ ЭФИРА ==========
// Сообщения приходят сокетом в комнату эфира. Раньше здесь стоял
// setInterval(fetchNewMessages, 2000): каждый зритель дёргал сервер 30 раз
// в минуту, почти всегда впустую, и всё равно видел сообщение с задержкой
// до двух секунд. Опрос остался ровно для двух случаев — первая загрузка
// и добор пропущенного после обрыва связи.

// Отрисовка одного сообщения. Общая для сокета и для добора опросом.
function appendChatMessage(message) {
                        const messageBox = document.querySelector('.messeg-box');
                        if (!messageBox) return;

                        // Сообщение могло прийти и сокетом, и добором — второй раз не рисуем.
                        if (message._id && messageBox.querySelector(`[data-message-id="${message._id}"]`)) return;

                        const messageElement = document.createElement('div');
                        messageElement.classList.add('chat-message');
                        if (message._id) messageElement.dataset.messageId = message._id;
                        messageElement.dataset.timestamp = message.createdAt;

                        // Своё сообщение отмечается классом: цвет решает stream.css,
                        // а не разметка, собранная в браузере.
                        if (message.userId === '<%= currentUser._id %>') messageElement.classList.add('chat-message--own');

                        messageElement.innerHTML = `
                            <p class="chat-message__line">
                                <span class="chat-message__who">${escapeHtml(message.username)}</span>
                                <span class="chat-message__text">${escapeHtml(message.message)}</span>
                            </p>
                            <time class="chat-message__time">${new Date(message.createdAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}</time>
                        `;

                        messageBox.appendChild(messageElement);
                        messageBox.scrollTo({ top: messageBox.scrollHeight, behavior: 'smooth' });

                        if (message.createdAt) lastMessageTime = message.createdAt;
}

// Добор пропущенного: при открытии страницы и после восстановления связи.
async function fetchNewMessages() {
                        const streamId = '<%= stream._id %>';

                        try {
                            const url = `/api/chat/messages/new?streamId=${streamId}&lastMessageTime=${lastMessageTime || ''}`;
                            const response = await fetch(url);
                            if (!response.ok) {
                                console.error('Ошибка при получении новых сообщений, статус:', response.status);
                                return;
                            }
                            (await response.json()).forEach(appendChatMessage);
                        } catch (error) {
                            console.error('Ошибка при запросе новых сообщений:', error);
                        }
}

// ========== ИНИЦИАЛИЗАЦИЯ ЧАТА ДЛЯ ВСЕХ ПОЛЬЗОВАТЕЛЕЙ (В КОНЦЕ) ==========
                    // Инициализация — ставим время последнего сообщения после загрузки страницы
                    document.addEventListener('DOMContentLoaded', function () {
                        const messages = document.querySelectorAll('.chat-message');

                        if (messages.length > 0) {
                            lastMessageTime = messages[messages.length - 1].dataset.timestamp || null;
                        } else {
                            lastMessageTime = null;
                        }

                        // Прокручиваем чат вниз при загрузке страницы
                        const messageBox = document.querySelector('.messeg-box');
                        if (messageBox) {
                            setTimeout(() => {
                                messageBox.scrollTo({
                                    top: messageBox.scrollHeight,
                                    behavior: 'smooth'
                                });
                            }, 500); // Небольшая задержка для загрузки контента
                        }

                        // Новые сообщения приходят сокетом в комнату эфира. Этот вызов —
                        // страховка на случай, если сокет не поднялся: основной добор идёт
                        // в подтверждении входа в комнату, там же и после обрыва связи.
                        // Повторы отсекаются по data-message-id.
                        fetchNewMessages();
                        if (typeof socket !== 'undefined' && socket) {
                            socket.on('chat:message', appendChatMessage);
                        } else {
                            console.error('Сокет недоступен — новые сообщения чата приходить не будут');
                        }
                    });

                </script>

            <script>
                // Мобильная оптимизация видео
                document.addEventListener('DOMContentLoaded', function() {
                    const isMobile = window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                    
                    if (isMobile) {
                        console.log('📱 Применяем мобильную оптимизацию видео');
                        
                        // Функция для оптимизации видео элементов
                        function optimizeVideoForMobile(video) {
                            if (video) {
                                video.style.objectFit = 'contain';
                                video.style.objectPosition = 'center';
                                video.style.background = '#000';
                                video.setAttribute('webkit-playsinline', 'true');
                                video.setAttribute('playsinline', 'true');
                                console.log('📱 Видео оптимизировано для мобильного:', video.id);
                            }
                        }
                        
                        // Оптимизируем существующие видео
                        const remoteVideo = document.getElementById('remoteVideo');
                        const backupVideo = document.getElementById('backupVideo');
                        
                        optimizeVideoForMobile(remoteVideo);
                        optimizeVideoForMobile(backupVideo);
                        
                        // Наблюдаем за новыми видео элементами
                        const observer = new MutationObserver(function(mutations) {
                            mutations.forEach(function(mutation) {
                                mutation.addedNodes.forEach(function(node) {
                                    if (node.nodeType === 1) { // Element node
                                        const videos = node.tagName === 'VIDEO' ? [node] : node.querySelectorAll('video');
                                        videos.forEach(optimizeVideoForMobile);
                                    }
                                });
                            });
                        });
                        
                        observer.observe(document.body, {
                            childList: true,
                            subtree: true
                        });
                        
                        // Обработка изменения ориентации
                        window.addEventListener('orientationchange', function() {
                            setTimeout(function() {
                                const videos = document.querySelectorAll('video');
                                videos.forEach(optimizeVideoForMobile);
                                console.log('📱 Видео переоптимизировано после поворота экрана');
                            }, 500);
                        });
                    }
                });
            </script>

            <script>
            // Увеличиваем высоту плеера и убираем обрезание на телефонах
            (function() {
              function applyMobilePlayerSizing() {
                try {
                  var container = document.getElementById('viewerPlayerContainer');
                  if (!container) return;
                  var isMobile = window.innerWidth <= 500;
                  if (isMobile) {
                    container.style.height = '62vh';
                    container.style.minHeight = '300px';
                    container.style.aspectRatio = '';
                  } else {
                    container.style.height = '';
                    container.style.minHeight = '';
                    container.style.aspectRatio = '16/9';
                  }

                  // Daily видео
                  var remoteVideo = document.getElementById('remoteVideo');
                  var backupVideo = document.getElementById('backupVideo');
                  [remoteVideo, backupVideo].forEach(function(v){
                    if (v) {
                      v.style.objectFit = isMobile ? 'contain' : 'cover';
                      v.style.objectPosition = 'center';
                      v.style.background = '#000';
                    }
                  });

                  // video.js внутренняя tech-нода
                  var tech = document.querySelector('.video-js .vjs-tech');
                  if (tech) {
                    tech.style.objectFit = isMobile ? 'contain' : '';
                    tech.style.objectPosition = isMobile ? 'center' : '';
                    tech.style.background = isMobile ? '#000' : '';
                  }
                } catch (e) { console.warn('applyMobilePlayerSizing error', e); }
              }
              window.addEventListener('resize', applyMobilePlayerSizing);
              document.addEventListener('DOMContentLoaded', applyMobilePlayerSizing);

              // Полноэкранный режим
              function getActiveVideoElement() {
                var el = document.getElementById('remoteVideo');
                if (el && el.style.display !== 'none') return el;
                el = document.getElementById('backupVideo');
                if (el && el.style.display !== 'none') return el;
                var tech = document.querySelector('.video-js .vjs-tech');
                return tech || document.getElementById('viewerPlayerContainer');
              }
              function toggleFullscreenViewer() {
                try {
                  var container = document.getElementById('viewerPlayerContainer');
                  var activeVideo = getActiveVideoElement();
                  var doc = document;
                  if (!doc.fullscreenElement && !doc.webkitFullscreenElement) {
                    if (container.requestFullscreen) container.requestFullscreen();
                    else if (container.webkitRequestFullscreen) container.webkitRequestFullscreen();
                    else if (activeVideo && activeVideo.webkitEnterFullscreen) activeVideo.webkitEnterFullscreen();
                  } else {
                    if (doc.exitFullscreen) doc.exitFullscreen();
                    else if (doc.webkitExitFullscreen) doc.webkitExitFullscreen();
                  }
                } catch(e) { console.warn('fullscreen error', e); }
              }
              document.addEventListener('DOMContentLoaded', function(){
                var fsBtn = document.getElementById('fullscreenButton');
                if (fsBtn) fsBtn.addEventListener('click', toggleFullscreenViewer);
              });
            })();
            </script>
</body>

</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand': {
                            50: '#f0f2ff',
                            100: '#e5e7ff',
                            200: '#cdcfff',
                            300: '#a5a9ff',
                            400: '#7a7aff',
                            500: '#666bcf',
                            600: '#5a5cba',
                            700: '#4c4e9a',
                            800: '#3f417e',
                            900: '#363865'
                        }
                    }
                }
            }
        }
    </script>
    
    <link href="https://vjs.zencdn.net/7.20.3/video-js.css" rel="stylesheet" />
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Daily.co библиотека (обновлено до 0.83.1+ для совместимости с Chrome) -->
    <script src="https://unpkg.com/@daily-co/daily-js@0.83.1/dist/daily-iframe.js"></script>  

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&family=Urbanist:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
  
    <title>Stream Page</title>
    
    <style>
        body { font-family: 'Inter', sans-serif; }
        .video-js { font-family: 'Inter', sans-serif; }
        .video-container { aspect-ratio: 16/9; }
        .gradient-border {
            background: linear-gradient(135deg, rgba(102, 107, 207, 0.1), rgba(102, 107, 207, 0.2));
            padding: 1px;
            border-radius: 1rem;
        }
        .chat-message {
            animation: slideInRight 0.3s ease-out;
        }
        @keyframes slideInRight {
            from { transform: translateX(20px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
        .stream-indicator {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        
        /* Кастомный скроллбар для чата */
        .messeg-box::-webkit-scrollbar {
            width: 6px;
        }
        .messeg-box::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 10px;
        }
        .messeg-box::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        .messeg-box::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        

        
        /* Адаптив для блока информации о стриме */
        @media (max-width: 768px) {
            .stream-info {
                padding: 0.75rem;
            }
            
            .stream-meta {
                flex-direction: column;
                gap: 0.5rem;
            }
            
            .stats-section {
                gap: 0.25rem;
                flex-wrap: wrap;
            }
            
            /* Компактные индикаторы для мобильных */
            .stream-paused-message,
            .stream-active-message {
                padding: 0.25rem 0.5rem !important;
                font-size: 0.625rem !important;
                top: 0.5rem !important;
                left: 0.5rem !important;
                border-radius: 0.5rem !important;
            }
            
            .stream-paused-message span,
            .stream-active-message span {
                font-size: 0.625rem !important;
                line-height: 1 !important;
            }
            
            .stream-paused-message svg,
            .stream-active-message svg {
                width: 0.75rem !important;
                height: 0.75rem !important;
            }
            
            /* Плейсхолдер видео */
            #videoPlaceholder {
                font-size: 0.875rem !important;
                padding: 1rem !important;
                text-align: center;
                line-height: 1.4;
            }
            
            /* Компактные статистики */
            .live-indicator {
                padding: 0.375rem 0.5rem !important;
            }
            
            .live-indicator span {
                font-size: 0.75rem !important;
            }
            
            .viewer-count {
                padding: 0.375rem 0.5rem !important;
            }
            
            .viewer-count span {
                font-size: 0.75rem !important;
            }
            
            /* Компактные кнопки управления */
            .control-buttons button {
                padding: 0.5rem 1rem !important;
                font-size: 0.875rem !important;
            }
            
            /* Заголовок стрима */
            .stream-title {
                font-size: 1.125rem !important;
                line-height: 1.4 !important;
            }
            
            /* Описание стрима */
            .stream-description {
                font-size: 0.875rem !important;
                line-height: 1.4 !important;
            }
            
            /* Улучшенное видео для мобильных */
            #localVideo,
            #remoteVideo,
            video {
                object-fit: cover !important;
                object-position: center !important;
            }
            
            /* Контейнер видео - обеспечиваем правильное соотношение сторон */
            .video-container,
            [style*="aspect-ratio: 16/9"] {
                aspect-ratio: 16/9 !important;
                width: 100% !important;
                height: auto !important;
                overflow: hidden;
            }
            
            /* Для мобильных устройств - предотвращаем обрезание */
            .mobile-video-fix {
                width: 100% !important;
                height: 100% !important;
                object-fit: contain !important; /* Покажет всё видео с чёрными полосами если нужно */
                background: #000;
            }
        }
        
        /* Очень маленькие экраны (до 480px) */
        @media (max-width: 480px) {
            .main-content {
                padding: 0.5rem !important;
            }
            
            .stream-paused-message,
            .stream-active-message {
                padding: 0.375rem 0.5rem !important;
                font-size: 0.625rem !important;
                top: 0.5rem !important;
                left: 0.5rem !important;
                border-radius: 0.75rem !important;
            }
            
            #videoPlaceholder {
                font-size: 0.75rem !important;
                padding: 0.75rem !important;
            }
            
            .stats-section {
                gap: 0.125rem;
            }
            
            .live-indicator,
            .viewer-count {
                padding: 0.25rem 0.375rem !important;
            }
            
            .live-indicator span,
            .viewer-count span {
                font-size: 0.625rem !important;
            }
            
            /* Индикаторы точек */
            .w-2.h-2 {
                width: 0.375rem !important;
                height: 0.375rem !important;
            }
        }
        
        /* Стили для лучшего отображения видео */
        .video-fit-cover {
            object-fit: cover;
            object-position: center;
        }
        
        .video-fit-contain {
            object-fit: contain;
            object-position: center;
            background: #000;
        }
        
        /* Мобильные: делаем контейнер выше и избегаем обрезания */
        @media (max-width: 500px) {
            .video-player-area {
                aspect-ratio: auto;
                height: 64vh;
                min-height: 300px;
            }
            #localVideo {
                object-fit: contain;
                object-position: center;
                background: #000;
            }
        }
        
        /* Анимированные переходы для мобильных */
        @media (max-width: 768px) {
            .stream-indicator {
                animation: pulse 1.5s infinite;
            }
        }
        
        @media (max-width: 350px) {
            .stream-info {
                padding: 0.5rem;
            }
            
            .stream-title {
                font-size: 0.875rem;
                line-height: 1.25rem;
                margin-bottom: 0.5rem;
            }
            
            .stream-meta {
                gap: 0.5rem;
            }
            
            .author-section {
                space-x: 0.375rem;
            }
            
            .avatar {
                width: 1.75rem;
                height: 1.75rem;
                border-radius: 0.5rem;
            }
            
            .avatar span {
                font-size: 0.75rem;
            }
            
            .author-name {
                font-size: 0.75rem;
            }
            
            .streamer-badge {
                font-size: 0.625rem;
            }
            
            .stats-section {
                gap: 0.375rem;
                font-size: 0.625rem;
            }
            
            .duration-text {
                font-size: 0.5625rem;
            }
            
            .viewers-text {
                display: none;
            }
            
            .stream-description {
                font-size: 0.625rem;
                line-height: 1rem;
            }
        }
        
        /* Ультра-маленькие экраны до 250px */
        @media (max-width: 250px) {
            .stream-info {
                padding: 0.375rem;
            }
            
            .stream-title {
                font-size: 0.75rem;
                line-height: 1.125rem;
                margin-bottom: 0.375rem;
            }
            
            .stream-meta {
                gap: 0.375rem;
            }
            
            .author-section {
                space-x: 0.25rem;
            }
            
            .avatar {
                width: 1.5rem;
                height: 1.5rem;
                border-radius: 0.375rem;
            }
            
            .avatar span {
                font-size: 0.625rem;
            }
            
            .author-name {
                font-size: 0.6875rem;
            }
            
            .streamer-badge {
                font-size: 0.5625rem;
            }
            
            .stats-section {
                gap: 0.25rem;
                font-size: 0.5625rem;
            }
            
            .live-indicator, .viewer-count {
                gap: 0.125rem;
                padding: 0.375rem 0.5rem;
                font-size: 0.5625rem;
            }
            
            .live-indicator .duration-text,
            .viewer-count .online__pepole-count {
                font-size: 0.5rem;
            }
            
            .live-indicator .duration-text {
                padding: 0.125rem 0.375rem;
            }
            
            .stream-description {
                font-size: 0.5625rem;
                line-height: 0.875rem;
            }
        }
        
        /* Улучшенная типографика */
        .line-clamp-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        .line-clamp-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        
        /* Дополнительная поддержка xs breakpoint */
        @media (min-width: 475px) {
            .xs\:inline {
                display: inline;
            }
        }
        
        /* Адаптивный чат - стили как на странице зрителя */
        .chat-overlay {
            position: fixed;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
            display: none;
        }
        
        .chat-tab {
            position: fixed;
            top: 50%;
            right: 0;
            transform: translateY(-50%);
            background: white;
            padding: 12px 8px;
            border-radius: 12px 0 0 12px;
            box-shadow: -2px 0 10px rgba(0, 0, 0, 0.1);
            cursor: pointer;
            z-index: 998;
            transition: all 0.3s ease;
            border-right: none;
        }
        
        .chat-tab:hover {
            background: #f3f4f6;
            transform: translateY(-50%) translateX(-2px);
        }
        
        /* Адаптив для мобильных устройств */
        @media (max-width: 1279px) {
            .chat-container {
                position: fixed;
                top: 0;
                right: 0;
                width: 100%;
                max-width: 400px;
                height: 100%;
                z-index: 1000;
                transform: translateX(100%);
                transition: transform 0.3s ease;
            }
            
            .chat-container.open {
                transform: translateX(0);
            }
            
            .chat__box {
                height: 100% !important;
                border-radius: 0 !important;
            }
        }
        
        @media (max-width: 768px) {
            .main-content {
                padding: 1rem;
            }
            
            .video-container {
                margin-bottom: 1rem;
            }
            
            .chat-container {
                max-width: 350px;
            }
            
            .chat-tab {
                padding: 10px 6px;
                right: -2px;
            }
        }
        
        @media (max-width: 480px) {
            .main-content {
                padding: 0.5rem;
            }
            
            .video-container {
                border-radius: 12px;
                overflow: hidden;
            }
            
            .chat-container {
                max-width: 320px;
            }
            
            .chat-tab {
                padding: 8px 5px;
                right: -3px;
                font-size: 0.75rem;
            }
        }
        
        @media (max-width: 350px) {
            .main-content {
                padding: 0.25rem;
            }
            
            .video-container {
                border-radius: 8px;
                margin-bottom: 0.5rem;
            }
            
            .chat-container {
                max-width: 280px;
            }
            
            .chat-tab {
                padding: 6px 4px;
                right: -4px;
                font-size: 0.7rem;
                border-radius: 8px 0 0 8px;
            }
        }
        
        /* Ультра-маленькие экраны до 250px */
        @media (max-width: 250px) {
            .main-content {
                padding: 0.125rem;
            }
            
            .video-container {
                border-radius: 8px;
                margin-bottom: 0.5rem;
            }
            
            .chat-container {
                max-width: 240px;
            }
            
            .chat-tab {
                padding: 4px 3px;
                font-size: 0.625rem;
            }
        }
        
    </style>
</head>
<body class="bg-gray-50"
      data-obs-only="<%= (typeof obsOnly !== 'undefined' && obsOnly) ? '1' : '0' %>"
      data-stream-id="<%= stream._id %>"
      data-stream-active="<%= stream.isActive ? '1' : '0' %>">
    
    <%- include('partials/header') %>

    <!-- Основной контейнер с отступом слева -->
    <div class="lg:pl-80 min-h-screen bg-gray-50">
        
        <%- include('partials/leftBar') %>

        <!-- Главный контент -->
        <div class="main-content p-4 sm:p-6 lg:p-8">
            <div class="max-w-7xl mx-auto">

                <!-- Главные переключатели режима стрима (всегда сверху) -->
                <div class="mb-4 sm:mb-6">
                    <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
                        <div class="p-4 sm:p-5 md:p-6">
                            <div class="flex flex-col gap-3 sm:gap-4">
                                <div class="flex items-center justify-between gap-3">
                                    <div class="text-sm sm:text-base font-semibold text-gray-900">
                                        <span lng="230">Режим трансляции</span>
                                    </div>
                                    <div class="text-xs sm:text-sm text-gray-500">
                                        <span lng="231">Стрим:</span> <span class="font-mono"><%= stream._id %></span>
                                    </div>
                                </div>

                                <div class="flex bg-gray-100 rounded-2xl p-1">
                                    <% if (typeof obsOnly !== 'undefined' && obsOnly) { %>
                                        <button class="web_stream flex-1 py-3 sm:py-3.5 px-4 text-sm sm:text-base font-bold rounded-xl transition-all duration-200 text-gray-600 hover:text-gray-900">
                                            <span lng="232">WEB (браузер)</span>
                                        </button>
                                        <button class="obs_stream flex-1 py-3 sm:py-3.5 px-4 text-sm sm:text-base font-bold rounded-xl transition-all duration-200 active bg-white text-brand-600 shadow-sm">
                                            <span lng="233">OBS</span>
                                        </button>
                                    <% } else { %>
                                        <button class="web_stream flex-1 py-3 sm:py-3.5 px-4 text-sm sm:text-base font-bold rounded-xl transition-all duration-200 active bg-white text-brand-600 shadow-sm">
                                            <span lng="232">WEB (браузер)</span>
                                        </button>
                                        <button class="obs_stream flex-1 py-3 sm:py-3.5 px-4 text-sm sm:text-base font-bold rounded-xl transition-all duration-200 text-gray-600 hover:text-gray-900">
                                            <span lng="233">OBS</span>
                                        </button>
                                    <% } %>
                                </div>

                                <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                                    <div class="font-semibold mb-1" lng="234">Важно</div>
                                    <div class="text-amber-800">
                                        <span lng="235">Не закрывайте эту страницу и не уходите с неё во время трансляции — иначе стрим может считаться неактивным и отключиться. Обновлять страницу можно.</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
                    
                    <!-- Левая колонка - Видео плеер -->
                    <div class="xl:col-span-2">
                        <div class="bg-white rounded-3xl shadow-xl overflow-hidden">
                            
                            <!-- Видео контейнер -->
                            <div id="playerContainer" class="video-player-area relative bg-black rounded-t-3xl overflow-hidden h-[64vh] min-h-[300px] sm:h-auto" style="aspect-ratio: 16/9;">
                                
                                <!-- Daily.co видео контейнер -->
                                <video id="localVideo" class="w-full h-full video-fit-cover" autoplay muted playsInline webkit-playsinline x5-playsinline x5-video-player-type="h5" style="display: none;"></video>

                                <!-- OBS preview (HTTP-FLV через /live) -->
                                <video id="video" class="w-full h-full video-fit-cover" autoplay muted playsInline webkit-playsinline x5-playsinline x5-video-player-type="h5" style="display: none; position:absolute; inset:0; z-index: 12;"></video>
                                <div id="obsPreviewHint" class="w-full h-full flex items-center justify-center text-white text-sm sm:text-lg px-4" style="display:none; position:absolute; inset:0; z-index: 13;">
                                    <div class="text-center">
                                        <div class="mb-2 font-semibold" lng="236">Предпросмотр OBS</div>
                                        <div class="text-xs sm:text-sm md:text-base text-white/80">
                                            <span lng="237">Запустите трансляцию в OBS — здесь появится видео.</span>
                                        </div>
                                    </div>
                                </div>
                                <div id="videoPlaceholder" class="w-full h-full flex items-center justify-center text-white text-sm sm:text-lg px-4">
                                    <div class="text-center">
                                        <div class="mb-2">
                                            <svg class="w-8 h-8 sm:w-12 sm:h-12 mx-auto text-white/60 mb-3" fill="currentColor" viewBox="0 0 24 24">
                                                <path fill-rule="evenodd" d="M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.348c1.295.712 1.295 2.573 0 3.285L7.28 19.991c-1.25.687-2.779-.217-2.779-1.643V5.653z" clip-rule="evenodd"/>
                                            </svg>
                                        </div>
                                        <div class="text-xs sm:text-sm md:text-base">
                                            <span lng="238">Нажмите</span> <span class="font-semibold" lng="239">"Начать стрим"</span><br class="sm:hidden">
                                            <span class="hidden sm:inline"> </span><span lng="240">для запуска</span>
                                        </div>
                                    </div>
                                </div>
                                

                                
                                <!-- Индикатор статуса стрима -->
                                <div class="absolute top-6 left-6">
                                    <% if (!stream.isActive) { %>
                                        <div class="stream-paused-message flex items-center bg-white/95 text-gray-700 px-4 py-2.5 rounded-2xl backdrop-blur-md border border-gray-200/50 shadow-lg">
                                            <svg class="w-4 h-4 mr-2 text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M5.25 5.25v13.5h3v-13.5h-3zm10.5 0v13.5h3v-13.5h-3z"/>
                                            </svg>
                                            <span class="font-semibold text-sm" lng="126">Стрим на паузе или не начат</span>
                                        </div>
                                        <div class="stream-active-message hidden flex items-center bg-gradient-to-r from-brand-500/95 to-purple-500/95 text-white px-4 py-2.5 rounded-2xl backdrop-blur-md shadow-lg border border-brand-400/30">
                                            <div class="relative mr-2">
                                                <div class="w-2 h-2 bg-white rounded-full stream-indicator shadow-sm"></div>
                                                <div class="absolute inset-0 w-2 h-2 bg-white rounded-full animate-pulse opacity-40"></div>
                                            </div>
                                            <span class="font-semibold text-sm" lng="127">В эфире</span>
                                        </div>
                                    <% } else { %>
                                        <div class="stream-paused-message hidden flex items-center bg-gradient-to-r from-brand-50/95 to-purple-50/95 text-brand-700 px-4 py-2.5 rounded-2xl backdrop-blur-md border border-brand-200/50 shadow-lg">
                                            <div class="p-1 bg-white/70 rounded-lg mr-2">
                                                <svg class="w-3 h-3 text-brand-600" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M5.25 5.25v13.5h3v-13.5h-3zm10.5 0v13.5h3v-13.5h-3z"/>
                                                </svg>
                                            </div>
                                            <span class="font-semibold text-sm" lng="126">Стрим на паузе или не начат</span>
                                        </div>
                                        <div class="stream-active-message flex items-center bg-gradient-to-r from-brand-500/95 to-purple-500/95 text-white px-4 py-2.5 rounded-2xl backdrop-blur-md shadow-lg border border-brand-400/30">
                                            <div class="relative mr-2">
                                                <div class="w-2 h-2 bg-white rounded-full stream-indicator shadow-sm"></div>
                                                <div class="absolute inset-0 w-2 h-2 bg-white rounded-full animate-pulse opacity-40"></div>
                                            </div>
                                            <span class="font-semibold text-sm" lng="127">В эфире</span>
                                        </div>
                                    <% } %>
                                </div>

                                <!-- Кнопка полноэкранного режима -->
                                <button id="streamerFsButton" class="absolute top-6 right-6 z-20 bg-black/50 hover:bg-black/60 text-white rounded-lg p-2 border border-white/10 transition-colors" title="На весь экран">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 9V4.5H9M15 4.5h4.5V9M4.5 15V19.5H9M15 19.5h4.5V15M9 4.5 4.5 9M19.5 9 15 4.5M9 19.5 4.5 15M19.5 15 15 19.5" />
                                    </svg>
                                </button>

                
                            </div>

                            <!-- Информация о стриме -->

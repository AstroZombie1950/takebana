// ========== ОБРАБОТЧИКИ ДЛЯ ЧАТА (ДЛЯ ВСЕХ) ==========
// Кнопка отправки сообщения
const sendButton = document.querySelector('.starting__buttone');
const messageInput = document.querySelector('.input__messeng');

if (sendButton && messageInput) {
    sendButton.addEventListener('click', sendMessage);
    
    // Отправка по Enter
    messageInput.addEventListener('keypress', function(event) {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
        }
    });
}

// Функция отправки сообщения в чат
async function sendMessage() {
    const messageContent = messageInput.value.trim();
    const streamId = '<%= stream._id %>';
    const userId = '<%= currentUser._id %>';
    const username = '<%= currentUser.displayName %>';

    if (messageContent === '') {
        return; // Не отправляем пустое сообщение
    }

    // Проверка длины сообщения
    if (messageContent.length > 140) {
        toast((window.langDict?.['248']?.[(localStorage.getItem('lang') === 'en' ? 'en' : 'ru')]) || 'Ошибка: Сообщение не должно превышать 140 символов', 'error');
        return;
    }

    try {
        // Отправка сообщения на бэкенд
        const response = await fetch('/chat/message', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                streamId,
                userId,
                username,
                message: messageContent
            }),
        });

        if (response.ok) {
            // console.log('Сообщение отправлено успешно!');
            messageInput.value = ''; // Очищаем поле ввода
        } else {
            console.error('Ошибка отправки сообщения');
            toast('Ошибка при отправке сообщения', 'error');
        }
    } catch (error) {
        console.error('Ошибка при отправке сообщения:', error);
        toast('Произошла ошибка при отправке сообщения', 'error');
    }
}

// ========== ЧАТ ЭФИРА ==========
// Сообщения приходят сокетом в комнату эфира. Раньше здесь стоял
// setInterval(fetchNewMessages, 2000): каждый зритель дёргал сервер 30 раз
// в минуту, почти всегда впустую, и всё равно видел сообщение с задержкой
// до двух секунд. Опрос остался ровно для двух случаев — первая загрузка
// и добор пропущенного после обрыва связи.

// Отрисовка одного сообщения. Общая для сокета и для добора опросом.
function appendChatMessage(message) {
    const messageBox = document.querySelector('.messeg-box');
    if (!messageBox) return;

    // Сообщение могло прийти и сокетом, и добором — второй раз не рисуем.
    if (message._id && messageBox.querySelector(`[data-message-id="${message._id}"]`)) return;

    const messageElement = document.createElement('div');
    messageElement.classList.add('chat-message');
    if (message._id) messageElement.dataset.messageId = message._id;
    messageElement.dataset.timestamp = message.createdAt;

    // Свои сообщения отмечаются классом, а не цветом в разметке: цвет решает
    // stream.css, и в тёмной теме он не остаётся синим по тёмному.
    if (message.userId === '<%= currentUser._id %>') messageElement.classList.add('chat-message--own');

    messageElement.innerHTML = `
        <p class="chat-message__line">
            <span class="chat-message__who">${escapeHtml(message.username)}</span>
            <span class="chat-message__text">${escapeHtml(message.message)}</span>
        </p>
        <time class="chat-message__time">${new Date(message.createdAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}</time>
    `;

    messageBox.appendChild(messageElement);
    messageBox.scrollTo({ top: messageBox.scrollHeight, behavior: 'smooth' });

    if (message.createdAt) lastMessageTime = message.createdAt;
}

// Добор пропущенного: при открытии страницы и после восстановления связи.
async function fetchNewMessages() {
    const streamId = '<%= stream._id %>';

    try {
        const url = `/api/chat/messages/new?streamId=${streamId}&lastMessageTime=${lastMessageTime || ''}`;
        const response = await fetch(url);
        if (!response.ok) {
            console.error('Ошибка при получении новых сообщений, статус:', response.status);
            return;
        }
        (await response.json()).forEach(appendChatMessage);
    } catch (error) {
        console.error('Ошибка при запросе новых сообщений:', error);
    }
}


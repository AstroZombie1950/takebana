        <!-- Подключаем необходимые библиотеки -->
    <script src="https://unpkg.com/peerjs@1.4.7/dist/peerjs.min.js"></script>
    <script src="https://cdn.socket.io/4.8.0/socket.io.min.js"></script>
    <% if (typeof obsOnly !== 'undefined' && obsOnly) { %>
        <!-- flv.js для предпросмотра OBS на странице стримера -->
        <script src="https://cdn.jsdelivr.net/npm/flv.js@1.6.2/dist/flv.min.js"></script>
    <% } %>
    
    

    <script src="/lang.js"></script>

    <script>
        // Глобальные переменные
        const streamKey = "<%= streamKey %>";
        const streamUrl = "<%= streamUrl %>";
        const serverEnv = '<%= start_server_env || "local" %>';
        
        console.log('=== STREAMER PAGE DEBUG ===');
        console.log('StreamKey from template:', streamKey);
        console.log('StreamKey type:', typeof streamKey);
        console.log('StreamKey length:', streamKey ? streamKey.length : 0);
        let currentStream;
        let lastMessageTime = null;
        let socket;

        // ОТЛАДКА: Проверяем что переменные определены правильно
        console.log('🔍 ОТЛАДКА переменных:');
        console.log('- streamKey:', streamKey);
        console.log('- streamUrl:', streamUrl);
        console.log('- serverEnv:', serverEnv);

        // Инициализация Socket.IO
        console.log('[Streamer] Initializing socket with serverEnv:', serverEnv);
        if (serverEnv == 'prod') {
            socket = io('https://takebana.com', {
                transports: ['websocket'],
                reconnection: true,
                reconnectionDelay: 1000,
                reconnectionAttempts: 5
            });
        }
        if (serverEnv == 'local') {
            socket = io('https://localhost:3000', {
                transports: ['websocket'],
                reconnection: true,
                reconnectionDelay: 1000,
                reconnectionAttempts: 5,
                rejectUnauthorized: false // Для self-signed SSL
            });
        }
        
        // Регистрируем обработчики ДО подключения
        console.log('[Streamer] Registering event handlers before connection...');
        
        // Функция для присоединения к комнате стрима
        const joinStreamRoom = () => {
            if (!streamKey || streamKey === 'undefined' || streamKey === 'null' || streamKey === '') {
                console.error('[Streamer] Cannot join: streamKey is invalid!', streamKey);
                return;
            }
            
            if (!socket.connected) {
                console.warn('[Streamer] Socket not connected, cannot join stream room');
                return;
            }
            
            console.log('[Streamer] Emitting join-stream-room, socket.connected:', socket.connected, 'socket.id:', socket.id);
            socket.emit('join-stream-room', streamKey, (response) => {
                console.log('[Streamer] join-stream-room callback response:', response);
            });
            console.log('[Streamer] Sent join-stream-room event with key:', streamKey);
        };

        // Стример тоже присоединяется к комнате, чтобы видеть счетчик
        socket.on('connect', () => {
            console.log('[Streamer] Socket connected! Socket ID:', socket.id);
            console.log('[Streamer] Socket connected state:', socket.connected);
            console.log('[Streamer] Attempting to join stream room with key:', streamKey);
            
            // Небольшая задержка чтобы убедиться что socket полностью подключен
            setTimeout(() => {
                joinStreamRoom();
            }, 100);
        });
        
        socket.on('connect_error', (error) => {
            console.error('[Streamer] Socket connection error:', error);
        });
        
        socket.on('disconnect', (reason) => {
            console.log('[Streamer] Socket disconnected, reason:', reason);
        });
        
        socket.on('reconnect', (attemptNumber) => {
            console.log('[Streamer] Socket reconnected after', attemptNumber, 'attempts');
            // При переподключении снова присоединяемся к комнате
            if (streamKey && streamKey !== 'undefined' && streamKey !== 'null' && streamKey !== '') {
                setTimeout(() => {
                    joinStreamRoom();
                }, 100);
            }
        });
        
        // Если socket уже подключен (например, при переподключении), сразу присоединяемся
        if (socket.connected) {
            console.log('[Streamer] Socket already connected, joining immediately');
            setTimeout(() => {
                joinStreamRoom();
            }, 100);
        }



        // Регистрируем обработчик ДО подключения, чтобы не пропустить события
        console.log('[Streamer] Registering viewers-count-updated handler...');
        
        // Обновление счетчика зрителей
        socket.on('viewers-count-updated', (data) => {
            console.log('[Streamer] ===== VIEWERS COUNT UPDATED EVENT RECEIVED =====');
            console.log('[Streamer] Full data:', JSON.stringify(data, null, 2));
            console.log('[Streamer] Received viewers count:', data);
            console.log('[Streamer] Comparing streamKey - received:', data.streamKey, 'local:', streamKey, 'match:', data.streamKey === streamKey);
            if (data.streamKey === streamKey) {
                // Пробуем обновить через .viewers-number (вложенный span)
                const viewersNumber = document.querySelector('.viewers-number');
                const countElement = document.querySelector('.online__pepole-count');
                
                console.log('[Streamer] Count element found:', !!countElement);
                console.log('[Streamer] Viewers number element found:', !!viewersNumber);
                
                if (viewersNumber) {
                    // Обновляем число зрителей
                    const oldText = viewersNumber.textContent;
                    viewersNumber.textContent = data.count;
                    console.log('[Streamer] Updated viewers-number from', oldText, 'to', data.count);
                } else if (countElement) {
                    // Fallback: обновляем весь элемент
                    const oldText = countElement.textContent;
                    countElement.textContent = `${data.count} зрителей`;
                    console.log('[Streamer] Updated count element from', oldText, 'to', countElement.textContent);
                } else {
                    console.error('[Streamer] ERROR: Neither .viewers-number nor .online__pepole-count element found!');
                    // Попробуем найти через другой селектор
                    const allCountElements = document.querySelectorAll('[class*="pepole"], [class*="viewer"]');
                    console.log('[Streamer] Found potential count elements:', allCountElements.length);
                }
            } else {
                console.warn('[Streamer] StreamKey mismatch! Received:', data.streamKey, 'Expected:', streamKey);
            }
        });

        // OBS preview для стримера на OBS-странице
        document.addEventListener('DOMContentLoaded', function () {
            const OBS_ONLY = document.body?.dataset?.obsOnly === '1';
            if (!OBS_ONLY) return;

            const previewVideo = document.getElementById('video');
            const hint = document.getElementById('obsPreviewHint');
            const placeholder = document.getElementById('videoPlaceholder');

            if (placeholder) placeholder.style.display = 'none';
            if (hint) hint.style.display = 'flex';

            if (!previewVideo) return;

            // Автоплей в браузерах почти всегда требует muted
            previewVideo.muted = true;

            const flvUrl = `/live/${streamKey}.flv`;
            console.log('[OBS Preview] Trying to play:', flvUrl);

            if (!(window.flvjs && flvjs.isSupported())) {
                console.error('[OBS Preview] flv.js is not supported in this browser');
                return;
            }

            let player = null;
            let retryTimer = null;
            const RETRY_MS = 2000;

            function cleanupPlayer() {
                if (!player) return;
                try { player.pause(); } catch (_) {}
                try { player.unload(); } catch (_) {}
                try { player.detachMediaElement(); } catch (_) {}
                try { player.destroy(); } catch (_) {}
                player = null;
            }

            function showHint() {
                if (hint) hint.style.display = 'flex';
                previewVideo.style.display = 'none';
            }

            function startPreview() {
                cleanupPlayer();
                showHint();

                player = flvjs.createPlayer(
                    { type: 'flv', url: flvUrl, isLive: true },
                    { enableStashBuffer: false, stashInitialSize: 128 }
                );

                player.attachMediaElement(previewVideo);
                player.load();
                player.play().catch((e) => console.warn('[OBS Preview] Autoplay blocked:', e));

                player.on(flvjs.Events.ERROR, (type, detail, info) => {
                    const status = info?.code;
                    // Ожидаемо, когда OBS еще не начал пушить: 404/502/503 и т.п.
                    if (detail === 'HttpStatusCodeInvalid' && (status === 404 || status === 502 || status === 503)) {
                        console.warn('[OBS Preview] Stream not ready yet. Retrying...', { type, detail, info });
                    } else {
                        console.error('[OBS Preview] Player error:', { type, detail, info });
                    }
                    cleanupPlayer();
                    showHint();
                    if (retryTimer) clearTimeout(retryTimer);
                    retryTimer = setTimeout(startPreview, RETRY_MS);
                });
            }

            previewVideo.addEventListener('playing', () => {
                if (hint) hint.style.display = 'none';
                previewVideo.style.display = 'block';
            });

            startPreview();

            window.addEventListener('beforeunload', () => {
                if (retryTimer) clearTimeout(retryTimer);
                cleanupPlayer();
            });
        });

        // Переключение между типами стрима

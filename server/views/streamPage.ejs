    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const streamId = '<%= stream._id %>';

            // Устойчивый heartbeat активности стримера (обновляет updatedAt)
            const HEARTBEAT_MS = 20000; // базовая частота
            let lastPing = 0;

            async function pingActivity(reason) {
                const now = Date.now();
                // анти-спам если события прилетают часто
                if (now - lastPing < 3000) return;
                lastPing = now;
                try {
                    // keepalive помогает при закрытии вкладки (не везде, но лучше чем ничего)
                    await fetch(`/stream/active/${streamId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        keepalive: true
                    });
                } catch (error) {
                    console.error('Ошибка при отправке активности стримера:', reason, error);
                }
            }

            // Основной интервал (может троттлиться в фоне)
            setInterval(() => pingActivity('interval'), HEARTBEAT_MS);
            // Первый пинг сразу
            pingActivity('init');

            // При возврате на вкладку — пингуем сразу
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') {
                    pingActivity('visible');
                } else {
                    // При уходе в фон / закрытии — стараемся отправить beacon
                    try {
                        const ok = navigator.sendBeacon && navigator.sendBeacon(`/stream/active/${streamId}`);
                        if (!ok) pingActivity('hidden_fallback');
                    } catch (_) {
                        pingActivity('hidden_exception');
                    }
                }
            });

            // При закрытии/перезагрузке
            window.addEventListener('pagehide', () => {
                try { navigator.sendBeacon && navigator.sendBeacon(`/stream/active/${streamId}`); } catch (_) {}
            });
        });
    </script>
        











<script>
    
    console.log("🎥 Подготовка для Dallyy.co стриминга...");


document.addEventListener('DOMContentLoaded', async () => {
    console.log("🎥 Инициализация системы стриминга...");

    // Камеру спрашиваем только у того, кто вещает с камеры.
    // Раньше разрешение запрашивалось у всех подряд, включая вещателей через OBS,
    // которым камера не нужна вообще: браузер показывал запрос доступа, а при
    // отказе выскакивал блокирующий alert. Для трансляций с пульта это лишний шаг
    // ровно там, где его быть не должно.
    if ('<%= stream.streamType %>' !== 'daily-stream') {
        console.log('Тип эфира не требует камеры — разрешение не запрашиваем');
        return;
    }

    try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
        console.log('✅ Доступ к камере/микрофону получен');
        // Поток нужен был только ради разрешения — сразу отпускаем устройство,
        // иначе индикатор камеры горит всё время, пока открыта страница.
        stream.getTracks().forEach(track => track.stop());
    } catch (err) {
        console.error('❌ Ошибка при запросе доступа к камере/микрофону:', err);
        if (err.name === 'NotAllowedError') {
            toast('Доступ к камере и микрофону не разрешён. Эфир с камеры не запустится — ' +
                         'разрешите доступ в настройках браузера или ведите эфир через OBS.');
        } else {
            toast('Не удалось получить доступ к камере и микрофону: ' + err.name, 'error');
        }
    }
});


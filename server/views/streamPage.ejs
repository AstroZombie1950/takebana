<%#
  Страница ведущего. Вёрстка на дизайн-системе: Tailwind, sweetalert, font-awesome,
  video-js и шрифты Inter/Urbanist сняты — первый не нужен, остальные не
  использовались ни строкой. PeerJS убран отдельно: на этой странице его не
  вызывали, а socket.io грузился дважды — из шапки локально и с CDN.
%>
<!DOCTYPE html>
<html lang="ru">
<head>
<%- include('partials/tkHead', { title: stream.title + ' — Takebana' }) %>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/stream.css">
</head>

<body class="tk-app"
      data-obs-only="<%= (typeof obsOnly !== 'undefined' && obsOnly) ? '1' : '0' %>"
      data-stream-id="<%= stream._id %>"
      data-stream-active="<%= stream.isActive ? '1' : '0' %>">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-live">

      <!-- Режим трансляции -->
      <section class="tk-live__modes">
        <div class="tk-live__modes-top">
          <span class="tk-kicker" lng="230">Режим трансляции</span>
          <span class="tk-live__id"><span lng="231">Стрим:</span> <code><%= stream._id %></code></span>
        </div>

        <% var obsFirst = (typeof obsOnly !== 'undefined' && obsOnly); %>
        <div class="tk-seg">
          <button type="button" class="tk-seg__btn web_stream<%= obsFirst ? '' : ' is-on' %>">
            <span lng="232">WEB (браузер)</span>
          </button>
          <button type="button" class="tk-seg__btn obs_stream<%= obsFirst ? ' is-on' : '' %>">
            <span lng="233">OBS</span>
          </button>
        </div>

        <p class="tk-live__warn">
          <b lng="234">Важно</b>
          <span lng="235">Не закрывайте эту страницу и не уходите с неё во время трансляции — иначе стрим может считаться неактивным и отключиться. Обновлять страницу можно.</span>
        </p>
      </section>

      <div class="tk-live__grid">

        <!-- Плеер и управление -->
        <section class="tk-live__col">
          <div class="tk-live__player video-player-area" id="playerContainer">
            <%# Daily отдаёт картинку в localVideo, OBS — в video через tk-hls.js.
                Оба скрыты до старта: показывает их скрипт страницы. %>
            <video id="localVideo" class="video-fit-cover" autoplay muted playsInline webkit-playsinline x5-playsinline x5-video-player-type="h5" style="display: none;"></video>
            <video id="video" class="video-fit-cover tk-live__video--obs" autoplay muted playsInline webkit-playsinline x5-playsinline x5-video-player-type="h5" style="display: none;"></video>

            <div class="tk-live__hint" id="obsPreviewHint" style="display: none;">
              <p class="tk-live__hint-title" lng="236">Предпросмотр OBS</p>
              <p lng="237">Запустите трансляцию в OBS — здесь появится видео.</p>
            </div>

            <div class="tk-live__hint" id="videoPlaceholder">
              <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M9 7.5l8 4.5-8 4.5V7.5Z"></path><rect x="3" y="4" width="18" height="16" rx="1"></rect></svg>
              <p><span lng="238">Нажмите</span> <b lng="239">«Начать стрим»</b> <span lng="240">для запуска</span></p>
            </div>

            <div class="tk-live__badges">
              <span class="tk-live__badge stream-paused-message<%= stream.isActive ? ' hidden' : '' %>" lng="126">Стрим на паузе или не начат</span>
              <span class="tk-live__badge tk-live__badge--live stream-active-message<%= stream.isActive ? '' : ' hidden' %>">
                <i class="stream-indicator"></i><span lng="127">В эфире</span>
              </span>
            </div>

            <button type="button" class="tk-live__fs" id="streamerFsButton" title="На весь экран" aria-label="На весь экран">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4.5 9V4.5H9M15 4.5h4.5V9M4.5 15v4.5H9M15 19.5h4.5V15"></path></svg>
            </button>
          </div>

          <!-- Информация об эфире -->
          <div class="tk-live__info stream-info">
            <h1 class="tk-live__title stream-title"><%= stream.title %></h1>

            <div class="tk-live__meta stream-meta">
              <div class="tk-live__author author-section">
                <a href="/userPage/<%= user._id %>" class="tk-live__avatar avatar"<% if (!user.avatarStyle.url) { %> data-avatar-gradient="<%= user.avatarStyle.gradient %>"<% } %>>
                  <% if (user.avatarStyle.url) { %>
                    <img src="<%= user.avatarStyle.url %>" alt="<%= user.displayName %>">
                  <% } else { %>
                    <%= user.avatarStyle.initial %>
                  <% } %>
                </a>
                <div class="author-info">
                  <a href="/userPage/<%= user._id %>" class="tk-live__author-name author-name"><%= user.displayName %></a>
                  <span class="tk-live__role streamer-badge">Ведущий</span>
                </div>
              </div>

              <div class="tk-live__stats stats-section">
                <span class="tk-live__stat live-indicator">
                  <i class="stream-indicator"></i>
                  <span class="live-text">Онлайн</span>
                  <span id="streamDuration" class="duration-text">00:00:00</span>
                </span>

                <span class="tk-live__stat viewer-count">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"></path><circle cx="12" cy="12" r="2.5"></circle></svg>
                  <span class="online__pepole-count">
                    <span class="viewers-number"><%= stream.viewers %></span>
                    <% const _v = Number(stream.viewers) || 0, _d10 = _v % 10, _d100 = _v % 100;
                       const _vw = (_d10 === 1 && _d100 !== 11) ? 'зритель'
                                 : (_d10 >= 2 && _d10 <= 4 && (_d100 < 12 || _d100 > 14)) ? 'зрителя' : 'зрителей'; %>
                    <span class="viewers-text"><%= _vw %></span>
                  </span>
                </span>
              </div>
            </div>

            <% if (stream.description) { %>
              <p class="tk-live__desc stream-description"><%= stream.description %></p>
            <% } %>
          </div>

          <!-- Управление -->
          <div class="tk-live__controls">
            <div class="web_tab<%= obsFirst ? ' hidden' : '' %>">
              <p class="tk-live__lead" lng="144">Выберите камеру и начните стрим из браузера, нажав «Начать стрим».</p>
              <select id="cameraSelect" class="tk-field tk-select"></select>

              <div class="tk-live__actions">
                <button type="button" class="tk-btn tk-btn--outline tk-btn--sm btn pause_stream<%= stream.isActive ? '' : ' hidden' %>" lng="120">Поставить на паузу</button>
                <button type="button" class="tk-btn tk-btn--primary tk-btn--sm btn start_stream<%= stream.isActive ? ' hidden' : '' %>" id="startStream" lng="119">Начать стрим</button>
              </div>
            </div>

            <div class="obs_tab<%= obsFirst ? '' : ' hidden' %>">
              <p class="tk-live__lead">
                <span lng="145">Скачайте и запустите OBS:</span>
                <a href="https://obsproject.com/ru/download" target="_blank" rel="noopener" lng="146">Скачать OBS Studio</a>
              </p>

              <ol class="tk-live__steps">
                <li lng="147">Настройте сцену: камера, рабочий стол, игра.</li>
                <li lng="148">Перейдите в настройки → трансляция.</li>
                <li>
                  <span lng="149">В поле «Сервер» вставьте:</span>
                  <code class="tk-live__key"><%= (start_server_env === 'local') ? 'rtmp://localhost:1935/live' : 'rtmp://takebana.com:1935/live' %></code>
                </li>
                <li>
                  <span lng="150">В поле «Ключ потока» вставьте свой ключ — никому его не показывайте:</span>
                  <code class="tk-live__key"><%= typeof obsStreamKey !== 'undefined' && obsStreamKey ? obsStreamKey : streamKey %></code>
                  <% if (typeof obsKeyExpiresAt !== 'undefined' && obsKeyExpiresAt) { %>
                    <span class="tk-live__note">Ключ действует до <%= obsKeyExpiresAt.toLocaleDateString('ru-RU') %>. После этой даты откройте страницу заново — здесь будет новый.</span>
                  <% } %>
                </li>
                <li lng="151">Нажмите «Применить» и начинайте трансляцию в программе.</li>
              </ol>
            </div>

            <div class="tk-live__danger">
              <button type="button" class="tk-btn tk-btn--outline tk-btn--sm tk-btn--block btn stop_stream" lng="229">Полностью завершить и удалить стрим</button>
            </div>
          </div>
        </section>

        <!-- Чат -->
        <%# chat-container — крючок выдвижной панели на узких экранах,
            chat__box и messeg-box — крючки чата. Имена оставлены прежними. %>
        <aside class="tk-live__chat chat-container chat__box">
          <div class="tk-live__chat-head">
            <h2 lng="135">Чат трансляции</h2>
            <button type="button" class="tk-live__chat-close close-chat-btn" aria-label="Закрыть чат">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
            </button>
          </div>

          <div class="wrapper__masseg">
            <div class="messeg-box"></div>

            <div class="input__messeng-box">
              <textarea class="tk-field input__messeng" rows="1" lng="218" placeholder="Сообщение..." maxlength="140"></textarea>
              <button type="button" class="tk-btn tk-btn--primary tk-btn--sm starting__buttone" lng="109">Отправить</button>
            </div>
            <p class="tk-live__limit" lng="247">Максимум 140 символов</p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</div>

<%# Ярлычок и подложка чата: ниже 1100px чат уезжает в выдвижную панель. %>
<button type="button" class="tk-live__chat-tab" id="chatTab" aria-label="Чат">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 12a8 8 0 01-11.5 7.2L4 21l1.8-5.5A8 8 0 1121 12Z"></path></svg>
  <span>Чат</span>
</button>
<div class="tk-live__chat-overlay" id="chatOverlay"></div>

<%# socket.io грузит шапка, локальной копией. Плеер HLS нужен только предпросмотру OBS. %>
<% if (typeof obsOnly !== 'undefined' && obsOnly) { %>
<script src="/tk-hls.js" defer></script>
<% } %>

    <script src="/lang.js"></script>

    <script>
        // Глобальные переменные
        const streamKey = "<%= streamKey %>";
        const serverEnv = '<%= start_server_env || "local" %>';

        console.log('=== STREAMER PAGE DEBUG ===');
        console.log('StreamKey from template:', streamKey);
        console.log('StreamKey type:', typeof streamKey);
        console.log('StreamKey length:', streamKey ? streamKey.length : 0);
        let currentStream;
        let lastMessageTime = null;
        let socket;

        // ОТЛАДКА: Проверяем что переменные определены правильно
        console.log('🔍 ОТЛАДКА переменных:');
        console.log('- streamKey:', streamKey);
        console.log('- serverEnv:', serverEnv);

        // Инициализация Socket.IO
        console.log('[Streamer] Initializing socket with serverEnv:', serverEnv);
        // Адрес берём из самой страницы, а не из зашитых строк.
        // Раньше здесь было две ветки: 'prod' → https://takebana.com и 'local' →
        // https://localhost:3000. Ветки для 'http' (наш режим локальной разработки)
        // не было вообще — socket оставался undefined, и первый же socket.on(...)
        // ронял весь скрипт страницы: ни чата, ни счётчика зрителей, ни реакции на
        // смену типа эфира. Плюс зашитый боевой домен ломал бы проверку сервера
        // по IP до переключения DNS.
        socket = io(window.location.origin, {
            transports: ['websocket'],
            reconnection: true,
            reconnectionDelay: 1000,
            reconnectionAttempts: 5
        });
        
        // Регистрируем обработчики ДО подключения
        console.log('[Streamer] Registering event handlers before connection...');
        
        // Функция для присоединения к комнате стрима
        const joinStreamRoom = () => {
            if (!streamKey || streamKey === 'undefined' || streamKey === 'null' || streamKey === '') {
                console.error('[Streamer] Cannot join: streamKey is invalid!', streamKey);
                return;
            }
            
            if (!socket.connected) {
                console.warn('[Streamer] Socket not connected, cannot join stream room');
                return;
            }
            
            console.log('[Streamer] Emitting join-stream-room, socket.connected:', socket.connected, 'socket.id:', socket.id);
            socket.emit('join-stream-room', streamKey, (response) => {
                console.log('[Streamer] join-stream-room callback response:', response);
                // Добираем пропущенное только после того, как вошли в комнату:
                // иначе сообщение, пришедшее между запросом и входом, потерялось бы.
                if (typeof fetchNewMessages === 'function') fetchNewMessages();
            });
            console.log('[Streamer] Sent join-stream-room event with key:', streamKey);
        };

        // Стример тоже присоединяется к комнате, чтобы видеть счетчик
        socket.on('connect', () => {
            console.log('[Streamer] Socket connected! Socket ID:', socket.id);
            console.log('[Streamer] Socket connected state:', socket.connected);
            console.log('[Streamer] Attempting to join stream room with key:', streamKey);
            
            // Небольшая задержка чтобы убедиться что socket полностью подключен
            setTimeout(() => {
                joinStreamRoom();
            }, 100);
        });
        
        socket.on('connect_error', (error) => {
            console.error('[Streamer] Socket connection error:', error);
        });
        
        socket.on('disconnect', (reason) => {
            console.log('[Streamer] Socket disconnected, reason:', reason);
        });
        
        socket.on('reconnect', (attemptNumber) => {
            console.log('[Streamer] Socket reconnected after', attemptNumber, 'attempts');
            // При переподключении снова присоединяемся к комнате
            if (streamKey && streamKey !== 'undefined' && streamKey !== 'null' && streamKey !== '') {
                setTimeout(() => {
                    joinStreamRoom();
                }, 100);
            }
        });
        
        // Если socket уже подключен (например, при переподключении), сразу присоединяемся
        if (socket.connected) {
            console.log('[Streamer] Socket already connected, joining immediately');
            setTimeout(() => {
                joinStreamRoom();
            }, 100);
        }



        // Регистрируем обработчик ДО подключения, чтобы не пропустить события
        console.log('[Streamer] Registering viewers-count-updated handler...');
        
        // Обновление счетчика зрителей
        socket.on('viewers-count-updated', (data) => {
            console.log('[Streamer] ===== VIEWERS COUNT UPDATED EVENT RECEIVED =====');
            console.log('[Streamer] Full data:', JSON.stringify(data, null, 2));
            console.log('[Streamer] Received viewers count:', data);
            console.log('[Streamer] Comparing streamKey - received:', data.streamKey, 'local:', streamKey, 'match:', data.streamKey === streamKey);
            if (data.streamKey === streamKey) {
                // Склонение слова «зритель». В шаблоне стояло жёсткое «зрителей»,
                // поэтому при одном зрителе выходило «1 зрителей».
                function viewersWord(n) {
                    n = Math.abs(Number(n) || 0);
                    const d10 = n % 10, d100 = n % 100;
                    if (d10 === 1 && d100 !== 11) return 'зритель';
                    if (d10 >= 2 && d10 <= 4 && (d100 < 12 || d100 > 14)) return 'зрителя';
                    return 'зрителей';
                }
                function setViewersCount(n) {
                    const num = document.querySelector('.viewers-number');
                    const word = document.querySelector('.viewers-text');
                    if (num) num.textContent = n;
                    if (word) word.textContent = viewersWord(n);
                }
                // Пробуем обновить через .viewers-number (вложенный span)
                const viewersNumber = document.querySelector('.viewers-number');
                const countElement = document.querySelector('.online__pepole-count');
                
                console.log('[Streamer] Count element found:', !!countElement);
                console.log('[Streamer] Viewers number element found:', !!viewersNumber);
                
                if (viewersNumber) {
                    // Обновляем число зрителей
                    const oldText = viewersNumber.textContent;
                    setViewersCount(data.count);
                    console.log('[Streamer] Updated viewers-number from', oldText, 'to', data.count);
                } else if (countElement) {
                    // Fallback: обновляем весь элемент
                    const oldText = countElement.textContent;
                    countElement.textContent = `${data.count} зрителей`;
                    console.log('[Streamer] Updated count element from', oldText, 'to', countElement.textContent);
                } else {
                    console.error('[Streamer] ERROR: Neither .viewers-number nor .online__pepole-count element found!');
                    // Попробуем найти через другой селектор
                    const allCountElements = document.querySelectorAll('[class*="pepole"], [class*="viewer"]');
                    console.log('[Streamer] Found potential count elements:', allCountElements.length);
                }
            } else {
                console.warn('[Streamer] StreamKey mismatch! Received:', data.streamKey, 'Expected:', streamKey);
            }
        });

        // OBS preview для стримера на OBS-странице
        document.addEventListener('DOMContentLoaded', function () {
            const OBS_ONLY = document.body?.dataset?.obsOnly === '1';
            if (!OBS_ONLY) return;

            const previewVideo = document.getElementById('video');
            const hint = document.getElementById('obsPreviewHint');
            const placeholder = document.getElementById('videoPlaceholder');

            if (placeholder) placeholder.style.display = 'none';
            if (hint) hint.style.display = 'flex';

            if (!previewVideo) return;

            // Предпросмотр — тот же HLS, что видят зрители, через tk-hls.js.
            // Раньше здесь был HTTP-FLV через flv.js: ради него жили HTTP-сервер
            // медиасервера на :8000 и прокси к нему. Задержка HLS в несколько
            // секунд предпросмотру не мешает — ведущий видит ровно то, что зритель.
            // Плеер ждёт плейлист, пока OBS не начал вещать, и снова ждёт после обрыва.
            previewVideo.style.display = 'none';
            previewVideo.addEventListener('playing', () => {
                if (hint) hint.style.display = 'none';
                previewVideo.style.display = 'block';
            });
            TKHls.play(previewVideo, `/live/${streamKey}/index.m3u8`);
        });

        // Переключение между типами стрима
        document.addEventListener('DOMContentLoaded', function() {
            const OBS_ONLY = document.body?.dataset?.obsOnly === '1';
            const STREAM_ID = document.body?.dataset?.streamId;
            const choiceWebBtn = document.querySelector('.web_stream');
            const choiceObsBtn = document.querySelector('.obs_stream');
            const choiceWebTab = document.querySelector('.web_tab');
            const choiceObsTab = document.querySelector('.obs_tab');

            // Применяем градиенты аватаров из data-атрибутов
            try {
                document.querySelectorAll('[data-avatar-gradient]').forEach((el) => {
                    const g = el.getAttribute('data-avatar-gradient');
                    if (g) el.style.background = g;
                });
            } catch (e) {}

            if (choiceWebBtn && choiceObsBtn) {
                choiceWebBtn.addEventListener('click', function() {
                    // Если это OBS-страница — кнопка WEB переводит на WEB-страницу
                    if (OBS_ONLY) {
                        window.location.href = `/stream/${STREAM_ID}`;
                        return;
                    }
                    // Отметка на переключателе и показ нужной панели. Прежде здесь
                    // перебирались восемь классов Tailwind в обе стороны; теперь
                    // состояние — один класс, а вид его описан в stream.css.
                    choiceWebBtn.classList.add('is-on');
                    choiceObsBtn.classList.remove('is-on');
                    choiceWebTab.classList.remove('hidden');
                    choiceObsTab.classList.add('hidden');
                });

                choiceObsBtn.addEventListener('click', function() {
                    // Если это WEB-страница — кнопка OBS ведёт на отдельную OBS-страницу
                    if (!OBS_ONLY) {
                        window.location.href = `/stream-obs/${STREAM_ID}`;
                        return;
                    }
                    choiceObsBtn.classList.add('is-on');
                    choiceWebBtn.classList.remove('is-on');
                    choiceObsTab.classList.remove('hidden');
                    choiceWebTab.classList.add('hidden');
                });
            }
        });




    </script>

    <script>
        // JavaScript код для управления модальными окнами и поведением на странице

        let profile = document.querySelector(".profile__box")
        let Avatar = document.querySelector(".AVATAR")
        let buttonExit = document.querySelector(".button__exit")
        let shodow = document.querySelector(".shodow")
        let chatMessegProfil = document.querySelectorAll(".chat__profile")
        let chatListBox = document.querySelector(".chat__list-box")
        let chatMesseg = document.querySelector(".chat__messeg")
        let buttonBackChat = document.querySelector(".button__back")
        let serhButton = document.querySelector(".serh-button")
        let serhWrapper = document.querySelector(".serh__wrapper")
        let inputSerh = document.querySelector(".input__serh")
        let buttonLine = document.querySelector(".button__line")
        let categoriesBox = document.querySelector(".categories__box")
        let titleCategories = document.querySelectorAll(".title__categories")
        let titleBox = document.querySelector(".title__box")
        let profilName = document.querySelectorAll(".profil__name")
        let priwMore = document.querySelector(".priw__more")



        if (Avatar) {
            Avatar.addEventListener("click", () => {
                if (profile) profile.classList.add("display-block")
                if (notification) notification.classList.remove("display-block")
                if (shodow) shodow.classList.add("display-block")
            });
        }

        if (buttonExit) {
            buttonExit.addEventListener("click", () => {
                if (profile) profile.classList.remove("display-block")
                if (shodow) shodow.classList.remove("display-block")
            });
        }

        if (shodow) {
            shodow.addEventListener("click", () => {
                if (notification) notification.classList.remove("display-block")
                if (profile) profile.classList.remove("display-block")
                if (shodow) shodow.classList.remove("display-block")
                if (categoriesBox) categoriesBox.style = null;
                if (titleBox) titleBox.style = null;
                if (titleCategories) {
                    titleCategories.forEach((el) => {
                        el.style = null;
                    });
                }
                if (profilName) {
                    profilName.forEach((el) => {
                        el.style = null;
                    });
                }
                if (priwMore) priwMore.style = null;
            });
        }


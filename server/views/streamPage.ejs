<%#
  Эфир глазами ведущего — две фазы одного шаблона.

  Студия (/studio, и черновик веб-эфира на /stream/:id): настройки эфира,
  источник — браузер или OBS, камера с предпросмотром, «Выйти в эфир».
  Раньше настройки были окном в шапке, а источник и камера — на отдельной
  странице пульта. Поведение — /tk-studio.js.

  Пульт (/stream/:id): картинка, кнопки эфира, чат — и больше ничего:
  настройки после выхода в эфир не нужны. Поведение — /tk-console.js.
  Общее со зрителем — метки, шапка эфира, чат, полный экран — в partials
  и /tk-stream.js.
%>
<%
  var s = stream;
  var source = s ? (s.streamType === 'obs-stream' ? 'obs' : 'web') : (defaults.source || 'web');
  // Веб-черновик — ещё студия; после «Выйти в эфир» страница приходит с ?go=1
  // и сразу пультом, который подключается сам.
  var phase = s && (s.firstLiveAt || s.isActive || source === 'obs' || autostart) ? 'console' : 'setup';
  var state = s && s.isActive ? 'live' : source === 'obs' ? 'wait' : 'paused';
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<% if (phase === 'setup') { %>
<%- include('partials/tkHead', { titleKey: 'page.studio.title' }) %>
<% } else { %>
<%- include('partials/tkHead', { title: s.title + ' — Takebana' }) %>
<% } %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/stream.css') %>">
</head>

<body class="tk-app<%= phase === 'console' ? ' tk-app--stage' : '' %>"
      data-phase="<%= phase %>"
      data-source="<%= source %>"
      <% if (s) { %>
      data-stream-id="<%= s._id %>"
      data-stream-key="<%= s.streamKey %>"
      data-started-at="<%= s.isActive && s.startedAt ? new Date(s.startedAt).toISOString() : '' %>"
      data-first-live="<%= s.firstLiveAt ? '1' : '' %>"
      data-autostart="<%= autostart ? '1' : '' %>"
      <% } %>
      data-recording="<%= recordingEnabled ? '1' : '' %>"
      data-user-id="<%= currentUser._id %>">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
  <%# ── Подключение OBS: в студии и в пульте OBS-эфира ── %>
  <% var obsSteps = function () { %>
    <ol class="tk-live__steps">
      <li><span data-i18n="stream.obs.step1"><%- t('stream.obs.step1') %></span> <a href="https://obsproject.com/download" target="_blank" rel="noopener" data-i18n="stream.obs.download"><%- t('stream.obs.download') %></a></li>
      <li data-i18n="stream.obs.step3"><%- t('stream.obs.step3') %></li>
      <li>
        <span data-i18n="stream.obs.step4"><%- t('stream.obs.step4') %></span>
        <code class="tk-live__key"><%= rtmpUrl %></code>
      </li>
      <li>
        <span data-i18n="stream.obs.step5"><%- t('stream.obs.step5') %></span>
        <code class="tk-live__key"><%= obsStreamKey %></code>
        <% if (obsKeyExpiresAt) { %>
          <span class="tk-live__note"><span data-i18n="stream.keyValidUntil"><%- t('stream.keyValidUntil') %></span> <%= date(obsKeyExpiresAt, { day: '2-digit', month: '2-digit', year: 'numeric' }) %><span data-i18n="stream.keyRenew"><%- t('stream.keyRenew') %></span></span>
        <% } %>
        <% if (!(stream && stream.firstLiveAt)) { %>
          <button type="button" class="tk-btn tk-btn--outline tk-btn--xs tk-live__rotate" data-rotate-key data-i18n="stream.keyRotate"><%- t('stream.keyRotate') %></button>
        <% } %>
      </li>
    </ol>
  <% }; %>

  <% if (phase === 'setup') { %>
    <div class="tk-studio">
      <section class="tk-studio__screen">
        <div class="tk-live__player" data-for="web"<% if (source !== 'web') { %> hidden<% } %>>
          <video id="previewVideo" class="video-fit-cover" autoplay muted playsinline hidden></video>
          <div class="tk-live__hint" id="previewHint">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 10l4.55-2.28A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.9L15 14"></path><rect x="3" y="6" width="12" height="12"></rect></svg>
            <p data-i18n="studio.preview"><%- t('studio.preview') %></p>
          </div>
        </div>

        <div class="tk-studio__panel" data-for="web"<% if (source !== 'web') { %> hidden<% } %>>
          <label class="tk-form__label" for="cameraSelect" data-i18n="studio.camera"><%- t('studio.camera') %></label>
          <select id="cameraSelect" class="tk-field tk-select"></select>
          <p class="tk-form__note" data-i18n="studio.webNote"><%- t('studio.webNote') %></p>
        </div>

        <div class="tk-studio__panel tk-studio__panel--obs" data-for="obs"<% if (source !== 'obs') { %> hidden<% } %>>
          <% obsSteps(); %>
          <p class="tk-form__note" data-i18n="studio.obsNote"><%- t('studio.obsNote') %></p>
        </div>
      </section>

      <form class="tk-studio__form tk-form" id="studioForm" novalidate>
        <h1 class="tk-page__h1" data-i18n="studio.h1"><%- t('studio.h1') %></h1>

        <fieldset class="tk-seg">
          <legend class="tk-form__label" data-i18n="studio.source"><%- t('studio.source') %></legend>
          <label class="tk-seg__btn"><input type="radio" name="source" value="web"<%= source === 'web' ? ' checked' : '' %>><span data-i18n="studio.sourceWeb"><%- t('studio.sourceWeb') %></span></label>
          <label class="tk-seg__btn"><input type="radio" name="source" value="obs"<%= source === 'obs' ? ' checked' : '' %>><span>OBS</span></label>
        </fieldset>

        <div class="tk-form__row">
          <label class="tk-form__label" for="streamTitle" data-i18n="studio.name"><%- t('studio.name') %></label>
          <input class="tk-field" type="text" id="streamTitle" name="title" maxlength="200" value="<%= defaults.title || '' %>" placeholder="<%= ta('studio.namePh') %>" data-i18n-placeholder="studio.namePh">
        </div>

        <div class="tk-studio__pair">
          <div class="tk-form__row">
            <label class="tk-form__label" for="streamCategory" data-i18n="studio.category"><%- t('studio.category') %></label>
            <select id="streamCategory" name="category" class="tk-field tk-select">
              <option value="" data-i18n="studio.categoryPh"><%- t('studio.categoryPh') %></option>
              <% Object.entries(catalog.CATEGORIES).forEach(function ([code, cat]) { %>
              <option value="<%= code %>" data-i18n="<%= cat.i18n %>"<%= defaults.category === code ? ' selected' : '' %>><%= ta(cat.i18n, cat.name) %></option>
              <% }); %>
            </select>
          </div>

          <%# Подкатегории — из config/catalog.js, как и теги каталога. %>
          <div class="tk-form__row">
            <label class="tk-form__label" for="streamSubcategory" data-i18n="studio.subcategory"><%- t('studio.subcategory') %></label>
            <select id="streamSubcategory" name="subcategory" class="tk-field tk-select" data-subs="<%= catalog.SUBS_JSON %>" data-value="<%= defaults.subcategory || '' %>" disabled>
              <option value="" data-i18n="studio.subcategoryPh"><%- t('studio.subcategoryPh') %></option>
            </select>
          </div>
        </div>

        <div class="tk-form__row">
          <label class="tk-form__label" for="streamCity"><span data-i18n="studio.city"><%- t('studio.city') %></span> <span class="tk-form__hint" data-i18n="common.optional"><%- t('common.optional') %></span></label>
          <select id="streamCity" name="city" class="tk-field tk-select">
            <option value="" data-i18n="common.notSet"><%- t('common.notSet') %></option>
            <% catalog.CITIES.forEach(function (city) { %>
            <option value="<%= city.code %>" data-i18n="<%= city.i18n %>"<%= defaults.city === city.code ? ' selected' : '' %>><%= ta(city.i18n, city.name) %></option>
            <% }); %>
          </select>
        </div>

        <div class="tk-form__row">
          <label class="tk-form__label" for="streamDescription"><span data-i18n="studio.description"><%- t('studio.description') %></span> <span class="tk-form__hint" data-i18n="common.optional"><%- t('common.optional') %></span></label>
          <textarea id="streamDescription" name="description" class="tk-field" rows="3" maxlength="5000" placeholder="<%= ta('studio.descriptionPh') %>" data-i18n-placeholder="studio.descriptionPh"><%= defaults.description || '' %></textarea>
        </div>

        <%# Обложка (21.09): картинка эфира в поиске и на витрине, она же —
            обложка записи. Без неё там кадр из эфира. Файл уходит после
            /start-stream (tk-studio.js). %>
        <% var coverUrl = defaults.thumbnail || ''; %>
        <div class="tk-form__row">
          <span class="tk-form__label"><span data-i18n="studio.cover"><%- t('studio.cover') %></span> <span class="tk-form__hint" data-i18n="common.optional"><%- t('common.optional') %></span></span>
          <div class="tk-studio__cover">
            <div class="tk-studio__coverbox">
              <img id="coverImg" alt=""<% if (coverUrl) { %> src="<%= coverUrl %>"<% } else { %> hidden<% } %>>
              <span class="tk-studio__coverph" id="coverPh"<% if (coverUrl) { %> hidden<% } %> data-i18n="studio.coverNone"><%- t('studio.coverNone') %></span>
            </div>
            <div class="tk-studio__coverctl">
              <input type="file" id="coverInput" accept="image/png,image/jpeg,image/webp" hidden>
              <input type="hidden" name="cover" value="keep">
              <button type="button" class="tk-btn tk-btn--outline tk-btn--xs" id="coverPick" data-i18n="upload.coverPick"><%- t('upload.coverPick') %></button>
              <button type="button" class="tk-btn tk-btn--quiet tk-btn--xs" id="coverClear"<% if (!coverUrl) { %> hidden<% } %> data-i18n="studio.coverClear"><%- t('studio.coverClear') %></button>
              <p class="tk-form__note" data-i18n="studio.coverNote"><%- t('studio.coverNote') %></p>
            </div>
          </div>
        </div>

        <div class="tk-form__row">
          <label class="tk-form__toggle">
            <input type="checkbox" name="isAdult"<%= defaults.isAdult ? ' checked' : '' %>>
            <span data-i18n="studio.adult"><%- t('studio.adult') %></span>
          </label>
          <p class="tk-form__note" data-i18n="studio.adultNote"><%- t('studio.adultNote') %></p>
        </div>

        <button type="submit" class="tk-btn tk-btn--primary tk-studio__go" id="studioGo" data-i18n="<%= source === 'obs' ? 'studio.goObs' : 'studio.go' %>"><%- t(source === 'obs' ? 'studio.goObs' : 'studio.go') %></button>
      </form>
    </div>

    <script defer src="<%= asset('/tk-studio.js') %>"></script>

  <% } else { %>
    <div class="tk-live">
      <div class="tk-live__grid" id="stage">
        <section class="tk-live__col">
          <div class="tk-live__player" id="player">
            <% if (source === 'obs') { %>
              <%# Предпросмотр — тот же HLS, что у зрителя; видео — с первым кадром. %>
              <video id="video" class="video-fit-contain" autoplay muted playsinline hidden></video>
            <% } else { %>
              <video id="localVideo" class="video-fit-contain" autoplay muted playsinline hidden></video>
            <% } %>
            <div class="tk-live__hint" id="playerHint">
              <% var hintKey = source === 'obs' ? 'stream.obsWaitHint' : autostart ? 'studio.connecting' : 'stream.pausedHint'; %>
              <p data-i18n="<%= hintKey %>"><%- t(hintKey) %></p>
            </div>

            <%- include('partials/streamBadges', { state: state }) %>

            <button type="button" class="tk-live__fs" data-fullscreen aria-pressed="false" aria-label="<%= ta('stream.fullscreen') %>" data-i18n-aria="stream.fullscreen" title="<%= ta('stream.fullscreen') %>" data-i18n-title="stream.fullscreen">
              <svg class="tk-live__fs-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4.5 9V4.5H9M15 4.5h4.5V9M4.5 15v4.5H9M15 19.5h4.5V15"></path></svg>
              <svg class="tk-live__fs-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M9 4.5V9H4.5M19.5 9H15V4.5M9 19.5V15H4.5M15 19.5V15h4.5"></path></svg>
            </button>
            <%# Чат поверх картинки во весь экран на телефоне — по кнопке (stream.css). %>
            <button type="button" class="tk-live__fs tk-live__chatbtn" data-chat-toggle aria-pressed="false" aria-label="<%= ta('stream.chatShow') %>" data-i18n-aria="stream.chatShow" title="<%= ta('stream.chatShow') %>" data-i18n-title="stream.chatShow">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M21 11a8 8 0 01-11.5 7.2L4 20l1.8-5.5A8 8 0 1121 11Z"></path></svg>
            </button>
          </div>

          <%# Кнопки эфира. Веб: микрофон, камера, пауза или «продолжить»,
              завершить. OBS: подключение и завершить — паузу ставят в программе. %>
          <div class="tk-live__bar" id="hostBar">
            <% if (source === 'web') { %>
              <button type="button" class="tk-live__tool" id="micBtn" aria-pressed="false" aria-label="<%= ta('stream.micOff') %>" data-i18n-aria="stream.micOff" title="<%= ta('stream.micOff') %>" data-i18n-title="stream.micOff" disabled>
                <svg class="tk-live__mic-on" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0014 0M12 18v3"></path></svg>
                <svg class="tk-live__mic-off" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M15 9.5V6a3 3 0 00-6 0v5a3 3 0 004.6 2.5M5 11a7 7 0 0011.3 5.5M19 11a7 7 0 01-.5 2.5M12 18v3M4 4l16 16"></path></svg>
              </button>
              <button type="button" class="tk-live__tool" id="cameraBtn" aria-label="<%= ta('stream.switchCamera') %>" data-i18n-aria="stream.switchCamera" title="<%= ta('stream.switchCamera') %>" data-i18n-title="stream.switchCamera" hidden>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M4 7h3l2-3h6l2 3h3v13H4V7Z"></path><path d="M9 13a3 3 0 015-2.2M15 13a3 3 0 01-5 2.2M14 9v2h-2M10 17v-2h2"></path></svg>
              </button>
              <select id="cameraSelect" hidden></select>
              <button type="button" class="tk-btn tk-btn--outline tk-btn--sm" id="pauseBtn"<% if (!s.isActive) { %> hidden<% } %> data-i18n="stream.pause"><%- t('stream.pause') %></button>
              <% var goKey = s.firstLiveAt ? 'stream.resume' : 'studio.go'; %>
              <button type="button" class="tk-btn tk-btn--primary tk-btn--sm" id="startBtn"<% if (s.isActive) { %> hidden<% } %> data-i18n="<%= goKey %>"><%- t(goKey) %></button>
            <% } else { %>
              <button type="button" class="tk-btn tk-btn--outline tk-btn--sm" id="obsToggle" aria-expanded="<%= s.firstLiveAt ? 'false' : 'true' %>" aria-controls="obsPanel" data-i18n="stream.obsKey"><%- t('stream.obsKey') %></button>
            <% } %>
            <button type="button" class="tk-btn tk-btn--danger tk-btn--sm tk-live__end" id="endBtn" data-i18n="stream.end"><%- t('stream.end') %></button>
          </div>

          <% if (source === 'obs') { %>
          <div class="tk-live__obs" id="obsPanel"<% if (s.firstLiveAt) { %> hidden<% } %>>
            <% obsSteps(); %>
          </div>
          <% } %>

          <%- include('partials/streamInfo', { stream: s, user: user, isStreamer: true }) %>
        </section>

        <%- include('partials/streamChat', { host: true }) %>
      </div>
    </div>

    <%# socket.io и tk-daily.js грузит шапка. Плеер HLS нужен только предпросмотру OBS. %>
    <% if (source === 'obs') { %><script defer src="<%= asset('/tk-hls.js') %>"></script><% } %>
    <script defer src="<%= asset('/tk-stream.js') %>"></script>
    <script defer src="<%= asset('/tk-console.js') %>"></script>
  <% } %>
  </main>
</div>

</body>
</html>

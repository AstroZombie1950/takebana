        // ========== УПРАВЛЕНИЕ АДАПТИВНЫМ ЧАТОМ ==========
        document.addEventListener('DOMContentLoaded', function () {
            // Управление адаптивным чатом
            const chatTab = document.getElementById('chatTab');
            const chatContainer = document.querySelector('.chat-container');
            const chatOverlay = document.getElementById('chatOverlay');
            const closeChatBtn = document.querySelector('.close-chat-btn');

            function openChat() {
                if (chatContainer && chatOverlay) {
                    chatOverlay.style.display = 'block';
                    chatContainer.classList.add('open');
                    document.body.style.overflow = 'hidden';
                }
            }

            function closeChat() {
                if (chatContainer && chatOverlay) {
                    chatContainer.classList.remove('open');
                    chatOverlay.style.display = 'none';
                    document.body.style.overflow = '';
                }
            }

            if (chatTab) {
                chatTab.addEventListener('click', openChat);
            }

            if (closeChatBtn) {
                closeChatBtn.addEventListener('click', closeChat);
            }

            if (chatOverlay) {
                chatOverlay.addEventListener('click', closeChat);
            }

            // Закрытие чата по Escape
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && window.innerWidth < 1280) {
                    closeChat();
                }
            });
                 });

        // ========== ТАЙМЕР ВРЕМЕНИ СУЩЕСТВОВАНИЯ СТРИМА ==========
        // Функция для форматирования времени
        function formatDuration(seconds) {
            const hours = String(Math.floor(seconds / 3600)).padStart(2, '0');
            const minutes = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
            const secs = String(seconds % 60).padStart(2, '0');
            return `${hours}:${minutes}:${secs}`;
        }

        // Глобальная переменная для хранения интервала таймера
        let streamExistenceTimer = null;

        // Функция для запуска таймера времени существования
        function startStreamExistenceTimer(createdTimeISO) {
            console.log('⏱️ Запускаем таймер времени существования стрима с:', createdTimeISO);
            const durationElement = document.getElementById('streamDuration');
            
            if (!durationElement) {
                console.warn('⚠️ Элемент streamDuration не найден');
                return;
            }

            // Останавливаем предыдущий таймер если он был
            if (streamExistenceTimer) {
                clearInterval(streamExistenceTimer);
            }

            const createdTime = new Date(createdTimeISO).getTime();
            
            function updateDuration() {
                const now = new Date().getTime();
                let diffSeconds = Math.floor((now - createdTime) / 1000);
                
                if (diffSeconds < 0) diffSeconds = 0;
                
                durationElement.textContent = formatDuration(diffSeconds);
            }
            
            // Первоначальный вызов и запуск интервала
            updateDuration();
            streamExistenceTimer = setInterval(updateDuration, 1000);
            console.log('✅ Таймер времени существования стрима запущен');
        }

        // Функция для остановки таймера (не используется для времени существования)
        function stopStreamExistenceTimer() {
            console.log('⏹️ Останавливаем таймер времени существования стрима');
            const durationElement = document.getElementById('streamDuration');
            
            if (streamExistenceTimer) {
                clearInterval(streamExistenceTimer);
                streamExistenceTimer = null;
            }
            
            if (durationElement) {
                durationElement.textContent = '00:00:00';
            }
            console.log('✅ Таймер времени существования стрима остановлен');
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Инициализация при загрузке страницы - показываем время существования стрима
            console.log('🕐 Запускаем таймер времени существования стрима');
            startStreamExistenceTimer('<%= stream.createdAt.toISOString() %>');
        });

        // ========== DAILY.CO STREAMER CLASS ==========
        console.log('🚀 Скрипт Daily.co загружается...');
        console.log('window.DailyIframe:', typeof window.DailyIframe !== 'undefined' ? 'ДОСТУПЕН' : 'НЕ ЗАГРУЖЕН!');
        
        class DailyStreamer {
                constructor() {
                console.log('🏗️ DailyStreamer конструктор вызван');
                console.log('🔍 window.DailyIframe доступен:', typeof window.DailyIframe !== 'undefined');
                this.callObject = null;
                this.roomData = null;
                this.authToken = null;
                this.isConnected = false;
                this.init();
                console.log('✅ DailyStreamer инициализирован');
            }

    init() {
        console.log('🔧 DailyStreamer.init() вызван');
        this.initElements();
        this.bindEvents();
        console.log('✅ DailyStreamer.init() завершен');
    }

                initElements() {

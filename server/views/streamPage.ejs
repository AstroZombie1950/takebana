            console.log('✅ onclick привязан к кнопке остановки');
        } else {
            console.error('❌ Кнопка остановки не найдена! Не могу привязать обработчик');
        }
        

    }

    async startStream() {
        try {
            this.log('Начинаем стрим...');
            this.updateStatus('Создание комнаты...');
            this.startStreamBtn.disabled = true;
            this.startStreamBtn.textContent = 'Создание комнаты...';
            
            // 1. Создаем комнату
            const response = await fetch('/api/create-room', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    streamId: this.streamId
                })
            });
            
            if (!response.ok) {
                throw new Error('Failed to create room');
            }
            
            const data = await response.json();
            
            if (!data.success) {
                throw new Error(data.message || 'Room creation failed');
            }
            
            this.roomData = data.room;
            this.log('Комната создана: ' + this.roomData.name);
            
            // 2. Получаем токен для стримера
            this.updateStatus('Получение токена...');
            this.startStreamBtn.textContent = 'Получение токена...';
            
            const tokenResponse = await fetch('/api/get-token', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    roomName: this.roomData.name,
                    role: 'streamer'
                })
            });
            
            if (!tokenResponse.ok) {
                throw new Error('Failed to get token');
            }
            
            const tokenData = await tokenResponse.json();
            
            if (!tokenData.success) {
                throw new Error(tokenData.message || 'Token generation failed');
            }
            
            this.authToken = tokenData.token;
            this.log('Токен получен, подключаемся к комнате...');
            
            // 3. Подключаемся к комнате и запускаем камеру
            this.updateStatus('Подключение к комнате...');
            this.startStreamBtn.textContent = 'Подключение...';
            
            // Проверяем поддержку getUserMedia (исправлено для Safari и Android)
            if (!navigator.mediaDevices) {
                navigator.mediaDevices = {};
            }
            
            if (!navigator.mediaDevices.getUserMedia) {
                navigator.mediaDevices.getUserMedia = function(constraints) {
                    const getUserMedia = navigator.webkitGetUserMedia || navigator.mozGetUserMedia;
                    if (!getUserMedia) {
                        throw new Error('getUserMedia не поддерживается в этом браузере. Требуется HTTPS для Safari на iOS.');
                    }
                    return new Promise(function(resolve, reject) {
                        getUserMedia.call(navigator, constraints, resolve, reject);
                    });
                }
            }
            
            // ИСПРАВЛЕНИЕ: Добавляем fallback для enumerateDevices (Safari iOS)
            if (!navigator.mediaDevices.enumerateDevices) {
                navigator.mediaDevices.enumerateDevices = function() {
                    console.log('⚠️ enumerateDevices не поддерживается в Safari iOS, используем fallback');
                    return Promise.resolve([]);
                }
            }
            
            // Проверяем HTTPS для Safari и мобильных устройств
            if (location.protocol !== 'https:' && location.hostname !== 'localhost') {
                this.log('⚠️ Внимание: getUserMedia может не работать без HTTPS на Safari и мобильных устройствах');
                this.updateStatus('⚠️ Требуется HTTPS для камеры на мобильных устройствах');
            }
            
            // Определяем мобильное устройство для специальной обработки
            const isMobile = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            const isAndroid = /Android/i.test(navigator.userAgent);
            
            if (isMobile) {
                this.log('📱 Обнаружено мобильное устройство, применяем специальные настройки');
            }
            
            // Получаем камеру и микрофон
            this.log('📹 Запрашиваем доступ к камере и микрофону...');
            this.updateStatus('Запрос доступа к камере...');
            
            // Настройки для мобильных устройств
            const mediaConstraints = {
                video: {
                    width: isMobile ? { ideal: 640, max: 1280 } : { ideal: 1280, max: 1920 },
                    height: isMobile ? { ideal: 480, max: 720 } : { ideal: 720, max: 1080 },
                    frameRate: isMobile ? { ideal: 30, max: 30 } : { ideal: 30, max: 60 },
                    facingMode: isAndroid ? { ideal: 'user' } : undefined // Предпочитаем фронтальную камеру на Android
                },
                audio: true
            };
            // Применяем выбранную камеру из селектора (и запомним её для повторного применения)
            try {
                const selectedVal = document.getElementById('cameraSelect')?.value;
                if (selectedVal) {
                    if (selectedVal.startsWith('device:')) {
                        const id = selectedVal.slice('device:'.length);
                        if (id) mediaConstraints.video.deviceId = { exact: id };
                    } else if (selectedVal.startsWith('facing:')) {
                        const mode = selectedVal.split(':')[1];
                        if (mode) mediaConstraints.video.facingMode = { ideal: mode };
                    }
                    window._preferredCameraValue = selectedVal;
                }
            } catch(_) {}
            
            const localStream = await navigator.mediaDevices.getUserMedia(mediaConstraints);
            this.log('✅ Доступ к камере и микрофону получен');
            
            // Специальная обработка для Android - проверяем треки
            if (isAndroid) {
                const videoTracks = localStream.getVideoTracks();
                const audioTracks = localStream.getAudioTracks();
                
                this.log(`📱 Android: Видео треков: ${videoTracks.length}, Аудио треков: ${audioTracks.length}`);
                
                // Проверяем состояние треков
                videoTracks.forEach((track, index) => {
                    this.log(`📱 Android: Видео трек ${index}: ${track.readyState}, enabled: ${track.enabled}`);
                    if (track.readyState === 'ended') {
                        this.log(`⚠️ Android: Видео трек ${index} завершён, возможна проблема`);
                    }
                });
                
                audioTracks.forEach((track, index) => {
                    this.log(`📱 Android: Аудио трек ${index}: ${track.readyState}, enabled: ${track.enabled}`);
                    if (track.readyState === 'ended') {
                        this.log(`⚠️ Android: Аудио трек ${index} завершён, возможна проблема`);
                    }
                });
            }
            
            // Создаем call object
            this.callObject = window.DailyIframe.createCallObject();
            
            // Настраиваем обработчики событий
            this.setupEventListeners();
            
            // Подключаемся к комнате БЕЗ медиа сначала
            this.log('Подключение к комнате: ' + this.roomData.name);
            // Важно: используем URL, который возвращает Daily API при создании комнаты.
            // Это предотвращает поломку при ребрендинге домена (например, webcatravel -> takebana),
            // если Daily subdomain ещё не сменён.
            const joinUrl = (this.roomData && (this.roomData.url || this.roomData.roomUrl)) 
                ? (this.roomData.url || this.roomData.roomUrl)
                : `https://webcatravel.daily.co/${this.roomData.name}`;

            await this.callObject.join({
                url: joinUrl,
                token: this.authToken
            });
            
            this.log('Подключились к комнате');
            
            // Включаем камеру и микрофон ПОСЛЕ подключения к комнате
            this.updateStatus('Включение камеры...');
            this.startStreamBtn.textContent = 'Включение камеры...';
            
            try {
                // Небольшая пауза для iOS, чтобы объект комнаты стабилизировался
                await new Promise(r => setTimeout(r, 500));
                
                this.log('Включаем локальный звук...');
                await this.callObject.setLocalAudio(true);
                this.log('Локальный звук включен');
                
                // На iOS иногда требуется отдельная пауза перед включением видео
                await new Promise(r => setTimeout(r, 200));
                // Применим выбранную камеру перед включением видео
                try {
                    const sel = document.getElementById('cameraSelect');
                    const pref = (sel && sel.value) || window._preferredCameraValue || '';
                    if (pref && pref.startsWith('device:')) {
                        const id = pref.slice('device:'.length);
                        if (id) { await this.callObject.setInputDevicesAsync({ videoDeviceId: id }); }
                    } else if (pref && pref.startsWith('facing:')) {
                        const mode = pref.split(':')[1];
                        if (mode) { await this.callObject.startCamera({ facingMode: mode }); }
                    }
                } catch(_) {}
                this.log('Включаем локальное видео...');
                await this.callObject.setLocalVideo(true);
                this.log('Локальное видео включено');
                
                // Показываем контроль громкости сразу после включения аудио
                if (this.streamerVolumeControl) {
                    this.streamerVolumeControl.style.display = 'block';
                    this.log('Контроль громкости показан');
                }
                
                // ПРИНУДИТЕЛЬНО показываем видео для iOS Safari
                setTimeout(() => {
                    this.log('Принудительное отображение видео...');
                    const localVideo = document.getElementById('localVideo');
                    if (localVideo) {
                        try {
                            const participants = this.callObject.participants();
                            const localParticipant = participants.local;
                            if (localParticipant && localParticipant.video) {
                                this.log('Видео трек найден через participants, отображаем...');
                                localVideo.style.display = 'block';
                                localVideo.srcObject = new MediaStream([localParticipant.video]);
                                this.videoPlaceholder.style.display = 'none';
                            }
                        } catch (error) {
                            this.log('Ошибка получения видео трека: ' + error.message);
                        }
                    }
                }, 800);
                
            } catch (mediaError) {
                this.log('Ошибка включения медиа: ' + mediaError.message);
                // Повторная попытка включения видео на iOS
                try {
                    await new Promise(r => setTimeout(r, 800));
                    this.log('Повтор: включаем локальное видео...');
                    await this.callObject.setLocalVideo(true);
                    this.log('Локальное видео включено со второй попытки');
                } catch (retryErr) {
                    this.log('Повтор включения видео не удался: ' + retryErr.message);
                }
            }
            
            // 4. Активируем стрим в базе данных
            this.updateStatus('Активация стрима...');
            this.startStreamBtn.textContent = 'Активация...';
            await activateStream();
            
            this.isConnected = true;
            this.startStreamBtn.disabled = true;
            this.startStreamBtn.textContent = 'Начать стрим';
            this.startStreamBtn.classList.add('hidden');
            this.stopStreamBtn.classList.remove('hidden');
            this.stopStreamBtn.disabled = false;
            this.updateStreamStatus(true);
            this.videoPlaceholder.style.display = 'none';
            
            this.log('Стрим успешно запущен!');
            
        } catch (error) {
            this.log('Ошибка запуска стрима: ' + error.message);
            this.updateStatus('Ошибка: ' + error.message);
            
            // Сброс кнопки при ошибке
            this.startStreamBtn.disabled = false;
            this.startStreamBtn.textContent = 'Начать стрим';
            
            // Детальная диагностика
            if (error.message.includes('getUserMedia')) {
                this.log('💡 Решение: Используйте HTTPS URL (ngrok) для Safari на iOS');
            }
            
            alert('Ошибка: ' + error.message);
        }
    }

                async stopStream() {
                try {
                    this.log('Остановка стрима...');
                    this.updateStatus('Остановка...');
                    
                    // Скрываем контроль громкости при остановке стрима
                    if (this.streamerVolumeControl) {
                        this.streamerVolumeControl.style.display = 'none';
                        this.log('Контроль громкости скрыт');
                    }
                    
                    if (this.callObject) {
                        await this.callObject.leave();
                        this.callObject.destroy();
                        this.callObject = null;
                    }
                    
                    // Деактивируем стрим в базе данных ПЕРЕД удалением комнаты
                    try {
                        await diactivateStream();
                        this.log('✅ Стрим деактивирован в базе данных');
                    } catch (error) {
                        this.log('⚠️ Ошибка деактивации стрима в базе: ' + error.message);
                    }
                    
                    // Удаляем комнату Daily.co и очищаем данные
                    if (this.streamId) {
                        try {
                            await fetch(`/api/delete-room/${this.streamId}`, {
                                method: 'DELETE'
                            });
                            this.log('✅ Комната Daily.co удалена');
                        } catch (error) {
                            this.log('⚠️ Ошибка удаления комнаты: ' + error.message);
                        }
                    }
            
            this.isConnected = false;
            this.authToken = null;
            this.roomData = null;
            
            // Сброс интерфейса
            this.startStreamBtn.disabled = false;
            this.startStreamBtn.textContent = 'Начать стрим';
            this.startStreamBtn.classList.remove('hidden');
            this.stopStreamBtn.classList.add('hidden');
            this.stopStreamBtn.disabled = true;
            this.updateStreamStatus(false);
            this.videoPlaceholder.textContent = 'Нажмите "Начать стрим" для начала';
            this.videoPlaceholder.style.display = 'block';
            
            // Скрываем видео
            const localVideo = document.getElementById('localVideo');
            if (localVideo) {
                localVideo.style.display = 'none';
                localVideo.srcObject = null;
            }
            
            this.log('Стрим остановлен');
            
        } catch (error) {
            this.log('Ошибка остановки стрима: ' + error.message);
            console.error('Stop error:', error);
        }
    }

    setupEventListeners() {
        // Участники подключились/отключились
        this.callObject.on('participant-joined', (event) => {
            this.log('Участник присоединился: ' + (event.participant.user_name || 'Гость'));
        });

        this.callObject.on('participant-left', (event) => {
            this.log('Участник покинул: ' + (event.participant.user_name || 'Гость'));
        });

        // Трек добавлен (видео участника)
        this.callObject.on('track-started', (event) => {
            this.log('Новое видео: ' + (event.participant.user_name || 'Участник') + ' (тип: ' + event.track.kind + ')');
            
            if (event.participant.local && event.track.kind === 'video') {
                // Показываем локальное видео стримера
                this.log('Локальное видео отображается');
                const localVideo = document.getElementById('localVideo');
                if (localVideo) {
                    // Настройка видео элемента для iOS и Android (КРИТИЧНО!)
                    localVideo.muted = true; // iOS и Android требуют muted для autoplay
                    localVideo.playsInline = true; // iOS требует playsInline
                    localVideo.autoplay = true;
                    
                    localVideo.style.display = 'block';
                    
                    // Безопасное создание MediaStream для Android
                    try {
                        // Проверяем валидность трека перед созданием MediaStream
                        if (event.track && event.track.readyState === 'live') {
                            const mediaStream = new MediaStream([event.track]);
                            localVideo.srcObject = mediaStream;
                            this.log('✅ MediaStream успешно создан для Android/iOS');
                        } else {
                            this.log('⚠️ Трек не готов, попробуем позже');
                            // Повторная попытка через небольшую задержку
                            setTimeout(() => {
                                if (event.track && event.track.readyState === 'live') {
                                    try {
                                        const mediaStream = new MediaStream([event.track]);
                                        localVideo.srcObject = mediaStream;
                                        this.log('✅ MediaStream создан при повторной попытке');
                                    } catch (retryError) {
                                        this.log('❌ Повторная попытка создания MediaStream не удалась: ' + retryError.message);
                                    }
                                }
                            }, 500);
                        }
                    } catch (streamError) {
                        this.log('❌ Ошибка создания MediaStream: ' + streamError.message);
                        
                        // Fallback для Android - используем track напрямую
                        if (/Android/i.test(navigator.userAgent)) {
                            this.log('📱 Android fallback: пытаемся использовать track напрямую');
                            try {
                                // Создаём пустой MediaStream и добавляем трек
                                const emptyStream = new MediaStream();
                                emptyStream.addTrack(event.track);
                                localVideo.srcObject = emptyStream;
                                this.log('✅ Android fallback MediaStream создан');
                            } catch (fallbackError) {
                                this.log('❌ Android fallback также не удался: ' + fallbackError.message);
                                this.updateStatus('Ошибка видео на Android: ' + fallbackError.message);
                            }
                        }
                    }
                    
                    this.videoPlaceholder.style.display = 'none';
                }
            }
        });

        // Трек остановлен
        this.callObject.on('track-stopped', (event) => {
            this.log('Трек остановлен: ' + (event.participant.user_name || 'Участник') + ' (тип: ' + event.track.kind + ')');
            
            if (event.participant.local) {
                if (event.track.kind === 'video') {
                    // Скрываем локальное видео
                    const localVideo = document.getElementById('localVideo');
                    if (localVideo) {
                        localVideo.style.display = 'none';
                        this.videoPlaceholder.style.display = 'block';
                    }
                } else if (event.track.kind === 'audio') {
                    this.log('Локальный аудио трек остановлен');
                    
                    // Скрываем контроль громкости
                    if (this.streamerVolumeControl) {
                        this.streamerVolumeControl.style.display = 'none';
                    }
                }
            }
        });

        // Ошибки
        this.callObject.on('error', (event) => {
            this.log('Daily.co ошибка: ' + event.errorMsg);
            console.error('Daily.co error:', event);
            this.updateStatus('Ошибка: ' + event.errorMsg);
        });

        // Подключение установлено
        this.callObject.on('joined-meeting', (event) => {
            this.log('Успешно подключились к встрече');
        });
    }

    updateStreamStatus(isActive) {
        if (this.activeMessage && this.pausedMessage) {
            if (isActive) {
                this.activeMessage.classList.remove('hidden');
                this.pausedMessage.classList.add('hidden');
            } else {
                this.activeMessage.classList.add('hidden');
                this.pausedMessage.classList.remove('hidden');
            }
        }
    }

    updateStatus(status) {
        this.log('Статус: ' + status);
    }

    log(message) {
        console.log('[Daily Streamer]', message);
    }
    

}

// Старая инициализация удалена - теперь используется упрощенная версия выше

// Инициализация DailyStreamer ТОЛЬКО для Daily.co (daily-stream).
if ('<%= stream.streamType %>' === 'daily-stream') {
    console.log('🎬 Инициализация Daily.co стримера (daily-stream)');
    document.addEventListener('DOMContentLoaded', () => {
        window.dailyStreamer = new DailyStreamer();
        console.log('✅ Daily.co стример инициализирован и сохранен в window.dailyStreamer:', window.dailyStreamer);
    });
}
    
    // Мобильная оптимизация видео
    document.addEventListener('DOMContentLoaded', function() {
        const isMobile = window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        
        if (isMobile) {
            console.log('📱 Применяем мобильную оптимизацию видео для стримера');
            
            // Функция для оптимизации видео элементов
            function optimizeVideoForMobile(video) {
                if (video) {
                    // Для стримера используем cover, но с правильным позиционированием
                    video.style.objectFit = 'cover';
                    video.style.objectPosition = 'center';
                    video.style.background = '#000';
                    video.setAttribute('webkit-playsinline', 'true');
                    video.setAttribute('playsinline', 'true');
                    video.setAttribute('muted', 'true'); // Важно для автовоспроизведения
                    console.log('📱 Видео стримера оптимизировано для мобильного:', video.id);
                }
            }
            
            // Оптимизируем видео стримера
            const localVideo = document.getElementById('localVideo');
            optimizeVideoForMobile(localVideo);
            
            // Наблюдаем за изменениями видео
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeType === 1) {
                            const videos = node.tagName === 'VIDEO' ? [node] : node.querySelectorAll('video');
                            videos.forEach(optimizeVideoForMobile);
                        }
                    });
                });
            });
            
            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
            
            // Обработка изменения ориентации
            window.addEventListener('orientationchange', function() {
                setTimeout(function() {
                    const videos = document.querySelectorAll('video');
                    videos.forEach(optimizeVideoForMobile);
                    console.log('📱 Видео стримера переоптимизировано после поворота экрана');
                }, 500);
            });
        }
    });
</script>

<script>
(function(){
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
  async function populateCameraSelector() {
    try {
      const select = document.getElementById('cameraSelect');
      if (!select) return;
      // Ensure permission first so labels/deviceIds are available (Safari)
      // Запросим доступ только к видео для ускорения появления deviceId/label
      try { await navigator.mediaDevices.getUserMedia({ video: true, audio: false }); } catch(e) {}
      let devices = [];
      if (navigator.mediaDevices && navigator.mediaDevices.enumerateDevices) {
        try { devices = await navigator.mediaDevices.enumerateDevices(); } catch(e) { devices = []; }
      }
      const videoInputs = devices.filter(d => d.kind === 'videoinput');
      select.innerHTML = '';
      if (videoInputs.length > 0) {
        videoInputs.forEach((cam, idx) => {
          const opt = document.createElement('option');
          opt.value = 'device:' + (cam.deviceId || '');
          opt.textContent = cam.label || `Камера ${idx + 1}`;
          select.appendChild(opt);
        });
      } else {
        // iOS fallback: front/back by facingMode
        const front = document.createElement('option');
        front.value = 'facing:user';
        front.textContent = 'Фронтальная камера';
        const back = document.createElement('option');
        back.value = 'facing:environment';
        back.textContent = 'Основная камера';
        select.appendChild(front);
        select.appendChild(back);
      }
    } catch (err) {
      console.warn('populateCameraSelector error', err);
    }
  }

  async function switchCameraByValue(value) {
    try {
      if (!window.dailyStreamer || !window.dailyStreamer.callObject) return;
      if (value.startsWith('device:')) {
        const deviceId = value.slice('device:'.length);
        if (deviceId) {
          // Мягкая смена устройства: сначала остановим локальное видео, затем применим девайс и включим заново
          try { await window.dailyStreamer.callObject.setLocalVideo(false); } catch(_) {}
          await window.dailyStreamer.callObject.setInputDevicesAsync({ videoDeviceId: deviceId });
          // Небольшая пауза даёт драйверу время переключиться
          await new Promise(r => setTimeout(r, 150));
          await window.dailyStreamer.callObject.setLocalVideo(true);
          // Принудительно обновим элемент localVideo, если трек ещё не отрисовался
          try {
            const localVideo = document.getElementById('localVideo');
            if (localVideo) {
              const parts = window.dailyStreamer.callObject.participants();
              const lp = parts && parts.local;
              if (lp && lp.video) {
                localVideo.style.display = 'block';
                localVideo.srcObject = new MediaStream([lp.video]);
              }
            }
          } catch(_) {}
          window._preferredCameraValue = value;
        }
      } else if (value.startsWith('facing:')) {
        const mode = value.split(':')[1];
        try { await window.dailyStreamer.callObject.setLocalVideo(false); } catch(_) {}
        await window.dailyStreamer.callObject.startCamera({ facingMode: mode });
        await new Promise(r => setTimeout(r, 150));
        await window.dailyStreamer.callObject.setLocalVideo(true);
        window._preferredCameraValue = value;
      }
    } catch (err) {
      console.warn('switchCameraByValue error', err);
    }
  }

  document.addEventListener('DOMContentLoaded', async function(){
    await populateCameraSelector();
    const select = document.getElementById('cameraSelect');
    if (select) {
      select.addEventListener('change', (e)=> switchCameraByValue(e.target.value));
      // При инициализации, если сохранён предпочтительный девайс — применим его
      try {
        const pref = window._preferredCameraValue;
        if (pref && typeof pref === 'string') {
          // Установим в селекте, если опция существует
          const opt = Array.from(select.options).find(o => o.value === pref);
          if (opt) { select.value = pref; await switchCameraByValue(pref); }
        }
      } catch(_) {}
    }
    // Автоматически обновлять список камер при изменении устройств
    try {
      if (navigator.mediaDevices && typeof navigator.mediaDevices.addEventListener === 'function') {
        navigator.mediaDevices.addEventListener('devicechange', () => {
          populateCameraSelector().catch(()=>{});
        });
      }
    } catch(_) {}
  });
})();
</script>

<script>
// ... existing code ...
// Полноэкранный режим для стримера
(function(){
  function toggleFullscreenStreamer(){
    try {
      var container = document.querySelector('.video-player-area');
      var video = document.getElementById('localVideo');
      var doc = document;
      if (!doc.fullscreenElement && !doc.webkitFullscreenElement) {
        if (container.requestFullscreen) container.requestFullscreen();
        else if (container.webkitRequestFullscreen) container.webkitRequestFullscreen();
        else if (video && video.webkitEnterFullscreen) video.webkitEnterFullscreen();
      } else {
        if (doc.exitFullscreen) doc.exitFullscreen();
        else if (doc.webkitExitFullscreen) doc.webkitExitFullscreen();
      }
    } catch(e){ console.warn('fullscreen error', e); }
  }
  document.addEventListener('DOMContentLoaded', function(){
    var btn = document.getElementById('streamerFsButton');
    if (btn) btn.addEventListener('click', toggleFullscreenStreamer);
  });
})();
</script>




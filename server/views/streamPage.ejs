// ========== ОБРАБОТЧИКИ ДЛЯ ЧАТА (ДЛЯ ВСЕХ) ==========
// Кнопка отправки сообщения
const sendButton = document.querySelector('.starting__buttone');
const messageInput = document.querySelector('.input__messeng');

if (sendButton && messageInput) {
    sendButton.addEventListener('click', sendMessage);
    
    // Отправка по Enter
    messageInput.addEventListener('keypress', function(event) {
        if (event.key === 'Enter' && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
        }
    });
}

// Функция отправки сообщения в чат
async function sendMessage() {
    const messageContent = messageInput.value.trim();
    const streamId = '<%= stream._id %>';
    const userId = '<%= currentUser._id %>';
    const username = '<%= currentUser.displayName %>';

    if (messageContent === '') {
        return; // Не отправляем пустое сообщение
    }

    // Проверка длины сообщения
    if (messageContent.length > 140) {
        toast((window.langDict?.['248']?.[(localStorage.getItem('lang') === 'en' ? 'en' : 'ru')]) || 'Ошибка: Сообщение не должно превышать 140 символов', 'error');
        return;
    }

    try {
        // Отправка сообщения на бэкенд
        const response = await fetch('/chat/message', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                streamId,
                userId,
                username,
                message: messageContent
            }),
        });

        if (response.ok) {
            // console.log('Сообщение отправлено успешно!');
            messageInput.value = ''; // Очищаем поле ввода
        } else {
            console.error('Ошибка отправки сообщения');
            toast('Ошибка при отправке сообщения', 'error');
        }
    } catch (error) {
        console.error('Ошибка при отправке сообщения:', error);
        toast('Произошла ошибка при отправке сообщения', 'error');
    }
}

// ========== ЧАТ ЭФИРА ==========
// Сообщения приходят сокетом в комнату эфира. Раньше здесь стоял
// setInterval(fetchNewMessages, 2000): каждый зритель дёргал сервер 30 раз
// в минуту, почти всегда впустую, и всё равно видел сообщение с задержкой
// до двух секунд. Опрос остался ровно для двух случаев — первая загрузка
// и добор пропущенного после обрыва связи.

// Отрисовка одного сообщения. Общая для сокета и для добора опросом.
function appendChatMessage(message) {
    const messageBox = document.querySelector('.messeg-box');
    if (!messageBox) return;

    // Сообщение могло прийти и сокетом, и добором — второй раз не рисуем.
    if (message._id && messageBox.querySelector(`[data-message-id="${message._id}"]`)) return;

    const messageElement = document.createElement('div');
    messageElement.classList.add('chat-message');
    if (message._id) messageElement.dataset.messageId = message._id;
    messageElement.dataset.timestamp = message.createdAt;

    // Свои сообщения отмечаются классом, а не цветом в разметке: цвет решает
    // stream.css, и в тёмной теме он не остаётся синим по тёмному.
    if (message.userId === '<%= currentUser._id %>') messageElement.classList.add('chat-message--own');

    messageElement.innerHTML = `
        <p class="chat-message__line">
            <span class="chat-message__who">${escapeHtml(message.username)}</span>
            <span class="chat-message__text">${escapeHtml(message.message)}</span>
        </p>
        <time class="chat-message__time">${new Date(message.createdAt).toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit' })}</time>
    `;

    messageBox.appendChild(messageElement);
    messageBox.scrollTo({ top: messageBox.scrollHeight, behavior: 'smooth' });

    if (message.createdAt) lastMessageTime = message.createdAt;
}

// Добор пропущенного: при открытии страницы и после восстановления связи.
async function fetchNewMessages() {
    const streamId = '<%= stream._id %>';

    try {
        const url = `/api/chat/messages/new?streamId=${streamId}&lastMessageTime=${lastMessageTime || ''}`;
        const response = await fetch(url);
        if (!response.ok) {
            console.error('Ошибка при получении новых сообщений, статус:', response.status);
            return;
        }
        (await response.json()).forEach(appendChatMessage);
    } catch (error) {
        console.error('Ошибка при запросе новых сообщений:', error);
    }
}

// ========== ИНИЦИАЛИЗАЦИЯ ЧАТА ДЛЯ ВСЕХ ПОЛЬЗОВАТЕЛЕЙ (В КОНЦЕ) ==========
// Инициализация — ставим время последнего сообщения после загрузки страницы
document.addEventListener('DOMContentLoaded', function () {
    // console.log("🔥 Инициализация чата запущена для всех пользователей");
    // console.log("🔍 Проверяем функцию fetchNewMessages:", typeof fetchNewMessages);
    
    const messages = document.querySelectorAll('.chat-message');
    // console.log("📨 Найдено сообщений при загрузке:", messages.length);

    if (messages.length > 0) {
        lastMessageTime = messages[messages.length - 1].dataset.timestamp || null;
        // console.log("⏰ Инициализировано время последнего сообщения:", lastMessageTime);
    } else {
        lastMessageTime = null;
        // console.log("⏰ Нет сообщений, lastMessageTime установлен в null");
    }
    
    // Прокручиваем чат вниз при загрузке страницы
    const messageBox = document.querySelector('.messeg-box');
    if (messageBox) {
        setTimeout(() => {
            messageBox.scrollTo({
                top: messageBox.scrollHeight,
                behavior: 'smooth'
            });
        }, 500); // Небольшая задержка для загрузки контента
    }
    
    // Новые сообщения приходят сокетом в комнату эфира. Этот вызов — страховка
    // на случай, если сокет не поднялся: основной добор идёт в подтверждении
    // входа в комнату, там же и после обрыва. Повторы отсекаются по data-message-id.
    fetchNewMessages();
    if (typeof socket !== 'undefined' && socket) {
        socket.on('chat:message', appendChatMessage);
    } else {
        console.error('Сокет недоступен — новые сообщения чата приходить не будут');
    }
    // Здесь стояла «автоматическая деактивация при загрузке»: идущий эфир
    // страница через 2 секунды снимала сама. На веб-странице это теперь делает
    // POST .../enter, а на OBS-странице это было ошибкой — ведущий открывал
    // пульт посреди эфира, и эфир помечался снятым, хотя OBS продолжал вещать.
    // Идёт ли OBS-эфир, решает приём RTMP (mediaServer.js), а не страница.
});

        // ========== УПРАВЛЕНИЕ АДАПТИВНЫМ ЧАТОМ ==========
        document.addEventListener('DOMContentLoaded', function () {
            // Управление адаптивным чатом
            const chatTab = document.getElementById('chatTab');
            const chatContainer = document.querySelector('.chat-container');
            const chatOverlay = document.getElementById('chatOverlay');
            const closeChatBtn = document.querySelector('.close-chat-btn');

            function openChat() {
                if (chatContainer && chatOverlay) {
                    chatOverlay.style.display = 'block';
                    chatContainer.classList.add('open');
                    document.body.style.overflow = 'hidden';
                }
            }

            function closeChat() {
                if (chatContainer && chatOverlay) {
                    chatContainer.classList.remove('open');
                    chatOverlay.style.display = 'none';
                    document.body.style.overflow = '';
                }
            }

            if (chatTab) {
                chatTab.addEventListener('click', openChat);
            }

            if (closeChatBtn) {
                closeChatBtn.addEventListener('click', closeChat);
            }

            if (chatOverlay) {
                chatOverlay.addEventListener('click', closeChat);
            }

            // Закрытие чата по Escape
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && window.innerWidth < 1280) {
                    closeChat();
                }
            });
                 });

        // ========== ТАЙМЕР ВРЕМЕНИ СУЩЕСТВОВАНИЯ СТРИМА ==========
        // Функция для форматирования времени
        function formatDuration(seconds) {
            const hours = String(Math.floor(seconds / 3600)).padStart(2, '0');
            const minutes = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
            const secs = String(seconds % 60).padStart(2, '0');
            return `${hours}:${minutes}:${secs}`;
        }

        // Глобальная переменная для хранения интервала таймера
        let streamExistenceTimer = null;

        // Функция для запуска таймера времени существования
        function startStreamExistenceTimer(createdTimeISO) {
            console.log('⏱️ Запускаем таймер времени существования стрима с:', createdTimeISO);
            const durationElement = document.getElementById('streamDuration');
            
            if (!durationElement) {
                console.warn('⚠️ Элемент streamDuration не найден');
                return;
            }

            // Останавливаем предыдущий таймер если он был
            if (streamExistenceTimer) {
                clearInterval(streamExistenceTimer);
            }

            const createdTime = new Date(createdTimeISO).getTime();
            
            function updateDuration() {
                const now = new Date().getTime();
                let diffSeconds = Math.floor((now - createdTime) / 1000);
                
                if (diffSeconds < 0) diffSeconds = 0;
                
                durationElement.textContent = formatDuration(diffSeconds);
            }
            
            // Первоначальный вызов и запуск интервала
            updateDuration();
            streamExistenceTimer = setInterval(updateDuration, 1000);
            console.log('✅ Таймер времени существования стрима запущен');
        }

        // Функция для остановки таймера (не используется для времени существования)
        function stopStreamExistenceTimer() {
            console.log('⏹️ Останавливаем таймер времени существования стрима');
            const durationElement = document.getElementById('streamDuration');
            
            if (streamExistenceTimer) {
                clearInterval(streamExistenceTimer);
                streamExistenceTimer = null;
            }
            
            if (durationElement) {
                durationElement.textContent = '00:00:00';
            }
            console.log('✅ Таймер времени существования стрима остановлен');
        }

        // Время в эфире — с выхода в эфир (startedAt), а не с создания записи:
        // раньше эфир, созданный утром и запущенный вечером, с первой секунды
        // показывал «Онлайн 10:00:00». У неидущего эфира таймер стоит на нуле.
        document.addEventListener('DOMContentLoaded', function() {
            const startedAt = <%- JSON.stringify(stream.isActive && stream.startedAt ? stream.startedAt : null) %>;
            if (startedAt) startStreamExistenceTimer(startedAt);
        });

        // ========== DAILY.CO STREAMER CLASS ==========
        console.log('🚀 Скрипт Daily.co загружается...');
        
        class DailyStreamer {
                constructor() {
                console.log('🏗️ DailyStreamer конструктор вызван');
                this.session = null;
                this.isConnected = false;
                this.init();
                console.log('✅ DailyStreamer инициализирован');
            }

    // Объект звонка Daily — им переключает камеру switchCameraByValue ниже.
    get callObject() { return this.session && this.session.call; }

    init() {
        console.log('🔧 DailyStreamer.init() вызван');
        this.initElements();
        this.bindEvents();
        console.log('✅ DailyStreamer.init() завершен');
    }

                initElements() {
                console.log('🔍 DailyStreamer.initElements() - поиск элементов...');
                this.startStreamBtn = document.getElementById('startStream');
                this.stopStreamBtn = document.querySelector('.pause_stream');
                this.videoPlaceholder = document.getElementById('videoPlaceholder');
                this.activeMessage = document.querySelector('.stream-active-message');
                this.pausedMessage = document.querySelector('.stream-paused-message');
                

                
                console.log('🔍 Найденные элементы:');
                console.log('- startStreamBtn:', !!this.startStreamBtn, this.startStreamBtn);
                console.log('- stopStreamBtn:', !!this.stopStreamBtn, this.stopStreamBtn);
                console.log('- videoPlaceholder:', !!this.videoPlaceholder);
                console.log('- activeMessage:', !!this.activeMessage);
                console.log('- pausedMessage:', !!this.pausedMessage);
                
                // Получаем streamId из EJS переменной
                this.streamId = '<%= stream._id %>';
                console.log('- streamId:', this.streamId);
            }

    bindEvents() {
        console.log('🔗 Привязка обработчиков событий...');
        console.log('Кнопка старта найдена:', !!this.startStreamBtn);
        console.log('Кнопка остановки найдена:', !!this.stopStreamBtn);
        
        if (this.startStreamBtn) {
            console.log('🔗 Привязываем onclick для кнопки старта...');
            this.startStreamBtn.onclick = () => {
                console.log('🎬 Кнопка "Начать стрим" нажата в Daily.co классе!');
                this.startStream();
            };
            console.log('✅ onclick привязан к кнопке старта');
        } else {
            console.error('❌ Кнопка старта не найдена! Не могу привязать обработчик');
        }
        
        if (this.stopStreamBtn) {
            console.log('🔗 Привязываем onclick для кнопки остановки...');
            this.stopStreamBtn.onclick = () => {
                console.log('🛑 Кнопка "Остановить стрим" нажата в Daily.co классе!');
                this.stopStream();
            };
            console.log('✅ onclick привязан к кнопке остановки');
        } else {
            console.error('❌ Кнопка остановки не найдена! Не могу привязать обработчик');
        }
        

    }

    // Сервер создаёт комнату и тем же ответом отдаёт токен вещателя. Камеру
    // и микрофон Daily берёт сам при входе: прежний отдельный getUserMedia
    // держал вторую копию камеры и не отпускал её до закрытия вкладки.
    async startStream() {
        this.startStreamBtn.disabled = true;
        this.startStreamBtn.textContent = 'Подключение...';
        try {
            const first = await TKDaily.requestAccess('/api/create-room', { streamId: this.streamId });
            await new Promise((resolve, reject) => {
                let firstAccess = first;
                this.session = TKDaily.connect({
                    send: true,
                    video: true,
                    // Повторный вход после обрыва — в ту же комнату со свежим токеном.
                    access: () => {
                        if (!firstAccess) return TKDaily.requestAccess('/api/get-token', { streamId: this.streamId });
                        const a = firstAccess;
                        firstAccess = null;
                        return Promise.resolve(a);
                    },
                    onTrack: (track, p, on) => {
                        if (p.local && track.kind === 'video') this.showLocalVideo(on ? track : null);
                    },
                    onMediaError: () => toast('Нет доступа к камере или микрофону — разрешите его в настройках браузера или ведите эфир через OBS', 'error'),
                    onState: (state) => {
                        if (state === 'live') resolve();
                        if (state !== 'ended') return;
                        reject(new Error('нет связи с сервисом видео'));
                        if (this.isConnected) {
                            toast('Связь с сервисом видео потеряна, эфир остановлен', 'error');
                            this.stopStream();
                        }
                    }
                });
            });
            await this.applyCameraPreference();
            await activateStream();
            startStreamExistenceTimer(new Date().toISOString());

            this.isConnected = true;
            this.startStreamBtn.textContent = 'Начать стрим';
            this.startStreamBtn.classList.add('hidden');
            this.stopStreamBtn.classList.remove('hidden');
            this.stopStreamBtn.disabled = false;
            this.updateStreamStatus(true);
        } catch (error) {
            if (this.session) { this.session.leave(); this.session = null; }
            this.startStreamBtn.disabled = false;
            this.startStreamBtn.textContent = 'Начать стрим';
            toast('Ошибка: ' + error.message, 'error');
        }
    }

    // Камера, выбранная в списке до запуска. Смена во время эфира —
    // switchCameraByValue ниже по странице.
    async applyCameraPreference() {
        const pref = (document.getElementById('cameraSelect') || {}).value || '';
        try {
            if (pref.startsWith('device:') && pref.length > 'device:'.length) {
                await this.callObject.setInputDevicesAsync({ videoDeviceId: pref.slice('device:'.length) });
            } else if (pref.startsWith('facing:')) {
                await this.callObject.startCamera({ facingMode: pref.slice('facing:'.length) });
            }
        } catch (_) {}
    }

    showLocalVideo(track) {
        const localVideo = document.getElementById('localVideo');
        if (!localVideo) return;
        TKDaily.attach(localVideo, track);
        localVideo.style.display = track ? 'block' : 'none';
        this.videoPlaceholder.style.display = track ? 'none' : 'block';
    }

    async stopStream() {
        const session = this.session;
        this.session = null;
        this.isConnected = false;
        if (session) await session.leave();
        stopStreamExistenceTimer();
        try {
            await diactivateStream();
        } catch (error) {
            console.error('Не удалось снять эфир в базе:', error);
        }
        // Удаление комнаты отключает и зрителей.
        await fetch(`/api/delete-room/${this.streamId}`, { method: 'DELETE' }).catch(() => {});

        this.startStreamBtn.disabled = false;
        this.startStreamBtn.textContent = 'Начать стрим';
        this.startStreamBtn.classList.remove('hidden');
        this.stopStreamBtn.classList.add('hidden');
        this.stopStreamBtn.disabled = true;
        this.updateStreamStatus(false);
        this.showLocalVideo(null);
        this.videoPlaceholder.textContent = 'Нажмите "Начать стрим" для начала';
    }

    updateStreamStatus(isActive) {
        if (this.activeMessage && this.pausedMessage) {
            if (isActive) {
                this.activeMessage.classList.remove('hidden');
                this.pausedMessage.classList.add('hidden');
            } else {
                this.activeMessage.classList.add('hidden');
                this.pausedMessage.classList.remove('hidden');
            }
        }
    }

}

// Старая инициализация удалена - теперь используется упрощенная версия выше

// Инициализация DailyStreamer ТОЛЬКО для Daily.co (daily-stream).
if ('<%= stream.streamType %>' === 'daily-stream') {
    console.log('🎬 Инициализация Daily.co стримера (daily-stream)');
    document.addEventListener('DOMContentLoaded', () => {
        window.dailyStreamer = new DailyStreamer();
        console.log('✅ Daily.co стример инициализирован и сохранен в window.dailyStreamer:', window.dailyStreamer);
    });
}
    
    // Мобильная оптимизация видео
    document.addEventListener('DOMContentLoaded', function() {
        const isMobile = window.innerWidth <= 768 || /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        
        if (isMobile) {
            console.log('📱 Применяем мобильную оптимизацию видео для стримера');
            
            // Функция для оптимизации видео элементов
            function optimizeVideoForMobile(video) {
                if (video) {
                    // Для стримера используем cover, но с правильным позиционированием
                    video.style.objectFit = 'cover';
                    video.style.objectPosition = 'center';
                    video.style.background = '#000';
                    video.setAttribute('webkit-playsinline', 'true');
                    video.setAttribute('playsinline', 'true');
                    video.setAttribute('muted', 'true'); // Важно для автовоспроизведения
                    console.log('📱 Видео стримера оптимизировано для мобильного:', video.id);
                }
            }
            
            // Оптимизируем видео стримера
            const localVideo = document.getElementById('localVideo');
            optimizeVideoForMobile(localVideo);
            
            // Наблюдаем за изменениями видео
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    mutation.addedNodes.forEach(function(node) {
                        if (node.nodeType === 1) {
                            const videos = node.tagName === 'VIDEO' ? [node] : node.querySelectorAll('video');
                            videos.forEach(optimizeVideoForMobile);
                        }
                    });
                });
            });
            
            observer.observe(document.body, {
                childList: true,
                subtree: true
            });
            
            // Обработка изменения ориентации
            window.addEventListener('orientationchange', function() {
                setTimeout(function() {
                    const videos = document.querySelectorAll('video');
                    videos.forEach(optimizeVideoForMobile);
                    console.log('📱 Видео стримера переоптимизировано после поворота экрана');
                }, 500);
            });
        }
    });
</script>

<script>
(function(){
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
  async function populateCameraSelector() {
    try {
      const select = document.getElementById('cameraSelect');
      if (!select) return;
      // Ensure permission first so labels/deviceIds are available (Safari)
      // Запросим доступ только к видео для ускорения появления deviceId/label
      try { await navigator.mediaDevices.getUserMedia({ video: true, audio: false }); } catch(e) {}
      let devices = [];
      if (navigator.mediaDevices && navigator.mediaDevices.enumerateDevices) {
        try { devices = await navigator.mediaDevices.enumerateDevices(); } catch(e) { devices = []; }
      }
      const videoInputs = devices.filter(d => d.kind === 'videoinput');
      select.innerHTML = '';
      if (videoInputs.length > 0) {
        videoInputs.forEach((cam, idx) => {
          const opt = document.createElement('option');
          opt.value = 'device:' + (cam.deviceId || '');
          opt.textContent = cam.label || `Камера ${idx + 1}`;
          select.appendChild(opt);
        });
      } else {
        // iOS fallback: front/back by facingMode
        const front = document.createElement('option');
        front.value = 'facing:user';
        front.textContent = 'Фронтальная камера';
        const back = document.createElement('option');
        back.value = 'facing:environment';
        back.textContent = 'Основная камера';
        select.appendChild(front);
        select.appendChild(back);
      }
    } catch (err) {
      console.warn('populateCameraSelector error', err);
    }
  }

  async function switchCameraByValue(value) {
    try {
      if (!window.dailyStreamer || !window.dailyStreamer.callObject) return;
      if (value.startsWith('device:')) {
        const deviceId = value.slice('device:'.length);
        if (deviceId) {
          // Мягкая смена устройства: сначала остановим локальное видео, затем применим девайс и включим заново
          try { await window.dailyStreamer.callObject.setLocalVideo(false); } catch(_) {}
          await window.dailyStreamer.callObject.setInputDevicesAsync({ videoDeviceId: deviceId });
          // Небольшая пауза даёт драйверу время переключиться
          await new Promise(r => setTimeout(r, 150));
          await window.dailyStreamer.callObject.setLocalVideo(true);
          // Принудительно обновим элемент localVideo, если трек ещё не отрисовался
          try {
            const localVideo = document.getElementById('localVideo');
            if (localVideo) {
              const parts = window.dailyStreamer.callObject.participants();
              const lp = parts && parts.local;
              if (lp && lp.video) {
                localVideo.style.display = 'block';
                localVideo.srcObject = new MediaStream([lp.video]);
              }
            }
          } catch(_) {}
          window._preferredCameraValue = value;
        }
      } else if (value.startsWith('facing:')) {
        const mode = value.split(':')[1];
        try { await window.dailyStreamer.callObject.setLocalVideo(false); } catch(_) {}
        await window.dailyStreamer.callObject.startCamera({ facingMode: mode });
        await new Promise(r => setTimeout(r, 150));
        await window.dailyStreamer.callObject.setLocalVideo(true);
        window._preferredCameraValue = value;
      }
    } catch (err) {
      console.warn('switchCameraByValue error', err);
    }
  }

  document.addEventListener('DOMContentLoaded', async function(){
    await populateCameraSelector();
    const select = document.getElementById('cameraSelect');
    if (select) {
      select.addEventListener('change', (e)=> switchCameraByValue(e.target.value));
      // При инициализации, если сохранён предпочтительный девайс — применим его
      try {
        const pref = window._preferredCameraValue;
        if (pref && typeof pref === 'string') {
          // Установим в селекте, если опция существует
          const opt = Array.from(select.options).find(o => o.value === pref);
          if (opt) { select.value = pref; await switchCameraByValue(pref); }
        }
      } catch(_) {}
    }
    // Автоматически обновлять список камер при изменении устройств
    try {
      if (navigator.mediaDevices && typeof navigator.mediaDevices.addEventListener === 'function') {
        navigator.mediaDevices.addEventListener('devicechange', () => {
          populateCameraSelector().catch(()=>{});
        });
      }
    } catch(_) {}
  });
})();
</script>

<script>

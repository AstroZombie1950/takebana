                this.startStreamBtn = document.getElementById('startStream');
                this.stopStreamBtn = document.querySelector('.pause_stream');
                this.videoPlaceholder = document.getElementById('videoPlaceholder');
                this.activeMessage = document.querySelector('.stream-active-message');
                this.pausedMessage = document.querySelector('.stream-paused-message');
                

                
                console.log('🔍 Найденные элементы:');
                console.log('- startStreamBtn:', !!this.startStreamBtn, this.startStreamBtn);
                console.log('- stopStreamBtn:', !!this.stopStreamBtn, this.stopStreamBtn);
                console.log('- videoPlaceholder:', !!this.videoPlaceholder);
                console.log('- activeMessage:', !!this.activeMessage);
                console.log('- pausedMessage:', !!this.pausedMessage);
                
                // Получаем streamId из EJS переменной
                this.streamId = '<%= stream._id %>';
                console.log('- streamId:', this.streamId);
            }

    bindEvents() {
        console.log('🔗 Привязка обработчиков событий...');
        console.log('Кнопка старта найдена:', !!this.startStreamBtn);
        console.log('Кнопка остановки найдена:', !!this.stopStreamBtn);
        
        if (this.startStreamBtn) {
            console.log('🔗 Привязываем onclick для кнопки старта...');
            this.startStreamBtn.onclick = () => {
                console.log('🎬 Кнопка "Начать стрим" нажата в Daily.co классе!');
                this.startStream();

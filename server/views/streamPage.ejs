            },
            body: JSON.stringify({
                streamId,
                userId,
                username,
                message: messageContent
            }),
        });

        if (response.ok) {
            // console.log('Сообщение отправлено успешно!');
            messageInput.value = ''; // Очищаем поле ввода
        } else {
            console.error('Ошибка отправки сообщения');
            alert('Ошибка при отправке сообщения');
        }
    } catch (error) {
        console.error('Ошибка при отправке сообщения:', error);
        alert('Произошла ошибка при отправке сообщения');
    }
}

// ========== ЗАГРУЗКА НОВЫХ СООБЩЕНИЙ В ЧАТ (ДЛЯ ВСЕХ) ==========
// console.log("✅ Определение функций чата для всех пользователей...");

// Функция для подгрузки новых сообщений
async function fetchNewMessages() {
    const streamId = '<%= stream._id %>'; // Получаем ID стрима
    
    try {
        // Запрашиваем сообщения, которые были созданы после последнего сообщения
        const url = `/api/chat/messages/new?streamId=${streamId}&lastMessageTime=${lastMessageTime || ''}`;
        
        const response = await fetch(url);
        
        if (response.ok) {
            const newMessages = await response.json();

            if (newMessages.length > 0) {
                const messageBox = document.querySelector('.messeg-box');
                
                // Добавляем каждое новое сообщение в конец чата
                newMessages.forEach(message => {
                    const messageElement = document.createElement('div');
                    messageElement.classList.add('chat-message', 'p-3', 'rounded-xl', 'bg-gray-50');
                    
                    // Определяем цвет имени пользователя
                    const isCurrentUser = message.userId === '<%= currentUser._id %>';
                    const nameColorClass = isCurrentUser ? 'text-green-600' : 'text-blue-600';
                    
                    messageElement.innerHTML = `
                        <div class="flex items-start space-x-3">
                            <div class="flex-1">
                                <p class="text-sm">
                                    <span class="${nameColorClass} font-semibold">${message.username}:</span>
                                    <span class="text-gray-900 ml-2">${message.message}</span>
                                </p>
                                <p class="text-xs text-gray-500 mt-1">${new Date(message.createdAt).toLocaleTimeString()}</p>
                            </div>
                        </div>
                    `;
                    
                    messageBox.appendChild(messageElement);
                    
                    // Плавная прокрутка вниз к новому сообщению
                    messageBox.scrollTo({
                        top: messageBox.scrollHeight,
                        behavior: 'smooth'
                    });
                });

                // Обновляем время последнего сообщения только если новые сообщения действительно пришли
                lastMessageTime = newMessages[newMessages.length - 1].createdAt;
            }
        } else {
            console.error('❌ Ошибка при получении новых сообщений, статус:', response.status);
            const errorText = await response.text();
            console.error('❌ Текст ошибки:', errorText);
        }
    } catch (error) {
        console.error('❌ Ошибка при запросе новых сообщений:', error);
    }
}





        // Получаем значение из EJS - isStreamer удален

// OBS status polling должен работать ТОЛЬКО на OBS-странице стримера,
// иначе на WEB-странице он будет переключать кнопки "Начать/Пауза" не по тому состоянию.
const OBS_ONLY_PAGE = document.body?.dataset?.obsOnly === '1';
if (OBS_ONLY_PAGE) {
    // Проверяем статус OBS стрима
    let isCurrentlyStreaming = false;

    function checkStreamStatus() {
        fetch(`/api/check-stream/${streamKey}`)
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(async data => {
                // Если статус изменился
                if (data.isLive !== isCurrentlyStreaming) {
                    if (data.isLive) {
                        console.log('🟢 OBS Stream just started!');
                        console.log('Stream key:', data.streamKey);
                        console.log('Start time:', new Date(data.timestamp).toLocaleString());

                        await activateStreamObs();
                    } else {
                        console.log('🔴 OBS Stream just ended!');
                        await diactivateStreamObs();
                    }
                    isCurrentlyStreaming = data.isLive;
                } else {
                    console.log(`${data.isLive ? '🟢' : '🔴'} Obs Stream status: ${data.isLive ? 'Active' : 'Inactive'}`);
                }
            })
            .catch(error => {
                console.error('❌ Error checking stream status:', error);
                isCurrentlyStreaming = false;
            });
    }

    // Запускаем проверку OBS стрима
    checkStreamStatus();
    let checkInterval = setInterval(checkStreamStatus, 5000);

    window.addEventListener('beforeunload', () => {
        clearInterval(checkInterval);
    });

    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            clearInterval(checkInterval);
        } else {
            checkStreamStatus();
            checkInterval = setInterval(checkStreamStatus, 5000);
        }
    });
}


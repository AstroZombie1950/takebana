<%#
  Настройки профиля (/settings). Восемь блоков, четыре ряда по два, в ряду —
  одной высоты (решение 18.09.2026):
    имя и никнейм  | фото профиля
    ── Безопасность ──
    пароль         | почта
    ── Приватность ── (с 24.09, utils/privacy.js)
    кто может      | видимость
    ограниченный доступ — во всю ширину
    ── Это устройство ──
    уведомления    | камера и микрофон
    язык           | удаление аккаунта
  Уведомления и доступ к камере — свойство браузера, не аккаунта: настройки
  хранятся в нём (tk-notify.js), разрешения выдаёт он сам.
  На телефоне — одной колонкой в том же порядке. Галерея живёт на странице
  профиля. Маршрут — routes/streaming/profile.js, поведение — public/settings.js,
  вёрстка — public/css/settings.css.
%>
<% var ava = currentUser.avatarStyle; %>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.settings.title' }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/settings.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-page tk-set">
      <a href="/userPage/<%= currentUser._id %>" class="tk-page__back">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        <span data-i18n="app.myProfile"><%- t('app.myProfile') %></span>
      </a>
      <h1 class="tk-page__h1" data-i18n="settings.title"><%- t('settings.title') %></h1>

      <div class="tk-set__grid">

        <!-- Имя и никнейм -->
        <section class="tk-panel">
          <p class="tk-panel__title" data-i18n="settings.who"><%- t('settings.who') %></p>
          <form class="tk-form tk-set__form" id="nameForm" novalidate>
            <label class="tk-form__label" for="profileName" data-i18n="settings.name"><%- t('settings.name') %></label>
            <input id="profileName" class="tk-field" type="text" maxlength="64" value="<%= profile.login %>" placeholder="<%= ta('settings.namePh') %>" data-i18n-placeholder="settings.namePh">

            <label class="tk-form__label" for="profileNick" data-i18n="settings.nickname"><%- t('settings.nickname') %></label>
            <div class="tk-set__nick">
              <span class="tk-set__at" aria-hidden="true">@</span>
              <input id="profileNick" class="tk-field" type="text" maxlength="20" autocomplete="off" autocapitalize="none" spellcheck="false"
                     value="<%= profile.nickname %>" data-current="<%= profile.nickname %>"
                     data-next="<%= profile.nickNext ? profile.nickNext.toISOString() : '' %>" aria-describedby="nickStatus nickHint">
            </div>
            <p class="tk-set__status" id="nickStatus" aria-live="polite"></p>
            <p class="tk-note" id="nickHint" data-i18n="settings.nickHint"><%- t('settings.nickHint') %></p>

            <button type="submit" class="tk-btn tk-btn--primary tk-btn--sm" data-i18n="common.save"><%- t('common.save') %></button>
          </form>
        </section>

        <!-- Фото профиля: файл уходит на сервер сразу после выбора -->
        <section class="tk-panel">
          <p class="tk-panel__title" data-i18n="settings.photo"><%- t('settings.photo') %></p>
          <div class="tk-set__photo">
            <div class="tk-set__ava" id="avatarBox"<% if (!ava.url) { %> data-bg="<%= ava.gradient %>"<% } %>>
              <% if (ava.url) { %><img src="<%= ava.url %>" alt=""><% } else { %><%= ava.initial %><% } %>
            </div>
            <div class="tk-set__side">
              <input id="avatarInput" type="file" accept="image/png,image/jpeg,image/webp" hidden>
              <div class="tk-panel__actions">
                <button id="chooseAvatarBtn" type="button" class="tk-btn tk-btn--outline tk-btn--xs" data-i18n="<%= ava.url ? 'settings.photoReplace' : 'settings.photoUpload' %>"><%- t(ava.url ? 'settings.photoReplace' : 'settings.photoUpload') %></button>
                <button id="deleteAvatarBtn" type="button" class="tk-btn tk-btn--ghost tk-btn--xs tk-set__danger"<% if (!ava.url) { %> hidden<% } %> data-i18n="settings.photoDelete"><%- t('settings.photoDelete') %></button>
              </div>
              <p class="tk-note" id="avatarHint" data-i18n="settings.photoLimit"><%- t('settings.photoLimit') %></p>
            </div>
          </div>
        </section>

        <!-- О себе и ссылки: одной кнопкой (/settings/about). Ссылку сети
             сервер собирает сам по логину (utils/profileLinks.js); под полем —
             что получилось, чтобы проверить переходом. -->
        <section class="tk-panel tk-set__about">
          <p class="tk-panel__title" data-i18n="settings.about"><%- t('settings.about') %></p>
          <form class="tk-form tk-set__form" id="aboutForm" novalidate>
            <div class="tk-set__about-cols">
              <div class="tk-set__bio">
                <label class="tk-form__label" for="profileBio" data-i18n="settings.bio"><%- t('settings.bio') %></label>
                <textarea id="profileBio" class="tk-field" maxlength="300" rows="7" placeholder="<%= ta('settings.bioPh') %>" data-i18n-placeholder="settings.bioPh"><%= profile.bio %></textarea>
                <p class="tk-note tk-set__count" id="bioCount" aria-live="polite"><%= profile.bio.length %>/300</p>
              </div>
              <div class="tk-set__nets">
                <p class="tk-form__label" data-i18n="settings.links"><%- t('settings.links') %></p>
                <% linkKinds.forEach(function (k) { var l = profile.links[k]; %>
                <div class="tk-set__net">
                  <label class="tk-set__net-name" for="link-<%= k %>">
                    <%- include('partials/linkIcon', { kind: k }) %>
                    <% if (k === 'site') { %><span data-i18n="settings.linkSite"><%- t('settings.linkSite') %></span><% } else { %><span><%= linkNames[k] %></span><% } %>
                  </label>
                  <input id="link-<%= k %>" class="tk-field" type="text" data-link="<%= k %>" value="<%= l ? l.display : '' %>"
                         placeholder="<%= ta('settings.linkPh.' + k) %>" data-i18n-placeholder="settings.linkPh.<%= k %>"
                         autocomplete="off" autocapitalize="none" spellcheck="false" inputmode="<%= k === 'whatsapp' ? 'tel' : k === 'site' ? 'url' : 'text' %>">
                  <a class="tk-set__net-out" data-out="<%= k %>" href="<%= l ? l.url : '#' %>" target="_blank" rel="noopener noreferrer"<% if (!l) { %> hidden<% } %>><%= l ? l.url : '' %></a>
                </div>
                <% }) %>
                <p class="tk-note" data-i18n="settings.linksHint"><%- t('settings.linksHint') %></p>
              </div>
            </div>
            <button type="submit" class="tk-btn tk-btn--primary tk-btn--sm" data-i18n="common.save"><%- t('common.save') %></button>
          </form>
        </section>

        <p class="tk-kicker tk-set__row-title" data-i18n="settings.security"><%- t('settings.security') %></p>

        <!-- Пароль: только у входа по паролю, у Google его нет -->
        <section class="tk-panel">
          <p class="tk-panel__title" data-i18n="settings.password"><%- t('settings.password') %></p>
          <% if (hasPassword) { %>
          <form class="tk-form tk-set__form" id="passwordForm">
            <%# Для менеджера паролей: к какой учётке относится новый пароль. %>
            <input type="email" value="<%= profile.email %>" autocomplete="username" hidden>
            <input class="tk-field" type="password" placeholder="<%= ta('settings.oldPassword') %>" id="oldPassword" data-i18n-placeholder="settings.oldPassword" autocomplete="current-password">
            <input class="tk-field" type="password" placeholder="<%= ta('settings.newPassword') %>" id="newPassword" data-i18n-placeholder="settings.newPassword" autocomplete="new-password">
            <input class="tk-field" type="password" placeholder="<%= ta('settings.confirmPassword') %>" id="confirmPassword" data-i18n-placeholder="settings.confirmPassword" autocomplete="new-password">
            <button type="submit" class="tk-btn tk-btn--primary tk-btn--sm" data-i18n="settings.savePassword"><%- t('settings.savePassword') %></button>
          </form>
          <% } else { %>
          <p class="tk-note" data-i18n="settings.passwordGoogle"><%- t('settings.passwordGoogle') %></p>
          <% } %>
        </section>

        <%# Почта: меняется по ссылке из письма на новый адрес.
            Порядок здесь тот же, что у пароля слева: сначала поля — они
            встают на одну линию с полями пароля, — потом нынешний адрес
            и его состояние, и внизу кнопка, напротив «Сохранить пароль».
            Кнопка вынесена из формы: сама форма кончается полями, а между
            ними и кнопкой стоит адрес. Отправку это не меняет — form=. %>
        <section class="tk-panel">
          <p class="tk-panel__title" data-i18n="settings.email"><%- t('settings.email') %></p>
          <% if (hasPassword && mailOn) { %>
          <form class="tk-form tk-set__fields" id="emailForm" novalidate>
            <input class="tk-field" type="email" id="newEmail" autocomplete="email" placeholder="<%= ta('settings.emailNew') %>" data-i18n-placeholder="settings.emailNew">
            <input class="tk-field" type="password" id="emailPassword" autocomplete="current-password" placeholder="<%= ta('settings.emailPassword') %>" data-i18n-placeholder="settings.emailPassword">
            <p class="tk-note" data-i18n="settings.emailHint"><%- t('settings.emailHint') %></p>
          </form>
          <% } else if (!hasPassword) { %>
          <p class="tk-note" data-i18n="settings.emailGoogle"><%- t('settings.emailGoogle') %></p>
          <% } %>

          <div class="tk-set__current">
            <p class="tk-set__email"><%= profile.email %></p>
            <% if (profile.emailVerified) { %>
            <p class="tk-set__verified is-ok" data-i18n="settings.emailVerified"><%- t('settings.emailVerified') %></p>
            <% } else { %>
            <p class="tk-set__verified is-bad"><span data-i18n="settings.emailUnverified"><%- t('settings.emailUnverified') %></span>
              <% if (mailOn) { %><button type="button" class="tk-set__link" id="verifyBtn" data-i18n="settings.emailVerifySend"><%- t('settings.emailVerifySend') %></button><% } %>
            </p>
            <% } %>
            <% if (hasPassword && mailOn) { %>
            <p class="tk-note tk-set__pending" id="emailPending"<% if (!profile.pendingEmail) { %> hidden<% } %>>
              <span data-i18n="settings.emailPending"><%- t('settings.emailPending') %></span> <b id="emailPendingAddr"><%= profile.pendingEmail %></b>
            </p>
            <% } %>
          </div>

          <% if (hasPassword && mailOn) { %>
          <button type="submit" form="emailForm" class="tk-btn tk-btn--primary tk-btn--sm tk-set__go" data-i18n="settings.emailSend"><%- t('settings.emailSend') %></button>
          <% } %>
        </section>

        <%# Приватность — свойство аккаунта, не устройства: хранится в базе
            (User.privacy), сохраняется сразу по выбору (settings.js). %>
        <p class="tk-kicker tk-set__row-title" data-i18n="settings.privacy"><%- t('settings.privacy') %></p>

        <% var PRIV = [
          ['messages', ['all', 'requests', 'contacts', 'nobody']],
          ['calls', ['all', 'contacts', 'nobody']],
          ['groups', ['all', 'contacts', 'nobody']],
        ]; var SEEN = [
          ['presence', ['all', 'contacts', 'nobody']],
          ['comments', ['all', 'followers', 'nobody']],
        ]; %>
        <% function privSelect(key, values) { %>
            <label class="tk-form__label" for="priv-<%= key %>" data-i18n="settings.priv.<%= key %>"><%- t('settings.priv.' + key) %></label>
            <select class="tk-field tk-select" id="priv-<%= key %>" data-privacy="<%= key %>">
              <% values.forEach(function (v) { %><option value="<%= v %>"<% if (privacy[key] === v) { %> selected<% } %> data-i18n="settings.priv.<%= key %>.<%= v %>"><%- t('settings.priv.' + key + '.' + v) %></option><% }) %>
            </select>
        <% } %>
        <section class="tk-panel" id="privacyPanel">
          <p class="tk-panel__title" data-i18n="settings.privWho"><%- t('settings.privWho') %></p>
          <div class="tk-set__form">
            <% PRIV.forEach(function (p) { privSelect(p[0], p[1]); }) %>
            <p class="tk-note tk-set__foot" data-i18n="settings.privWhoHint"><%- t('settings.privWhoHint') %></p>
          </div>
        </section>

        <section class="tk-panel" id="visibilityPanel">
          <p class="tk-panel__title" data-i18n="settings.privSeen"><%- t('settings.privSeen') %></p>
          <div class="tk-set__form">
            <% SEEN.forEach(function (p) { privSelect(p[0], p[1]); }) %>
            <label class="tk-form__toggle"><input type="checkbox" data-privacy="searchable"<% if (privacy.searchable) { %> checked<% } %>><span data-i18n="settings.priv.searchable"><%- t('settings.priv.searchable') %></span></label>
            <p class="tk-note tk-set__foot" data-i18n="settings.privSeenHint"><%- t('settings.privSeenHint') %></p>
          </div>
        </section>

        <%# Кому закрыт канал и общение (utils/restrict.js): вернуть доступ.
            Закрывают — со страницы человека или из своих подписчиков. %>
        <section class="tk-panel tk-set__restricted" id="restrictedPanel">
          <p class="tk-panel__title" data-i18n="settings.restricted"><%- t('settings.restricted') %></p>
          <p class="tk-note" data-i18n="settings.restrictedHint"><%- t('settings.restrictedHint') %></p>
          <ul class="tk-set__people"<% if (!restricted.length) { %> hidden<% } %>>
            <% restricted.forEach(function (p) { %>
            <li class="tk-set__person" data-restricted="<%= p._id %>">
              <a href="/userPage/<%= p._id %>" class="tk-set__person-name"><%= p.displayName %></a>
              <button type="button" class="tk-btn tk-btn--outline tk-btn--xs" data-unrestrict data-i18n="user.unrestrict"><%- t('user.unrestrict') %></button>
            </li>
            <% }); %>
          </ul>
          <p class="tk-note tk-set__empty" id="restrictedEmpty"<% if (restricted.length) { %> hidden<% } %> data-i18n="settings.restrictedNone"><%- t('settings.restrictedNone') %></p>
        </section>

        <p class="tk-kicker tk-set__row-title" data-i18n="settings.device"><%- t('settings.device') %></p>

        <!-- Уведомления: звук сообщения, звук звонка, системные (tk-notify.js) -->
        <section class="tk-panel" id="notifyPanel">
          <p class="tk-panel__title" data-i18n="settings.notify"><%- t('settings.notify') %></p>
          <div class="tk-set__form">
            <label class="tk-form__toggle"><input type="checkbox" data-notify="sndMsg"><span data-i18n="settings.notifyMsg"><%- t('settings.notifyMsg') %></span></label>
            <label class="tk-form__toggle"><input type="checkbox" data-notify="sndCall"><span data-i18n="settings.notifyCall"><%- t('settings.notifyCall') %></span></label>
            <label class="tk-form__toggle"><input type="checkbox" data-notify="sys"><span data-i18n="settings.notifySys"><%- t('settings.notifySys') %></span></label>
            <p class="tk-note tk-set__warn" id="notifyState" hidden></p>
            <%# Отказ с сайта не отменить — показываем, где это переключается
                в самом браузере. Раскрывается по нажатию, свёрнутое не мешает. %>
            <details class="tk-set__how" id="notifyHow" hidden>
              <summary data-i18n="settings.permHow"><%- t('settings.permHow') %></summary>
              <p class="tk-note" data-i18n="settings.permHowText"><%- t('settings.permHowText') %></p>
            </details>
            <p class="tk-note tk-set__foot" data-i18n="settings.notifyHint"><%- t('settings.notifyHint') %></p>
          </div>
        </section>

        <%# Пуши: приходят и с закрытой вкладкой. Панели нет вовсе, пока
            на сервере не задана пара VAPID (utils/push.js): нерабочий
            тумблер хуже отсутствующего. Поведение — public/tk-push.js. %>
        <% if (vapidPublic) { %>
        <section class="tk-panel" id="pushPanel">
          <p class="tk-panel__title" data-i18n="settings.push"><%- t('settings.push') %></p>
          <div class="tk-set__form">
            <label class="tk-form__toggle"><input type="checkbox" data-push="on"><span data-i18n="settings.pushOn"><%- t('settings.pushOn') %></span></label>
            <label class="tk-form__toggle"><input type="checkbox" data-push="preview"><span data-i18n="settings.pushPreview"><%- t('settings.pushPreview') %></span></label>
            <label class="tk-form__toggle"><input type="checkbox" data-push="live"><span data-i18n="settings.pushLive"><%- t('settings.pushLive') %></span></label>
            <p class="tk-note tk-set__warn" id="pushState" hidden></p>
            <%# Отказ с сайта не отменить — показываем, где это переключается
                в самом браузере. Раскрывается по нажатию, свёрнутое не мешает. %>
            <details class="tk-set__how" id="pushHow" hidden>
              <summary data-i18n="settings.permHow"><%- t('settings.permHow') %></summary>
              <p class="tk-note" data-i18n="settings.permHowText"><%- t('settings.permHowText') %></p>
            </details>
            <p class="tk-note tk-set__foot" data-i18n="settings.pushHint"><%- t('settings.pushHint') %></p>
            <p class="tk-note" data-i18n="settings.pushMobile"><%- t('settings.pushMobile') %></p>
            <button type="button" class="tk-btn tk-btn--ghost tk-btn--sm" id="pushTest" data-i18n="settings.pushTest"><%- t('settings.pushTest') %></button>
          </div>
        </section>
        <% } %>

        <!-- Камера и микрофон: что разрешил браузер, и проверка -->
        <section class="tk-panel" id="devicesPanel">
          <p class="tk-panel__title" data-i18n="settings.devices"><%- t('settings.devices') %></p>
          <div class="tk-set__form">
            <dl class="tk-set__perms">
              <dt data-i18n="settings.camera"><%- t('settings.camera') %></dt><dd id="permCamera">—</dd>
              <dt data-i18n="settings.mic"><%- t('settings.mic') %></dt><dd id="permMic">—</dd>
            </dl>
            <div class="tk-set__check" id="devCheck" hidden>
              <video id="devVideo" autoplay muted playsinline></video>
              <div class="tk-set__meter" role="meter" aria-valuemin="0" aria-valuemax="100" aria-label="<%= ta('settings.micLevel') %>" data-i18n-aria="settings.micLevel"><i id="devLevel"></i></div>
            </div>
            <p class="tk-note tk-set__warn" id="devState" hidden></p>
            <p class="tk-note" data-i18n="settings.devicesHint"><%- t('settings.devicesHint') %></p>
            <button type="button" class="tk-btn tk-btn--outline tk-btn--sm" id="devBtn" data-i18n="settings.devicesCheck"><%- t('settings.devicesCheck') %></button>
          </div>
        </section>

        <%# Проверка связи — отдельная страница (utils/netCheck.js): что именно
            не открывается у провайдера человека. %>
        <section class="tk-panel">
          <p class="tk-panel__title" data-i18n="settings.netcheck"><%- t('settings.netcheck') %></p>
          <div class="tk-set__form">
            <p class="tk-note" data-i18n="settings.netcheckHint"><%- t('settings.netcheckHint') %></p>
            <a href="/check" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="settings.netcheckBtn"><%- t('settings.netcheckBtn') %></a>
          </div>
        </section>

        <!-- Язык: общий переключатель public/tk-i18n.js, без перезагрузки -->
        <section class="tk-panel">
          <p class="tk-panel__title" data-i18n="settings.lang"><%- t('settings.lang') %></p>
          <div class="tk-lang tk-set__lang">
            <button type="button" class="tk-lang__btn<%= lang === 'ru' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'ru' %>" data-lang="ru">RU</button>
            <button type="button" class="tk-lang__btn<%= lang === 'en' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'en' %>" data-lang="en">EN</button>
          </div>
        </section>

        <%# Удаление аккаунта. У администратора его нет: панель осталась бы
            без владельца, маршрут такую попытку тоже отклоняет. Но и пустого
            места нет — иначе похоже, что удаления в системе не сделали. %>
        <section class="tk-panel tk-set__zone">
          <p class="tk-panel__title" data-i18n="settings.delete.title"><%- t('settings.delete.title') %></p>
          <% if (canDelete) { %>
          <p class="tk-note" data-i18n="settings.delete.what"><%- t('settings.delete.what') %></p>
          <form class="tk-form tk-set__form" id="deleteForm">
            <% if (hasPassword) { %>
            <input class="tk-field" type="password" placeholder="<%= ta('settings.delete.password') %>" id="deletePassword" data-i18n-placeholder="settings.delete.password" autocomplete="current-password">
            <% } %>
            <button type="submit" class="tk-btn tk-btn--danger tk-btn--sm" data-i18n="settings.delete.btn"><%- t('settings.delete.btn') %></button>
          </form>
          <% } else { %>
          <p class="tk-note" data-i18n="settings.delete.admin"><%- t('settings.delete.admin') %></p>
          <% } %>
        </section>
      </div>

      <%# Выход — только на телефоне: на десктопе он в левой панели. Кнопкой
          во всю ширину, как остальные кнопки настроек. %>
      <form method="post" action="/logout">
        <button type="submit" class="tk-btn tk-btn--outline tk-btn--sm tk-set__exit">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M10 4H4v16h6M16 8l4 4-4 4M20 12H9"></path></svg>
          <span data-i18n="settings.logout"><%- t('settings.logout') %></span>
        </button>
      </form>
    </div>
  </main>
</div>

<script defer src="<%= asset('/settings.js') %>"></script>
</body>
</html>

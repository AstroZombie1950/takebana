<%#
  Настройки профиля (/settings): имя, фото, язык, галерея, пароль, выход.
  Открываются кнопкой на своей странице. Маршрут — routes/streaming/profile.js,
  поведение — public/settings.js, вёрстка — public/css/settings.css.

  Раньше это было окно в шапке кабинета: разметка и скрипт ехали с каждой
  страницей, хотя нужны только здесь.
%>
<% var ava = currentUser.avatarStyle; %>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.settings.title' }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/settings.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-page tk-set">
      <a href="/userPage/<%= currentUser._id %>" class="tk-page__back">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        <span data-i18n="app.myProfile"><%- t('app.myProfile') %></span>
      </a>
      <h1 class="tk-page__h1" data-i18n="settings.title"><%- t('settings.title') %></h1>

      <!-- Имя -->
      <section class="tk-panel">
        <label class="tk-panel__title" for="profileNameInput" data-i18n="settings.yourName"><%- t('settings.yourName') %></label>
        <form class="tk-set__line" id="nameForm">
          <input id="profileNameInput" class="tk-field" type="text" maxlength="64" placeholder="<%= ta('settings.namePh') %>" value="<%= currentUser.displayName %>" data-i18n-placeholder="settings.namePh">
          <button type="submit" class="tk-btn tk-btn--primary tk-btn--sm" data-i18n="settings.saveName"><%- t('settings.saveName') %></button>
        </form>
      </section>

      <!-- Фото профиля: файл уходит на сервер сразу после выбора -->
      <section class="tk-panel">
        <p class="tk-panel__title" data-i18n="settings.photo"><%- t('settings.photo') %></p>
        <div class="tk-set__photo">
          <div class="tk-set__ava" id="avatarBox"<% if (!ava.url) { %> data-bg="<%= ava.gradient %>"<% } %>>
            <% if (ava.url) { %><img src="<%= ava.url %>" alt=""><% } else { %><%= ava.initial %><% } %>
          </div>
          <div class="tk-set__side">
            <input id="avatarInput" type="file" accept="image/png,image/jpeg" hidden>
            <div class="tk-panel__actions">
              <button id="chooseAvatarBtn" type="button" class="tk-btn tk-btn--outline tk-btn--xs" data-i18n="<%= ava.url ? 'settings.photoReplace' : 'settings.photoUpload' %>"><%- t(ava.url ? 'settings.photoReplace' : 'settings.photoUpload') %></button>
              <button id="deleteAvatarBtn" type="button" class="tk-btn tk-btn--ghost tk-btn--xs tk-set__danger"<% if (!ava.url) { %> hidden<% } %> data-i18n="settings.photoDelete"><%- t('settings.photoDelete') %></button>
            </div>
            <p class="tk-note" id="avatarHint" data-i18n="settings.photoLimit"><%- t('settings.photoLimit') %></p>
          </div>
        </div>
      </section>

      <!-- Язык: общий переключатель public/tk-i18n.js, без перезагрузки -->
      <section class="tk-panel">
        <p class="tk-panel__title" data-i18n="settings.lang"><%- t('settings.lang') %></p>
        <div class="tk-lang tk-set__lang">
          <button type="button" class="tk-lang__btn<%= lang === 'ru' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'ru' %>" data-lang="ru">RU</button>
          <button type="button" class="tk-lang__btn<%= lang === 'en' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'en' %>" data-lang="en">EN</button>
        </div>
      </section>

      <!-- Личная галерея -->
      <section class="tk-panel">
        <div class="tk-panel__head">
          <p class="tk-panel__title" data-i18n="settings.gallery.title"><%- t('settings.gallery.title') %></p>
          <span class="tk-note" data-i18n="settings.gallery.limit"><%- t('settings.gallery.limit') %></span>
        </div>

        <div id="galleryDropzone" class="tk-dropzone">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M3 7l3.5-3.5M3 7h18M21 7L17.5 3.5"></path></svg>
          <p data-i18n="settings.gallery.drop"><%- t('settings.gallery.drop') %></p>
          <input id="galleryInput" type="file" accept="image/png,image/jpeg" multiple hidden>
        </div>

        <div class="tk-panel__actions">
          <button id="uploadGalleryBtn" type="button" class="tk-btn tk-btn--primary tk-btn--xs" disabled><span><span data-i18n="settings.gallery.upload"><%- t('settings.gallery.upload') %></span> (<span id="galleryCount">0</span>)</span></button>
          <span class="tk-note" id="galleryHint" data-i18n="settings.gallery.noFiles"><%- t('settings.gallery.noFiles') %></span>
        </div>

        <div id="galleryPreview" class="tk-thumbs"></div>

        <div id="galleryPersisted" class="tk-thumbs">
          <% currentUser.gallery.forEach(function (url) { %>
          <div class="tk-thumb">
            <img src="<%= url %>" alt="" loading="lazy">
            <button type="button" data-name="<%= url.split('/').pop() %>" class="tk-thumb__del" aria-label="<%= ta('common.delete') %>" data-i18n-aria="common.delete">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
            </button>
          </div>
          <% }); %>
        </div>
      </section>

      <%# Смена пароля — только у входа по паролю: у входа через Google его нет. %>
      <% if (hasPassword) { %>
      <section class="tk-panel">
        <p class="tk-panel__title" data-i18n="settings.security"><%- t('settings.security') %></p>
        <form class="tk-form tk-set__pass" id="passwordForm">
          <%# Для менеджера паролей: к какой учётке относится новый пароль. %>
          <input type="email" value="<%= currentUser.email %>" autocomplete="username" hidden>
          <input class="tk-field" type="password" placeholder="<%= ta('settings.oldPassword') %>" id="oldPassword" data-i18n-placeholder="settings.oldPassword" autocomplete="current-password">
          <input class="tk-field" type="password" placeholder="<%= ta('settings.newPassword') %>" id="newPassword" data-i18n-placeholder="settings.newPassword" autocomplete="new-password">
          <input class="tk-field" type="password" placeholder="<%= ta('settings.confirmPassword') %>" id="confirmPassword" data-i18n-placeholder="settings.confirmPassword" autocomplete="new-password">
          <button type="submit" class="tk-btn tk-btn--primary tk-btn--sm" data-i18n="settings.savePassword"><%- t('settings.savePassword') %></button>
        </form>
      </section>
      <% } %>

      <a href="/logout" class="tk-set__exit" data-i18n="settings.logout"><%- t('settings.logout') %></a>
    </div>
  </main>
</div>

<script src="/settings.js"></script>
</body>
</html>

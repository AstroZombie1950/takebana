<script>
    // Код для установки значения в localStorage при переходе по ссылкам
    const service1Link = document.querySelector('a[href="/set-next?next=service1"]');
    const service2Link = document.querySelector('a[href="/set-next?next=service2"]');

    if (service1Link) {
        service1Link.addEventListener('click', function () {
            localStorage.setItem('targetService', 'service1');
        });
    }

    if (service2Link) {
        service2Link.addEventListener('click', function () {
            localStorage.setItem('targetService', 'service2');
        });
    }
</script>



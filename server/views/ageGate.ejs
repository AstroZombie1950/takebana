<%#
  Гейт 18+. Сюда попадает только вошедший зритель помеченного эфира, поэтому
  каркас кабинетный, как на остальных страницах за входом: гостевая шапка
  предлагала бы войти тому, кто уже вошёл.
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.age.title' }) %>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/status.css">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-status">
      <span class="tk-status__kicker" data-i18n="age.kicker"><%- t('age.kicker') %></span>
      <h1 class="tk-status__title" data-i18n="age.title"><%- t('age.title') %></h1>
      <p class="tk-status__text" data-i18n="age.text"><%- t('age.text') %></p>

      <div class="tk-status__acts">
        <button type="button" class="tk-btn tk-btn--primary tk-btn--sm" id="ageConfirm" data-i18n="age.confirm"><%- t('age.confirm') %></button>
        <a href="/streaming" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="age.back"><%- t('age.back') %></a>
      </div>
    </div>
  </main>
</div>

<script>
  // Подтверждение уходит на сервер и запоминается в аккаунте, поэтому после
  // ответа страница просто перезагружается: маршрут эфира пропустит.
  document.getElementById('ageConfirm').addEventListener('click', async function () {
    this.disabled = true;
    try {
      const res = await fetch('/api/age/confirm', { method: 'POST' });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      location.reload();
    } catch (err) {
      this.disabled = false;
      toast(t('age.failed'), 'error');
    }
  });
</script>
</body>
</html>

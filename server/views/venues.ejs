<%#
  Раздел «Заведения» /venues (29.09; до того — «Карта заведений» /map).
  Решения — docs/VENUES.md, вариант Б. Сверху поиск и фильтры одной
  GET-формой: адрес с фильтрами можно переслать, без скрипта форма уходит
  перезагрузкой. Ниже карточки и карта рядом; вид «Список и карта / Список /
  Карта» переключает скрипт, до 1024px — только «Список / Карта».

  Карточки — partials/venueCard.ejs, поведение — public/tk-venues.js,
  вёрстка — css/venues.css, карта — public/tk-map.js (грузится, только когда
  её показывают: на телефоне в списке она не нужна).

  Фильтры (30.09): страна, потом город; тип — одной выпадашкой с галочками;
  «В эфире» и «Открыто сейчас» — метками рядом, а на телефоне скрипт кладёт
  их в ту же выпадашку («Фильтры»): всё помещается без прокрутки вбок.
  У порядка — постоянная подпись «Сортировка». where — страны и города,
  где есть заведения (routes/establishmentsRouter.js, filterPlaces).
%>
<% var anyFilter = filters.q || filters.country || filters.city || filters.types.length || filters.live || filters.open || filters.sort !== 'live';
   var count = plural(venues.length, 'venues.count');
   var scope = filters.q ? ta('venues.scopeQuery', { q: filters.q })
             : filters.city ? placeLabel('city', filters.city)
             : filters.country ? placeLabel('country', filters.country)
             : ta('common.allCities');
   // Подпись выпадашки типов: «Все», одно-два имени или «Выбрано: N».
   var typeNames = filters.types.map(function (c) { return placeLabel('type', c); });
   var typeVal = !typeNames.length ? ta('venues.anyType') : typeNames.length <= 2 ? typeNames.join(', ') : ta('venues.picked', { n: typeNames.length });
   var views = [
     ['split', 'venues.viewSplit', '<rect x="3" y="4" width="18" height="16"></rect><path d="M11 4v16"></path>'],
     ['list', 'venues.viewList', '<path d="M4 6h16M4 12h16M4 18h16"></path>'],
     ['map', 'venues.viewMap', '<path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2-6-2zM9 4v14M15 6v14"></path>'],
   ]; %>
<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="<%= themeOn %>"<% if (theme === 'auto') { %> data-theme-auto<% } %>>
<head>
<%# В индексе — сам раздел. Выдача по запросу и пустая — нет: первой в поиске
    не место, у второй нечего показать (docs/seo/DECISIONS.md). %>
<%- include('partials/tkHead', { titleKey: 'page.venues.title', descriptionKey: 'page.venues.description', seo: { path: '/venues', robots: filters.q || !venues.length ? 'noindex, follow' : '',
      jsonld: [ld.page({ type: 'CollectionPage', path: '/venues', name: ta('page.venues.title'), description: ta('page.venues.description') }),
               ld.crumbs([['Takebana', '/'], [ta('venues.h1'), '/venues']])] } }) %>
<%# Стили MapLibre (83 КБ) грузит tk-venues.js вместе с картой: телефону
    в списке они не нужны, а здесь блокировали отрисовку (задача 43). %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/tk-map.css') %>">
<link rel="stylesheet" href="<%= asset('/css/venues.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main tk-venues" id="venues">
    <%# Вид — до первой отрисовки, чтобы раскладка не прыгала: выбор посетителя
        на этом классе экрана, иначе широкому — список и карта, узкому — список.
        Без скрипта атрибута нет, и CSS показывает один список. %>
    <script>
    (function () {
      var wide = matchMedia('(min-width: 1024px)').matches, v = null;
      try { v = localStorage.getItem('tk.venues.view.' + (wide ? 'wide' : 'narrow')); } catch (e) {}
      if (v !== 'list' && v !== 'map' && !(v === 'split' && wide)) v = wide ? 'split' : 'list';
      document.getElementById('venues').dataset.view = v;
    })();
    </script>

    <form class="tk-venues__bar" id="venueFilters" action="/venues" method="get" role="search">
      <div class="tk-venues__top">
        <div class="tk-venues__title">
          <p class="tk-kicker" data-i18n="venues.kicker"><%- t('venues.kicker') %></p>
          <h1 class="tk-venues__h1" data-i18n="venues.h1"><%- t('venues.h1') %></h1>
        </div>
        <label class="tk-venues__search">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
          <input type="search" name="q" value="<%= filters.q %>" class="tk-venues__q" id="venueQuery" maxlength="100" autocomplete="off" enterkeyhint="search"
                 placeholder="<%= ta('app.search') %>" data-i18n-placeholder="app.search" aria-label="<%= ta('app.search') %>" data-i18n-aria="app.search">
          <button type="button" class="tk-venues__clear" id="venueClear" aria-label="<%= ta('common.clear') %>" data-i18n-aria="common.clear"<%= filters.q ? '' : ' hidden' %>>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
          </button>
        </label>
        <div class="tk-venues__views" role="group" aria-label="<%= ta('venues.view') %>" data-i18n-aria="venues.view">
          <% views.forEach(function (v) { %>
          <button type="button" data-set-view="<%= v[0] %>" aria-pressed="false">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><%- v[2] %></svg>
            <span data-i18n="<%= v[1] %>"><%- t(v[1]) %></span>
          </button>
          <% }); %>
        </div>
      </div>

      <%# Поле с подписью внутри (.tk-venues__ctl): подпись сверху мелко,
          значение под ней. У выпадашек — свой список и на телефоне
          (public/tk-listbox.js, data-listbox-touch). %>
      <div class="tk-venues__filters">
        <label class="tk-venues__ctl">
          <span class="tk-venues__cap" data-i18n="venues.country"><%- t('venues.country') %></span>
          <select name="country" class="tk-select tk-venues__sel" id="venueCountry" data-listbox-touch>
            <option value="" data-i18n="common.allCountries"><%- t('common.allCountries') %></option>
            <% where.countries.forEach(function (c) { %>
            <option value="<%= c.code %>"<%= filters.country === c.code ? ' selected' : '' %><% if (c.i18n) { %> data-i18n="<%= c.i18n %>"<% } else { %> data-user-content<% } %>><%= c.text %></option>
            <% }); %>
          </select>
        </label>
        <%# Город — после страны: без неё заперт. Пункты всех стран здесь,
            скрипт оставляет города выбранной (data-country). %>
        <label class="tk-venues__ctl">
          <span class="tk-venues__cap" data-i18n="venues.city"><%- t('venues.city') %></span>
          <select name="city" class="tk-select tk-venues__sel" id="venueCity" data-listbox-touch<%= filters.country ? '' : ' disabled' %>>
            <option value="" data-i18n="common.allCities"><%- t('common.allCities') %></option>
            <% where.cities.forEach(function (c) { %>
            <option value="<%= c.code %>" data-country="<%= c.country %>"<%= filters.city === c.code ? ' selected' : '' %><% if (c.i18n) { %> data-i18n="<%= c.i18n %>"<% } else { %> data-user-content<% } %>><%= c.text %></option>
            <% }); %>
          </select>
        </label>
        <details class="tk-venues__dd" id="venueMore">
          <summary class="tk-venues__ctl tk-venues__ddbtn">
            <span class="tk-venues__cap"><span class="tk-venues__wide" data-i18n="venues.type"><%- t('venues.type') %></span><span class="tk-venues__narrow" data-i18n="venues.filters"><%- t('venues.filters') %></span></span>
            <span class="tk-venues__ddval" id="venueMoreVal"><%= typeVal %></span>
          </summary>
          <div class="tk-venues__ddpanel" id="venueMorePanel">
            <div class="tk-venues__types" role="group" aria-label="<%= ta('venues.type') %>" data-i18n-aria="venues.type">
              <% placeOptions('type').forEach(function (type) { %>
              <label class="tk-venues__check"><input type="checkbox" name="type" value="<%= type.code %>"<%= filters.types.includes(type.code) ? ' checked' : '' %>><span<% if (type.i18n) { %> data-i18n="<%= type.i18n %>"<% } else { %> data-user-content<% } %>><%= type.text %></span></label>
              <% }); %>
            </div>
          </div>
        </details>
        <div class="tk-venues__flags" id="venueFlags">
          <label class="tk-tag"><input type="checkbox" name="live" value="1"<%= filters.live ? ' checked' : '' %>><i class="tk-venues__dot" aria-hidden="true"></i><span data-i18n="venues.onAir"><%- t('venues.onAir') %></span></label>
          <label class="tk-tag"><input type="checkbox" name="open" value="1"<%= filters.open ? ' checked' : '' %>><span data-i18n="venues.openNow"><%- t('venues.openNow') %></span></label>
        </div>
        <label class="tk-venues__ctl tk-venues__sort">
          <span class="tk-venues__cap" data-i18n="venues.sort"><%- t('venues.sort') %></span>
          <select name="sort" class="tk-select tk-venues__sel" data-listbox-touch>
            <% ['live', 'rate', 'name'].forEach(function (s) { var key = 'venues.sort' + s[0].toUpperCase() + s.slice(1); %>
            <option value="<%= s %>"<%= filters.sort === s ? ' selected' : '' %> data-i18n="<%= key %>"><%= ta(key) %></option>
            <% }); %>
          </select>
        </label>
        <a href="/venues" class="tk-venues__reset" data-reset<%= anyFilter ? '' : ' hidden' %> data-i18n="common.resetFilters"><%- t('common.resetFilters') %></a>
        <%# Нужна только без скрипта: со скриптом фильтр применяется сразу. %>
        <noscript><button type="submit" class="tk-btn tk-btn--outline tk-btn--sm"><%- t('common.show') %></button></noscript>
      </div>
    </form>

    <div class="tk-venues__body">
      <section class="tk-venues__list" aria-label="<%= ta('venues.aria') %>" data-i18n-aria="venues.aria">
        <div class="tk-venues__head">
          <p class="tk-venues__count" id="venueCount"><b data-i18n="<%= count.key %>" data-i18n-vars='<%= JSON.stringify({ n: venues.length }) %>'><%= count.text %></b> <span><%= scope %></span></p>
          <%# Владельцу — его заведения (тот же адрес, что у пункта левой панели),
              остальным — заявка. %>
          <%# Заявка — заметной красной кнопкой (30.09): ссылкой мелким шрифтом
              её не находили. %>
          <% if (currentUser && currentUser.venuesHref) { %>
          <a href="<%= currentUser.venuesHref %>" class="tk-btn tk-btn--outline tk-btn--sm tk-venues__mine" data-i18n="venues.mine"><%- t('venues.mine') %></a>
          <% } else { %>
          <a href="/company-register" class="tk-btn tk-btn--primary tk-btn--sm tk-venues__mine" data-i18n="venues.register"><%- t('venues.register') %></a>
          <% } %>
        </div>
        <div class="tk-venues__cards" id="venueCards"><%- include('partials/venueCards') %></div>
        <div class="tk-venues__empty" id="venueEmpty"<%= venues.length ? ' hidden' : '' %>>
          <b data-i18n="venues.nothingFound"><%- t('venues.nothingFound') %></b>
          <span id="venueEmptyNote" data-i18n="venues.emptyFilter"><%- t('venues.emptyFilter') %></span>
          <button type="button" class="tk-btn tk-btn--outline tk-btn--sm" id="venueShowAll" data-i18n="venues.showAll" hidden><%- t('venues.showAll') %></button>
        </div>
      </section>

      <div class="tk-venues__map" id="venueMap">
        <label class="tk-venues__follow"><input type="checkbox" id="venueFollow" checked><span data-i18n="venues.follow"><%- t('venues.follow') %></span></label>
      </div>
    </div>

    <%# Телефон: переключатель вида у заголовка уезжает вверх вместе со
        списком — эта кнопка всегда под пальцем. Подпись ставит скрипт. %>
    <button type="button" class="tk-venues__fab" id="venueFab"></button>
  </main>
</div>

<script defer src="<%= asset('/vendor/pmtiles-4.5.0.js') %>"></script>
<script defer src="<%= asset('/tk-map.js') %>"></script>
<script defer src="<%= asset('/tk-venues.js') %>"></script>
</body>
</html>

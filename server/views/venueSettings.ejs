<%#
  Настройки заведения /venue/:id/settings (29.09, docs/VENUES.md п. 8) — только
  владельцу и администратору, в индекс не идёт. Свои у каждого заведения,
  меняются сразу, без проверки: PUT того же адреса (routes/establishmentsRouter.js),
  переключатели — public/tk-venue-edit.js, вид — css/venue.css.
  Пока одна настройка — видео-меню (само меню — вкладка /venue/:id/menu,
  routes/venueMenu.js); остальные — потом.
%>
<% var letter = (String(venue.name || '').match(/[\p{L}\p{N}]/u) || ['•'])[0].toUpperCase();
   var features = venue.features || {}; %>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { title: venue.name + ' — ' + ta('venue.tab.settings') + ' — Takebana', robots: 'noindex, nofollow' }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/venue.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-vp" data-venue="<%= venue._id %>" data-name="<%= venue.name %>">

      <header class="tk-vp__head tk-vp__head--small">
        <div class="tk-vp__ava"><% if (venue.avatar) { %><img src="<%= venue.avatar %>" alt=""><% } else { %><%= letter %><% } %></div>
        <div class="tk-vp__id">
          <h1 class="tk-vp__name" data-user-content><%= venue.name %></h1>
        </div>
      </header>

      <%- include('partials/venueTabs', { tab: 'settings', manage: true }) %>

      <section class="tk-panel tk-vset">
        <label class="tk-vset__row">
          <span class="tk-vset__text">
            <span class="tk-vset__name" data-i18n="venue.set.videoMenu"><%- t('venue.set.videoMenu') %></span>
            <span class="tk-vset__hint" data-i18n="venue.set.videoMenuHint"><%- t('venue.set.videoMenuHint') %></span>
          </span>
          <input type="checkbox" class="tk-vset__switch" data-venue-feature="videoMenu"<%= features.videoMenu ? ' checked' : '' %>>
        </label>
        <a href="/venue/<%= venue._id %>/menu" class="tk-vset__link" data-feature-link="videoMenu"<% if (!features.videoMenu) { %> hidden<% } %> data-i18n="venue.set.openMenu"><%- t('venue.set.openMenu') %></a>
      </section>

    </div>
  </main>
</div>
<script defer src="<%= asset('/tk-venue-edit.js') %>"></script>
</body>
</html>

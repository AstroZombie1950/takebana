<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.forgot.title' }) %>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/auth.css') %>">
</head>
<body class="tk-app tk-app--wide">

<%- include('partials/header') %>
<%- include('partials/leftBar') %>

<div class="tk-shell">

<main class="tk-auth">
  <div class="tk-auth__card">
    <a href="/login" class="tk-auth__back">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5l-7 7 7 7M4 12h16"></path></svg>
      <span data-i18n="auth.backToLogin"><%- t('auth.backToLogin') %></span>
    </a>

    <span class="tk-auth__kicker" data-i18n="auth.kicker"><%- t('auth.kicker') %></span>
    <h1 class="tk-auth__h1" data-i18n="auth.forgot.h1"><%- t('auth.forgot.h1') %></h1>

    <p class="tk-auth__lede" data-i18n="auth.forgot.lede"><%- t('auth.forgot.lede') %></p>
    <form class="tk-auth__form" id="tkForgotForm" novalidate>
      <input class="tk-field" type="email" id="email" name="email" placeholder="<%= ta('auth.ph.email') %>" data-i18n-placeholder="auth.ph.email" autocomplete="email" required>
      <button class="tk-btn tk-btn--primary tk-btn--block tk-auth__submit" type="submit" data-i18n="auth.forgot.submit"><%- t('auth.forgot.submit') %></button>
    </form>

    <%# Показывается вместо формы, что бы ни ответил сервер про саму почту:
        ответ одинаковый, есть учётка или нет. %>
    <p class="tk-auth__row" id="tkForgotSent" role="status" data-i18n="auth.forgot.sent" hidden><%- t('auth.forgot.sent') %></p>
  </div>
</main>

<%- include('partials/tkFooter') %>
</div>

<script defer src="/tk-auth.js"></script>
</body>
</html>

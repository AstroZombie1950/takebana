<%#
  Запись эфира (/recording/:id). Смотрят все вошедшие, метка 18+ — через
  гейт (routes/recordings.js). Автор видит и незаконченную запись, и кнопку
  удаления. Вёрстка — раздел «Запись эфира» в css/stream.css.
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { title: rec.title + ' — Takebana' }) %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/stream.css">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-rec">
      <div class="tk-rec__col">
        <div class="tk-live__player">
          <% if (rec.status === 'ready') { %>
            <%# Обычный MP4 с индексом в начале: перемотка и iPhone — без плеера HLS. %>
            <video src="<%= rec.video.url %>"<% if (rec.thumb.url) { %> poster="<%= rec.thumb.url %>"<% } %> class="video-fit-contain" controls playsinline preload="metadata"></video>
          <% } else { %>
            <% var stateKey = rec.status === 'failed' ? 'rec.failedNote' : 'rec.processingNote'; %>
            <p class="tk-rec__state" data-i18n="<%= stateKey %>"><%- t(stateKey) %></p>
          <% } %>
        </div>

        <div class="tk-live__info">
          <h1 class="tk-live__title"><%= rec.title %></h1>
          <p class="tk-rec__meta">
            <% if (rec.isAdult) { %><span>18+</span> · <% } %>
            <span><%= date(rec.recordedAt || rec.createdAt, { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
            <% if (rec.duration) { %> · <span><%= clock(rec.duration) %></span><% } %>
          </p>

          <div class="tk-rec__body">
            <div class="tk-live__author">
              <a href="/userPage/<%= author._id %>" class="tk-live__avatar"<% if (!author.avatarStyle.url) { %> data-bg="<%= author.avatarStyle.gradient %>"<% } %>>
                <% if (author.avatarStyle.url) { %><img src="<%= author.avatarStyle.url %>" alt=""><% } else { %><%= author.avatarStyle.initial %><% } %>
              </a>
              <div class="tk-live__author-body">
                <a href="/userPage/<%= author._id %>" class="tk-live__author-name"><%= author.displayName %></a>
              </div>
            </div>
            <% if (rec.description) { %><p class="tk-live__desc"><%= rec.description %></p><% } %>
          </div>

          <% if (isOwner && rec.status !== 'processing') { %>
          <div class="tk-rec__acts">
            <button type="button" class="tk-btn tk-btn--outline tk-btn--sm" id="deleteRecording" data-id="<%= rec._id %>" data-back="/userPage/<%= author._id %>" data-i18n="rec.delete"><%- t('rec.delete') %></button>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<% if (isOwner && rec.status !== 'processing') { %>
<script>
  // Удаление записи автором: подтверждение, запрос, назад на свою страницу.
  document.getElementById('deleteRecording').addEventListener('click', function () {
    var btn = this;
    confirmDialog(t('rec.deleteQ'), { okText: t('rec.delete') }).then(function (ok) {
      if (!ok) return;
      btn.disabled = true;
      return fetch('/recording/' + btn.dataset.id, { method: 'DELETE' }).then(function (r) {
        return r.json().catch(function () { return {}; }).then(function (b) {
          if (!r.ok) throw new Error(b.message || 'HTTP ' + r.status);
          location.href = btn.dataset.back + '#recordings';
        });
      });
    }).catch(function (e) {
      btn.disabled = false;
      toast(t('app.deleteError', { message: e.message }), 'error');
    });
  });
</script>
<% } %>
</body>
</html>

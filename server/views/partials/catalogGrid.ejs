<%#
  Сетка эфиров каталога. Рисуется внутри страницы и отдельно, маршрутом
  /streaming/:category/grid — его подгружает catalog.js при смене фильтра.
  Нужны: streams, filtered (выбран город или подкатегория), base (адрес
  страницы без фильтров); compact — главная: под пустой строкой там
  лента, в разделах — записи.
%>
<% if (streams.length > 0) { %>
<div class="tk-grid">
  <% streams.forEach(function (stream, index) { %>
  <a href="/stream/<%= stream.streamId %>" class="tk-card" style="animation-delay: <%= index * 70 %>ms">
    <div class="tk-card__shot">
      <% if (stream.thumbnail) { %>
        <img src="<%= stream.thumbnail %>" alt="<%= ta('alt.live', { title: meaningful(stream.title) ? stream.title : stream.user.displayName }) %>" loading="lazy">
      <% } else { %>
        <svg viewBox="0 0 24 24" width="46" height="46" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" aria-hidden="true"><path d="M15 10l4.55-2.28A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.9L15 14"></path><rect x="3" y="6" width="12" height="12"></rect></svg>
      <% } %>

      <% if (stream.isActive) { %>
      <span class="tk-card__live">LIVE</span>
      <% } %>
      <%# Только для подписчиков (29.09): эфир в каталоге есть, смотреть — после подписки. %>
      <% if (stream.subscribersOnly) { %>
      <span class="tk-card__subs" data-i18n="catalog.subsOnly"><%- t('catalog.subsOnly') %></span>
      <% } %>

      <span class="tk-card__eyes">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true"><path d="M1.5 12S5 5.5 12 5.5 22.5 12 22.5 12 19 18.5 12 18.5 1.5 12 1.5 12Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        <%= stream.viewers %>
      </span>
    </div>

    <div class="tk-card__body">
      <div class="tk-card__ava"<% if (!stream.user.avatarStyle.url) { %> data-bg="<%= stream.user.avatarStyle.gradient %>"<% } %>>
        <% if (stream.user.avatarStyle.url) { %>
          <img src="<%= stream.user.avatarStyle.url %>" alt="" loading="lazy">
        <% } else { %>
          <%= stream.user.avatarStyle.initial %>
        <% } %>
      </div>

      <div class="tk-card__text">
        <h3 class="tk-card__title"><%= stream.title %></h3>
        <p class="tk-card__who"><%= stream.user.displayName %></p>
        <% var cat = catalog.CATEGORIES[stream.category], city = catalog.CITY_NAME[stream.city]; %>
        <% if (cat || city) { %>
        <div class="tk-card__tags">
          <% if (cat) { %><span class="tk-card__cat" data-i18n="<%= cat.i18n %>"><%= ta(cat.i18n, cat.name) %></span><% } %>
          <% if (city) { %><span class="tk-card__cat" data-i18n="city.<%= stream.city %>"><%= ta('city.' + stream.city, city) %></span><% } %>
        </div>
        <% } %>
      </div>
    </div>
  </a>
  <% }); %>
</div>
<% } else if (filtered) { %>
<div class="tk-empty">
  <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" aria-hidden="true"><path d="M3 5h18l-7 8.5V19l-4 2v-7.5L3 5Z"></path></svg>
  <p class="tk-empty__h" data-i18n="catalog.filteredEmptyTitle"><%- t('catalog.filteredEmptyTitle') %></p>
  <p class="tk-empty__p" data-i18n="catalog.filteredEmptyText"><%- t('catalog.filteredEmptyText') %></p>
  <a href="<%= base %>" class="tk-btn tk-btn--outline tk-btn--sm" data-reset data-i18n="common.resetFilters"><%- t('common.resetFilters') %></a>
</div>
<% } else { %>
<%# Никто не в эфире — строка, а не рамка на пол-экрана (с 02.10 и в
    разделах: рамка занимала первый экран, записи уходили под сгиб).
    «Стать первым» — кнопкой акцентного цвета, а не ссылкой-подписью: это
    единственное, что можно сделать с пустым эфиром, и подписью её не
    замечали (правки 29.09). %>
<% var quiet = typeof compact !== 'undefined' && compact ? 'feed.noLive' : 'catalog.noLive'; %>
<div class="tk-home__quiet">
  <span data-i18n="<%= quiet %>"><%- t(quiet) %></span>
  <a href="/studio" class="tk-btn tk-btn--primary tk-btn--sm tk-home__first">
    <span class="tk-home__first-dot" aria-hidden="true"></span>
    <span data-i18n="catalog.emptyCta"><%- t('catalog.emptyCta') %></span>
  </a>
</div>
<% } %>

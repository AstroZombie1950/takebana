<%#
  Тип заведения (30.09) — общий блок заявки (/company-register) и настроек
  заведения (/venue/:id/edit). Список — справочник utils/places.js, первым
  пунктом «Другое — ввести самому»: под списком появляется поле, и владелец
  пишет своё. В фильтры раздела своё попадает, когда панель возьмёт его
  в общий список. Страну и город здесь не спрашиваем (09.10): страна — по
  адресу в блоке точки (partials/venuePoint.ejs), города нет.

  Ждёт form — текущие значения (у заявки пусто) и labeled — подпись над
  полем (настройки) или подсказка в самом поле (заявка).
  Поведение — public/tk-venue-place.js, вид — css/app.css (.tk-place).
%>
<% var f = locals.form || {}, labeled = !!locals.labeled, OTHER = '__other';
   var own = !f.type && !!f.typeOther; %>
<div class="tk-place" data-place>
  <div class="tk-place__one">
    <% if (labeled) { %><span class="tk-form__label" data-i18n="venues.type"><%- t('venues.type') %></span><% } %>
    <select class="tk-field tk-select" name="type" data-place-select aria-label="<%= ta('venues.type') %>" data-i18n-aria="venues.type" required>
      <option value="" data-i18n="company.ph.type"><%- t('company.ph.type') %></option>
      <option value="<%= OTHER %>"<%= own ? ' selected' : '' %> data-i18n="place.otherType"><%- t('place.otherType') %></option>
      <% placeOptions('type').forEach(function (o) { %>
      <option value="<%= o.code %>"<%= f.type === o.code ? ' selected' : '' %><% if (o.i18n) { %> data-i18n="<%= o.i18n %>"<% } else { %> data-user-content<% } %>><%= o.text %></option>
      <% }); %>
    </select>
    <input class="tk-field" type="text" name="typeOther" maxlength="60" value="<%= own ? f.typeOther : '' %>" data-place-other
           placeholder="<%= ta('place.typePh') %>" data-i18n-placeholder="place.typePh"<%= own ? '' : ' hidden' %>>
  </div>
</div>

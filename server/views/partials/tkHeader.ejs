<%
  // Шапка сайта для страниц без входа. Локаль navActive: about | blog —
  // подчёркивает текущий раздел. Пустая — ничего не активно.
  var navActive = typeof navActive !== 'undefined' ? navActive : '';

  // «Блог» — по ТЗ главной, но страницы под него ещё нет. Адрес не выдумываем:
  // заглушку гасит tk.js, чтобы не прыгало наверх.
  var navItems = [
    { key: 'about', href: '/about', i18n: 'nav.about' },
    { key: 'blog',  href: '#',      i18n: 'nav.blog' }
  ];
%>
<header class="tk-header">
  <a href="/" class="tk-header__brand" aria-label="Takebana">
    <img src="/img/logo.svg" alt="Takebana" class="tk-header__logo"
         width="101" height="52" decoding="async" fetchpriority="high">
  </a>

  <nav class="tk-header__nav">
    <% navItems.forEach(function (item) { %>
    <a href="<%= item.href %>" class="tk-nav" data-i18n="<%= item.i18n %>"<%- item.key === navActive ? ' aria-current="page"' : '' %>><%- t(item.i18n) %></a>
    <% }); %>
  </nav>

  <div class="tk-header__gap"></div>

  <div class="tk-header__actions">
    <a href="/login" class="tk-login tk-hide-sm" data-i18n="nav.login"><%- t('nav.login') %></a>
    <a href="/register" class="tk-btn tk-btn--primary tk-btn--sm tk-hide-sm" data-i18n="nav.signup"><%- t('nav.signup') %></a>

    <div class="tk-lang">
      <button type="button" class="tk-lang__btn<%= lang === 'ru' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'ru' %>" data-lang="ru">RU</button>
      <button type="button" class="tk-lang__btn<%= lang === 'en' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'en' %>" data-lang="en">EN</button>
    </div>

    <div class="tk-header__burger" id="tkBurgerOpen" role="button" tabindex="0" aria-label="<%= ta('app.menu') %>" data-i18n-aria="app.menu" aria-controls="tkMobileMenu">
      <span></span>
      <span></span>
    </div>
  </div>
</header>

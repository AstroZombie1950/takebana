<%#
  Модальные окна каркаса приложения: настройки эфира, профиль, уведомления,
  два окна звонка и жалоба. Живут в шапке, потому что открываются с любой
  страницы кабинета. Стили — раздел «Модальные окна» в app.css,
  поведение — tk-app.js, у жалобы своё report.js.

  Идентификаторы и атрибуты lng сохранены от прежней вёрстки: на них завязаны
  скрипт и словарь. Менялась только разметка и оформление.
%>

<!-- Настройки трансляции -->
<div class="tk-modal hidden" id="streamSettingsModal">
  <div class="tk-modal__card" id="streamModalContent">
    <div class="tk-modal__head">
      <h3 class="tk-modal__title" data-i18n="modal.stream.title"><%- t('modal.stream.title') %></h3>
      <button type="button" class="tk-modal__close" id="closeStreamModal" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>

    <div class="tk-modal__body">
      <% if (!currentUser.hasActiveStream) { %>
        <div class="tk-form">
          <div class="tk-form__row">
            <label class="tk-form__label" for="streamTitle" data-i18n="modal.stream.name"><%- t('modal.stream.name') %></label>
            <input class="tk-field" type="text" id="streamTitle" placeholder="<%= ta('modal.stream.namePh') %>" data-i18n-placeholder="modal.stream.namePh">
          </div>

          <div class="tk-form__row">
            <label class="tk-form__label" for="streamCategory" data-i18n="modal.stream.category"><%- t('modal.stream.category') %></label>
            <select id="streamCategory" class="tk-field tk-select">
              <option value="" data-i18n="modal.stream.categoryPh"><%- t('modal.stream.categoryPh') %></option>
              <% Object.entries(catalog.CATEGORIES).forEach(function ([code, cat]) { %>
              <option value="<%= code %>" data-i18n="<%= cat.i18n %>"><%= ta(cat.i18n, cat.name) %></option>
              <% }); %>
            </select>
          </div>

          <%# Подкатегории берутся из config/catalog.js, как и теги каталога:
              раньше их список был зашит в tk-app.js отдельной копией. %>
          <div class="tk-form__row">
            <label class="tk-form__label" for="streamSubcategory" data-i18n="modal.stream.subcategory"><%- t('modal.stream.subcategory') %></label>
            <select id="streamSubcategory" class="tk-field tk-select" data-subs="<%= catalog.SUBS_JSON %>" disabled>
              <option value="" data-i18n="modal.stream.subcategoryPh"><%- t('modal.stream.subcategoryPh') %></option>
            </select>
          </div>

          <div class="tk-form__row">
            <label class="tk-form__label" for="streamCity"><span data-i18n="modal.stream.city"><%- t('modal.stream.city') %></span> <span class="tk-form__hint" data-i18n="common.optional"><%- t('common.optional') %></span></label>
            <select id="streamCity" class="tk-field tk-select">
              <option value="" data-i18n="common.notSet"><%- t('common.notSet') %></option>
              <% catalog.CITIES.forEach(function (city) { %>
              <option value="<%= city.code %>" data-i18n="<%= city.i18n %>"><%= ta(city.i18n, city.name) %></option>
              <% }); %>
            </select>
          </div>

          <div class="tk-form__row">
            <label class="tk-form__label" for="streamDescription"><span data-i18n="modal.stream.description"><%- t('modal.stream.description') %></span> <span class="tk-form__hint" data-i18n="common.optional"><%- t('common.optional') %></span></label>
            <textarea id="streamDescription" class="tk-field" rows="4" placeholder="<%= ta('modal.stream.descriptionPh') %>" data-i18n-placeholder="modal.stream.descriptionPh"></textarea>
          </div>

          <div class="tk-form__row">
            <label class="tk-form__toggle">
              <input type="checkbox" id="streamAdult">
              <span data-i18n="modal.stream.adult"><%- t('modal.stream.adult') %></span>
            </label>
            <p class="tk-form__note" data-i18n="modal.stream.adultNote"><%- t('modal.stream.adultNote') %></p>
          </div>
        </div>
      <% } else { %>
        <div class="tk-modal__state">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 10l4.55-2.28A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.9L15 14"></path><rect x="3" y="6" width="12" height="12" rx="1"></rect></svg>
          <p data-i18n="modal.stream.active"><%- t('modal.stream.active') %></p>
          <a href="/stream/<%= currentUser.activeStreamId %>" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="modal.stream.goto"><%- t('modal.stream.goto') %></a>
        </div>
      <% } %>
    </div>

    <div class="tk-modal__foot">
      <% if (!currentUser.hasActiveStream) { %>
        <button type="button" class="tk-btn tk-btn--primary tk-btn--sm tk-btn--block" id="startStreamButton">
          <span data-i18n="modal.stream.settingsLink"><%- t('modal.stream.settingsLink') %></span>
        </button>
      <% } else { %>
        <button type="button" class="tk-btn tk-btn--danger tk-btn--sm tk-btn--block" id="terminateStreamButton">
          <span data-i18n="modal.stream.end"><%- t('modal.stream.end') %></span>
        </button>
      <% } %>
    </div>
  </div>
</div>

<!-- Профиль -->
<div class="tk-modal hidden" id="profileInfoModal">
  <div class="tk-modal__card tk-modal__card--wide">
    <div class="tk-modal__head">
      <h3 class="tk-modal__title" data-i18n="modal.profile.title"><%- t('modal.profile.title') %></h3>
      <button type="button" class="tk-modal__close" id="closeProfileModal" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>

    <div class="tk-modal__body">
      <div class="tk-form__row">
        <label class="tk-form__label" for="profileNameInput" data-i18n="modal.profile.yourName"><%- t('modal.profile.yourName') %></label>
        <input id="profileNameInput" class="tk-field" type="text" placeholder="<%= ta('modal.profile.namePh') %>" value="<%= currentUser.displayName %>" data-i18n-placeholder="modal.profile.namePh">
        <button id="saveNameButton" type="button" class="tk-btn tk-btn--primary tk-btn--xs" data-i18n="modal.profile.saveName"><%- t('modal.profile.saveName') %></button>
      </div>

      <!-- Фото профиля -->
      <section class="tk-panel">
        <p class="tk-panel__title" data-i18n="modal.profile.photo"><%- t('modal.profile.photo') %></p>
        <div class="tk-avatar-row">
          <div class="tk-avatar-box">
            <% if (currentUser.avatarStyle && currentUser.avatarStyle.url) { %>
              <img id="profileAvatarPreview" src="<%= currentUser.avatarStyle.url %>" alt="">
            <% } else { %>
              <span id="profileAvatarEmpty" data-i18n="modal.profile.noPhoto"><%- t('modal.profile.noPhoto') %></span>
              <%# без src: пустой атрибут — это лишний запрос страницы самой к себе. %>
              <%# Реальный адрес проставляет JS после загрузки аватара. %>
              <img id="profileAvatarPreview" class="hidden" alt="">
            <% } %>
          </div>

          <div class="tk-avatar-row__side">
            <p class="tk-note">
              <% if (currentUser.avatarStyle && currentUser.avatarStyle.url) { %>
                <span data-i18n="modal.profile.photoReplace"><%- t('modal.profile.photoReplace') %></span>
              <% } else { %>
                <span data-i18n="modal.profile.photoHint"><%- t('modal.profile.photoHint') %></span>
              <% } %>
            </p>
            <input id="profileAvatarInput" type="file" accept="image/png,image/jpeg" class="hidden">
            <div class="tk-panel__actions">
              <button id="chooseAvatarBtn" type="button" class="tk-btn tk-btn--outline tk-btn--xs" data-i18n="modal.profile.choosePhoto"><%- t('modal.profile.choosePhoto') %></button>
              <button id="uploadAvatarBtn" type="button" class="tk-btn tk-btn--primary tk-btn--xs" disabled data-i18n="modal.profile.savePhoto"><%- t('modal.profile.savePhoto') %></button>
            </div>
            <p class="tk-note" id="avatarHint" data-i18n="modal.profile.photoLimit"><%- t('modal.profile.photoLimit') %></p>
          </div>
        </div>
      </section>

      <!-- Личная галерея -->
      <section class="tk-panel">
        <div class="tk-panel__head">
          <p class="tk-panel__title" data-i18n="modal.gallery.title"><%- t('modal.gallery.title') %></p>
          <span class="tk-note" data-i18n="modal.gallery.limit"><%- t('modal.gallery.limit') %></span>
        </div>

        <div id="galleryDropzone" class="tk-dropzone">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7M3 7l3.5-3.5M3 7h18M21 7L17.5 3.5"></path></svg>
          <p data-i18n="modal.gallery.drop"><%- t('modal.gallery.drop') %></p>
          <input id="galleryInput" type="file" accept="image/png,image/jpeg" multiple class="hidden">
        </div>

        <div class="tk-panel__actions">
          <button id="chooseGalleryBtn" type="button" class="tk-btn tk-btn--outline tk-btn--xs" data-i18n="modal.gallery.choose"><%- t('modal.gallery.choose') %></button>
          <button id="uploadGalleryBtn" type="button" class="tk-btn tk-btn--primary tk-btn--xs" disabled><span><span data-i18n="modal.gallery.upload"><%- t('modal.gallery.upload') %></span> (<span id="galleryCount">0</span>)</span></button>
          <span class="tk-note tk-panel__spacer" id="galleryHint" data-i18n="modal.gallery.noFiles"><%- t('modal.gallery.noFiles') %></span>
        </div>

        <div id="galleryPreview" class="tk-thumbs"></div>

        <div id="galleryPersisted" class="tk-thumbs">
          <% if (currentUser.gallery && currentUser.gallery.length) { %>
            <% currentUser.gallery.forEach(function (url) {
                 const name = url.split('/').pop(); %>
              <div class="tk-thumb">
                <img src="<%= url %>" alt="" loading="lazy">
                <button type="button" data-name="<%= name %>" class="tk-thumb__del" aria-label="<%= ta('common.delete') %>" data-i18n-aria="common.delete">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
                </button>
              </div>
            <% }); %>
          <% } %>
        </div>
      </section>

      <!-- Безопасность -->
      <section class="tk-panel">
        <button type="button" class="tk-panel__toggle" id="securityToggle">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75"></path><rect x="4.5" y="10.5" width="15" height="11" rx="1"></rect></svg>
          <span data-i18n="modal.profile.security"><%- t('modal.profile.security') %></span>
        </button>

        <div class="tk-form hidden" id="securityFields">
          <input class="tk-field" type="password" placeholder="<%= ta('modal.profile.oldPassword') %>" id="oldPassword" data-i18n-placeholder="modal.profile.oldPassword" autocomplete="current-password">
          <input class="tk-field" type="password" placeholder="<%= ta('modal.profile.newPassword') %>" id="newPassword" data-i18n-placeholder="modal.profile.newPassword" autocomplete="new-password">
          <input class="tk-field" type="password" placeholder="<%= ta('modal.profile.confirmPassword') %>" id="confirmPassword" data-i18n-placeholder="modal.profile.confirmPassword" autocomplete="new-password">
          <button id="savePasswordButton" type="button" class="tk-btn tk-btn--primary tk-btn--xs" data-i18n="modal.profile.savePassword"><%- t('modal.profile.savePassword') %></button>
        </div>
      </section>
    </div>

    <div class="tk-modal__foot tk-modal__foot--split">
      <a href="/userPage/<%= currentUser._id %>" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="modal.profile.open"><%- t('modal.profile.open') %></a>
      <a href="/logout" class="tk-modal__exit" data-i18n="modal.profile.logout"><%- t('modal.profile.logout') %></a>
    </div>
  </div>
</div>

<!-- Уведомления -->
<div class="tk-modal hidden" id="notificationModal">
  <div class="tk-modal__card">
    <div class="tk-modal__head">
      <h3 class="tk-modal__title" data-i18n="modal.notifications.title"><%- t('modal.notifications.title') %></h3>
      <button type="button" class="tk-modal__close" id="closeNotificationModal" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>

    <div class="tk-modal__body tk-modal__body--list" id="notificationsContent">
      <p class="tk-note tk-note--center" data-i18n="modal.notifications.loading"><%- t('modal.notifications.loading') %></p>
    </div>
  </div>
</div>

<%# Окна звонка. Имя, тип, статус и подписи кнопок ставит tk-app.js при
    открытии (showOutgoingCall, showIncomingCall) — в разметке их нет. %>
<!-- Исходящий звонок -->
<div id="outgoingCallModal" class="tk-modal hidden">
  <div class="tk-modal__card tk-modal__card--call">
    <div class="tk-modal__head">
      <div class="tk-call__who">
        <div class="tk-call__ava" id="outgoingAvatar"></div>
        <div class="tk-call__names">
          <p class="tk-call__name" id="outgoingName"></p>
          <p class="tk-call__type" id="outgoingType"></p>
        </div>
      </div>
      <button type="button" class="tk-modal__close" id="outgoingCloseBtn" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>

    <div class="tk-call__body">
      <p class="tk-call__status">
        <span class="tk-call__beacon tk-call__beacon--ok"></span>
        <span id="outgoingStatus"></span>
        <span class="tk-call__net hidden" id="outgoingNet" role="img" aria-label="<%= ta('call.network') %>" data-i18n-aria="call.network"><i></i><i></i><i></i></span>
      </p>
      <p class="tk-call__timer"><span id="outgoingTimer" class="hidden">00:00</span></p>

      <div class="tk-call__stage hidden" id="outgoingVideos">
        <div class="pip-call-container">
          <video id="outRemoteVideo" class="pip-remote" autoplay playsinline></video>
          <video id="outLocalVideo" class="pip-local" autoplay playsinline muted></video>
        </div>
      </div>

      <audio id="outRemoteAudio" autoplay playsinline></audio>

      <div class="tk-call__actions">
        <button type="button" id="outgoingVoiceBtn" class="tk-btn tk-btn--outline tk-btn--sm hidden" aria-pressed="false"></button>
        <button type="button" id="outgoingCancelBtn" class="tk-btn tk-btn--danger tk-btn--sm tk-btn--block"></button>
      </div>
    </div>
  </div>
</div>

<!-- Входящий звонок -->
<div id="incomingCallModal" class="tk-modal hidden">
  <div class="tk-modal__card tk-modal__card--call">
    <div class="tk-modal__head">
      <div class="tk-call__who">
        <div class="tk-call__ava" id="incomingAvatar"></div>
        <div class="tk-call__names">
          <p class="tk-call__name" id="incomingName"></p>
          <p class="tk-call__type" id="incomingType"></p>
        </div>
      </div>
      <button type="button" class="tk-modal__close" id="incomingCloseBtn" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>

    <div class="tk-call__body">
      <p class="tk-call__status">
        <span class="tk-call__beacon tk-call__beacon--ring"></span>
        <span id="incomingStatus"></span>
        <span class="tk-call__net hidden" id="incomingNet" role="img" aria-label="<%= ta('call.network') %>" data-i18n-aria="call.network"><i></i><i></i><i></i></span>
      </p>
      <p class="tk-call__timer"><span id="incomingTimer" class="hidden">00:00</span></p>

      <div class="tk-call__stage hidden" id="incomingVideos">
        <div class="pip-call-container">
          <video id="inRemoteVideo" class="pip-remote" autoplay playsinline></video>
          <video id="inLocalVideo" class="pip-local" autoplay playsinline muted></video>
        </div>
      </div>

      <audio id="inRemoteAudio" autoplay playsinline></audio>

      <div class="tk-call__actions tk-call__actions--pair">
        <button type="button" id="incomingVoiceBtn" class="tk-btn tk-btn--outline tk-btn--sm hidden" aria-pressed="false"></button>
        <button type="button" id="incomingDeclineBtn" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="call.decline"><%- t('call.decline') %></button>
        <button type="button" id="incomingAcceptBtn" class="tk-btn tk-btn--ok tk-btn--sm"></button>
      </div>
    </div>
  </div>
</div>

<!-- Жалоба: открывается кнопкой с data-report на любой странице кабинета -->
<div class="tk-modal hidden" id="reportModal">
  <div class="tk-modal__card">
    <div class="tk-modal__head">
      <h3 class="tk-modal__title" data-i18n="common.report"><%- t('common.report') %></h3>
      <button type="button" class="tk-modal__close" id="closeReportModal" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>

    <div class="tk-modal__body">
      <div class="tk-form">
        <p class="tk-form__note" id="reportTarget"></p>

        <div class="tk-form__row">
          <label class="tk-form__label" for="reportReason" data-i18n="report.reason"><%- t('report.reason') %></label>
          <select id="reportReason" class="tk-field tk-select">
            <option value="abuse" data-i18n="report.abuse"><%- t('report.abuse') %></option>
            <option value="spam" data-i18n="report.spam"><%- t('report.spam') %></option>
            <option value="adult" data-i18n="report.adult"><%- t('report.adult') %></option>
            <option value="violence" data-i18n="report.violence"><%- t('report.violence') %></option>
            <option value="copyright" data-i18n="report.copyright"><%- t('report.copyright') %></option>
            <option value="other" data-i18n="report.other"><%- t('report.other') %></option>
          </select>
        </div>

        <div class="tk-form__row">
          <label class="tk-form__label" for="reportComment"><span data-i18n="report.what"><%- t('report.what') %></span> <span class="tk-form__hint" data-i18n="common.optional"><%- t('common.optional') %></span></label>
          <textarea id="reportComment" class="tk-field" rows="4" maxlength="1000" placeholder="<%= ta('report.commentPh') %>" data-i18n-placeholder="report.commentPh"></textarea>
        </div>
      </div>
    </div>

    <div class="tk-modal__foot">
      <button type="button" class="tk-btn tk-btn--primary tk-btn--sm tk-btn--block" id="sendReport" data-i18n="report.send"><%- t('report.send') %></button>
    </div>
  </div>
</div>

<script defer src="/report.js"></script>

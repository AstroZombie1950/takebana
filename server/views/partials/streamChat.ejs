<%# Чат эфира — общий у пульта ведущего и страницы зрителя; сообщения ведёт
    /tk-stream.js. chat-container — крючок выдвижной панели на узких экранах,
    chat__box и messeg-box — крючки чата. Ярлычок и подложка стоят
    position: fixed, поэтому их место в разметке на вёрстку не влияет. %>
<aside class="tk-live__chat chat-container chat__box">
  <div class="tk-live__chat-head">
    <h2 data-i18n="chat.title"><%- t('chat.title') %></h2>
    <button type="button" class="tk-live__chat-close close-chat-btn" aria-label="<%= ta('chat.close') %>" data-i18n-aria="chat.close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
    </button>
  </div>

  <div class="wrapper__masseg">
    <div class="messeg-box"></div>

    <div class="input__messeng-box">
      <textarea class="tk-field input__messeng" rows="1" data-i18n-placeholder="chats.messagePh" placeholder="<%= ta('chats.messagePh') %>" maxlength="140"></textarea>
      <button type="button" class="tk-btn tk-btn--primary tk-btn--sm starting__buttone" data-i18n="chats.send"><%- t('chats.send') %></button>
    </div>
    <p class="tk-live__limit" data-i18n="chat.limit"><%- t('chat.limit') %></p>
  </div>
</aside>

<button type="button" class="tk-live__chat-tab" id="chatTab" aria-label="<%= ta('chat.aria') %>" data-i18n-aria="chat.aria">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M21 12a8 8 0 01-11.5 7.2L4 21l1.8-5.5A8 8 0 1121 12Z"></path></svg>
  <span data-i18n="chat.short"><%- t('chat.short') %></span>
</button>
<div class="tk-live__chat-overlay" id="chatOverlay"></div>

<%#
  Карточка человека — одна на поиск (/search), авторов (/authors) и списки
  подписчиков (/userPage/:id/followers). Раньше она была выписана в каждом
  шаблоне своя. Стили — css/search.css.

  person: _id, displayName, avatarStyle, isOnline, followersCount, official;
          у авторов ещё stream (идёт эфир) или recordings (сколько записей).
  href — куда ведёт карточка; по умолчанию на страницу человека.
%>
<a href="<%= typeof href !== 'undefined' && href ? href : person.url %>" class="tk-person" data-presence-user="<%= person._id %>">
  <span class="tk-person__ava"<% if (!person.avatarStyle.url) { %> data-bg="<%= person.avatarStyle.gradient %>"<% } %>>
    <% if (person.avatarStyle.url) { %><img src="<%= person.avatarStyle.url %>" alt="" loading="lazy" decoding="async"><% } else { %><%= person.avatarStyle.initial %><% } %>
    <span class="presence-dot <%= person.isOnline ? 'presence-online' : 'presence-offline' %>"></span>
  </span>
  <span class="tk-person__body">
    <span class="tk-person__name"><%= person.displayName %><% if (person.official) { %><%- include('official') %><% } %></span>

    <% if (person.stream) { %>
    <span class="tk-person__meta tk-person__meta--live">
      <span class="tk-person__live" data-i18n="authors.liveMark"><%- t('authors.liveMark') %></span>
      · <%= person.stream.viewers %> <span data-i18n="search.viewers"><%- t('search.viewers') %></span>
    </span>
    <span class="tk-person__meta"><%= person.stream.title %></span>
    <% } else { %>
    <span class="tk-person__meta">
      <span data-i18n="authors.followers"><%- t('authors.followers') %></span>: <%= person.followersCount %>
    </span>
    <span class="tk-person__meta">
      <% if (person.recordings) { %><span data-i18n="authors.recordings"><%- t('authors.recordings') %></span>: <%= person.recordings %>
      <% } else { %><% var pk = person.isOnline ? 'common.online' : 'common.offline'; %><span data-presence-text><span data-i18n="<%= pk %>"><%- t(pk) %></span></span><% } %>
    </span>
    <% } %>
  </span>
</a>

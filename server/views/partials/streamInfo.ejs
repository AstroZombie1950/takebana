<%# Шапка эфира — общая у пульта ведущего и страницы зрителя: название,
    автор, описание. Зрителю — подписка и жалоба, гостю — ссылка на вход
    вместо подписки. На телефоне видно только
    название: остальное раскрывается кнопкой «▾», чтобы чат получил экран. %>
<div class="tk-live__info" id="streamInfo">
  <div class="tk-live__title-row">
    <%# Шапки сайта на телефоне у эфира нет — назад ведёт эта стрелка. %>
    <a href="/" class="tk-live__back" aria-label="<%= ta('stream.back') %>" data-i18n-aria="stream.back">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </a>
    <h1 class="tk-live__title"><%= stream.title %></h1>
    <button type="button" class="tk-live__more" id="infoToggle" aria-expanded="false" aria-controls="infoMore" aria-label="<%= ta('stream.details') %>" data-i18n-aria="stream.details">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
    </button>
  </div>

  <div class="tk-live__more-body" id="infoMore">
    <div class="tk-live__author">
      <a href="<%= user.url %>" class="tk-live__avatar"<% if (!user.avatarStyle.url) { %> data-bg="<%= user.avatarStyle.gradient %>"<% } %>>
        <% if (user.avatarStyle.url) { %><img src="<%= user.avatarStyle.url %>" alt=""><% } else { %><%= user.avatarStyle.initial %><% } %>
      </a>

      <div class="tk-live__author-body">
        <a href="<%= user.url %>" class="tk-live__author-name"><%= user.displayName %></a>
        <% if (isStreamer) { %>
          <span class="tk-live__role streamer-badge" data-i18n="stream.host"><%- t('stream.host') %></span>
        <% } %>
      </div>

      <% if (!currentUser) { %>
      <div class="tk-live__author-acts">
        <a href="/login?next=<%= encodeURIComponent(url) %>" class="tk-btn tk-btn--primary tk-btn--xs" data-i18n="stream.subscribe"><%- t('stream.subscribe') %></a>
      </div>
      <% } else if (!isStreamer) { %>
      <div class="tk-live__author-acts">
        <% if (isSubscribed) { %>
          <button type="button" class="tk-btn tk-btn--outline tk-btn--xs js-unsubscribe" data-i18n="stream.unsubscribe"><%- t('stream.unsubscribe') %></button>
        <% } else { %>
          <button type="button" class="tk-btn tk-btn--primary tk-btn--xs js-subscribe" data-i18n="stream.subscribe"><%- t('stream.subscribe') %></button>
        <% } %>
        <%# Жалоба на эфир: окно живёт в общем партиале шапки. %>
        <button type="button" class="tk-btn tk-btn--ghost tk-btn--xs"
                data-report="stream"
                data-report-id="<%= stream._id %>"
                data-report-name="<%= stream.title %>" data-i18n="common.report"><%- t('common.report') %></button>
      </div>
      <% } %>
    </div>

    <% if (stream.description) { %>
      <p class="tk-live__desc"><%= stream.description %></p>
    <% } %>
  </div>
</div>

<%
  // Левая панель — единственное меню сайта: на десктопе стоит слева всегда,
  // ниже 1024 (и на широких страницах — tk-app--wide) выезжает по бургеру.
  // Сверху карточка профиля (имя и почта — она же ссылка на профиль) и карта,
  // затем подписки, разделы каталога и запуск эфира, внизу документы и выход.
  // Сообщения — иконкой в шапке, настройки профиля и язык — на странице
  // /settings, звонки — вкладкой в сообщениях. Поведение — tk-app.js.
  //
  // Гостю вместо профиля — вход и регистрация, из личного — карта и «Что такое
  // Takebana», подписок и выхода нет, язык — внизу панели (в шапке на телефоне
  // ему места нет). Вошедшему «Что такое Takebana» — только на телефоне:
  // на широком экране она кнопкой в шапке, а на узком в шапке ей нет места.
  //
  // Активный раздел каталога: страницу рендерит catalog.js и передаёт category.
  // Активная личная ссылка — по адресу страницы (commonDataMiddleware).
  var cat = typeof category !== 'undefined' ? category : '';
  var here = typeof path !== 'undefined' ? path : '';
  var guest = !currentUser;
  var sections = [
    { key: 'popular',       href: '/',               i18n: 'cat.popular',       noteI18n: 'cat.popularNote' },
    { key: 'entertainment', href: '/streaming/entertainment', i18n: 'cat.entertainment', noteI18n: 'cat.entertainmentNote' },
    { key: 'business',      href: '/streaming/business',      i18n: 'cat.business',      noteI18n: 'cat.businessNote' },
    { key: 'fashion',       href: '/streaming/fashion',       i18n: 'cat.fashion',       noteI18n: 'cat.fashionNote' },
    { key: 'authors',       href: '/authors',                 i18n: 'authors.h1',        noteI18n: 'authors.sideNote' }
  ];
  var myPage = guest ? '' : '/userPage/' + currentUser._id;
  var venues = { href: '/main', i18n: 'app.venues', icon: '<path d="M12 21s7-5.6 7-10.5A7 7 0 105 10.5C5 15.4 12 21 12 21Z"></path><circle cx="12" cy="10" r="2.5"></circle>' };
  var about = { href: '/about', i18n: 'nav.whatIs', icon: '<circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5v.01"></path>' };
  var links = guest ? [venues, about] : [venues, Object.assign({ phone: true }, about)];
  var online = (subscriptions || []).filter(function (x) { return x.status === 'online'; }).length;
%>
<div class="tk-aside__overlay" id="sidebarOverlay" hidden></div>

<aside class="tk-aside" id="sidebar">
  <% if (guest) { %>
  <div class="tk-aside__guest">
    <p class="tk-aside__guest-h" data-i18n="side.guestTitle"><%- t('side.guestTitle') %></p>
    <div class="tk-aside__guest-acts">
      <a href="/register" class="tk-btn tk-btn--primary tk-btn--sm tk-btn--block" data-i18n="nav.signup"><%- t('nav.signup') %></a>
      <a href="/login" class="tk-btn tk-btn--outline tk-btn--sm tk-btn--block" data-i18n="nav.login"><%- t('nav.login') %></a>
    </div>
  </div>
  <% } else { %>
  <a href="<%= myPage %>" class="tk-aside__me<%= here === myPage || here === '/settings' ? ' tk-aside__me--on' : '' %>">
    <span class="tk-aside__me-ava" data-my-avatar<% if (!currentUser.avatarStyle.url) { %> data-bg="<%= currentUser.avatarStyle.gradient %>"<% } %>>
      <% if (currentUser.avatarStyle.url) { %><img src="<%= currentUser.avatarStyle.url %>" alt=""><% } else { %><%= currentUser.avatarStyle.initial %><% } %>
    </span>
    <span class="tk-aside__me-body">
      <span class="tk-aside__me-name"><%= currentUser.displayName %></span>
      <span class="tk-aside__sub-state"><%= currentUser.email %></span>
    </span>
  </a>
  <% } %>

  <%# Заявка заведения подсвечивает «Карту». %>
  <% var parentOf = { '/company-register': '/main' }; %>
  <% links.forEach(function (item) { %>
  <a href="<%= item.href %>" class="tk-aside__item<%= item.phone ? ' tk-aside__item--phone' : '' %><%= (parentOf[here] || here) === item.href ? ' tk-aside__item--on' : '' %>">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><%- item.icon %></svg>
    <span data-i18n="<%= item.i18n %>"><%- t(item.i18n) %></span>
  </a>
  <% }); %>

  <% if (!guest) { %>
  <div class="tk-aside__rule"></div>

  <div class="tk-aside__title">
    <span data-i18n="side.subscriptions"><%- t('side.subscriptions') %></span>
    <span class="tk-aside__count<%= online ? '' : ' hidden' %>" id="subsOnline"><b><%= online %></b> <span data-i18n="side.live"><%- t('side.live') %></span></span>
  </div>

  <%# Подписку и отписку без перезагрузки дорисовывает tk-app.js
      (window.tkSubscriptions): строка ниже — образец для новой. %>
  <div id="subsList">
    <% (subscriptions || []).forEach(function (sub) { %>
    <a href="/userPage/<%= sub.id %>" class="tk-aside__sub" data-sub-id="<%= sub.id %>" data-presence-user="<%= sub.id %>" data-live="<%= sub.status === 'online' ? 1 : 0 %>">
      <div class="tk-aside__ava"<% if (!sub.avatarStyle.url) { %> data-bg="<%= sub.avatarStyle.gradient %>"<% } %>>
        <% if (sub.avatarStyle.url) { %><img src="<%= sub.avatarStyle.url %>" alt="" loading="lazy" decoding="async"><% } else { %><%= sub.avatarStyle.initial %><% } %>
        <span class="presence-dot <%= sub.status === 'online' ? 'presence-online' : 'presence-offline' %>"></span>
      </div>
      <div style="min-width: 0;">
        <p class="tk-aside__sub-name"><%= sub.displayName %></p>
        <p class="tk-aside__sub-state" data-presence-text>
          <% if (sub.status === 'online') { %><span data-i18n="common.online"><%- t('common.online') %></span><% } else { %><span data-i18n="common.offline"><%- t('common.offline') %></span><% } %>
        </p>
      </div>
    </a>
    <% }); %>
  </div>

  <div class="tk-aside__empty<%= subscriptions && subscriptions.length ? ' hidden' : '' %>" id="subsEmpty">
    <span data-i18n="side.noSubs"><%- t('side.noSubs') %></span><br>
    <span data-i18n="side.noSubsHint"><%- t('side.noSubsHint') %></span>
  </div>
  <% } %>

  <div class="tk-aside__rule"></div>

  <div class="tk-aside__title"><span data-i18n="side.sections"><%- t('side.sections') %></span></div>

  <%# Разделы каталога помечает category со страницы, «Авторы» — свой адрес:
      category у них нет. %>
  <% sections.forEach(function (item) { %>
  <a href="<%= item.href %>" class="tk-aside__item<%= item.key === cat || item.href === here ? ' tk-aside__item--on' : '' %>">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
      <% if (item.key === 'popular') { %><path d="M12 3l2.6 5.6 6.4.8-4.7 4.4 1.2 6.2L12 17l-5.5 3 1.2-6.2L3 9.4l6.4-.8L12 3Z"></path>
      <% } else if (item.key === 'entertainment') { %><rect x="3" y="6" width="18" height="12"></rect><path d="M8 12h3M9.5 10.5v3M16 11h.01M18 13h.01"></path>
      <% } else if (item.key === 'business') { %><rect x="3" y="7" width="18" height="13"></rect><path d="M9 7V4h6v3"></path>
      <% } else if (item.key === 'fashion') { %><path d="M12 3a2 2 0 0 0-1 3.8v1.9"></path><path d="M11 8.7 3.6 14.6a1.2 1.2 0 0 0 .8 2.2h15.2a1.2 1.2 0 0 0 .8-2.2L13 8.7Z"></path>
      <% } else { %><circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20c0-3.3 2.9-5 6.5-5s6.5 1.7 6.5 5"></path><path d="M16 5.5a3.5 3.5 0 0 1 0 7"></path><path d="M18 15c2.2.6 3.5 2.2 3.5 5"></path><% } %>
    </svg>
    <span>
      <span data-i18n="<%= item.i18n %>"><%- t(item.i18n) %></span>
      <span class="tk-aside__sub-state" style="display: block;" data-i18n="<%= item.noteI18n %>"><%- t(item.noteI18n) %></span>
    </span>
  </a>
  <% }); %>

  <div class="tk-aside__cta">
    <a href="/studio" class="tk-btn tk-btn--ghost tk-btn--sm tk-btn--block" data-i18n="side.ctaButton"><%- t('side.ctaButton') %></a>
  </div>

  <div class="tk-aside__foot">
    <% if (guest) { %>
    <div class="tk-lang tk-aside__lang">
      <button type="button" class="tk-lang__btn<%= lang === 'ru' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'ru' %>" data-lang="ru">RU</button>
      <button type="button" class="tk-lang__btn<%= lang === 'en' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'en' %>" data-lang="en">EN</button>
    </div>
    <% } %>
    <nav class="tk-aside__docs" aria-label="<%= ta('side.docs') %>" data-i18n-aria="side.docs">
      <a href="/terms" data-i18n="app.terms"><%- t('app.terms') %></a>
      <a href="/privacy" data-i18n="app.privacy"><%- t('app.privacy') %></a>
      <a href="/cookies" data-i18n="app.cookies"><%- t('app.cookies') %></a>
    </nav>

    <% if (!guest) { %>
    <a href="/logout" class="tk-aside__item tk-aside__exit">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path><path d="M12 3H5v18h7"></path></svg>
      <span data-i18n="app.exit"><%- t('app.exit') %></span>
    </a>
    <% } %>
  </div>
</aside>

<%
  // Левая панель — единственное меню сайта: на десктопе стоит слева всегда,
  // ниже 1024 (и на широких страницах — tk-app--wide) выезжает по бургеру.
  // Сверху карточка профиля (имя и почта — она же ссылка на профиль), под ней
  // три группы с заголовками: «Мессенджер» (сообщения, звонки, контакты),
  // «Подписки», «Разделы» (Популярное, Лента, Заведения, Мои заведения, «Что такое
  // Takebana»); ниже запуск эфира, внизу документы и выход. Настройки профиля
  // и язык — на странице /settings. Поведение — tk-app.js.
  //
  // Сообщения, звонки и контакты — с 02.10 (правки заказчика): звонки
  // и контакты жили только вкладками переписки, и их не находили. Это те же
  // вкладки (/chatsPage?tab=…). Иконка переписки в шапке осталась: на
  // телефоне панель спрятана за бургером, и счётчик непрочитанного должен
  // быть виден без него.
  //
  // Развлечения, Бизнес и Мода с 04.10 — не пункты панели, а вкладки внутри
  // «Популярного» (partials/catTabs.ejs): это одна витрина с фильтром по
  // категории. «Авторы» — ссылкой «Все авторы» с главной. Обе страницы
  // подсвечивают «Популярное».
  //
  // Гостю вместо профиля — вход и регистрация, мессенджера, подписок и выхода
  // нет, язык — внизу панели (в шапке на телефоне ему места нет).
  // «Что такое Takebana» — в разделах у всех: у гостя на широком экране она
  // ещё и кнопкой в шапке.
  //
  // Активный пункт: каталог передаёт category, остальное — по адресу
  // страницы (commonDataMiddleware).
  var cat = typeof category !== 'undefined' ? category : '';
  var here = typeof path !== 'undefined' ? path : '';
  var guest = !currentUser;
  var myPage = guest ? '' : currentUser.url;
  // «Мои заведения» (29.09) — только у того, у кого они есть: ссылка
  // на их список с «Добавить заведение» (routes/streaming/shared.js).
  var mine = !guest && currentUser.venuesHref
    ? { href: currentUser.venuesHref, i18n: 'venues.mine', noteI18n: 'side.mineNote', icon: '<path d="M4 20V9l8-5 8 5v11"></path><path d="M9 20v-6h6v6"></path>' }
    : null;
  var sections = [
    { href: '/', i18n: 'cat.popular', noteI18n: 'cat.popularNote', icon: '<path d="M12 3l2.6 5.6 6.4.8-4.7 4.4 1.2 6.2L12 17l-5.5 3 1.2-6.2L3 9.4l6.4-.8L12 3Z"></path>' },
    { href: '/feed', i18n: 'feed.h1', noteI18n: 'side.feedNote', icon: '<rect x="3" y="3" width="8" height="8"></rect><rect x="13" y="3" width="8" height="8"></rect><rect x="3" y="13" width="8" height="8"></rect><path d="M15 14.5v5l4-2.5-4-2.5Z"></path>' },
    { href: '/venues', i18n: 'app.venues', noteI18n: 'side.venuesNote', icon: '<path d="M12 21s7-5.6 7-10.5A7 7 0 105 10.5C5 15.4 12 21 12 21Z"></path><circle cx="12" cy="10" r="2.5"></circle>' },
    mine,
    { href: '/about', i18n: 'nav.whatIs', noteI18n: 'side.aboutNote', icon: '<circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5v.01"></path>' }
  ].filter(Boolean);
  // Чей пункт подсвечивать, если у страницы своего нет: категория и «Авторы» —
  // «Популярное», заявка заведения — «Заведения».
  var parentOf = { '/authors': '/', '/company-register': '/venues' };
  var active = cat ? '/' : (parentOf[here] || here);
  var online = (subscriptions || []).filter(function (x) { return x.status === 'online'; }).length;
  // Вкладка переписки, открытая сейчас: подсвечивает свой пункт. Дальше
  // вкладки переключает chats.js, он же переносит подсветку.
  var chatTab = here === '/chatsPage' ? (typeof tab !== 'undefined' ? tab : 'messages') : '';
  var talk = guest ? [] : [
    { key: 'messages', href: '/chatsPage', i18n: 'app.messages', badge: 'data-chat-messages', count: unreadMessages || 0,
      icon: '<path d="M21 11a8 8 0 01-11.5 7.2L4 20l1.8-5.5A8 8 0 1121 11Z"></path>' },
    { key: 'calls', href: '/chatsPage?tab=calls', i18n: 'calls.title', badge: 'data-missed-calls', count: missedCalls || 0,
      icon: '<path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 006 6l1.5-2 4 1.5v3c0 1.1-.9 2-2 2A15.5 15.5 0 014.5 5.5c0-1.1.9-2 2-2z"></path>' },
    { key: 'contacts', href: '/chatsPage?tab=contacts', i18n: 'contacts.title',
      icon: '<rect x="4" y="3" width="16" height="18"></rect><circle cx="12" cy="10" r="3"></circle><path d="M7.5 18c.8-2 2.4-3 4.5-3s3.7 1 4.5 3"></path>' }
  ];
%>
<div class="tk-aside__overlay" id="sidebarOverlay" hidden></div>

<aside class="tk-aside" id="sidebar">
  <% if (guest) { %>
  <div class="tk-aside__guest">
    <p class="tk-aside__guest-h" data-i18n="side.guestTitle"><%- t('side.guestTitle') %></p>
    <div class="tk-aside__guest-acts">
      <a href="/register" class="tk-btn tk-btn--primary tk-btn--sm tk-btn--block" data-i18n="nav.signup"><%- t('nav.signup') %></a>
      <a href="/login" class="tk-btn tk-btn--outline tk-btn--sm tk-btn--block" data-i18n="nav.login"><%- t('nav.login') %></a>
    </div>
  </div>
  <% } else { %>
  <a href="<%= myPage %>" class="tk-aside__me<%= here === myPage || here === '/settings' ? ' tk-aside__me--on' : '' %>">
    <span class="tk-aside__me-ava" data-my-avatar<% if (!currentUser.avatarStyle.url) { %> data-bg="<%= currentUser.avatarStyle.gradient %>"<% } %>>
      <% if (currentUser.avatarStyle.url) { %><img src="<%= currentUser.avatarStyle.url %>" alt=""><% } else { %><%= currentUser.avatarStyle.initial %><% } %>
    </span>
    <span class="tk-aside__me-body">
      <span class="tk-aside__me-name"><%= currentUser.displayName %></span>
      <span class="tk-aside__sub-state"><%= currentUser.email %></span>
    </span>
  </a>
  <% } %>

  <% if (talk.length) { %>
  <div class="tk-aside__title"><span data-i18n="side.messenger"><%- t('side.messenger') %></span></div>
  <% talk.forEach(function (item) { %>
  <a href="<%= item.href %>" class="tk-aside__item<%= chatTab === item.key ? ' tk-aside__item--on' : '' %>" data-chat-tab="<%= item.key %>">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><%- item.icon %></svg>
    <span data-i18n="<%= item.i18n %>"><%- t(item.i18n) %></span>
    <% if (item.badge) { %><span class="tk-aside__badge<%= item.count ? '' : ' hidden' %>" <%= item.badge %>><%= item.count > 99 ? '99+' : item.count %></span><% } %>
  </a>
  <% }); %>
  <div class="tk-aside__rule"></div>
  <% } %>

  <% if (!guest) { %>
  <div class="tk-aside__title">
    <span data-i18n="side.subscriptions"><%- t('side.subscriptions') %></span>
    <span class="tk-aside__count<%= online ? '' : ' hidden' %>" id="subsOnline"><b><%= online %></b> <span data-i18n="side.live"><%- t('side.live') %></span></span>
  </div>

  <%# Подписку и отписку без перезагрузки дорисовывает tk-app.js
      (window.tkSubscriptions): строка ниже — образец для новой. %>
  <div id="subsList">
    <% (subscriptions || []).forEach(function (sub) { %>
    <a href="<%= sub.url %>" class="tk-aside__sub" data-sub-id="<%= sub.id %>" data-presence-user="<%= sub.id %>" data-live="<%= sub.status === 'online' ? 1 : 0 %>">
      <div class="tk-aside__ava"<% if (!sub.avatarStyle.url) { %> data-bg="<%= sub.avatarStyle.gradient %>"<% } %>>
        <% if (sub.avatarStyle.url) { %><img src="<%= sub.avatarStyle.url %>" alt="" loading="lazy" decoding="async"><% } else { %><%= sub.avatarStyle.initial %><% } %>
        <span class="presence-dot <%= sub.status === 'online' ? 'presence-online' : 'presence-offline' %>"></span>
      </div>
      <div style="min-width: 0;">
        <p class="tk-aside__sub-name"><%= sub.displayName %></p>
        <p class="tk-aside__sub-state" data-presence-text>
          <% if (sub.status === 'online') { %><span data-i18n="common.online"><%- t('common.online') %></span><% } else { %><span data-i18n="common.offline"><%- t('common.offline') %></span><% } %>
        </p>
      </div>
    </a>
    <% }); %>
  </div>

  <div class="tk-aside__empty<%= subscriptions && subscriptions.length ? ' hidden' : '' %>" id="subsEmpty">
    <span data-i18n="side.noSubs"><%- t('side.noSubs') %></span><br>
    <span data-i18n="side.noSubsHint"><%- t('side.noSubsHint') %></span>
  </div>

  <div class="tk-aside__rule"></div>
  <% } %>

  <div class="tk-aside__title"><span data-i18n="side.sections"><%- t('side.sections') %></span></div>

  <% sections.forEach(function (item) { %>
  <a href="<%= item.href %>" class="tk-aside__item<%= active === item.href ? ' tk-aside__item--on' : '' %>">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><%- item.icon %></svg>
    <span class="tk-aside__item-body">
      <span data-i18n="<%= item.i18n %>"><%- t(item.i18n) %></span>
      <span class="tk-aside__sub-state" data-i18n="<%= item.noteI18n %>"><%- t(item.noteI18n) %></span>
    </span>
  </a>
  <% }); %>

  <div class="tk-aside__cta">
    <a href="/studio" class="tk-btn tk-btn--ghost tk-btn--sm tk-btn--block" data-i18n="side.ctaButton"><%- t('side.ctaButton') %></a>
  </div>

  <div class="tk-aside__foot">
    <%# Тема и язык — только здесь, у всех и на любой ширине (правки
        06.10: из шапки убраны). Тема переключателем слева, язык справа.
        Тема — public/tk-theme.js (data-theme-pick), язык — public/tk-i18n.js. %>
    <div class="tk-aside__prefs">
      <div class="tk-lang tk-aside__theme" role="group" aria-label="<%= ta('settings.theme') %>" data-i18n-aria="settings.theme">
        <button type="button" class="tk-lang__btn<%= themeOn === 'dark' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= themeOn === 'dark' %>" data-theme-pick="dark" aria-label="<%= ta('theme.dark') %>" data-i18n-aria="theme.dark" title="<%= ta('theme.dark') %>" data-i18n-title="theme.dark">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5Z"></path></svg>
        </button>
        <button type="button" class="tk-lang__btn<%= themeOn === 'light' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= themeOn === 'light' %>" data-theme-pick="light" aria-label="<%= ta('theme.light') %>" data-i18n-aria="theme.light" title="<%= ta('theme.light') %>" data-i18n-title="theme.light">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        </button>
      </div>
      <div class="tk-lang" role="group" aria-label="<%= ta('settings.lang') %>" data-i18n-aria="settings.lang">
        <button type="button" class="tk-lang__btn<%= lang === 'ru' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'ru' %>" data-lang="ru">RU</button>
        <button type="button" class="tk-lang__btn<%= lang === 'en' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'en' %>" data-lang="en">EN</button>
      </div>
    </div>
    <nav class="tk-aside__docs" aria-label="<%= ta('side.docs') %>" data-i18n-aria="side.docs">
      <a href="/terms" data-i18n="app.terms"><%- t('app.terms') %></a>
      <a href="/privacy" data-i18n="app.privacy"><%- t('app.privacy') %></a>
      <a href="/cookies" data-i18n="app.cookies"><%- t('app.cookies') %></a>
    </nav>

    <% if (!guest) { %>
    <form method="post" action="/logout">
      <button type="submit" class="tk-aside__item tk-aside__exit">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path><path d="M12 3H5v18h7"></path></svg>
        <span data-i18n="app.exit"><%- t('app.exit') %></span>
      </button>
    </form>
    <% } %>
  </div>
</aside>

<!-- Левая колонка навигации -->
<style>
/* Улучшенные стили для кнопки сайдбара */
#sidebarToggle {
    /* Универсальная тень для лучшей видимости */
    box-shadow: 
        0 4px 6px -1px rgba(0, 0, 0, 0.1),
        0 2px 4px -1px rgba(0, 0, 0, 0.06),
        0 0 0 1px rgba(255, 255, 255, 0.8),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

#sidebarToggle:hover {
    box-shadow: 
        0 10px 15px -3px rgba(0, 0, 0, 0.15),
        0 4px 6px -2px rgba(0, 0, 0, 0.1),
        0 0 0 1px rgba(255, 255, 255, 1),
        inset 0 1px 0 rgba(255, 255, 255, 1);
}

/* Дополнительная подсветка для темных фонов */
@media (prefers-color-scheme: dark) {
    #sidebarToggle {
        background: rgba(255, 255, 255, 0.95) !important;
        border-color: rgba(255, 255, 255, 0.3) !important;
    }
    
    #sidebarToggle:hover {
        background: rgba(255, 255, 255, 1) !important;
        border-color: rgba(255, 255, 255, 0.5) !important;
    }
}

/* Улучшенная видимость на светлых фонах */
@media (prefers-color-scheme: light) {
    #sidebarToggle {
        background: rgba(255, 255, 255, 0.95) !important;
        border-color: rgba(0, 0, 0, 0.1) !important;
    }
    
    #sidebarToggle:hover {
        background: rgba(255, 255, 255, 1) !important;
        border-color: rgba(0, 0, 0, 0.2) !important;
    }
}

/* Анимация появления для лучшего UX */
#sidebarToggle {
    animation: slideInLeft 0.3s ease-out;
}

@keyframes slideInLeft {
    from {
        transform: translateY(-50%) translateX(-100%);
        opacity: 0;
    }
    to {
        transform: translateY(-50%) translateX(0);
        opacity: 1;
    }
}

/* Улучшенный tooltip */
#sidebarToggle .tooltip {
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
}
</style>

<!-- Мобильная кнопка для открытия сайдбара (видимый край) -->
<div class="lg:hidden fixed left-0 top-1/2 z-30 -translate-y-1/2">
  <button id="sidebarToggle" class="group flex flex-col items-center justify-center w-8 h-12 bg-white/90 backdrop-blur-md rounded-r-xl border border-gray-200/50 shadow-xl hover:shadow-2xl hover:bg-white transition-all duration-300 hover:w-10 relative">
    <!-- Hamburger icon -->
    <div class="flex flex-col space-y-0.5">
      <div class="w-3 h-0.5 bg-gray-700 rounded-full transition-all duration-300 group-hover:w-4 group-hover:bg-gray-900"></div>
      <div class="w-2.5 h-0.5 bg-gray-600 rounded-full transition-all duration-300 group-hover:w-4 group-hover:bg-gray-800"></div>
      <div class="w-3 h-0.5 bg-gray-700 rounded-full transition-all duration-300 group-hover:w-4 group-hover:bg-gray-900"></div>
    </div>
    <!-- Tooltip -->
    <div class="absolute left-full ml-2 px-2 py-1 bg-gray-900/90 text-white text-xs rounded-lg opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap shadow-lg tooltip" lng="154">
      Меню
    </div>
    <!-- Glow effect for better visibility -->
    <div class="absolute inset-0 rounded-r-xl bg-gradient-to-r from-blue-500/10 to-purple-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
  </button>
</div>

<!-- Overlay для закрытия сайдбара -->
<div id="sidebarOverlay" class="lg:hidden fixed inset-0 bg-black/50 backdrop-blur-sm z-40 opacity-0 invisible transition-all duration-300"></div>


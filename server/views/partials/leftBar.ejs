<%
  // Активный раздел: страницу каталога рендерит catalog.js и передаёт category,
  // на остальных страницах её нет — тогда не подсвечиваем ничего.
  var cat = typeof category !== 'undefined' ? category : '';
  var sections = [
    { key: 'popular',       href: '/streaming',               lng: '83', name: 'Популярное',  lng2: '156', note: 'Самые просматриваемые' },
    { key: 'entertainment', href: '/streaming/entertainment', lng: '84', name: 'Развлечения', lng2: '157', note: 'Игры, музыка, творчество' },
    { key: 'business',      href: '/streaming/business',      lng: '85', name: 'Бизнес',      lng2: '158', note: 'Презентации, обучение' }
  ];
  var online = (subscriptions || []).filter(function (x) { return x.status === 'online'; }).length;
%>
<%# Видимый край панели на узких экранах: кнопка и затемнение под ней. %>
<button class="tk-aside__toggle" id="sidebarToggle" aria-label="Меню" aria-controls="sidebar">
  <span></span><span></span><span></span>
</button>
<div class="tk-aside__overlay invisible opacity-0" id="sidebarOverlay"></div>

<aside class="tk-aside" id="sidebar">
  <div class="tk-aside__title"><span>Разделы</span></div>

  <% sections.forEach(function (item) { %>
  <a href="<%= item.href %>" class="tk-aside__item<%= item.key === cat ? ' tk-aside__item--on' : '' %>">
    <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
      <% if (item.key === 'popular') { %><path d="M12 3l2.6 5.6 6.4.8-4.7 4.4 1.2 6.2L12 17l-5.5 3 1.2-6.2L3 9.4l6.4-.8L12 3Z"></path>
      <% } else if (item.key === 'entertainment') { %><rect x="3" y="6" width="18" height="12"></rect><path d="M8 12h3M9.5 10.5v3M16 11h.01M18 13h.01"></path>
      <% } else { %><rect x="3" y="7" width="18" height="13"></rect><path d="M9 7V4h6v3"></path><% } %>
    </svg>
    <span>
      <span lng="<%= item.lng %>"><%= item.name %></span>
      <span class="tk-aside__sub-state" style="display: block;" lng="<%= item.lng2 %>"><%= item.note %></span>
    </span>
  </a>
  <% }); %>

  <div class="tk-aside__rule"></div>

  <div class="tk-aside__title">
    <span lng="86">Подписки</span>
    <% if (online) { %><span class="tk-aside__count"><%= online %> в эфире</span><% } %>
  </div>

  <% if (subscriptions && subscriptions.length > 0) { %>
    <% subscriptions.forEach(function (sub) { %>
    <a href="/userPage/<%= sub.id %>" class="tk-aside__sub" data-presence-user="<%= sub.id %>">
      <div class="tk-aside__ava"<% if (!sub.avatarStyle.url) { %> data-bg="<%= sub.avatarStyle.gradient %>"<% } %>>
        <% if (sub.avatarStyle.url) { %><img src="<%= sub.avatarStyle.url %>" alt=""><% } else { %><%= sub.avatarStyle.initial %><% } %>
        <span class="presence-dot <%= sub.status === 'online' ? 'presence-online' : 'presence-offline' %>"></span>
      </div>
      <div style="min-width: 0;">
        <p class="tk-aside__sub-name"><%= sub.displayName %></p>
        <p class="tk-aside__sub-state" data-presence-text>
          <% if (sub.status === 'online') { %><span lng="159">онлайн</span><% } else { %><span lng="160">оффлайн</span><% } %>
        </p>
      </div>
    </a>
    <% }); %>
  <% } else { %>
    <div class="tk-aside__empty">
      <span lng="161">Пока нет подписок</span><br>
      <span lng="162">Подпишитесь на интересных стримеров</span>
    </div>
  <% } %>

  <div class="tk-aside__cta">
    <p style="margin: 0 0 4px; font-size: 15px; font-weight: 900; letter-spacing: -.01em; text-transform: uppercase; line-height: 1.15;" lng="87">Откройте свой путь к стримингу!</p>
    <p class="tk-aside__sub-state" style="margin: 0 0 14px;" lng="163">Создайте свой первый стрим</p>
    <button type="button" class="tk-btn tk-btn--ghost tk-btn--sm tk-btn--block" id="startStreamButtonMain" lng="138">Начать стрим</button>
  </div>
</aside>

<script>
// КНОПКА В БАНЕРЕ ОТКРЫТИЯ МОДАЛКИ ЗАПУСКА СТРИМА 
// Получаем элементы
let startStreamButtonMain = document.getElementById('startStreamButtonMain');

// Функция для открытия модалки настроек трансляции
function openStreamSettingsModal() {
    const streamSettingsModal = document.getElementById('streamSettingsModal');
    if (streamSettingsModal) {
        streamSettingsModal.classList.remove('hidden');
    }
}

// Добавляем обработчик события на кнопку "Начать" в блоке призыва к действию
if (startStreamButtonMain) {
    startStreamButtonMain.addEventListener('click', (event) => {
        event.preventDefault();
        openStreamSettingsModal();
    });
}

// УПРАВЛЕНИЕ САЙДБАРОМ
document.addEventListener('DOMContentLoaded', function() {
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('sidebar');
    const sidebarOverlay = document.getElementById('sidebarOverlay');
    
    let isOpen = false;
    
    // Функция для открытия сайдбара
    function openSidebar() {
        if (window.innerWidth >= 1024) return; // Не работает на desktop
        
        isOpen = true;
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        
        sidebarOverlay.classList.remove('invisible', 'opacity-0');
        sidebarOverlay.classList.add('visible', 'opacity-100');
        
        // Скрываем кнопку toggle
        sidebarToggle.style.transform = 'translateY(-50%) translateX(-100%)';
        sidebarToggle.style.opacity = '0';
        
        document.body.style.overflow = 'hidden'; // Предотвращаем скролл
    }
    
    // Функция для закрытия сайдбара
    function closeSidebar() {
        if (window.innerWidth >= 1024) return; // Не работает на desktop
        
        isOpen = false;
        sidebar.classList.remove('translate-x-0');
        sidebar.classList.add('-translate-x-full');
        
        sidebarOverlay.classList.remove('visible', 'opacity-100');
        sidebarOverlay.classList.add('invisible', 'opacity-0');
        
        // Показываем кнопку toggle
        setTimeout(() => {
            sidebarToggle.style.transform = 'translateY(-50%) translateX(0)';
            sidebarToggle.style.opacity = '1';
        }, 300);
        
        document.body.style.overflow = ''; // Восстанавливаем скролл
    }
    
    // Обработчики событий
    if (sidebarToggle) {
        sidebarToggle.addEventListener('click', openSidebar);
    }
    
    if (sidebarOverlay) {
        sidebarOverlay.addEventListener('click', closeSidebar);
    }
    
    // Закрытие по Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && isOpen) {
            closeSidebar();
        }
    });
    
    // Обработка изменения размера окна
    window.addEventListener('resize', function() {
        if (window.innerWidth >= 1024) {
            // На desktop сбрасываем все мобильные стили
            sidebar.classList.remove('-translate-x-full', 'translate-x-0');
            sidebarOverlay.classList.add('invisible', 'opacity-0');
            sidebarToggle.style.transform = 'translateY(-50%) translateX(0)';
            sidebarToggle.style.opacity = '1';
            document.body.style.overflow = '';
            isOpen = false;
        } else if (!isOpen) {
            // На мобильных устройствах скрываем сайдбар если он не открыт
            sidebar.classList.add('-translate-x-full');
            sidebar.classList.remove('translate-x-0');
        }
    });
    
    // Инициализация при загрузке
    if (window.innerWidth < 1024) {
        sidebar.classList.add('-translate-x-full');
    }
});
</script>
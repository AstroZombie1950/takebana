<!-- Мобильная версия (burger menu) уже есть в header -->

<!-- Кастомные стили для скроллбара -->
<style>
.custom-scrollbar::-webkit-scrollbar {
  width: 3px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 2px;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, rgba(102, 107, 207, 0.6), rgba(102, 107, 207, 0.8));
  border-radius: 2px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(135deg, rgba(102, 107, 207, 0.8), rgba(102, 107, 207, 1));
}

/* Стили для кнопки toggle сайдбара */
#sidebarToggle {
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  transform: translateY(-50%);
}

#sidebarToggle:hover {
  transform: translateY(-50%);
}

#sidebarToggle:active {
  transform: translateY(-50%) scale(0.95);
}

/* Адаптация кнопки для разных фонов */
.bg-popular #sidebarToggle,
.bg-entertainment #sidebarToggle,
.bg-business #sidebarToggle {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(16px);
  border-color: rgba(255, 255, 255, 0.25);
}

.bg-popular #sidebarToggle:hover,
.bg-entertainment #sidebarToggle:hover,
.bg-business #sidebarToggle:hover {
  background: rgba(255, 255, 255, 0.25);
  border-color: rgba(255, 255, 255, 0.35);
}

/* Анимация для hamburger иконки */
#sidebarToggle .space-y-0\.5 > div {
  transform-origin: center;
}

#sidebarToggle:hover .space-y-0\.5 > div {
  opacity: 1;
}

/* Стили для overlay */
#sidebarOverlay {
  backdrop-filter: blur(8px);
}

/* Улучшенная тень для сайдбара на мобильных */
@media (max-width: 1023px) {
  #sidebar {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(255, 255, 255, 0.05);
  }
}
</style>

<script>
// КНОПКА В БАНЕРЕ ОТКРЫТИЯ МОДАЛКИ ЗАПУСКА СТРИМА 
// Получаем элементы
let startStreamButtonMain = document.getElementById('startStreamButtonMain');

// Функция для открытия модалки настроек трансляции
function openStreamSettingsModal() {
    const streamSettingsModal = document.getElementById('streamSettingsModal');
    const shodow = document.querySelector('.shodow');
    
    if (streamSettingsModal) {
        streamSettingsModal.classList.remove('hidden');
        const modalContent = streamSettingsModal.querySelector('#streamModalContent');
        if (modalContent) {
            setTimeout(() => {
                modalContent.classList.remove('scale-95', 'opacity-0');
                modalContent.classList.add('scale-100', 'opacity-100');
            }, 10);
        }
    }
    
    if (shodow) {
        shodow.classList.add('display-block');
    }
}

// Добавляем обработчик события на кнопку "Начать" в блоке призыва к действию
if (startStreamButtonMain) {
    startStreamButtonMain.addEventListener('click', (event) => {
        event.preventDefault();
        openStreamSettingsModal();
    });
}

// УПРАВЛЕНИЕ САЙДБАРОМ
document.addEventListener('DOMContentLoaded', function() {
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebar = document.getElementById('sidebar');
    const sidebarOverlay = document.getElementById('sidebarOverlay');
    
    let isOpen = false;
    
    // Функция для открытия сайдбара
    function openSidebar() {
        if (window.innerWidth >= 1024) return; // Не работает на desktop
        
        isOpen = true;
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        
        sidebarOverlay.classList.remove('invisible', 'opacity-0');
        sidebarOverlay.classList.add('visible', 'opacity-100');
        
        // Скрываем кнопку toggle
        sidebarToggle.style.transform = 'translateY(-50%) translateX(-100%)';
        sidebarToggle.style.opacity = '0';
        
        document.body.style.overflow = 'hidden'; // Предотвращаем скролл
    }
    
    // Функция для закрытия сайдбара
    function closeSidebar() {
        if (window.innerWidth >= 1024) return; // Не работает на desktop
        
        isOpen = false;
        sidebar.classList.remove('translate-x-0');
        sidebar.classList.add('-translate-x-full');
        
        sidebarOverlay.classList.remove('visible', 'opacity-100');
        sidebarOverlay.classList.add('invisible', 'opacity-0');
        
        // Показываем кнопку toggle
        setTimeout(() => {
            sidebarToggle.style.transform = 'translateY(-50%) translateX(0)';
            sidebarToggle.style.opacity = '1';
        }, 300);
        
        document.body.style.overflow = ''; // Восстанавливаем скролл
    }
    
    // Обработчики событий
    if (sidebarToggle) {
        sidebarToggle.addEventListener('click', openSidebar);
    }
    
    if (sidebarOverlay) {
        sidebarOverlay.addEventListener('click', closeSidebar);
    }
    
    // Закрытие по Escape
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && isOpen) {
            closeSidebar();
        }
    });
    
    // Обработка изменения размера окна
    window.addEventListener('resize', function() {
        if (window.innerWidth >= 1024) {
            // На desktop сбрасываем все мобильные стили
            sidebar.classList.remove('-translate-x-full', 'translate-x-0');
            sidebarOverlay.classList.add('invisible', 'opacity-0');
            sidebarToggle.style.transform = 'translateY(-50%) translateX(0)';
            sidebarToggle.style.opacity = '1';
            document.body.style.overflow = '';
            isOpen = false;
        } else if (!isOpen) {
            // На мобильных устройствах скрываем сайдбар если он не открыт
            sidebar.classList.add('-translate-x-full');
            sidebar.classList.remove('translate-x-0');
        }
    });
    
    // Инициализация при загрузке
    if (window.innerWidth < 1024) {
        sidebar.classList.add('-translate-x-full');
    }
});
</script>
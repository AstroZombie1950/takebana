<%#
  Шапка сайта — одна на все страницы, у гостя и у вошедшего. Модальные окна
  вынесены в appModals.ejs, поведение — в /tk-app.js.

  Гостю окна (уведомления, звонки, жалоба) и звонки через Daily не нужны:
  они не грузятся. socket.io гостю — только там, где страница просит сама
  (socket: true — эфир: чат и счётчик зрителей).
%>
<% var guest = !currentUser;
   // На самих страницах входа и регистрации те же кнопки в шапке ни к чему:
   // форма прямо под ней.
   var onAuthPage = /^\/(login|register)\b/.test(path); %>
<%# Все внешние скрипты сайта идут с defer: разбор разметки на них не встаёт,
    а порядок выполнения остаётся порядком в документе. Запускаются они до
    DOMContentLoaded, так что обработчики этого события в наших файлах
    срабатывают как прежде. Без defer эта пара блокировала отрисовку
    в самом начале страницы — PageSpeed оценивал её в 430 мс. %>
<script defer src="<%= asset('/escape-html.js') %>"></script>
<script defer src="<%= asset('/toast.js') %>"></script>

<% if (!guest) { %><%- include('appModals') %><% } %>

<%# Шапка: бургер (открывает левую панель), логотип, поиск, «Что такое
    Takebana?», справа — у вошедшего уведомления, переписка и запуск эфира,
    у гостя язык, вход и регистрация. Профиль, выход и остальные ссылки —
    в левой панели (leftBar.ejs). Язык вошедшего — на странице настроек. %>
<header class="tk-ahead<%= guest ? ' tk-ahead--guest' : '' %><%= onAuthPage ? ' tk-ahead--auth' : '' %>">
  <button class="tk-ahead__burger" id="sidebarToggle" aria-label="<%= ta('app.menu') %>" data-i18n-aria="app.menu" aria-controls="sidebar" aria-expanded="false">
    <span></span><span></span>
  </button>

  <a href="/" class="tk-ahead__brand" aria-label="Takebana">
    <img src="/img/logo.svg" alt="Takebana" class="tk-ahead__logo" width="66" height="34" decoding="async">
  </a>

  <%# Обычная форма: Enter и кнопка лупы уводят на страницу результатов
      (/search), а выпадашка с быстрыми результатами — сверху, скриптом
      (на телефоне её нет, там сразу страница). На входе и регистрации
      поиска нет: форма прямо под шапкой, уводить с неё незачем. %>
  <% if (!onAuthPage) { %>
  <form class="tk-ahead__search" action="/search" method="get" role="search">
    <button type="submit" class="tk-ahead__loupe" aria-label="<%= ta('search.submit') %>" data-i18n-aria="search.submit">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
    </button>
    <input type="search" name="q" class="tk-ahead__field" id="searchInput" enterkeyhint="search" placeholder="<%= ta('app.searchPh') %>" data-i18n-placeholder="app.searchPh" autocomplete="off" value="<%= path === '/search' && typeof query !== 'undefined' ? query : '' %>">
    <div class="tk-ahead__results hidden" id="searchResults"></div>
  </form>
  <% } %>

  <div class="tk-ahead__right">
    <%# Заметный вход в «что это за сервис»: не мелкая ссылка в подвале.
        В правой группе, а не за поиском: поиска нет на входе и регистрации,
        и кнопка уезжала к логотипу. Здесь она всегда у правого края —
        слева от языка у гостя и левее колокольчика у вошедшего.
        На самой «О нас» её нет: она вела бы на эту же страницу. %>
    <% if (path !== '/about') { %>
    <a href="/about" class="tk-btn tk-btn--outline tk-btn--sm tk-ahead__about" data-i18n="nav.whatIs"><%- t('nav.whatIs') %></a>
    <% } %>

    <% if (guest) { %>
    <div class="tk-lang tk-ahead__lang">
      <button type="button" class="tk-lang__btn<%= lang === 'ru' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'ru' %>" data-lang="ru">RU</button>
      <button type="button" class="tk-lang__btn<%= lang === 'en' ? ' tk-lang__btn--on' : '' %>" aria-pressed="<%= lang === 'en' %>" data-lang="en">EN</button>
    </div>

    <% if (!onAuthPage) { %>
    <% var back = url && url !== '/' ? '?next=' + encodeURIComponent(url) : ''; %>
    <a href="/login<%= back %>" class="tk-login tk-ahead__login" data-i18n="nav.login"><%- t('nav.login') %></a>
    <a href="/register<%= back %>" class="tk-btn tk-btn--primary tk-btn--sm tk-ahead__signup" data-i18n="nav.signup"><%- t('nav.signup') %></a>
    <% } %>
    <% } else { %>
    <button class="tk-ahead__icon" id="notificationButton" aria-label="<%= ta('app.notifications') %>" data-i18n-aria="app.notifications">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M18 8a6 6 0 10-12 0c0 5-2 6-2 6h16s-2-1-2-6Z"></path><path d="M10 20h4"></path></svg>
      <span class="tk-ahead__dot<%= notifications && notifications.hasUnread ? '' : ' hidden' %>" id="notificationDot"></span>
    </button>

    <%# Счётчик — пропущенные звонки: звонки — вкладка переписки. %>
    <a href="/chatsPage" class="tk-ahead__icon" aria-label="<%= ta('app.chats') %>" data-i18n-aria="app.chats">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M21 11a8 8 0 01-11.5 7.2L4 20l1.8-5.5A8 8 0 1121 11Z"></path></svg>
      <span class="tk-ahead__count<%= missedCalls ? '' : ' hidden' %>" data-missed-calls><%= missedCalls %></span>
    </a>

    <a href="/studio" class="tk-btn tk-btn--primary tk-btn--sm" id="startStreamButtonHeader">
      <span data-i18n="app.startStream"><%- t('app.startStream') %></span>
    </a>
    <% } %>
  </div>
</header>

<%# Ограниченный аккаунт должен понимать, почему у него ничего не отправляется:
    без этой полосы он видел бы только всплывающие отказы на каждое действие. %>
<% if (!guest && currentUser.banned) { %>
<div class="tk-banned" role="status">
  <b data-i18n="app.bannedTitle"><%- t('app.bannedTitle') %></b>
  <span><span data-i18n="app.bannedText"><%- t('app.bannedText') %></span><% if (currentUser.banReason) { %> <span data-i18n="app.bannedReason"><%- t('app.bannedReason') %></span> <%= currentUser.banReason %><% } %></span>
</div>
<% } %>

<%# Единственное, что скрипту нужно от сервера. %>
<script>
  window.TK = {
    userId: <%- JSON.stringify(guest ? '' : String(currentUser._id)) %>,
    // Словари обоих языков: второй tk-i18n.js догружает при переключении.
    dicts: <%- JSON.stringify({ ru: asset('/tk-i18n-ru.js'), en: asset('/tk-i18n-en.js') }) %>
  };
</script>
<%# Словарь языка страницы и переключатель — одни на весь сайт
    (public/tk-i18n.js). Второй язык подгружается при переключении. %>
<script defer src="<%= asset('/tk-i18n-' + lang + '.js') %>"></script>
<script defer src="<%= asset('/tk-i18n.js') %>"></script>
<%# Свой раскрывающийся список у всех <select class="tk-select">: системный
    рисуется мимо дизайна. До скриптов страниц — те заполняют списки уже
    поверх него, и он это видит. %>
<script defer src="<%= asset('/tk-listbox.js') %>"></script>
<% if (!guest || typeof socket !== 'undefined') { %><script defer src="/socket.io/socket.io.js"></script><% } %>
<% if (!guest) { %><script defer src="<%= asset('/tk-daily.js') %>"></script><script defer src="<%= asset('/tk-peer.js') %>"></script><% } %>
<script defer src="<%= asset('/tk-app.js') %>"></script>

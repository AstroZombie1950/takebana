        <button class="text-gray-400 hover:text-gray-600 transition-all duration-200 hover:rotate-90 p-1.5 sm:p-2 rounded-full hover:bg-gray-100" id="closeStreamModal">
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">

          <div class="space-y-4 sm:space-y-5 md:space-y-6">
            <div class="group">
              <label class="block text-sm font-semibold text-gray-700 mb-2 sm:mb-3" for="streamTitle" lng="111">Название трансляции</label>
              <input class="w-full px-3 py-3 sm:px-4 sm:py-3 md:px-5 md:py-4 text-sm border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 group-hover:border-gray-300" type="text" id="streamTitle" placeholder="Введите название трансляции" lng="226">
          </div>
            
            <div class="group">
              <label class="block text-sm font-semibold text-gray-700 mb-2 sm:mb-3" for="streamCategory" lng="112">Категория</label>
              <select id="streamCategory" class="w-full px-3 py-3 sm:px-4 sm:py-3 md:px-5 md:py-4 text-sm border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 group-hover:border-gray-300 appearance-none bg-white">
                  <option value="" lng="113">Выберите категорию</option>
                  <option value="business" lng="85">Бизнес</option>
                  <option value="entertainment" lng="84">Развлечения</option>
              </select>
          </div>
            
            <div class="group">
              <label class="block text-sm font-semibold text-gray-700 mb-2 sm:mb-3" for="streamSubcategory" lng="114">Подкатегория</label>
              <select id="streamSubcategory" class="w-full px-3 py-3 sm:px-4 sm:py-3 md:px-5 md:py-4 text-sm border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 group-hover:border-gray-300 appearance-none bg-white opacity-50" disabled>
                  <option value="" lng="115">Сначала выберите категорию</option>
              </select>
          </div>
            
            <div class="group">
              <label class="block text-sm font-semibold text-gray-700 mb-2 sm:mb-3" for="streamDescription" lng="116">Описание <span class="font-normal text-gray-400">(необязательно)</span></label>
              <textarea id="streamDescription" class="w-full px-3 py-3 sm:px-4 sm:py-3 md:px-5 md:py-4 text-sm border-2 border-gray-200 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 resize-none group-hover:border-gray-300" rows="4" placeholder="Описание трансляции (необязательно)" lng="227"></textarea>
            </div>
          </div>
      <% } else { %>
          <div class="text-center py-8 sm:py-10 md:py-12">
            <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-6 rounded-full flex items-center justify-center" style="background: linear-gradient(135deg, rgba(102, 107, 207, 0.1), rgba(102, 107, 207, 0.2));">
              <svg class="w-8 h-8 sm:w-10 sm:h-10" style="color: rgba(102, 107, 207, 1);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
            </div>
            <p class="text-gray-600 mb-6 text-base sm:text-lg" lng="117">У вас уже есть активный стрим.</p>
            <a href="/stream/<%= currentUser.activeStreamId %>" class="inline-flex items-center px-4 py-2.5 sm:px-5 sm:py-3 rounded-xl font-semibold transition-all duration-300 hover:scale-105 text-sm sm:text-base" style="background: rgba(102, 107, 207, 1); color: white;" lng="118">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
              Перейти к стриму
            </a>
          </div>
      <% } %>
  </div>
      
      <div class="flex gap-3 sm:gap-4 p-4 sm:p-6 md:p-8 border-t border-gray-100">
      <% if (!currentUser.hasActiveStream) { %>
          <button class="flex-1 py-3 px-3 sm:py-3 sm:px-4 md:py-4 md:px-6 rounded-xl font-semibold transition-all duration-300 hover:scale-105 transform hover:shadow-lg text-sm sm:text-base" style="background: linear-gradient(135deg, rgba(102, 107, 207, 1), rgba(102, 107, 207, 0.8)); color: white;" id="startStreamButton">
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
            <span lng="228">Перейти на страницу настроек стрима</span>
          </button>
      <% } else { %>
          <button class="flex-1 bg-red-500 hover:bg-red-600 text-white py-3 px-3 sm:py-3 sm:px-4 md:py-4 md:px-6 rounded-xl font-semibold transition-all duration-300 hover:scale-105 transform hover:shadow-lg text-sm sm:text-base" id="terminateStreamButton">
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span lng="225">Завершить стрим</span>
          </button>
      <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Модалка профиля -->
<div class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden backdrop-blur-sm" id="profileInfoModal">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md md:max-w-2xl lg:max-w-3xl mx-auto transform transition-all duration-300 max-h-[85vh] overflow-y-auto">
      <div class="flex items-center justify-between p-6 border-b border-gray-100">
        <h3 class="text-lg font-bold" style="color: rgba(102, 107, 207, 1);" lng="32">Профиль</h3>
        <button class="text-gray-400 hover:text-gray-600 transition-all duration-200 hover:rotate-90 p-2 rounded-full hover:bg-gray-100" id="closeProfileModal">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
      <div class="p-6 space-y-5">
        <div class="group">
          <label class="block text-sm font-medium text-gray-700 mb-2" lng="180">Ваше имя</label>
          <input id="profileNameInput" class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:ring-2 focus:border-transparent transition-all duration-300 group-hover:border-gray-300 text-sm" type="text" placeholder="Укажите ваше имя" value="<%= currentUser.displayName %>" lng="33">
          <button id="saveNameButton" type="button" class="mt-2 px-4 py-2 text-sm rounded-lg text-white transition-all duration-300 hover:scale-105 transform hover:shadow-lg" style="background: linear-gradient(135deg, rgba(102, 107, 207, 1), rgba(102, 107, 207, 0.8));" lng="181">Сохранить имя</button>
        </div>

        <!-- Аватар пользователя -->
        <div class="mt-2 p-4 border border-gray-100 rounded-xl bg-white">
          <p class="text-sm font-semibold text-gray-900 mb-3" lng="182">Фото профиля</p>
          <div class="flex items-center gap-5">
            <div class="relative">
              <div class="w-20 h-20 rounded-xl overflow-hidden ring-1 ring-gray-200 shadow-sm bg-gray-100 flex items-center justify-center">
                <% if (currentUser.avatarStyle && currentUser.avatarStyle.url) { %>
                <img id="profileAvatarPreview" src="<%= currentUser.avatarStyle.url %>" class="w-full h-full object-cover" alt="avatar"/>
              <% } else { %>
                  <div id="profileAvatarEmpty" class="w-full h-full flex items-center justify-center text-gray-400 text-xs">Нет фото</div>
                  <%# без src: пустой атрибут — это лишний запрос страницы самой к себе. %>
                  <%# Реальный адрес проставляет JS после загрузки аватара. %>
                  <img id="profileAvatarPreview" class="w-full h-full object-cover hidden" alt="avatar"/>
                <% } %>
              </div>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-xs text-gray-500 mb-2">
                <% if (currentUser.avatarStyle && currentUser.avatarStyle.url) { %>
                  <span lng="183">Вы можете заменить изображение</span>
                <% } else { %>
                  <span lng="184">Загрузите изображение PNG/JPG до 5MB</span>
                <% } %>
              </p>
              <div class="flex flex-col gap-2">
                <input id="profileAvatarInput" type="file" accept="image/png,image/jpeg" class="hidden"/>
                <button id="chooseAvatarBtn" type="button" class="px-3 py-2 text-sm rounded-lg bg-white border text-[rgba(102,107,207,1)]" style="border-color: rgba(102,107,207,0.4);" lng="185">Выбрать файл</button>
                <button id="uploadAvatarBtn" type="button" class="px-3 py-2 text-sm rounded-lg text-white disabled:opacity-60 disabled:cursor-not-allowed" style="background: linear-gradient(135deg, rgba(102,107,207,0.7), rgba(102,107,207,0.5));" disabled lng="186">Сохранить фото профиля</button>
              </div>
              <div id="avatarHint" class="text-xs text-gray-500 mt-2" lng="187">PNG/JPG, до 5MB</div>
            </div>
          </div>
        </div>

        <!-- Личная галерея -->
        <div class="mt-3 p-4 border border-gray-100 rounded-xl bg-white">
          <div class="flex items-center justify-between mb-3">
            <p class="text-sm font-semibold text-gray-900" lng="188">Личная галерея</p>
            <div class="text-xs text-gray-500" lng="189">до 100 фото, PNG/JPG до 10MB</div>
          </div>

          <!-- Зона перетаскивания / выбора -->
          <div id="galleryDropzone" class="rounded-xl border-2 border-dashed border-gray-200 hover:border-brand-300 bg-gray-50/60 p-4 cursor-pointer flex items-center justify-center text-center">
            <div>
              <svg class="mx-auto w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V7M3 7l3.5-3.5M3 7h18M21 7L17.5 3.5"/>
              </svg>
              <p class="mt-1 text-xs text-gray-600" lng="190">Перетащите сюда фото или нажмите, чтобы выбрать</p>
            </div>
            <input id="galleryInput" type="file" accept="image/png,image/jpeg" multiple class="hidden" />
          </div>

          <!-- Кнопки -->
          <div class="flex items-center gap-2 mt-3">
            <button id="chooseGalleryBtn" type="button" class="px-3 py-2 text-sm rounded-lg bg-white border text-[rgba(102,107,207,1)]" style="border-color: rgba(102,107,207,0.4);" lng="191">Выбрать фото</button>
            <button id="uploadGalleryBtn" type="button" class="px-3 py-2 text-sm rounded-lg text-white disabled:opacity-60 disabled:cursor-not-allowed" style="background: linear-gradient(135deg, rgba(102,107,207,0.7), rgba(102,107,207,0.5));" disabled><span lng="192">Загрузить</span> (<span id="galleryCount">0</span>)</button>
            <div id="galleryHint" class="text-xs text-gray-500 ml-auto" lng="193">Файлы не выбраны</div>
          </div>

          <!-- Превью -->
          <div id="galleryPreview" class="mt-3 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2"></div>

          <!-- Уже загруженные -->
          <% if (currentUser.gallery && currentUser.gallery.length) { %>
          <div id="galleryPersisted" class="mt-3 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2">
            <% currentUser.gallery.forEach(function(url){
               const name = url.split('/').pop(); %>
              <div class="relative group">
                <img src="<%= url %>" class="w-full h-24 object-cover rounded-lg ring-1 ring-gray-200 shadow-sm"/>
                <button type="button" data-name="<%= name %>" class="absolute top-1 right-1 bg-black/60 hover:bg-black/70 text-white rounded-md p-1 opacity-0 group-hover:opacity-100 transition-opacity">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                </button>
              </div>
            <% }); %>
          </div>
          <% } else { %>
          <div id="galleryPersisted" class="mt-3 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2"></div>
          <% } %>
        </div>

        <div class="space-y-4">
          <button class="flex items-center w-full text-left p-4 border border-gray-200 rounded-lg hover:border-gray-300 transition-all duration-300 group" id="securityToggle">
            <div class="flex items-center">
              <div class="w-8 h-8 rounded-lg mr-3 flex items-center justify-center" style="background: linear-gradient(135deg, rgba(102, 107, 207, 0.1), rgba(102, 107, 207, 0.2));">
                <svg class="w-4 h-4" style="color: rgba(102, 107, 207, 1);" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
                </svg>
              </div>
              <span class="font-medium text-gray-900 text-sm" lng="34">Безопасность</span>
            </div>
          </button>
          
          <div class="hidden space-y-3 transform transition-all duration-300" id="securityFields">
            <input class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:border-transparent transition-all duration-300 text-sm" type="password" placeholder="Старый пароль" id="oldPassword" lng="35">
            <input class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:border-transparent transition-all duration-300 text-sm" type="password" placeholder="Новый пароль" id="newPassword" lng="36">
            <input class="w-full px-4 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:border-transparent transition-all duration-300 text-sm" type="password" placeholder="Подтвердите пароль" id="confirmPassword" lng="37">
            <button id="savePasswordButton" type="button" class="w-full px-4 py-2 text-sm rounded-lg text-white transition-all duration-300 hover:scale-105 transform hover:shadow-lg" style="background: linear-gradient(135deg, rgba(102, 107, 207, 1), rgba(102, 107, 207, 0.8));" lng="197">Сохранить пароль</button>
          </div>
          </div>
        
        <div class="pt-4 border-t border-gray-100">
          <a href="/logout" class="flex items-center justify-center text-red-500 hover:text-red-600 font-medium py-2.5 px-4 rounded-lg hover:bg-red-50 transition-all duration-300 text-sm" lng="38">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
            </svg>
            Выйти из аккаунта
          </a>
        </div>
      </div>
      
      <div class="flex gap-3 p-6 border-t border-gray-100">
        <a href="/userPage/<%= currentUser._id %>" class="flex-1 py-3 px-4 rounded-lg font-medium transition-all duration-300 hover:scale-105 transform hover:shadow-lg text-gray-700 bg-white border border-gray-200 text-sm text-center" lng="198">Открыть профиль</a>
      </div>
     </div>
     </div>
     </div>
   </div>


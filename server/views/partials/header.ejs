<%#
  Шапка кабинета. Модальные окна вынесены в appModals.ejs, поведение —
  в /tk-app.js: инлайн-скрипта в шаблоне больше нет.
%>
<script src="/escape-html.js"></script>
<script src="/toast.js"></script>

<%- include('appModals') %>

<%# Шапка: бургер (ниже 1024 — открывает левую панель), логотип, поиск,
    справа — язык, уведомления, переписка и запуск эфира. Профиль, выход
    и остальные ссылки — в левой панели (leftBar.ejs): раньше то же самое
    дублировалось выпадашкой у аватара и отдельным мобильным меню. %>
<header class="tk-ahead">
  <button class="tk-ahead__burger" id="sidebarToggle" aria-label="<%= ta('app.menu') %>" data-i18n-aria="app.menu" aria-controls="sidebar" aria-expanded="false">
    <span></span><span></span>
  </button>

  <a href="/" class="tk-ahead__brand" aria-label="Takebana">
    <img src="/img/logo.svg" alt="Takebana" class="tk-ahead__logo" width="66" height="34" decoding="async">
  </a>

  <div class="tk-ahead__search">
    <span class="tk-ahead__loupe">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
    </span>
    <input type="text" class="tk-ahead__field" id="searchInput" placeholder="<%= ta('app.searchPh') %>" data-i18n-placeholder="app.searchPh" autocomplete="off">
    <div class="tk-ahead__results hidden" id="searchResults"></div>
  </div>

  <div class="tk-ahead__right">
    <button class="tk-ahead__icon tk-ahead__msearch-btn" id="mobileSearchToggle" aria-label="<%= ta('app.search') %>" data-i18n-aria="app.search">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
    </button>

    <div class="tk-ahead__lang">
      <button class="tk-ahead__lang-btn" id="languageToggle">
        <span><%= lang.toUpperCase() %></span>
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
      </button>
      <div class="tk-ahead__lang-menu hidden" id="languageDropdown">
        <button type="button" data-lang="ru" data-i18n="app.langRu"><%- t('app.langRu') %></button>
        <button type="button" data-lang="en" data-i18n="app.langEn"><%- t('app.langEn') %></button>
      </div>
    </div>

    <button class="tk-ahead__icon" id="notificationButton" aria-label="<%= ta('app.notifications') %>" data-i18n-aria="app.notifications">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M18 8a6 6 0 10-12 0c0 5-2 6-2 6h16s-2-1-2-6Z"></path><path d="M10 20h4"></path></svg>
      <span class="tk-ahead__dot<%= notifications && notifications.hasUnread ? '' : ' hidden' %>" id="notificationDot"></span>
    </button>

    <a href="/chatsPage" class="tk-ahead__icon" aria-label="<%= ta('app.chats') %>" data-i18n-aria="app.chats">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M21 12a8 8 0 01-11.5 7.2L4 21l1.8-5.5A8 8 0 1121 12Z"></path></svg>
    </a>

    <button class="tk-btn tk-btn--primary tk-btn--sm" id="startStreamButtonHeader" data-open-stream>
      <span data-i18n="app.startStream"><%- t('app.startStream') %></span>
    </button>
  </div>
</header>

<%# Ограниченный аккаунт должен понимать, почему у него ничего не отправляется:
    без этой полосы он видел бы только всплывающие отказы на каждое действие. %>
<% if (currentUser.banned) { %>
<div class="tk-banned" role="status">
  <b data-i18n="app.bannedTitle"><%- t('app.bannedTitle') %></b>
  <span><span data-i18n="app.bannedText"><%- t('app.bannedText') %></span><% if (currentUser.banReason) { %> <span data-i18n="app.bannedReason"><%- t('app.bannedReason') %></span> <%= currentUser.banReason %><% } %></span>
</div>
<% } %>

<div class="tk-msearch hidden" id="mobileSearchBar">
  <div class="tk-ahead__search" style="max-width: none;">
    <span class="tk-ahead__loupe">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path></svg>
    </span>
    <input type="text" class="tk-ahead__field" id="mobileSearchField" placeholder="<%= ta('app.searchUsersPh') %>" data-i18n-placeholder="app.searchUsersPh" autocomplete="off">
    <button class="tk-ahead__icon" id="closeMobileSearch" aria-label="<%= ta('app.searchClose') %>" data-i18n-aria="app.searchClose" style="position: absolute; right: 2px; top: 50%; transform: translateY(-50%);">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
    </button>
    <div class="tk-ahead__results hidden" id="mobileSearchFieldResults"></div>
  </div>
</div>

<%# Единственное, что скрипту нужно от сервера. %>
<script>
  window.TK = {
    userId: <%- JSON.stringify(currentUser && currentUser._id ? String(currentUser._id) : '') %>,
    activeStreamId: <%- JSON.stringify(currentUser && currentUser.activeStreamId ? String(currentUser.activeStreamId) : '') %>
  };
</script>
<%# Словарь языка страницы и переключатель — одни на весь сайт
    (public/tk-i18n.js). Второй язык подгружается при переключении. %>
<script src="/tk-i18n-<%= lang %>.js"></script>
<script src="/tk-i18n.js"></script>
<script src="/socket.io/socket.io.js"></script>
<script src="/tk-daily.js"></script>
<script src="/tk-app.js"></script>

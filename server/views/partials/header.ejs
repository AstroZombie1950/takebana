<!-- Глобальные модалки звонков -->
<div id="outgoingCallModal" class="fixed inset-0 hidden items-center justify-center bg-black/60 z-50 p-2 sm:p-4">
  <div class="bg-white rounded-2xl w-full max-w-md sm:max-w-2xl lg:max-w-4xl shadow-2xl overflow-hidden flex flex-col h-[90vh] sm:h-[85vh]">
    <div class="p-4 sm:p-5 border-b border-gray-100 flex items-center justify-between flex-shrink-0">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl bg-gray-100 overflow-hidden flex-shrink-0" id="outgoingAvatar"></div>
        <div class="min-w-0">
          <div class="text-base sm:text-lg font-semibold text-gray-900 truncate" id="outgoingName">Пользователь</div>
          <div class="text-xs sm:text-sm text-gray-500" id="outgoingType">Исходящий звонок...</div>
        </div>
      </div>
      <button class="text-gray-400 hover:text-gray-600 p-2 rounded-lg hover:bg-gray-100 transition-colors flex-shrink-0" id="outgoingCloseBtn">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="p-4 sm:p-5 flex-1 flex flex-col min-h-0">
      <div class="flex items-center justify-center py-3 sm:py-4 flex-shrink-0">
        <div class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
        <div class="ml-2 text-sm sm:text-base text-gray-700 font-medium" id="outgoingStatus">Соединение...</div>
      </div>
      <div class="text-center text-xs sm:text-sm text-gray-500 pb-2 flex-shrink-0">
        <span id="outgoingTimer" class="hidden">00:00</span>

<%#
  Карточка видео во вкладке «Видео» — как у записи эфира: обложка,
  длительность, название, просмотры и дата. Ведёт на /video/:id; ролик,
  который ещё едет или ждёт «Опубликовать», — на страницу загрузки.
  Незаконченное видит только владелец; проценты загрузки и конец
  пережатия ставит public/gallery.js (по data-video-id).
  Параметр: v — видео (utils/gallery.js).
%>
<% var st = v.status; var href = st === 'uploading' || st === 'draft' ? '/upload#v' + v._id : '/video/' + v._id; %>
<a href="<%= href %>" class="tk-recard<%= st !== 'ready' ? ' is-' + st : '' %>" data-video-id="<%= v._id %>">
  <span class="tk-recard__thumb">
    <% if (v.thumb && v.thumb.url) { %><img src="<%= v.thumb.url %>" alt="" loading="lazy" decoding="async"><% } %>
    <% if (st === 'ready') { %>
      <span class="tk-recard__len"><%= clock(v.duration) %></span>
    <% } else if (st === 'uploading') { var pct = v.upload && v.upload.size ? Math.floor(v.upload.received / v.upload.size * 100) : 0; %>
      <span class="tk-recard__state" data-upload-pct data-i18n="user.videoUploading" data-i18n-vars='<%= JSON.stringify({ p: pct }) %>'><%- t('user.videoUploading', { p: pct }) %></span>
    <% } else { var vKey = st === 'draft' ? 'user.videoDraft' : st === 'failed' ? (v.error === 'long' ? 'user.videoLong' : 'user.videoFailed') : 'user.videoProcessing'; %>
      <span class="tk-recard__state" data-i18n="<%= vKey %>"><%- t(vKey) %></span>
    <% } %>
  </span>
  <span class="tk-recard__title"><%= v.title || ta('video.untitled', { date: date(v.createdAt, { day: 'numeric', month: 'long', year: 'numeric' }) }) %></span>
  <span class="tk-recard__date">
    <% if (st === 'ready') { var vv = plural(v.views || 0, 'rec.views'); %><span data-i18n="<%= vv.key %>" data-i18n-vars='<%= JSON.stringify({ n: num(v.views) }) %>'><%= vv.text %></span> · <% } %>
    <time><%= date(v.createdAt, { day: '2-digit', month: '2-digit', year: 'numeric' }) %></time>
  </span>
</a>

<%
  // Общее начало <head>. Заголовок — ключ словаря titleKey (подстановки —
  // titleVars) или готовая строка title: название эфира, админка, документы.
  // Описание — ключ descriptionKey или строка description, необязательно.
  // С ключом заголовок переключается вместе с языком, без перезагрузки.
  var headTitleVars = typeof titleVars !== 'undefined' ? titleVars : undefined;
  var headDescription = typeof descriptionKey !== 'undefined' ? ta(descriptionKey)
                      : typeof description !== 'undefined' ? description : '';
%>
<meta charset="utf-8">
<%# viewport-fit=cover — страница раскладывается во весь экран, включая чёлку
    и полосу системных кнопок; сами отступы под них берёт вёрстка из токенов
    --tk-safe-* (tk.css). Без cover браузер не отдаёт env(safe-area-inset-*),
    и на Android 15 поле ввода переписки наполовину уходило под кнопки.

    interactive-widget=resizes-content — экранная клавиатура ужимает страницу,
    а не наезжает на неё: в переписке поле ввода само встаёт над клавиатурой,
    потому что высота считается от 100dvh. %>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content">

<%# Ошибки браузера — в тот же журнал, что серверные (routes/clientErrors.js).
    Инлайном и первым: отдельный файл с defer выполнился бы позже инлайновых
    скриптов страниц и их ошибок не увидел бы, а без defer он блокировал бы
    разбор разметки на каждой странице сайта. Пять сообщений на загрузку,
    повторы не шлём: сломанный цикл иначе завалит маршрут за секунды. %>
<script>
(function () {
  var sent = 0, seen = {};
  function send(d) {
    var key = (d.message || '') + '|' + (d.line || '');
    if (sent >= 5 || seen[key]) return;
    seen[key] = 1; sent++;
    try {
      var body = JSON.stringify({
        page: location.pathname, name: d.name, message: d.message,
        stack: d.stack, source: d.source, line: d.line, column: d.column
      });
      if (navigator.sendBeacon) navigator.sendBeacon('/api/client-error', new Blob([body], { type: 'application/json' }));
      else fetch('/api/client-error', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true });
    } catch (e) {}
  }
  window.addEventListener('error', function (e) {
    if (!e || !e.message) return;
    // «Script error.» без файла — ошибка чужого скрипта (расширение браузера,
    // встроенный браузер почты): подробности браузер прячет, наши файлы все
    // с этого же домена. Чинить в ней нечего, а журнал она засоряет.
    if (/^Script error\.?$/.test(e.message) && !e.filename) return;
    send({ name: e.error && e.error.name, message: e.message, stack: e.error && e.error.stack,
           source: e.filename, line: e.lineno, column: e.colno });
  });

  // Не загрузился файл: картинка, скрипт, стиль, видео. Такое событие не
  // всплывает — ловим на погружении, и у него нет message, поэтому обработчик
  // выше его пропускал, а мы не знали ни об одной битой картинке.
  //
  // Это единственный способ увидеть со стороны, что у человека не открывается
  // наш CDN: заблокированный или недоступный хост даёт ровно такую тишину —
  // пустые рамки вместо аватаров и обложек и ни одной ошибки в консоли.
  // Пишем хост, а не полный адрес: важно, чей он, а не какой именно файл.
  var hosts = {};
  window.addEventListener('error', function (e) {
    var el = e && e.target;
    if (!el || el === window || !el.tagName) return;
    var tag = el.tagName.toLowerCase();
    if (['img', 'script', 'link', 'video', 'audio', 'source'].indexOf(tag) === -1) return;
    var url = el.src || el.href || '';
    if (!url) return;
    var host;
    try { host = new URL(url, location.href).host; } catch (err) { host = '?'; }
    // По одному сообщению на хост: если отвалился CDN, битых картинок
    // на странице десятки, а поломка одна.
    if (hosts[tag + host]) return;
    hosts[tag + host] = 1;
    send({ name: 'ResourceError', message: 'не загрузился ' + tag + ' с ' + host, source: url });
  }, true);
  window.addEventListener('unhandledrejection', function (e) {
    var r = (e && e.reason) || {};
    send({ name: r.name || 'UnhandledRejection', message: r.message || String(r), stack: r.stack });
  });
})();
</script>
<% if (typeof titleKey !== 'undefined') { %>
<title data-i18n="<%= titleKey %>"<% if (headTitleVars) { %> data-i18n-vars="<%= JSON.stringify(headTitleVars) %>"<% } %>><%= ta(titleKey, headTitleVars) %></title>
<% } else { %>
<title><%= title %></title>
<% } %>
<% if (headDescription) { %>
<meta name="description" content="<%= headDescription %>">
<% } %>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<%# Сайт на домашнем экране телефона. Манифест даёт Android иконку, имя
    и запуск без адресной строки и предлагает «Установить приложение»;
    apple-touch-icon и две meta — то же самое для «На экран Домой» на айфоне,
    манифест Safari почти не читает. Значки — public/img/app (сделаны из
    favicon.svg), сам запуск и поведение без сети — public/sw.js. %>
<link rel="manifest" href="/manifest.webmanifest">
<meta name="theme-color" content="#0A0A0A">
<link rel="apple-touch-icon" href="/img/app/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Takebana">
<%# Чей это канал и какой у зрителя доступ к нему — для живого ограничения
    (utils/profileSignal.js, access:changed в tk-app.js). scope: profile —
    страница человека, важны обе стороны; content — эфир и запись, важно
    только ограничение зрителя. %>
<% if (locals.pageOwner) { %><meta name="tk-owner" content="<%= pageOwner.id %>" data-access="<%= pageOwner.access || '' %>" data-scope="<%= pageOwner.scope %>"><% } %>

<%# Шрифты первого экрана. Без preload браузер находит их только после
    разбора tk.css — PageSpeed показывал цепочку «страница → tk.css → шрифт»
    длиной 592 мс, и заголовок успевал моргнуть системным.

    Латиница нужна всегда, на любом языке: в её диапазон (U+0000–00FF) попадают
    пробел, цифры и знаки препинания. Кириллица — только на русской странице;
    английской она если и понадобится, то под чужим именем или названием
    эфира, и браузер догрузит её сам. %>
<link rel="preload" as="font" type="font/woff2" href="/fonts/golos-text-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/fonts/oswald-latin.woff2" crossorigin>
<% if (lang === 'ru') { %>
<link rel="preload" as="font" type="font/woff2" href="/fonts/golos-text-cyrillic.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/fonts/oswald-cyrillic.woff2" crossorigin>
<% } %>

<link rel="stylesheet" href="<%= asset('/css/tk.css') %>">

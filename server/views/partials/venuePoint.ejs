<%#
  Точка заведения на карте: общий блок для заявки (/company-register)
  и настроек владельца (/main). Поведение — public/tk-point.js, метка
  и карта — public/tk-map.js, стили — public/css/tk-map.css.

  Координаты заведения раньше ставила только админка, а владельцу поля
  не показывали вовсе: заведение оставалось без точки и на карту не попадало.
  Широта с долготой в форме — не вариант, их никто не знает; поэтому метка
  и поиск по адресу, который написан в поле выше.
%>
<div class="tk-pick" data-point>
  <div class="tk-pick__head">
    <span class="tk-form__label" data-i18n="venue.point.label"><%- t('venue.point.label') %></span>
  </div>

  <%# Поле адреса — здесь, а не в панели выше. Кнопка «Найти» ищет по тому,
      что в нём написано, но пока поле стояло в другом блоке, связи между ними
      не было видно: человек ставил метку, получал подставленный адрес и не
      догадывался, что адрес можно вписать руками и подвинуть метку. %>
  <div class="tk-pick__addr">
    <label class="tk-form__label" for="venueAddress" data-i18n="venues.address"><%- t('venues.address') %></label>
    <div class="tk-pick__addr-line">
      <input id="venueAddress" class="tk-field" type="text" name="address" maxlength="300"
             placeholder="<%= ta('company.ph.address') %>" data-i18n-placeholder="company.ph.address"
             autocomplete="street-address"<% if (typeof addressRequired !== 'undefined' && addressRequired) { %> required<% } %>>
      <button type="button" class="tk-btn tk-btn--outline tk-btn--sm" data-point-find data-i18n="venue.point.find"><%- t('venue.point.find') %></button>
    </div>
  </div>

  <div class="tk-pick__map" data-point-map></div>

  <p class="tk-pick__note" data-point-note data-i18n="venue.point.hint"><%- t('venue.point.hint') %></p>

  <div class="tk-pick__found" data-point-found hidden>
    <span class="tk-pick__address" data-point-address></span>
    <button type="button" class="tk-btn tk-btn--ghost tk-btn--xs" data-point-apply data-i18n="venue.point.apply"><%- t('venue.point.apply') %></button>
  </div>

  <%# Скрытые поля, а не отдельная переменная в скрипте: обе формы собирают
      тело запроса из своих полей, и точка попадает туда сама. %>
  <input type="hidden" name="lat" data-point-lat>
  <input type="hidden" name="lng" data-point-lng>
</div>

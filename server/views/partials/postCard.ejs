<%#
  Пост «Ленты» (/feed, 04.10.2026): фото или видео человека — как в Инстаграме.
  Шапка — автор и дата, ниже снимок или обложка ролика (ведут на его
  страницу), под ним название у видео и подпись.
  С 05.10 (решение Ивана) действия — прямо в ленте: «нравится», разговор,
  «Поделиться» сообщением, жалоба (красным флажком у правого края, 06.10),
  последние комментарии с ответом и удалением и поле ответа, — страницу
  публикации открывать не нужно. На широком экране
  снимок слева, всё остальное колонкой справа (css/feed.css). Поведение —
  public/tk-posts.js, «Поделиться» — tk-share.js, жалоба — report.js.
  Подписи и alt — по правилу «текст что-то говорит» (utils/snippet.js,
  docs/seo DECISIONS 04.10). Первые снимки экрана грузятся сразу и первыми —
  imgLoad (utils/i18n.js).
  С 09.10 — и пост (models/Post.js): текст, фото и видео. Одно медиа — как
  фото или видео; несколько — карусель, листается пальцем и стрелками
  (tk-posts.js), со счётчиком; без медиа — сам текст на месте снимка.
  Тема — ссылкой на «Ленту» по ней. С 09.10 длинный текст разворачивается
  на месте («Ещё», tk-posts.js), у карусели — точки под кадром. Пост в работе (ролики пережимаются)
  видит только автор — с пометкой.
  Параметры: item — из utils/feed.js (card + withTalk); me — id смотрящего
  или пусто.
%>
<% var isPhoto = item.kind === 'photo', isPost = item.kind === 'post';
   var when = date(item.at, { day: 'numeric', month: 'long', year: 'numeric' });
   var name = isPhoto || isPost ? '' : mediaTitle(item.title, 'video', item.author.displayName, item.at);
   var said = meaningful(item.text);
   // Медиа карусели: у поста — его фото и видео, у пачки фото (загружены
   // разом, utils/feed.js) — её фото; одно фото — как раньше, без карусели.
   var media = item.media || [];
   // Текст поста; длинный — началом, «Ещё» разворачивает его на месте
   // (tk-posts.js). Пост без медиа показывает больше.
   var limit = media.length ? 220 : 700;
   var full = isPost && said ? item.text.trim() : '';
   var cut = full.length > limit;
   var short = cut ? snippet(full, limit) : full;
   var alt = isPhoto || isPost ? (said ? snippet(item.text, 125) : ta('alt.photoBy', { name: item.author.displayName, date: when }))
                     : ta('alt.cover', { title: name });
   // Вход — с возвратом туда, где пост увидели: «Лента» или профиль.
   var login = '/login?next=' + encodeURIComponent(url);
   var likeKey = me ? 'photo.like' : 'rec.loginToRate';
   var topicKey = isPost && item.topic ? topicI18n(item.topic) : '';
   // Название для «Поделиться» и жалобы: у поста — начало текста.
   var shareTitle = isPhoto || isPost ? (said ? snippet(item.text, 140) : '') : name;
   var shareImage = isPost ? (media[0] ? media[0].url : '') : item.thumb; %>
<article class="tk-post<%= isPost && !media.length ? ' tk-post--text' : '' %>" data-post="<%= item.href %>">
  <a href="<%= item.author.url %>" class="tk-post__head">
    <span class="tk-post__ava"<% if (!item.author.avatarStyle.url) { %> data-bg="<%= item.author.avatarStyle.gradient %>"<% } %>>
      <% if (item.author.avatarStyle.url) { %><img src="<%= item.author.avatarStyle.url %>" alt="" width="36" height="36" loading="lazy" decoding="async"><% } else { %><%= item.author.avatarStyle.initial %><% } %>
    </span>
    <span class="tk-post__who"><%= item.author.displayName %></span>
    <time class="tk-post__when" datetime="<%= new Date(item.at).toISOString() %>"><%= when %></time>
  </a>

  <% if (isPost && !media.length && cut) { %>
  <%# Пост без фото и видео — текст на месте снимка, крупно; длинный —
      с «Ещё», которое разворачивает его здесь же. %>
  <div class="tk-post__media tk-post__media--text tk-post__media--long" data-more-box><p class="tk-post__big"><span data-user-content data-more-text><%= short %></span></p><a href="<%= item.href %>" class="tk-post__more" data-more data-i18n="rec.more"><%- t('rec.more') %></a></div>
  <% } else if (isPost && !media.length) { %>
  <a href="<%= item.href %>" class="tk-post__media tk-post__media--text"><p class="tk-post__big" data-user-content><%= full %></p></a>
  <% } else if (isPost || media.length > 1) { %>
  <div class="tk-post__media tk-post__media--photo<%= media.length > 1 ? ' tk-post__media--set' : '' %>" data-slides>
    <div class="tk-post__track">
      <% media.forEach(function (m, i) { var href = isPost && m.kind === 'photo' ? item.href : m.href;
         var mAlt = !isPost && meaningful(m.text) ? snippet(m.text, 125) : alt; %>
      <a href="<%= href %>" class="tk-post__slide tk-post__slide--<%= m.kind %>"<% if (media.length > 1) { %> aria-label="<%= ta('post.slide', { n: i + 1, total: media.length }) %>"<% } %>>
        <% if (m.url) { %><img src="<%= m.url %>" alt="<%= m.kind === 'photo' ? mAlt : ta('alt.cover', { title: alt }) %>" decoding="async"<% if (m.w && m.h) { %> width="<%= m.w %>" height="<%= m.h %>"<% } %> <%- i ? 'loading="lazy"' : imgLoad() %>><% } %>
        <% if (m.kind === 'video') { %>
        <% if (m.ready) { %><span class="tk-post__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg></span>
        <% if (m.duration) { %><span class="tk-post__len"><%= clock(m.duration) %></span><% } %>
        <% } else { %><span class="tk-post__wait" data-i18n="post.processing"><%- t('post.processing') %></span><% } %>
        <% } %>
      </a>
      <% }); %>
    </div>
    <% if (media.length > 1) { %>
    <button type="button" class="tk-post__nav tk-post__nav--prev" data-slide="-1" aria-label="<%= ta('user.photoPrev') %>" data-i18n-aria="user.photoPrev" hidden><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg></button>
    <button type="button" class="tk-post__nav tk-post__nav--next" data-slide="1" aria-label="<%= ta('user.photoNext') %>" data-i18n-aria="user.photoNext"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg></button>
    <span class="tk-post__count" data-slide-n>1 / <%= media.length %></span>
    <span class="tk-post__dots" aria-hidden="true"><% media.forEach(function (m, i) { %><i<%- i ? '' : ' class="is-on"' %>></i><% }); %></span>
    <% } %>
  </div>
  <% } else { %>
  <a href="<%= item.href %>" class="tk-post__media tk-post__media--<%= isPhoto ? 'photo' : 'video' %>">
    <% if (item.thumb) { %><img src="<%= item.thumb %>" alt="<%= alt %>" decoding="async" <%- imgLoad() %>><% } %>
    <% if (!isPhoto) { %>
    <span class="tk-post__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg></span>
    <% if (item.duration) { %><span class="tk-post__len"><%= clock(item.duration) %></span><% } %>
    <% } %>
  </a>
  <% } %>

  <div class="tk-post__side">
    <% if (isPost ? (topicKey || item.processing || (said && media.length)) : (!isPhoto || said)) { %>
    <div class="tk-post__body">
      <% if (!isPhoto && !isPost) { %><h2 class="tk-post__title"><a href="<%= item.href %>"><%= name %></a></h2><% } %>
      <% if (item.processing) { %><p class="tk-post__note" data-i18n="post.processingNote"><%- t('post.processingNote') %></p><% } %>
      <% if (isPost && said && media.length) { %><p class="tk-post__text" data-more-box><span data-user-content data-more-text><%= short %></span><% if (cut) { %> <a href="<%= item.href %>" class="tk-post__more" data-more data-i18n="rec.more"><%- t('rec.more') %></a><% } %></p>
      <% } else if (said && !isPost) { %><p class="tk-post__text" data-user-content><%= snippet(item.text, 220) %></p><% } %>
      <% if (topicKey) { %><a href="/feed?t=<%= item.topic %>" class="tk-post__topic" data-i18n="<%= topicKey %>"><%- t(topicKey) %></a><% } %>
    </div>
    <% } %>

    <div class="tk-post__acts">
      <%# «Нравится» — сердечком; гостю — ссылка на вход с возвратом в ленту. %>
      <<%- me ? 'button type="button"' : 'a' %> class="tk-post__act"<% if (me) { %> data-like aria-pressed="<%= !!item.liked %>"<% } else { %> href="<%= login %>"<% } %> aria-label="<%= ta(likeKey) %>" data-i18n-aria="<%= likeKey %>" title="<%= ta(likeKey) %>" data-i18n-title="<%= likeKey %>">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5l-1.4-1.3C5.4 14.5 2 11.4 2 7.6 2 4.5 4.4 2 7.5 2c1.7 0 3.4.8 4.5 2.1C13.1 2.8 14.8 2 16.5 2 19.6 2 22 4.5 22 7.6c0 3.8-3.4 6.9-8.6 11.6z"/></svg>
        <span class="tk-post__num" data-likes><%= num(item.likes) %></span>
      </<%- me ? 'button' : 'a' %>>
      <a class="tk-post__act" href="<%= item.href %>#comments" aria-label="<%= ta('rec.commentPh') %>" data-i18n-aria="rec.commentPh">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 4.5h17v12h-11l-6 4z"/></svg>
        <span class="tk-post__num" data-comments><%= num(item.comments) %></span>
      </a>
      <%- include('shareReport', { cls: 'tk-post__act', report: !!me && me !== item.ownerId,
            s: { kind: item.kind, id: item._id, title: shareTitle, image: shareImage, author: item.author.displayName, reportName: isPhoto || isPost ? item.author.displayName : name } }) %>
      <% if (!isPhoto && !isPost) { var vv = plural(item.views, 'rec.views'); %>
      <span class="tk-post__views" data-i18n="<%= vv.key %>" data-i18n-vars='<%= JSON.stringify({ n: num(item.views) }) %>'><%= vv.text %></span>
      <% } %>
    </div>

    <%# Разговор (правки 06.10): у каждого комментария — ответить и удалить
        значками. Телефон показывает два последних и ссылку на все — разговор
        целиком на странице публикации; широкий экран — все пришедшие,
        с прокруткой внутри колонки (css/feed.css). Поле — в рамке,
        стрелка отправки внутри неё и только когда есть текст. %>
    <div class="tk-post__talk">
      <% var talk = item.talk || []; if (item.comments > 2) { var all = plural(item.comments, 'rec.comments'); %>
      <a class="tk-post__all<%= item.comments > talk.length ? ' tk-post__all--more' : '' %>" href="<%= item.href %>#comments" data-i18n="<%= all.key %>" data-i18n-vars='<%= JSON.stringify({ n: num(item.comments) }) %>'><%= all.text %></a>
      <% } %>
      <ul class="tk-post__said" data-said>
        <% talk.forEach(function (c) { %>
        <li class="tk-post__c" data-cid="<%= c._id %>">
          <p class="tk-post__c-text"><a href="<%= c.url %>" class="tk-post__said-who"><%= c.name %></a> <span data-user-content><%= snippet(c.text, 200) %></span></p>
          <% if (me && !c.mine) { %><button type="button" class="tk-post__c-btn" data-reply="<%= c.nick || c.name %>" aria-label="<%= ta('chats.reply') %>" data-i18n-aria="chats.reply" title="<%= ta('chats.reply') %>" data-i18n-title="chats.reply"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M9 7L4 12l5 5M4 12h11a5 5 0 015 5v2"/></svg></button><% } %>
          <% if (c.canDelete) { %><button type="button" class="tk-post__c-btn" data-cdel aria-label="<%= ta('common.delete') %>" data-i18n-aria="common.delete" title="<%= ta('common.delete') %>" data-i18n-title="common.delete"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg></button><% } %>
        </li>
        <% }); %>
      </ul>
      <% if (me) { %>
      <form class="tk-post__say" data-say>
        <input type="text" name="text" class="tk-post__input" maxlength="2000" autocomplete="off" enterkeyhint="send" required
               placeholder="<%= ta('rec.commentPh') %>" data-i18n-placeholder="rec.commentPh" aria-label="<%= ta('rec.commentPh') %>" data-i18n-aria="rec.commentPh">
        <button type="submit" class="tk-post__send" aria-label="<%= ta('share.send') %>" data-i18n-aria="share.send" title="<%= ta('share.send') %>" data-i18n-title="share.send">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l16-8-6 16-2.5-6.5z"/></svg>
        </button>
      </form>
      <% } else { %>
      <a class="tk-post__all" href="<%= login %>" data-i18n="rec.commentLogin"><%- t('rec.commentLogin') %></a>
      <% } %>
    </div>
  </div>
</article>

<%# Подвал и нижняя полоса. Почта, телеграм и соцсети — из config/contacts.js:
    пустой адрес — пункта нет, нет ни одной соцсети — нет и колонки. %>
<%
  var socialIcons = {
    instagram: ['Instagram', '<rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><path d="M17.5 6.5h.01"></path>'],
    youtube: ['YouTube', '<rect x="2" y="5" width="20" height="14"></rect><path d="M11 9l4 3-4 3V9Z"></path>'],
    tiktok: ['TikTok', '<path d="M14 3v12a4 4 0 1 1-4-4"></path><path d="M14 3c.4 2.8 2.3 4.7 5 5"></path>']
  };
  var socials = Object.keys(socialIcons).filter(function (k) { return contacts.social[k]; });
%>
<footer class="tk-footer<%= socials.length ? '' : ' tk-footer--nosocial' %>">
  <div class="tk-footer__brand">
    <a href="/" class="tk-footer__home" aria-label="Takebana">
      <%- include('logo', { cls: 'tk-footer__logo', w: 93, h: 48 }) %>
    </a>
    <span class="tk-footer__tagline" data-i18n="foot.tagline"><%- t('foot.tagline') %></span>
  </div>

  <div class="tk-footer__col">
    <span class="tk-footer__title" data-i18n="foot.col1.title"><%- t('foot.col1.title') %></span>
    <a href="/about" class="tk-flink" data-i18n="foot.about"><%- t('foot.about') %></a>
    <a href="/terms" class="tk-flink" data-i18n="foot.terms"><%- t('foot.terms') %></a>
    <a href="/privacy" class="tk-flink" data-i18n="foot.privacy"><%- t('foot.privacy') %></a>
    <a href="/cookies" class="tk-flink" data-i18n="foot.cookies"><%- t('foot.cookies') %></a>
  </div>

  <div class="tk-footer__col">
    <span class="tk-footer__title" data-i18n="foot.col2.title"><%- t('foot.col2.title') %></span>
    <a href="mailto:<%= contacts.email %>" class="tk-flink"><%= contacts.email %></a>
    <% if (contacts.telegram) { %><a href="<%= contacts.telegram %>" class="tk-flink" rel="noopener">@<%= contacts.telegram.replace(/^https?:\/\/t\.me\//, '') %></a><% } %>
  </div>

  <% if (socials.length) { %>
  <div class="tk-footer__col">
    <span class="tk-footer__title" data-i18n="foot.col3.title"><%- t('foot.col3.title') %></span>
    <div class="tk-footer__socials">
      <% socials.forEach(function (k) { %>
      <a href="<%= contacts.social[k] %>" class="tk-social" rel="noopener" aria-label="<%= socialIcons[k][0] %>"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><%- socialIcons[k][1] %></svg></a>
      <% }); %>
    </div>
  </div>
  <% } %>
</footer>

<div class="tk-copy">
  <span data-i18n="foot.copy"><%- t('foot.copy') %></span>
  <div class="tk-copy__gap"></div>
  <span class="tk-hide-sm">takebana.com</span>
</div>

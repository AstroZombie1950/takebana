<%# Подвал и нижняя полоса. Адреса соцсетей и телеграма заказчик ещё не дал —
    оставлены заглушками, как в ТЗ главной. %>
<footer class="tk-footer">
  <div class="tk-footer__brand">
    <img src="/img/logo.webp" alt="Takebana" class="tk-footer__logo"
         width="77" height="48" decoding="async" loading="lazy">
    <span class="tk-footer__tagline" data-i18n="foot.tagline"><%- t('foot.tagline') %></span>
  </div>

  <div class="tk-footer__col">
    <span class="tk-footer__title" data-i18n="foot.col1.title"><%- t('foot.col1.title') %></span>
    <a href="/about" class="tk-flink" data-i18n="foot.about"><%- t('foot.about') %></a>
    <a href="/terms_of_service" class="tk-flink" data-i18n="foot.rules"><%- t('foot.rules') %></a>
    <a href="/personal_data_processing" class="tk-flink" data-i18n="foot.privacy"><%- t('foot.privacy') %></a>
  </div>

  <div class="tk-footer__col">
    <span class="tk-footer__title" data-i18n="foot.col2.title"><%- t('foot.col2.title') %></span>
    <a href="mailto:help@takebana.com" class="tk-flink">help@takebana.com</a>
    <a href="#" class="tk-flink">@takebana</a>
  </div>

  <div class="tk-footer__col">
    <span class="tk-footer__title" data-i18n="foot.col3.title"><%- t('foot.col3.title') %></span>
    <div class="tk-footer__socials">
      <a href="#" class="tk-social" aria-label="Telegram"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#C9C2B7" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M22 3 2 11l6 2 2 7 4-5 5 4 3-16Z"></path><path d="M8 13l9-7-5 9"></path></svg></a>
      <a href="#" class="tk-social" aria-label="VK"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#C9C2B7" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M3 6h3c.6 4.4 2.6 7.4 5 8V6h3v5l5-5h3l-5 6 5 6h-3.4L14 13v5h-2.6C7 17.4 3.6 12.6 3 6Z"></path></svg></a>
      <a href="#" class="tk-social" aria-label="YouTube"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#C9C2B7" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><rect x="2" y="5" width="20" height="14"></rect><path d="M11 9l4 3-4 3V9Z"></path></svg></a>
    </div>
  </div>
</footer>

<div class="tk-copy">
  <span data-i18n="foot.copy"><%- t('foot.copy') %></span>
  <div class="tk-copy__gap"></div>
  <span class="tk-hide-sm">takebana.com</span>
</div>

<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.register.title', descriptionKey: 'page.register.description' }) %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/auth.css">
</head>
<body class="tk-app tk-app--wide">

<%- include('partials/header') %>
<%- include('partials/leftBar') %>

<div class="tk-shell">

<main class="tk-auth">
  <div class="tk-auth__card">
    <a href="/" class="tk-auth__back">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 5l-7 7 7 7M4 12h16"></path></svg>
      <span data-i18n="auth.back"><%- t('auth.back') %></span>
    </a>

    <span class="tk-auth__kicker" data-i18n="auth.kicker"><%- t('auth.kicker') %></span>
    <h1 class="tk-auth__h1" data-i18n="auth.register.h1"><%- t('auth.register.h1') %></h1>

    <% if (googleOAuthConfigured) { %>
    <a href="/auth/google" class="tk-btn tk-btn--ghost tk-btn--block tk-auth__google">
      <img src="/img/google.svg" alt="" aria-hidden="true" width="20" height="20">
      <span data-i18n="auth.google"><%- t('auth.google') %></span>
    </a>
    <span class="tk-auth__or" data-i18n="auth.or"><%- t('auth.or') %></span>
    <% } %>

    <form class="tk-auth__form" id="tkRegisterForm" novalidate>
      <input class="tk-field" type="email" id="email" name="email" placeholder="<%= ta('auth.ph.email') %>" data-i18n-placeholder="auth.ph.email" autocomplete="email" required>

      <div class="tk-field-wrap">
        <input class="tk-field" type="password" id="password" name="password" placeholder="<%= ta('auth.ph.password') %>" data-i18n-placeholder="auth.ph.password" autocomplete="new-password" required>
        <button type="button" class="tk-field-eye" data-eye aria-label="<%= ta('auth.showPassword') %>" data-i18n-aria="auth.showPassword">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </button>
      </div>

      <div class="tk-field-wrap">
        <input class="tk-field" type="password" id="confirmPassword" name="confirmPassword" placeholder="<%= ta('auth.ph.password2') %>" data-i18n-placeholder="auth.ph.password2" autocomplete="new-password" required>
        <button type="button" class="tk-field-eye" data-eye aria-label="<%= ta('auth.showPassword') %>" data-i18n-aria="auth.showPassword">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7Z"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </button>
      </div>

      <button class="tk-btn tk-btn--primary tk-btn--block tk-auth__submit" type="submit" data-i18n="auth.submit.register"><%- t('auth.submit.register') %></button>
    </form>

    <%# Ссылки вели на «/» — в приложении обе страницы есть, подставлены их адреса. %>
    <p class="tk-auth__note" data-i18n="auth.policy"><%- t('auth.policy') %></p>
    <p class="tk-auth__row" data-i18n="auth.haveAccount"><%- t('auth.haveAccount') %></p>
  </div>
</main>

<%- include('partials/tkFooter') %>
</div>

<script defer src="/tk-auth.js"></script>
</body>
</html>

<%#
  Вся галерея человека: /userPage/:id/gallery?page=N. Фото и видео одной
  лентой, новые сверху (utils/gallery.js), по странице — маршрут в
  routes/streaming/catalog.js. Плитка — partials/galleryTile.ejs, вид —
  css/gallery.css, поведение (крестик владельца, ролики в работе, просмотр
  фото) — public/gallery.js, общий с профилем.
%>
<%
  var base = '/userPage/' + owner._id;
  var pageHref = function (p) { return base + '/gallery' + (p > 1 ? '?page=' + p : ''); };
  // Номера вокруг текущей, первая и последняя всегда; пропуски — «…».
  var nums = [];
  for (var p = 1; p <= pages; p++) {
    if (p === 1 || p === pages || Math.abs(p - page) <= 2) nums.push(p);
    else if (nums[nums.length - 1] !== 0) nums.push(0);
  }
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.gallery.title', titleVars: { name: owner.displayName } }) %>
<% if (page > 1) { %><link rel="prev" href="<%= pageHref(page - 1) %>"><% } %>
<% if (page < pages) { %><link rel="next" href="<%= pageHref(page + 1) %>"><% } %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/profile.css') %>">
<link rel="stylesheet" href="<%= asset('/css/gallery.css') %>">
<link rel="stylesheet" href="<%= asset('/css/lightbox.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-gal" id="gallery"<% if (isSelf) { %> data-own<% } %>>

      <a href="<%= base %>" class="tk-page__back">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        <span data-i18n="user.backToProfile"><%- t('user.backToProfile') %></span>
      </a>

      <p class="tk-kicker" data-i18n="user.gallery"><%- t('user.gallery') %></p>
      <div class="tk-gal__head">
        <%# Имя — отдельным узлом с экранированием, как на странице подписчиков. %>
        <h1 class="tk-gal__h1"><%= owner.displayName %></h1>
        <span class="tk-note" id="galleryCount"><%= count %></span>
        <% if (isSelf) { %>
        <a href="/upload" class="tk-btn tk-btn--outline tk-btn--sm tk-gal__add" data-i18n="user.galleryAdd"><%- t('user.galleryAdd') %></a>
        <% } %>
      </div>

      <% if (restricted) { %>
      <section class="tk-panel--prof">
        <div class="tk-prof__none">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M6 6l12 12"></path></svg>
          <p data-i18n="restricted.text"><%- t('restricted.text') %></p>
        </div>
      </section>
      <% } else { %>
      <div class="tk-shots tk-shots--wide" id="galleryShots">
        <% shots.forEach(function (item, i) { %><%- include('partials/galleryTile', { item: item, n: offset + i + 1, isSelf: isSelf }) %><% }); %>
      </div>
      <p class="tk-note tk-note--center" id="galleryEmpty" data-i18n="user.galleryEmpty"<% if (shots.length) { %> hidden<% } %>><%- t('user.galleryEmpty') %></p>

      <% if (pages > 1) { %>
      <nav class="tk-pager" aria-label="<%= ta('gallery.pages') %>" data-i18n-aria="gallery.pages">
        <% if (page > 1) { %><a href="<%= pageHref(page - 1) %>" class="tk-btn tk-btn--outline tk-btn--sm" rel="prev" data-i18n="user.listPrev"><%- t('user.listPrev') %></a><% } %>
        <% nums.forEach(function (p) { %>
          <% if (!p) { %><span class="tk-pager__num tk-pager__gap" aria-hidden="true">…</span>
          <% } else if (p === page) { %><span class="tk-pager__num" aria-current="page"><%= p %></span>
          <% } else { %><a href="<%= pageHref(p) %>" class="tk-pager__num"><%= p %></a><% } %>
        <% }); %>
        <% if (page < pages) { %><a href="<%= pageHref(page + 1) %>" class="tk-btn tk-btn--outline tk-btn--sm" rel="next" data-i18n="user.listNext"><%- t('user.listNext') %></a><% } %>
      </nav>
      <% } %>
      <% } %>

    </div>
  </main>
</div>

<%- include('partials/lightbox') %>
<script defer src="<%= asset('/gallery.js') %>"></script>
</body>
</html>

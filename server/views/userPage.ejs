                        <a href="#" class="flex items-center gap-2 lg:gap-3 p-2 lg:p-3 rounded-lg lg:rounded-xl border border-gray-100 hover:border-gray-200 hover:bg-gray-50 transition-colors social-link">
                            <div class="w-6 h-6 lg:w-8 lg:h-8 bg-red-500 rounded-lg flex items-center justify-center social-icon">
                                <svg class="w-3 h-3 lg:w-4 lg:h-4 text-white" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="font-medium text-gray-900 text-sm lg:text-base">YouTube</p>
                                <p class="text-xs text-gray-500">канал пользователя</p>
                            </div>
                        </a>
                    </div>
                </div>
                -->
                
            </div>
        </main>
    </div>

    <!-- JavaScript -->
    <script src="/lang.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            const getUILang = () => {
              try {
                const v = localStorage.getItem('lang');
                return (v === 'en' || v === 'ru') ? v : 'ru';
              } catch (e) {
                return 'ru';
              }
            };
            const t = (key, fallbackRu, fallbackEn) => {
              const l = getUILang();
              try {
                if (window.langDict && window.langDict[key] && typeof window.langDict[key][l] !== 'undefined') {
                  return window.langDict[key][l];
                }
              } catch (e) {}
              return l === 'en' ? fallbackEn : fallbackRu;
            };
            
            // Кнопка сообщения
            const messageButton = document.getElementById('message-button');
            if (messageButton) {
                messageButton.addEventListener('click', function() {
                    const recipientId = this.getAttribute('data-user-id');
                    
            fetch('/start-conversation', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ recipientId })
                })
                .then(response => {
                    if (!response.ok) {
                    throw new Error('Network response was not ok');
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('success:', data);
                    if (data.success) {
                    window.location.href = `/chatsPage?conversationId=${data.conversationId}`;
                    }
                })
                .catch(error => console.error('error:', error));
                });
            }

            // Кнопка подписки
        const subscribeButton = document.querySelector('.subscribe__button');
            if (subscribeButton && messageButton) {
                const userId = messageButton.getAttribute('data-user-id');

        async function subscribe() {
            try {
                const response = await fetch('/subscribe', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ userId })
                });

                if (response.ok) {
                            subscribeButton.querySelector('span').textContent = t('130', 'Отписаться', 'Unsubscribe');
                    subscribeButton.classList.add('unsubscribe');
                } else {
                    const result = await response.json();
                    toast(result.message || t('212', 'Ошибка при подписке.', 'Subscribe error.'), 'error');
                }
            } catch (error) {
                console.error('subscribe error:', error);
            }
        }

        async function unsubscribe() {
            try {
                const response = await fetch('/unsubscribe', {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ userId })
                });

                if (response.ok) {
                            subscribeButton.querySelector('span').textContent = t('91', 'Подписаться', 'Subscribe');
                    subscribeButton.classList.remove('unsubscribe');
                } else {
                    const result = await response.json();
                    toast(result.message || t('213', 'Ошибка при отписке.', 'Unsubscribe error.'), 'error');
                }
            } catch (error) {
                console.error('unsubscribe error:', error);
            }
        }

        subscribeButton.addEventListener('click', function() {
            if (subscribeButton.classList.contains('unsubscribe')) {
                unsubscribe();
            } else {
                subscribe();
            }
        });
    }

    // Заглушки для звонков (покажем модалку вызова)
    const videoCallBtn = document.getElementById('video-call-button');
    const audioCallBtn = document.getElementById('audio-call-button');
    function openOutgoing(type) {
        if (window.showOutgoingCall) {
            window.showOutgoingCall({
                userId: '<%= user._id %>',
                displayName: '<%= user.displayName %>',
                avatarUrl: '<%= user.avatarStyle.url || "" %>',
                callType: type
            });
                    if (type === 'audio' && window.startAudioCall) {
                      window.startAudioCall('<%= user._id %>');
                    } else if (type === 'video' && window.startVideoCall) {
                      window.startVideoCall('<%= user._id %>');
                    }
        }
    }
            if (videoCallBtn) videoCallBtn.addEventListener('click', () => { window._lastCallType='video'; openOutgoing('video'); });
            if (audioCallBtn) audioCallBtn.addEventListener('click', () => { window._lastCallType='audio'; openOutgoing('audio'); });

    // Лайтбокс для галереи с навигацией
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightboxImg');
    const lightboxClose = document.getElementById('lightboxClose');
    const lightboxPrev = document.getElementById('lightboxPrev');
    const lightboxNext = document.getElementById('lightboxNext');
    const lightboxCounter = document.getElementById('lightboxCounter');
    
    // Получаем все фотографии из галереи
    const galleryPhotos = Array.from(document.querySelectorAll('img[data-photo-url]')).map(img => img.getAttribute('data-photo-url'));
    let currentPhotoIndex = 0;
    
    function showPhoto(index) {
        if (index < 0 || index >= galleryPhotos.length) return;
        currentPhotoIndex = index;
        lightboxImg.src = galleryPhotos[currentPhotoIndex];
        lightboxCounter.textContent = `${currentPhotoIndex + 1} / ${galleryPhotos.length}`;
        
        // Показываем/скрываем кнопки навигации
        if (galleryPhotos.length > 1) {
            lightboxPrev.style.display = 'block';
            lightboxNext.style.display = 'block';
        } else {
            lightboxPrev.style.display = 'none';
            lightboxNext.style.display = 'none';
        }
    }
    
    function openLightbox(index) {
        currentPhotoIndex = index;
        showPhoto(currentPhotoIndex);
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
    }
    
    function closeLightbox() {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
    }
    
    // Открытие лайтбокса при клике на фото
    document.addEventListener('click', function(e){
        const img = e.target.closest('img[data-photo-url]');
        if (img) {
            const photoUrl = img.getAttribute('data-photo-url');
            const index = galleryPhotos.indexOf(photoUrl);
            if (index !== -1) {
                openLightbox(index);
            }
            return;
        }
        
        // Открытие лайтбокса при клике на аватар
        const avatar = e.target.closest('img[data-avatar-url]');
        if (avatar) {
            const avatarUrl = avatar.getAttribute('data-avatar-url');
            lightboxImg.src = avatarUrl;
            lightboxCounter.textContent = t('211', 'Аватар', 'Avatar');
            lightboxPrev.style.display = 'none';
            lightboxNext.style.display = 'none';
            lightbox.classList.remove('hidden');
            lightbox.classList.add('flex');
        }
    });
    
    // Кнопка закрытия
    lightboxClose.addEventListener('click', closeLightbox);
    
    // Кнопка "Назад"
    lightboxPrev.addEventListener('click', (e) => {
        e.stopPropagation();
        const prevIndex = currentPhotoIndex > 0 ? currentPhotoIndex - 1 : galleryPhotos.length - 1;
        showPhoto(prevIndex);
    });
    
    // Кнопка "Вперед"
    lightboxNext.addEventListener('click', (e) => {
        e.stopPropagation();
        const nextIndex = currentPhotoIndex < galleryPhotos.length - 1 ? currentPhotoIndex + 1 : 0;
        showPhoto(nextIndex);
    });
    
    // Закрытие при клике на фон
    lightbox.addEventListener('click', (e)=>{
        if (e.target === lightbox || e.target === lightboxImg) {
            closeLightbox();
        }
    });
    
    // Навигация клавиатурой
    document.addEventListener('keydown', function(e) {
        if (lightbox.classList.contains('flex')) {
            if (e.key === 'Escape') {
                closeLightbox();
            } else if (e.key === 'ArrowLeft') {
                const prevIndex = currentPhotoIndex > 0 ? currentPhotoIndex - 1 : galleryPhotos.length - 1;
                showPhoto(prevIndex);
            } else if (e.key === 'ArrowRight') {
                const nextIndex = currentPhotoIndex < galleryPhotos.length - 1 ? currentPhotoIndex + 1 : 0;
                showPhoto(nextIndex);
            }
        }
    });
        });
    </script>
</body>
</html>

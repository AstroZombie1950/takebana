<% var isSelf = !!currentUser && user._id.toString() === currentUser._id.toString(); %>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.user.title', titleVars: { name: user.displayName }, seo: { path: user.url, type: 'profile', robots: indexable ? '' : 'noindex, follow', image: ogImage, imageStd: !!ogImage, imageAlt: user.displayName,
         jsonld: ld.profile({ url: user.url, name: user.displayName, image: user.avatarStyle.url, followers: user.followersCount }) } }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/profile.css') %>">
<link rel="stylesheet" href="<%= asset('/css/gallery.css') %>">
<link rel="stylesheet" href="<%= asset('/css/lightbox.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-prof">

      <% if (isSelf) { %>
      <p class="tk-kicker" data-i18n="user.ownPage"><%- t('user.ownPage') %></p>
      <% } %>

      <!-- Шапка профиля -->
      <div class="tk-prof__head">
        <%# Настройки — иконкой в углу блока, а не кнопкой в общем ряду:
            на своей странице ряд состоит из неё одной, и она выбивалась
            из имени с аватаром. %>
        <% if (isSelf) { %>
        <a href="/settings" class="tk-prof__gear" aria-label="<%= ta('settings.title') %>" title="<%= ta('settings.title') %>" data-i18n-aria="settings.title" data-i18n-title="settings.title">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.8-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1.1-1.5 1.7 1.7 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.8 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1.1 1.7 1.7 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.8.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.8V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z"></path></svg>
        </a>
        <% } else if (currentUser) { %>
        <%# Чужой профиль: в том же углу, где у своего шестерёнка, — меню
            «⋯» с жалобой и ограничением (21.09): в лицо их не ставим. %>
        <div class="tk-prof__more">
          <button type="button" class="tk-prof__gear" id="profMore" aria-haspopup="menu" aria-expanded="false" aria-controls="profMenu" aria-label="<%= ta('user.more') %>" title="<%= ta('user.more') %>" data-i18n-aria="user.more" data-i18n-title="user.more">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="1.8"></circle><circle cx="12" cy="12" r="1.8"></circle><circle cx="19" cy="12" r="1.8"></circle></svg>
          </button>
          <div class="tk-prof__menu" id="profMenu" role="menu" hidden>
            <%# Окно жалобы лежит в общем партиале шапки, здесь только пункт. %>
            <button type="button" role="menuitem" data-report="user" data-report-id="<%= user._id %>" data-report-name="<%= user.displayName %>">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M5 21V4h9l.6 2H20v9h-6l-.6-2H5"></path></svg>
              <span data-i18n="user.reportUser"><%- t('user.reportUser') %></span>
            </button>
            <%# Записная книжка (models/Contact.js): связь односторонняя,
                собеседник о ней не узнаёт. %>
            <% var cKey = inContacts ? 'contacts.remove' : 'contacts.add'; %>
            <button type="button" role="menuitem" id="contactButton" data-on="<%= inContacts ? '1' : '' %>">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M10 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM3.5 20c0-3.3 2.9-5.5 6.5-5.5s6.5 2.2 6.5 5.5M17 6.5v5M19.5 9h-5"></path></svg>
              <span data-i18n="<%= cKey %>"><%- t(cKey) %></span>
            </button>
            <% var rKey = iRestricted ? 'user.unrestrict' : 'user.restrict'; %>
            <button type="button" role="menuitem" class="is-danger" id="restrictButton" data-on="<%= iRestricted ? '1' : '' %>">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M6 6l12 12"></path></svg>
              <span data-i18n="<%= rKey %>"><%- t(rKey) %></span>
            </button>
          </div>
        </div>
        <% } %>

        <div class="tk-prof__ava"<% if (!user.avatarStyle.url) { %> data-bg="<%= user.avatarStyle.gradient %>"<% } %>>
          <% if (user.avatarStyle.url) { %>
            <img src="<%= user.avatarStyle.url %>" alt="<%= user.displayName %>" data-avatar-url="<%= user.avatarStyle.url %>">
          <% } else { %>
            <%= user.avatarStyle.initial %>
          <% } %>
        </div>

        <div class="tk-prof__main">
          <h1 class="tk-prof__name"><%= user.displayName %></h1>

          <%# Активность: строка под именем, а не панель в сетке ниже —
              это две строчки, целого блока им не нужно. Атрибуты присутствия
              те же: на них висит живое обновление (public/tk-app.js). %>
          <%# Класс присутствия — на всей строке: по нему CSS прячет ненужную
              половину. «Онлайн» и «Последний раз в сети: Сейчас» рядом — одно
              и то же дважды. Тот же класс проставляет живое обновление. %>
          <p class="tk-prof__meta <%= user.isOnline ? 'presence-online' : 'presence-offline' %>" data-presence-user="<%= user._id %>">
            <%# Цвет точки задаёт общий класс из app.css. Прежде страница
                держала свою пару правил с зашитыми цветами. %>
            <span class="presence-dot <%= user.isOnline ? 'presence-online' : 'presence-offline' %>"></span>

            <span class="tk-prof__meta-live" data-presence-text title="<%= user.lastSeen ? date(user.lastSeen) : '' %>">
              <% var presenceKey = user.isOnline ? 'common.online' : 'common.offline'; %>
              <span data-i18n="<%= presenceKey %>"><%- t(presenceKey) %></span>
            </span>

            <span class="tk-prof__meta-seen">
              <span data-i18n="user.lastSeen"><%- t('user.lastSeen') %></span>
              <%# Дата последнего входа — не словарная строка, поэтому ключ только
                  у «Сейчас»: иначе перевод затирал бы дату. %>
              <span data-presence-lastseen-user="<%= user._id %>"<% if (user.isOnline) { %> data-i18n="common.now"<% } %>><%= user.isOnline ? ta('common.now') : (user.lastSeen ? date(user.lastSeen) : ta('common.dash')) %></span>
            </span>
          </p>

          <%# Оба числа — ссылки на списки (routes/streaming/subscriptions.js).
              Раньше число подписчиков было просто текстом, а подписки
              считались, но не показывались. %>
          <div class="tk-prof__stats">
            <a href="/userPage/<%= user._id %>/followers" class="tk-prof__stat">
              <span class="tk-prof__num" id="followersCount" data-count-followers="<%= user._id %>"><%= user.followersCount %></span>
              <span class="tk-prof__lbl" data-i18n="user.subscribers"><%- t('user.subscribers') %></span>
            </a>
            <a href="/userPage/<%= user._id %>/following" class="tk-prof__stat">
              <span class="tk-prof__num" data-count-following="<%= user._id %>"><%= user.followingCount %></span>
              <span class="tk-prof__lbl" data-i18n="user.followingLabel"><%- t('user.followingLabel') %></span>
            </a>
          </div>

          <% if (!isSelf && !currentUser) { %>
          <%# Гостю — те же «Написать» и «Подписаться», но через вход: после него
              человек вернётся на эту страницу. Звонки и жалоба — только вошедшим. %>
          <% var loginBack = '/login?next=' + encodeURIComponent(url); %>
          <div class="tk-prof__acts tk-prof__acts-row">
            <a href="<%= loginBack %>" class="tk-btn tk-btn--primary tk-btn--sm">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M21 12a8 8 0 01-11.5 7.2L4 21l1.8-5.5A8 8 0 1121 12Z"></path></svg>
              <span data-i18n="user.message"><%- t('user.message') %></span>
            </a>
            <a href="<%= loginBack %>" class="tk-btn tk-btn--outline tk-btn--sm">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"></path></svg>
              <span data-i18n="stream.subscribe"><%- t('stream.subscribe') %></span>
            </a>
          </div>
          <% } else if (!isSelf) { %>
          <%# На виду (решение 21.09): общение — написать и позвонить — и
              отдельно подписка. Жалоба и ограничение — в меню «⋯» в углу
              шапки. Ограничение в любую сторону закрывает и общение
              (utils/restrict.js), поэтому первой группы тогда нет вовсе.
              Поведение — profile.js. %>
          <div class="tk-prof__acts">
            <div class="tk-prof__acts-row tk-prof__talk" id="talkActions"<% if (restricted || iRestricted) { %> hidden<% } %>>
              <button type="button" class="tk-btn tk-btn--primary tk-btn--sm tk-prof__write" id="message-button" data-user-id="<%= user._id %>">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M21 12a8 8 0 01-11.5 7.2L4 21l1.8-5.5A8 8 0 1121 12Z"></path></svg>
                <span data-i18n="user.message"><%- t('user.message') %></span>
              </button>

              <button type="button" class="tk-btn tk-btn--outline tk-btn--sm tk-prof__call" id="video-call-button" data-user-id="<%= user._id %>" aria-label="<%= ta('user.videoCall') %>" data-i18n-aria="user.videoCall">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M15.5 10.5l4.5-2.25v7.5l-4.5-2.25"></path><rect x="3.5" y="6" width="12" height="12"></rect></svg>
                <span data-i18n="user.videoCall"><%- t('user.videoCall') %></span>
              </button>

              <button type="button" class="tk-btn tk-btn--outline tk-btn--sm tk-prof__call" id="audio-call-button" data-user-id="<%= user._id %>" aria-label="<%= ta('user.audioCall') %>" data-i18n-aria="user.audioCall">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M6.5 3h-2A1.5 1.5 0 003 4.5C3 13 11 21 19.5 21a1.5 1.5 0 001.5-1.5v-2l-4-1.5-1.7 2A14 14 0 018 11.7l2-1.7L8.5 6l-2-3Z"></path></svg>
                <span data-i18n="user.audioCall"><%- t('user.audioCall') %></span>
              </button>
            </div>

            <% if (!restricted) { %>
            <div class="tk-prof__acts-row tk-prof__chan">
              <button type="button" class="tk-btn tk-btn--outline tk-btn--sm subscribe__button<%= user.isSubscribed ? ' unsubscribe' : '' %>">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"></path></svg>
                <% var subKey = user.isSubscribed ? 'stream.unsubscribe' : 'stream.subscribe'; %>
                <span data-i18n="<%= subKey %>"><%- t(subKey) %></span>
              </button>
            </div>
            <% } %>
          </div>
          <% } %>
        </div>
      </div>

      <% if (restricted) { %>
      <section class="tk-panel--prof">
        <div class="tk-prof__none">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M6 6l12 12"></path></svg>
          <p data-i18n="restricted.text"><%- t('restricted.text') %></p>
        </div>
      </section>
      <% } else { %>
      <!-- Идёт ли эфир -->
      <section class="tk-panel--prof">
        <h2 class="tk-kicker" data-i18n="user.stream"><%- t('user.stream') %></h2>

        <% if (user.isStreaming && user.activeStreamId) { %>
        <div class="tk-prof__live">
          <span class="tk-prof__live-mark" data-i18n="user.live"><%- t('user.live') %></span>
          <a href="/stream/<%= user.activeStreamId %>" data-i18n="stream.goto"><%- t('stream.goto') %></a>
        </div>
        <% } else { %>
        <div class="tk-prof__none">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" aria-hidden="true"><path d="M15 10l4.55-2.28A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.9L15 14"></path><rect x="3" y="6" width="12" height="12"></rect></svg>
          <p data-i18n="user.notLive"><%- t('user.notLive') %></p>
        </div>
        <% } %>
      </section>

      <!-- Записи эфиров: автор видит и те, что ещё сохраняются -->
      <section class="tk-prof__gal" id="recordings">
        <div class="tk-prof__gal-head">
          <h2 class="tk-kicker tk-prof__gal-title" data-i18n="rec.title"><%- t('rec.title') %></h2>
          <span class="tk-note"><%= recordings.length %></span>
        </div>

        <% if (recordings.length) { %>
        <div class="tk-recs">
          <% recordings.forEach(function (r) { %>
          <%# data-rec-id — чтобы profile.js нашёл карточку, когда придёт
              recording:status: склейка идёт минуты, и до 20.09.2026 автор
              не узнавал о её конце без перезагрузки. %>
          <a href="/recording/<%= r._id %>" class="tk-recard<%= r.status !== 'ready' ? ' is-' + r.status : '' %>" data-rec-id="<%= r._id %>">
            <span class="tk-recard__thumb">
              <% if (r.thumb && r.thumb.url) { %><img src="<%= r.thumb.url %>" alt="" loading="lazy"><% } %>
              <% if (r.status === 'ready') { %>
                <span class="tk-recard__len"><%= clock(r.duration) %></span>
              <% } else { %>
                <% var stKey = r.status === 'failed' ? 'rec.failed' : 'rec.processing'; %>
                <span class="tk-recard__state" data-i18n="<%= stKey %>"><%- t(stKey) %></span>
              <% } %>
              <% if (r.isAdult) { %><span class="tk-recard__adult">18+</span><% } %>
            </span>
            <span class="tk-recard__title"><%= r.title %></span>
            <span class="tk-recard__date">
              <% if (r.status === 'ready') { var rv = plural(r.views || 0, 'rec.views'); %><span data-i18n="<%= rv.key %>" data-i18n-vars='<%= JSON.stringify({ n: num(r.views) }) %>'><%= rv.text %></span> · <% } %>
              <time><%= date(r.createdAt, { day: '2-digit', month: '2-digit', year: 'numeric' }) %></time>
            </span>
          </a>
          <% }); %>
        </div>
        <% } else { %>
        <p class="tk-note tk-note--center" data-i18n="rec.empty"><%- t('rec.empty') %></p>
        <% } %>
      </section>

      <!-- Фото и видео: начало ленты (utils/gallery.js), целиком — на
           /@ник/gallery. Плитка — partials/galleryTile.ejs,
           поведение — public/gallery.js. -->
      <section class="tk-prof__gal" id="gallery"<% if (isSelf) { %> data-own<% } %>>
        <div class="tk-prof__gal-head">
          <h2 class="tk-prof__gal-title"><a href="<%= user.url %>/gallery" class="tk-kicker" data-i18n="user.gallery"><%- t('user.gallery') %></a></h2>
          <span class="tk-note" id="galleryCount"><%= shotsCount %></span>
        </div>

        <div class="tk-shots" id="galleryShots">
          <% shots.forEach(function (item, i) { %><%- include('partials/galleryTile', { item: item, n: i + 1, owner: user.displayName, isSelf: isSelf }) %><% }); %>
        </div>
        <p class="tk-note tk-note--center" id="galleryEmpty" data-i18n="user.galleryEmpty"<% if (shots.length) { %> hidden<% } %>><%- t('user.galleryEmpty') %></p>

        <%# Под снимками, по центру: «Все» — если в превью влезло не всё;
            «Добавить» ведёт на страницу загрузки (/upload, 21.09) — там
            выбор файлов, докачка, правка видео и «Опубликовать». %>
        <% if (shotsMore || isSelf) { %>
        <div class="tk-prof__gal-add">
          <% if (shotsMore) { %>
          <a href="<%= user.url %>/gallery" class="tk-btn tk-btn--outline tk-btn--xs" data-i18n="gallery.all" data-i18n-vars='<%= JSON.stringify({ n: shotsCount }) %>'><%- t('gallery.all', { n: shotsCount }) %></a>
          <% } %>
          <% if (isSelf) { %>
          <a href="/upload" class="tk-btn tk-btn--outline tk-btn--xs" id="galleryAdd" data-i18n="user.galleryAdd"><%- t('user.galleryAdd') %></a>
          <% } %>
        </div>
        <% } %>
      </section>
      <% } %>

    </div>
  </main>
</div>

<%- include('partials/lightbox') %>

<%# Единственное, что скрипту профиля нужно от сервера. %>
<script>
  window.TK_PROFILE = {
    userId: <%- JSON.stringify(String(user._id)) %>,
    displayName: <%- JSON.stringify(user.displayName).replace(/</g, '\\u003c') %>,
    avatarUrl: <%- JSON.stringify(user.avatarStyle.url || '').replace(/</g, '\\u003c') %>
  };
</script>
<script defer src="<%= asset('/gallery.js') %>"></script>
<script defer src="<%= asset('/profile.js') %>"></script>
</body>
</html>

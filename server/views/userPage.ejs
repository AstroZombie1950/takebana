<% var isSelf = user._id.toString() === currentUser._id.toString(); %>
<!DOCTYPE html>
<html lang="ru">
<head>
<%- include('partials/tkHead', { title: title }) %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/profile.css">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-prof">

      <% if (isSelf) { %>
      <p class="tk-kicker" lng="199">Страница вашего профиля</p>
      <% } %>

      <!-- Шапка профиля -->
      <div class="tk-prof__head">
        <div class="tk-prof__ava"<% if (!user.avatarStyle.url) { %> data-bg="<%= user.avatarStyle.gradient %>"<% } %>>
          <% if (user.avatarStyle.url) { %>
            <img src="<%= user.avatarStyle.url %>" alt="<%= user.displayName %>" data-avatar-url="<%= user.avatarStyle.url %>">
          <% } else { %>
            <%= user.avatarStyle.initial %>
          <% } %>
        </div>

        <div class="tk-prof__main">
          <h1 class="tk-prof__name"><%= user.displayName %></h1>

          <div class="tk-prof__stats">
            <div>
              <span class="tk-prof__num"><%= user.followersCount %></span>
              <span class="tk-prof__lbl" lng="140">подписчиков</span>
            </div>
          </div>

          <% if (!isSelf) { %>
          <div class="tk-prof__acts">
            <button type="button" class="tk-btn tk-btn--primary tk-btn--sm" id="message-button" data-user-id="<%= user._id %>">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M21 12a8 8 0 01-11.5 7.2L4 21l1.8-5.5A8 8 0 1121 12Z"></path></svg>
              <span lng="141">Сообщение</span>
            </button>

            <button type="button" class="tk-btn tk-btn--outline tk-btn--sm" id="video-call-button" data-user-id="<%= user._id %>">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M15.5 10.5l4.5-2.25v7.5l-4.5-2.25"></path><rect x="3.5" y="6" width="12" height="12"></rect></svg>
              <span lng="200">Видеозвонок</span>
            </button>

            <button type="button" class="tk-btn tk-btn--outline tk-btn--sm" id="audio-call-button" data-user-id="<%= user._id %>">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M6.5 3h-2A1.5 1.5 0 003 4.5C3 13 11 21 19.5 21a1.5 1.5 0 001.5-1.5v-2l-4-1.5-1.7 2A14 14 0 018 11.7l2-1.7L8.5 6l-2-3Z"></path></svg>
              <span lng="201">Аудиозвонок</span>
            </button>

            <button type="button" class="tk-btn tk-btn--outline tk-btn--sm subscribe__button<%= user.isSubscribed ? ' unsubscribe' : '' %>">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"></path></svg>
              <span lng="<%= user.isSubscribed ? '130' : '91' %>"><%= user.isSubscribed ? 'Отписаться' : 'Подписаться' %></span>
            </button>

            <%# Окно жалобы лежит в общем партиале шапки, здесь только кнопка. %>
            <button type="button" class="tk-btn tk-btn--ghost tk-btn--sm"
                    data-report="user"
                    data-report-id="<%= user._id %>"
                    data-report-name="<%= user.displayName %>">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M5 21V4h9l.6 2H20v9h-6l-.6-2H5"></path></svg>
              <span>Пожаловаться</span>
            </button>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Активность и эфир -->
      <div class="tk-prof__grid">
        <section class="tk-panel--prof">
          <p class="tk-kicker" lng="202">Активность</p>

          <div class="tk-prof__rows">
            <div class="tk-prof__row" data-presence-user="<%= user._id %>">
              <span class="tk-prof__key" lng="203">Статус</span>
              <span class="tk-prof__val">
                <%# Цвет точки задаёт общий класс из app.css. Прежде страница
                    держала свою пару правил с зашитыми цветами. %>
                <span class="presence-dot <%= user.isOnline ? 'presence-online' : 'presence-offline' %>"></span>
                <span data-presence-text title="<%= user.lastSeen ? new Date(user.lastSeen).toLocaleString() : '' %>">
                  <span lng="<%= user.isOnline ? '159' : '160' %>"><%= user.isOnline ? 'онлайн' : 'оффлайн' %></span>
                </span>
              </span>
            </div>

            <div class="tk-prof__row">
              <span class="tk-prof__key" lng="204">Последний раз в сети</span>
              <span class="tk-prof__val" data-presence-lastseen-user="<%= user._id %>">
                <span lng="<%= user.isOnline ? '178' : '179' %>"><%= user.isOnline ? 'Сейчас' : (user.lastSeen ? new Date(user.lastSeen).toLocaleString() : '—') %></span>
              </span>
            </div>
          </div>
        </section>

        <section class="tk-panel--prof">
          <p class="tk-kicker" lng="205">Стрим</p>

          <% if (user.isStreaming && user.activeStreamId) { %>
          <div class="tk-prof__live">
            <span class="tk-prof__live-mark" lng="206">Пользователь в эфире</span>
            <a href="/stream/<%= user.activeStreamId %>" lng="118">Перейти к стриму</a>
          </div>
          <% } else { %>
          <div class="tk-prof__none">
            <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" aria-hidden="true"><path d="M15 10l4.55-2.28A1 1 0 0 1 21 8.62v6.76a1 1 0 0 1-1.45.9L15 14"></path><rect x="3" y="6" width="12" height="12"></rect></svg>
            <p lng="207">Не стримит сейчас</p>
          </div>
          <% } %>
        </section>
      </div>

      <!-- Галерея -->
      <section class="tk-prof__gal">
        <div class="tk-prof__gal-head">
          <p class="tk-kicker" style="margin: 0; flex: 1;" lng="208">Галерея</p>
          <span class="tk-note"><%= (user.gallery || []).length %> <span lng="209">фото</span></span>
        </div>

        <% if (user.gallery && user.gallery.length) { %>
        <div class="tk-shots">
          <% user.gallery.forEach(function (url, idx) { %>
          <button type="button" class="tk-shot" aria-label="Фото <%= idx + 1 %>">
            <img src="<%= url %>" alt="" loading="lazy" data-photo-url="<%= url %>">
          </button>
          <% }); %>
        </div>
        <% } else { %>
        <p class="tk-note tk-note--center" lng="210">Галерея пуста</p>
        <% } %>
      </section>

    </div>
  </main>
</div>

<!-- Просмотр фотографии -->
<div id="lightbox" class="tk-lightbox hidden">
  <button type="button" class="tk-lightbox__btn tk-lightbox__close" id="lightboxClose" aria-label="Закрыть">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
  </button>
  <button type="button" class="tk-lightbox__btn tk-lightbox__prev" id="lightboxPrev" aria-label="Предыдущее">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
  </button>
  <button type="button" class="tk-lightbox__btn tk-lightbox__next" id="lightboxNext" aria-label="Следующее">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
  </button>
  <span class="tk-lightbox__count" id="lightboxCounter">1 / 1</span>
  <%# Без src: пустая строка — это адрес текущей страницы, браузер честно идёт
      за ней и получает битую картинку. Адрес подставляет profile.js при открытии. %>
  <img id="lightboxImg" alt="">
</div>

<%# Единственное, что скрипту профиля нужно от сервера. %>
<script>
  window.TK_PROFILE = {
    userId: <%- JSON.stringify(String(user._id)) %>,
    displayName: <%- JSON.stringify(user.displayName) %>,
    avatarUrl: <%- JSON.stringify(user.avatarStyle.url || '') %>
  };
</script>
<script src="/profile.js"></script>
<script src="/lang.js"></script>
</body>
</html>

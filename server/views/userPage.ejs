<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'brand': {
                            50: '#f0f2ff',
                            100: '#e5e7ff',
                            200: '#cdcfff',
                            300: '#a5a9ff',
                            400: '#7a7aff',
                            500: '#666bcf',
                            600: '#5a5cba',
                            700: '#4c4e9a',
                            800: '#3f417e',
                            900: '#363865'
                        }
                    },
                    screens: {
                        'xs': '475px',
                    },
                    fontFamily: {
                        'inter': ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <title><%= title %></title>
    
    <!-- Mobile-first responsive styles -->
    <style>
        /* Mobile optimizations for userPage */
        @media (max-width: 640px) {
            /* Extra small screens - 350px and below */
            .user-profile-container {
                padding: 0.75rem;
            }
            
            .user-avatar {
                width: 4rem;
                height: 4rem;
            }
            
            .user-name {
                font-size: 1.125rem;
                line-height: 1.25;
            }
            
            .user-stats {
                gap: 1rem;
            }
            
            .user-stats-number {
                font-size: 1rem;
            }
            
            .user-stats-label {
                font-size: 0.75rem;
            }
            
            .user-buttons {
                flex-direction: column;
                width: 100%;
            }
            
            .user-button {
                width: 100%;
                padding: 0.5rem 1rem;
                font-size: 0.875rem;
            }
            
            .content-grid {
                gap: 0.75rem;
            }
            
            .content-card {
                padding: 0.75rem;
                border-radius: 0.75rem;
            }
            
            .card-icon {
                width: 1.5rem;
                height: 1.5rem;
            }
            
            .card-title {
                font-size: 0.875rem;
            }
            
            .card-content {
                font-size: 0.75rem;
            }
            
            .social-links {
                gap: 0.5rem;
            }
            
            .social-link {
                padding: 0.5rem;
                gap: 0.5rem;
            }
            
            .social-icon {
                width: 1.5rem;
                height: 1.5rem;
            }
        }
        
        /* Smooth transitions for all interactive elements */
        .user-button,
        .social-link,
        .content-card {
            transition: all 0.2s ease-in-out;
        }
        
        /* Improved touch targets for mobile */
        @media (max-width: 640px) {
            .user-button,
            .social-link {
                min-height: 2.5rem;
            }
        }
        
        /* Better spacing for ultra-small screens */
        @media (max-width: 350px) {
            .user-profile-container {
                padding: 0.5rem;
            }
            
            .user-avatar {
                width: 3.5rem;
                height: 3.5rem;
            }
            
            .user-name {
                font-size: 1rem;
            }
            
            .user-stats {
                gap: 0.75rem;
            }
            
            .content-card {
                padding: 0.5rem;
            }
            
            .card-icon {
                width: 1.25rem;
                height: 1.25rem;
            }
        }
        /* Presence dots */
        .presence-online .presence-dot { background-color: #22c55e; }
        .presence-offline .presence-dot { background-color: #9ca3af; }
    </style>
</head>
<body class="font-inter bg-white">
    <%- include('partials/header') %>

    <!-- Основной контейнер -->
    <div class="min-h-screen bg-gray-50">
        <%- include('partials/leftBar') %>
        
        <!-- Основной контент -->
        <main class="min-h-screen lg:pl-72">
            <div class="max-w-4xl mx-auto px-3 py-6 lg:px-6 lg:py-12">
                
                <!-- Профиль -->
                <div class="bg-white rounded-xl lg:rounded-2xl border border-gray-100 p-4 lg:p-8 mb-4 lg:mb-8 user-profile-container">
                    <% if (user._id.toString() === currentUser._id.toString()) { %>
                    <!-- Заголовок для своего профиля -->
                    <div class="mb-4 lg:mb-6 text-center md:text-left">
                        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-lg" style="background: linear-gradient(135deg, rgba(102, 107, 207, 0.1), rgba(102, 107, 207, 0.05));">
                            <svg class="w-5 h-5" style="color: rgba(102, 107, 207, 1);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <span class="text-sm lg:text-base font-semibold" style="color: rgba(102, 107, 207, 1);" lng="199">Страница вашего профиля</span>
                        </div>
                    </div>
                    <% } %>
                    <!-- Основная информация -->
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-4 lg:gap-8 mb-6 lg:mb-8">
                        
                        <!-- Аватар -->
                        <div class="relative">
                <% if (user.avatarStyle.url) { %>
                                <img class="w-20 h-20 lg:w-32 lg:h-32 rounded-full object-cover border-2 border-gray-100 user-avatar cursor-pointer hover:opacity-90 transition-opacity" 
                                     src="<%= user.avatarStyle.url %>" alt="<%= user.displayName %>" data-avatar-url="<%= user.avatarStyle.url %>">
                <% } else { %>
                                <div class="w-20 h-20 lg:w-32 lg:h-32 rounded-full flex items-center justify-center text-white font-semibold text-xl lg:text-3xl border-2 border-gray-100 user-avatar"
                                     data-bg="<%= user.avatarStyle.gradient %>">
                        <%= user.avatarStyle.initial %>
                    </div>
                <% } %>
                        </div>
                        
                        <!-- Информация -->
                        <div class="flex-1 text-center md:text-left">
                            <!-- Имя -->
                            <h1 class="text-xl lg:text-3xl font-bold text-gray-900 mb-2 lg:mb-3 user-name">
                                <%= user.displayName %>
                            </h1>
                            
                            <!-- Статистика -->
                            <div class="flex items-center justify-center md:justify-start gap-4 lg:gap-8 mb-4 lg:mb-6 user-stats">
                                <div class="text-center">
                                    <div class="text-lg lg:text-2xl font-bold text-gray-900 user-stats-number">
                                        <%= user.followersCount %>
                                    </div>
                                    <div class="text-xs lg:text-sm text-gray-500 user-stats-label" lng="140">
                                        подписчиков
                                    </div>
                                </div>
                     </div>
                    
                            <!-- Кнопки -->
                            <% if (user._id.toString() !== currentUser._id.toString()) { %>
                            <div class="flex flex-col sm:flex-row gap-2 lg:gap-3 justify-center md:justify-start user-buttons">
                                <!-- Кнопка сообщения -->
                                <button class="bg-brand-500 hover:bg-brand-600 text-white font-medium py-2 px-4 lg:py-3 lg:px-6 rounded-lg lg:rounded-xl transition-colors flex items-center justify-center gap-2 text-sm lg:text-base user-button" 
                                        id="message-button" data-user-id="<%= user._id %>">
                                    <svg class="w-3 h-3 lg:w-4 lg:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                                    </svg>
                                    <span lng="141">Сообщение</span>
                                </button>

                                <!-- Видеозвонок -->
                                <button class="border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-600 hover:text-[rgba(102,107,207,1)] font-medium py-2 px-4 lg:py-2.5 lg:px-5 rounded-lg lg:rounded-xl transition-colors flex items-center justify-center gap-2 text-sm user-button" 
                                        id="video-call-button" data-user-id="<%= user._id %>">
                                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5l4.5-2.25v7.5l-4.5-2.25M3.75 6.75A2.25 2.25 0 006 4.5h6A2.25 2.25 0 0114.25 6.75v10.5A2.25 2.25 0 0112 19.5H6A2.25 2.25 0 013.75 17.25V6.75z" />
                                    </svg>
                                    <span lng="200">Видеозвонок</span>
                                </button>

                                <!-- Аудиозвонок -->
                                <button class="border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-600 hover:text-[rgba(102,107,207,1)] font-medium py-2 px-4 lg:py-2.5 lg:px-5 rounded-lg lg:rounded-xl transition-colors flex items-center justify-center gap-2 text-sm user-button" 
                                        id="audio-call-button" data-user-id="<%= user._id %>">
                                    <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15H19.5A2.25 2.25 0 0021.75 19.5v-3.651a1.125 1.125 0 00-.852-1.089l-3.174-.794a1.125 1.125 0 00-1.296.65l-.7 1.575a.75.75 0 01-1.017.38 12.035 12.035 0 01-5.305-5.305.75.75 0 01.38-1.017l1.575-.7a1.125 1.125 0 00.65-1.296L8.24 1.102A1.125 1.125 0 007.151.25H3.5A2.25 2.25 0 001.25 2.5V3.75z" />
                                    </svg>
                                    <span lng="201">Аудиозвонок</span>
                                </button>
                                
                                <!-- Кнопка подписки -->
                                <button class="border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-4 lg:py-3 lg:px-6 rounded-lg lg:rounded-xl transition-colors flex items-center justify-center gap-2 text-sm lg:text-base user-button subscribe__button <%= user.isSubscribed ? 'unsubscribe' : '' %>">
                                    <svg class="w-3 h-3 lg:w-4 lg:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                    <span lng="<%= user.isSubscribed ? '130' : '91' %>"><%= user.isSubscribed ? 'Отписаться' : 'Подписаться' %></span>
                                </button>
                            </div>
                            <% } %>
            </div>
        </div>
    </div>
  
                <!-- Контент секции -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6 content-grid">
                    
                    <!-- Активность -->
                    <div class="bg-white rounded-xl lg:rounded-2xl border border-gray-100 p-4 lg:p-6 content-card">
                        <div class="flex items-center gap-2 lg:gap-3 mb-3 lg:mb-4">
                            <div class="w-6 h-6 lg:w-8 lg:h-8 bg-blue-50 rounded-lg flex items-center justify-center card-icon">
                                <svg class="w-3 h-3 lg:w-4 lg:h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                            </div>
                            <h2 class="text-base lg:text-lg font-semibold text-gray-900 card-title" lng="202">Активность</h2>
                        </div>
                        
                        <div class="space-y-2 lg:space-y-3">
                            <!-- Текущий статус -->
                            <div class="flex items-center justify-between py-1.5 lg:py-2" data-presence-user="<%= user._id %>">
                                <span class="text-xs lg:text-sm text-gray-600 card-content" lng="203">Статус</span>
                                <div class="flex items-center gap-2 <%= user.isOnline ? 'presence-online' : 'presence-offline' %>">
                                    <span class="w-2.5 h-2.5 rounded-full presence-dot"></span>
                                    <span class="text-xs lg:text-sm font-medium text-gray-900 card-content" data-presence-text
                                          title="<%= user.lastSeen ? new Date(user.lastSeen).toLocaleString() : '' %>">
                                        <span lng="<%= user.isOnline ? '159' : '160' %>"><%= user.isOnline ? 'онлайн' : 'оффлайн' %></span>
                                    </span>
                                </div>
                            </div>
                            <!-- Последний раз в сети -->
                            <div class="flex items-center justify-between py-1.5 lg:py-2">
                                <span class="text-xs lg:text-sm text-gray-600 card-content" lng="204">Последний раз в сети</span>
                                <span class="text-xs lg:text-sm font-medium text-gray-900 card-content" data-presence-lastseen-user="<%= user._id %>">
                                    <span lng="<%= user.isOnline ? '178' : '179' %>"><%= user.isOnline ? 'Сейчас' : (user.lastSeen ? new Date(user.lastSeen).toLocaleString() : '—') %></span>
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Активный стрим -->
                    <div class="bg-white rounded-xl lg:rounded-2xl border border-gray-100 p-4 lg:p-6 content-card">
                        <div class="flex items-center gap-2 lg:gap-3 mb-3 lg:mb-4">
                            <div class="w-6 h-6 lg:w-8 lg:h-8 bg-red-50 rounded-lg flex items-center justify-center card-icon">
                                <svg class="w-3 h-3 lg:w-4 lg:h-4 text-red-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                            <h2 class="text-base lg:text-lg font-semibold text-gray-900 card-title" lng="205">Стрим</h2>
                        </div>
                        <% if (user.isStreaming && user.activeStreamId) { %>
                        <div class="flex items-center justify-between py-2 lg:py-3 bg-red-50 border border-red-100 rounded-lg px-3">
                            <div class="flex items-center gap-2">
                                <span class="inline-flex w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                                <span class="text-xs lg:text-sm font-medium text-red-700" lng="206">Пользователь в эфире</span>
                            </div>
                            <a href="/stream/<%= user.activeStreamId %>" class="text-xs lg:text-sm font-semibold text-red-700 hover:text-red-800 underline" lng="118">Перейти к стриму</a>
                        </div>
                        <% } else { %>
                        <div class="text-center py-6 lg:py-8">
                            <div class="w-8 h-8 lg:w-12 lg:h-12 bg-gray-100 rounded-lg lg:rounded-xl flex items-center justify-center mx-auto mb-2 lg:mb-3">
                                <svg class="w-4 h-4 lg:w-6 lg:h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <p class="text-xs lg:text-sm text-gray-500" lng="207">Не стримит сейчас</p>
                        </div>
                        <% } %>
                    </div>
                    
                </div>

                <!-- Галерея пользователя -->
                <div class="mt-4 lg:mt-6 bg-white rounded-xl lg:rounded-2xl border border-gray-100 p-4 lg:p-6">
                    <div class="flex items-center justify-between mb-3 lg:mb-4">
                        <div class="flex items-center gap-2 lg:gap-3">
                            <div class="w-6 h-6 lg:w-8 lg:h-8 bg-purple-50 rounded-lg flex items-center justify-center">
                                <svg class="w-3 h-3 lg:w-4 lg:h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V8a2 2 0 00-2-2H6a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <h2 class="text-base lg:text-lg font-semibold text-gray-900" lng="208">Галерея</h2>
                        </div>
                        <div class="text-xs lg:text-sm text-gray-500"><%= (user.gallery || []).length %> <span lng="209">фото</span></div>
                    </div>

                    <% if (user.gallery && user.gallery.length) { %>
                    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 lg:gap-3">
                        <% user.gallery.forEach(function(url, idx){ %>
                        <button type="button" class="group relative">
                            <img src="<%= url %>" alt="photo <%= idx+1 %>" class="w-full h-28 sm:h-32 md:h-36 object-cover rounded-lg ring-1 ring-gray-200 shadow-sm group-hover:ring-brand-300 transition" data-photo-url="<%= url %>">
                        </button>
                        <% }) %>
                    </div>
                    <% } else { %>
                    <div class="text-center py-8 text-gray-500 text-sm" lng="210">Галерея пуста</div>
                    <% } %>
                </div>

                <!-- Лайтбокс -->
                <div id="lightbox" class="fixed inset-0 bg-black/80 hidden items-center justify-center z-50">
                    <button id="lightboxClose" class="absolute top-4 right-4 text-white/80 hover:text-white z-10">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                    <button id="lightboxPrev" class="absolute left-4 text-white/80 hover:text-white z-10 bg-black/30 hover:bg-black/50 rounded-full p-2 transition-all">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                        </svg>
                    </button>
                    <button id="lightboxNext" class="absolute right-4 text-white/80 hover:text-white z-10 bg-black/30 hover:bg-black/50 rounded-full p-2 transition-all">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </button>
                    <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 text-white/80 text-sm z-10">
                        <span id="lightboxCounter">1 / 1</span>
                    </div>
                    <img id="lightboxImg" src="" class="max-h-[85vh] max-w-[90vw] rounded-lg shadow-2xl">
                </div>
                
                <!-- Контакты - скрыто до реализации функционала -->
                <!--
                <div class="bg-white rounded-xl lg:rounded-2xl border border-gray-100 p-4 lg:p-6 mt-4 lg:mt-6 content-card">
                    <div class="flex items-center gap-2 lg:gap-3 mb-3 lg:mb-4">
                        <div class="w-6 h-6 lg:w-8 lg:h-8 bg-gray-50 rounded-lg flex items-center justify-center card-icon">
                            <svg class="w-3 h-3 lg:w-4 lg:h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                            </svg>
                        </div>
                        <h2 class="text-base lg:text-lg font-semibold text-gray-900 card-title">Социальные сети</h2>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 lg:gap-3 social-links">

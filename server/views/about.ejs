<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%#
  «О нас» — что такое Takebana, для кого и как начать. До 15 сентября 2026
  это была главная страница (лендинг по ТЗ); главной стала витрина эфиров.
  Шапка и панель — общие с сайтом, панель выезжает по бургеру (tk-app--wide):
  вёрстка лендинга рассчитана на всю ширину окна.
%>
<%- include('partials/tkHead', { titleKey: 'page.about.title', descriptionKey: 'page.about.description', seo: { path: '/about' } }) %>

<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/about.css') %>">
</head>
<body class="tk-app tk-app--wide">

<%- include('partials/header') %>
<%- include('partials/leftBar') %>

<div class="tk-shell">

<main>

    <section class="tk-about__hero">
      <div class="tk-about__hero-text">
        <p class="tk-kicker tk-about__kicker" data-i18n="hero.kicker"><%- t('hero.kicker') %></p>
        <h1 class="tk-about__h1" data-i18n="hero.h1"><%- t('hero.h1') %></h1>
        <div class="tk-about__hero-gap"></div>
        <p class="tk-about__lede" data-i18n="hero.lede"><%- t('hero.lede') %></p>
        <div class="tk-about__btns">
          <a href="<%= currentUser ? '/studio' : '/register' %>" class="tk-btn tk-btn--primary" data-i18n="hero.cta1"><%- t('hero.cta1') %></a>
          <a href="/" class="tk-btn tk-btn--ghost" data-i18n="hero.cta2"><%- t('hero.cta2') %></a>
        </div>
      </div>
      <div class="tk-about__shot">
        <div class="tk-about__shot-tint"></div>
        <div class="tk-about__shot-center">
          <span class="tk-about__shot-ph" data-i18n="hero.shotPlaceholder"><%- t('hero.shotPlaceholder') %></span>
        </div>
        <div class="tk-about__live">
          <span class="tk-about__live-dot"></span>
          <span class="tk-about__live-text">LIVE</span>
        </div>
        <div class="tk-about__host">
          <span class="tk-about__host-kicker" data-i18n="hero.liveNow"><%- t('hero.liveNow') %></span>
          <span class="tk-about__host-name" data-i18n="hero.hostName"><%- t('hero.hostName') %></span>
          <span class="tk-about__host-role" data-i18n="hero.hostRole"><%- t('hero.hostRole') %></span>
        </div>
      </div>
    </section>

    <section class="tk-about__sec tk-about__sec--paper" data-bg="paper">
      <div class="tk-about__head tk-about__head--ink">
        <h2 class="tk-about__h2" data-i18n="feat.h2"><%- t('feat.h2') %></h2>
      </div>
      <div class="tk-about__feats">
        <% ['01', '02', '03', '04'].forEach(function (n, i, all) { %>
        <div class="tk-about__feat<%= i === 0 ? ' tk-about__feat--first' : '' %><%= i === all.length - 1 ? ' tk-about__feat--last' : '' %>">
          <span class="tk-about__feat-num"><%= n %></span>
          <h3 class="tk-about__feat-title" data-i18n="feat.<%= n %>.title"><%- t('feat.' + n + '.title') %></h3>
          <p class="tk-about__feat-body" data-i18n="feat.<%= n %>.body"><%- t('feat.' + n + '.body') %></p>
        </div>
        <% }); %>
      </div>
    </section>

    <%# Карта — настоящая, та же, что у вошедших на /main (public/tk-map.js).
        Библиотеку карты (~300 КБ) tk-landing.js грузит, только когда секция
        подходит к экрану. Метка ведёт ко входу: карточка заведения — для
        вошедших. %>
    <section class="tk-about__sec">
      <h2 class="tk-about__h2" data-i18n="map.h2"><%- t('map.h2') %></h2>
      <div class="tk-about__head tk-about__head--map">
        <p class="tk-about__note" data-i18n="map.body"><%- t('map.body') %></p>
        <div class="tk-about__grow"></div>
        <div class="tk-about__legend">
          <div class="tk-about__legend-row"><span class="tk-about__mark"></span><span class="tk-about__legend-label" data-i18n="map.statLive"><%- t('map.statLive') %></span></div>
          <div class="tk-about__legend-row"><span class="tk-about__mark tk-about__mark--green"></span><span class="tk-about__legend-label tk-about__legend-label--muted" data-i18n="map.statVerified"><%- t('map.statVerified') %></span></div>
        </div>
      </div>
      <div class="tk-homemap tk-about__map" id="tkHomeMap"></div>
    </section>

    <section class="tk-about__split">
      <% [['l', 'left', ''], ['r', 'right', ' tk-about__h2s--accent']].forEach(function (side) { %>
      <div class="tk-about__split-<%= side[0] %>">
        <h2 class="tk-about__h2s<%= side[2] %>" data-i18n="split.<%= side[1] %>.h2"><%- t('split.' + side[1] + '.h2') %></h2>
        <div class="tk-about__list">
          <% [1, 2, 3].forEach(function (n) { %>
          <div class="tk-about__item"><span class="tk-about__item-num">0<%= n %></span><span class="tk-about__item-text" data-i18n="split.<%= side[1] %>.item<%= n %>"><%- t('split.' + side[1] + '.item' + n) %></span></div>
          <% }); %>
        </div>
      </div>
      <% }); %>
    </section>

    <section class="tk-about__sec tk-about__sec--paper" data-bg="paper">
      <div class="tk-about__head tk-about__head--ink">
        <h2 class="tk-about__h2" data-i18n="steps.h2"><%- t('steps.h2') %></h2>
      </div>
      <div class="tk-about__steps">
        <% [1, 2, 3].forEach(function (n) { %>
        <div class="tk-about__step">
          <span class="tk-about__step-num"><%= n %></span>
          <h3 class="tk-about__step-title" data-i18n="steps.<%= n %>.title"><%- t('steps.' + n + '.title') %></h3>
          <p class="tk-about__step-body" data-i18n="steps.<%= n %>.body"><%- t('steps.' + n + '.body') %></p>
        </div>
        <% }); %>
      </div>
    </section>

    <section class="tk-about__sec">
      <div class="tk-about__head">
        <h2 class="tk-about__h2" data-i18n="comms.h2"><%- t('comms.h2') %></h2>
      </div>
      <div class="tk-about__comms">
        <div class="tk-about__comm">
          <span class="tk-about__comm-num" data-i18n="comms.01.num"><%- t('comms.01.num') %></span>
          <svg viewBox="0 0 48 48" width="52" height="52" fill="none" stroke="#E34234" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M4 6h40v26H16L4 42V6Z"></path><path d="M13 15h22M13 23h14"></path></svg>
          <span class="tk-about__comm-title" data-i18n="comms.01.title"><%- t('comms.01.title') %></span>
        </div>
        <div class="tk-about__comm">
          <span class="tk-about__comm-num" data-i18n="comms.02.num"><%- t('comms.02.num') %></span>
          <svg viewBox="0 0 48 48" width="52" height="52" fill="none" stroke="#E34234" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M4 12h26v24H4V12Z"></path><path d="M30 21l14-8v22l-14-8"></path><path d="M10 18h6"></path></svg>
          <span class="tk-about__comm-title" data-i18n="comms.02.title"><%- t('comms.02.title') %></span>
        </div>
        <div class="tk-about__comm">
          <span class="tk-about__comm-num" data-i18n="comms.03.num"><%- t('comms.03.num') %></span>
          <svg viewBox="0 0 48 48" width="52" height="52" fill="none" stroke="#E34234" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true"><path d="M24 5h0a6 6 0 0 1 6 6v11a6 6 0 0 1-12 0V11a6 6 0 0 1 6-6Z"></path><path d="M11 21v2a13 13 0 0 0 26 0v-2"></path><path d="M24 36v7M17 43h14"></path></svg>
          <span class="tk-about__comm-title" data-i18n="comms.03.title"><%- t('comms.03.title') %></span>
        </div>
        <div class="tk-about__comm tk-about__comm--accent">
          <span class="tk-about__comm-num" data-i18n="comms.04.num"><%- t('comms.04.num') %></span>
          <span class="tk-about__comm-title" data-i18n="comms.04.title"><%- t('comms.04.title') %></span>
        </div>
      </div>
    </section>

    <section class="tk-about__sec tk-about__sec--paper tk-about__sec--stats" data-bg="paper">
      <div class="tk-about__stats" id="tkStats">
        <div class="tk-about__stat">
          <span class="tk-about__stat-num" id="tkStatStreams">0+</span>
          <span class="tk-about__stat-label" data-i18n="stats.streamsLabel"><%- t('stats.streamsLabel') %></span>
        </div>
        <span class="tk-about__stat-rule"></span>
        <div class="tk-about__stat">
          <span class="tk-about__stat-num" id="tkStatVenues">0+</span>
          <span class="tk-about__stat-label" data-i18n="stats.venuesLabel"><%- t('stats.venuesLabel') %></span>
        </div>
      </div>
      <div class="tk-about__quotes">
        <% [['l', 1], ['r', 2]].forEach(function (q) { %>
        <div class="tk-about__quote-box tk-about__quote-box--<%= q[0] %>">
          <p class="tk-about__quote" data-i18n="quote<%= q[1] %>.text"><%- t('quote' + q[1] + '.text') %></p>
          <span class="tk-about__quote-author" data-i18n="quote<%= q[1] %>.author"><%- t('quote' + q[1] + '.author') %></span>
        </div>
        <% }); %>
      </div>
    </section>

    <section class="tk-about__sec tk-about__cta" data-bleed>
      <h2 class="tk-about__cta-h" data-i18n="cta.h2"><%- t('cta.h2') %></h2>
      <div class="tk-about__fill"></div>
      <div class="tk-about__cta-side">
        <a href="<%= currentUser ? '/studio' : '/register' %>" class="tk-btn tk-btn--dark tk-about__cta-btn" data-i18n="cta.btn"><%- t('cta.btn') %></a>
        <span class="tk-about__cta-note" data-i18n="cta.note"><%- t('cta.note') %></span>
      </div>
    </section>

</main>

<%- include('partials/tkFooter') %>
</div>

<script defer src="<%= asset('/tk-landing.js') %>"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.about.title', descriptionKey: 'page.about.description' }) %>
<link rel="stylesheet" href="/css/prose.css">
</head>
<body>

<div class="tk-shell">
<%- include('partials/tkHeader', { navActive: 'about' }) %>

<main class="tk-prose" data-bg="paper">
  <div class="tk-prose__inner">
    <span class="tk-prose__kicker" data-i18n="about.kicker"><%- t('about.kicker') %></span>
    <h1 class="tk-prose__title">Takebana</h1>

    <div class="tk-prose__body">
      <p data-i18n="about.lede"><%- t('about.lede') %></p>
      <p data-i18n="about.p1"><%- t('about.p1') %></p>
      <p data-i18n="about.p2"><%- t('about.p2') %></p>

      <h2 data-i18n="about.features"><%- t('about.features') %></h2>
      <p data-i18n="about.f1"><%- t('about.f1') %></p>
      <p data-i18n="about.f2"><%- t('about.f2') %></p>
      <p data-i18n="about.f3"><%- t('about.f3') %></p>
      <p data-i18n="about.f4"><%- t('about.f4') %></p>
      <p data-i18n="about.f5"><%- t('about.f5') %></p>
    </div>

    <p class="tk-prose__cta" data-i18n="auth.noAccount"><%- t('auth.noAccount') %></p>
  </div>
</main>

<%- include('partials/tkFooter') %>
</div>

<%- include('partials/tkMenu', { navActive: 'about' }) %>

<script defer src="/tk-i18n-<%= lang %>.js"></script>
<script defer src="/tk-i18n.js"></script>
<script defer src="/tk.js"></script>
</body>
</html>

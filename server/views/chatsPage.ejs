<!DOCTYPE html>
<html lang="ru">
<head>
<%- include('partials/tkHead', { title: 'Чаты — Takebana' }) %>
<link rel="stylesheet" href="/css/app.css">
<link rel="stylesheet" href="/css/chats.css">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-chat" id="chat">

      <!-- Список диалогов -->
      <section class="tk-chat__list">
        <div class="tk-chat__list-head">
          <h1 class="tk-chat__h1" data-i18n="app.messages">Сообщения</h1>
          <p class="tk-chat__sub" data-i18n="chats.pickHint">Выберите диалог для просмотра</p>
        </div>

        <div class="tk-chat__scroll" id="conversationsList">
          <% if (conversations && conversations.length) { %>
            <% conversations.forEach(function (conversation) { %>
            <button
              type="button"
              class="tk-dialog chat__profile"
              data-id="<%= conversation.interlocutor._id %>"
              data-avatar="<%= conversation.interlocutor.avatarStyle.url || conversation.interlocutor.avatarStyle.gradient %>"
              data-name="<%= conversation.interlocutor.displayName %>"
              data-presence-user="<%= conversation.interlocutor._id %>"
            >
              <span class="tk-dialog__ava"<% if (!conversation.interlocutor.avatarStyle.url) { %> data-bg="<%= conversation.interlocutor.avatarStyle.gradient %>"<% } %>>
                <% if (conversation.interlocutor.avatarStyle.url) { %>
                  <img src="<%= conversation.interlocutor.avatarStyle.url %>" alt="" loading="lazy">
                <% } else { %>
                  <%= conversation.interlocutor.avatarStyle.initial %>
                <% } %>
                <% if (conversation.hasUnreadMessages) { %>
                  <span class="unread-indicator"></span>
                <% } %>
              </span>

              <span class="tk-dialog__body">
                <span class="tk-dialog__top">
                  <span class="tk-dialog__who">
                    <span class="tk-dialog__name"><%= conversation.interlocutor.displayName %></span>
                    <span class="presence-dot <%= conversation.interlocutor.isOnline ? 'presence-online' : 'presence-offline' %>"></span>
                  </span>
                  <%# Серверный timeAgo отдаёт только английское «5 minutes ago».
                      Отдаём саму дату, а подпись собирает chats.js на языке
                      интерфейса; текст внутри — запасной вариант без JS. %>
                  <span class="tk-dialog__when" data-time="<%= (conversation.lastMessage ? conversation.lastMessage.sentAt : conversation.createdAt).toISOString() %>">
                    <%= conversation.lastMessage ? timeAgo(conversation.lastMessage.sentAt) : timeAgo(conversation.createdAt) %>
                  </span>
                </span>

                <span class="tk-dialog__last">
                  <% if (conversation.lastMessage) { %>
                    <%= conversation.lastMessage.content.length > 40
                          ? conversation.lastMessage.content.substring(0, 40) + '…'
                          : conversation.lastMessage.content %>
                  <% } else { %>
                    <span data-i18n="chats.empty">Нет сообщений</span>
                  <% } %>
                </span>
              </span>
            </button>
            <% }); %>
          <% } else { %>
            <p class="tk-note tk-chat__empty-list" data-i18n="chats.empty">Нет сообщений</p>
          <% } %>
        </div>
      </section>

      <!-- Переписка -->
      <section class="tk-chat__area">
        <div class="tk-chat__head">
          <button type="button" class="tk-chat__back" id="backToList" aria-label="К списку диалогов" data-i18n-aria="chats.backToList">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>

          <span class="tk-chat__ava-big" id="chatAvatar">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"></path></svg>
          </span>

          <div class="tk-chat__peer-wrap" id="peerLink">
            <div class="tk-chat__peer" id="chatHeaderPresence" data-presence-user="">
              <h2 class="avatar__name" data-i18n="chats.pick">Выберите диалог</h2>
              <span class="presence-dot presence-offline hidden"></span>
            </div>
            <p class="tk-chat__peer-note" data-i18n="chats.startHint">для начала переписки</p>
          </div>
        </div>

        <div class="tk-chat__feed chat__messeg-box" id="feed"></div>

        <div class="tk-chat__compose">
          <form id="composeForm">
            <input
              type="text"
              id="messageInput"
              class="tk-field"
              data-id=""
              placeholder="Введите сообщение..."
              data-i18n-placeholder="chats.messagePh"
              autocomplete="off"
            >
            <button type="submit" class="tk-btn tk-btn--primary tk-btn--sm tk-chat__send input__button-icons" data-id="">
              <span data-i18n="chats.send">Отправить</span>
            </button>
          </form>
        </div>
      </section>

    </div>
  </main>
</div>

<script src="/chats.js"></script>
</body>
</html>

<%#
  Переписка (/chatsPage): слева три вкладки — диалоги, журнал звонков
  и контакты, справа открытый диалог, где звонки стоят в ленте между
  сообщениями. Пока диалог не выбран, правая часть пустая. Маршрут —
  routes/streaming/messages.js, журнал — routes/calls.js, контакты —
  routes/contacts.js, поведение — public/chats.js.
%>
<% var missed = typeof missedCalls !== 'undefined' ? missedCalls : 0; %>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.chats.title' }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/chats.css') %>">
<link rel="stylesheet" href="<%= asset('/css/lightbox.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-chat" id="chat">

      <!-- Списки: диалоги, звонки и контакты. Вкладки — ссылки: без скрипта тоже работают. -->
      <section class="tk-chat__list">
        <div class="tk-chat__tabs" role="tablist">
          <a href="/chatsPage" class="tk-chat__tab" role="tab" id="tabMessages" data-tab="messages" aria-controls="conversationsList" aria-selected="<%= tab === 'messages' %>">
            <span data-i18n="app.messages"><%- t('app.messages') %></span>
          </a>
          <a href="/chatsPage?tab=calls" class="tk-chat__tab" role="tab" id="tabCalls" data-tab="calls" aria-controls="callsList" aria-selected="<%= tab === 'calls' %>">
            <span data-i18n="calls.title"><%- t('calls.title') %></span>
            <span class="tk-chat__badge<%= missed ? '' : ' hidden' %>" data-missed-calls><%= missed %></span>
          </a>
          <a href="/chatsPage?tab=contacts" class="tk-chat__tab" role="tab" id="tabContacts" data-tab="contacts" aria-controls="contactsList" aria-selected="<%= tab === 'contacts' %>">
            <span data-i18n="contacts.title"><%- t('contacts.title') %></span>
          </a>
        </div>

        <%# Недавние: с кем чаще и ближе к сегодняшнему дню общались — письмами
            и звонками (utils/recentPeers.js). Порядок задаёт сервер, дальше
            ленту двигает chats.js: написали кому-то — он уезжает в начало.
            Те же data-ava-*, что у строки диалога: открывают её одним кодом. %>
        <div class="tk-recent" id="recentPeers"<% if (tab !== 'messages' || !recent.length) { %> hidden<% } %>>
          <p class="tk-recent__title" data-i18n="chats.recent"><%- t('chats.recent') %></p>
          <div class="tk-recent__row" id="recentRow">
            <% recent.forEach(function (p) { %>
            <button
              type="button"
              class="tk-recent__item"
              data-id="<%= p.id %>"
              data-name="<%= p.displayName %>"
              data-ava-url="<%= p.avatarStyle.url || '' %>"
              data-ava-bg="<%= p.avatarStyle.gradient || '' %>"
              data-ava-initial="<%= p.avatarStyle.initial || '' %>"
              data-presence-user="<%= p.id %>"
              title="<%= p.displayName %>"
            >
              <span class="tk-recent__ava"<% if (!p.avatarStyle.url) { %> style="background: <%= p.avatarStyle.gradient %>"<% } %>>
                <% if (p.avatarStyle.url) { %><img src="<%= p.avatarStyle.url %>" alt="" loading="lazy"><% } else { %><%= p.avatarStyle.initial %><% } %>
                <span class="presence-dot <%= p.isOnline ? 'presence-online' : 'presence-offline' %>"></span>
              </span>
              <span class="tk-recent__name"><%= p.displayName %></span>
            </button>
            <% }); %>
          </div>
        </div>

        <%# Контакты — личная записная книжка (models/Contact.js). Список
            и подсказки собирает chats.js из /api/contacts при открытии вкладки.
            Поле поиска отсеивает уже загруженные строки, никуда не ходя. %>
        <div class="tk-contacts" id="contactsPane" role="tabpanel" aria-labelledby="tabContacts"<% if (tab !== 'contacts') { %> hidden<% } %>>
          <div class="tk-contacts__search">
            <input type="search" id="contactSearch" class="tk-field" placeholder="<%= ta('contacts.search') %>" data-i18n-placeholder="contacts.search" autocomplete="off">
          </div>
          <div class="tk-chat__scroll" id="contactsList"></div>
        </div>

        <%# Журнал звонков собирает chats.js из /api/calls: при открытии вкладки. %>
        <div class="tk-chat__scroll" id="callsList" role="tabpanel" aria-labelledby="tabCalls"<% if (tab !== 'calls') { %> hidden<% } %>></div>

        <div class="tk-chat__scroll" id="conversationsList" role="tabpanel" aria-labelledby="tabMessages"<% if (tab !== 'messages') { %> hidden<% } %>>
          <% conversations.forEach(function (c) { var p = c.interlocutor; %>
          <button
            type="button"
            class="tk-dialog"
            data-id="<%= p.id %>"
            data-name="<%= p.displayName %>"
            data-ava-url="<%= p.avatarStyle.url || '' %>"
            data-ava-bg="<%= p.avatarStyle.gradient || '' %>"
            data-ava-initial="<%= p.avatarStyle.initial || '' %>"
            data-presence-user="<%= p.id %>"
          >
            <span class="tk-dialog__ava"<% if (!p.avatarStyle.url) { %> data-bg="<%= p.avatarStyle.gradient %>"<% } %>>
              <% if (p.avatarStyle.url) { %><img src="<%= p.avatarStyle.url %>" alt="" loading="lazy"><% } else { %><%= p.avatarStyle.initial %><% } %>
            </span>

            <span class="tk-dialog__body">
              <span class="tk-dialog__top">
                <span class="tk-dialog__who">
                  <span class="tk-dialog__name"><%= p.displayName %></span>
                  <span class="presence-dot <%= p.isOnline ? 'presence-online' : 'presence-offline' %>"></span>
                </span>
                <%# Дата — для chats.js: он обновляет подпись со временем
                    и при смене языка. %>
                <span class="tk-dialog__when" data-time="<%= new Date(c.lastActivity).toISOString() %>"><%= timeAgo(c.lastActivity, lang) %></span>
              </span>

              <span class="tk-dialog__bottom">
                <span class="tk-dialog__last">
                  <% if (c.last) { %><% if (c.last.mine) { %><span data-i18n="chats.you"><%- t('chats.you') %></span> <% } %><% if (c.last.expired) { %><span data-i18n="chats.gone"><%- t('chats.gone') %></span><% } else if (c.last.limited) { %><span data-i18n="chats.sealed.<%= c.last.kind || 'text' %>"><%- t('chats.sealed.' + (c.last.kind || 'text')) %></span><% } else { %><% if (c.last.kind) { %><span data-i18n="chats.att.<%= c.last.kind %>"><%- t('chats.att.' + c.last.kind) %></span><% if (c.last.content) { %> · <% } %><% } %><%= c.last.content %><% } %><% } else { %><span data-i18n="chats.empty"><%- t('chats.empty') %></span><% } %>
                </span>
                <span class="tk-dialog__unread<%= c.unread ? '' : ' hidden' %>"><%= c.unread %></span>
              </span>
            </span>
          </button>
          <% }); %>
          <p class="tk-note tk-chat__empty-list<%= conversations.length ? ' hidden' : '' %>" id="conversationsEmpty" data-i18n="chats.empty"><%- t('chats.empty') %></p>
        </div>
      </section>

      <!-- Переписка: пока диалог не выбран, содержимое скрыто (chats.css) -->
      <section class="tk-chat__area">
        <div class="tk-chat__head">
          <button type="button" class="tk-chat__back" id="backToList" aria-label="<%= ta('chats.backToList') %>" data-i18n-aria="chats.backToList">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>

          <%# Имя, аватар и присутствие ставит chats.js при выборе диалога. %>
          <span class="tk-chat__ava-big" id="chatAvatar"></span>

          <div class="tk-chat__peer-wrap" id="peerLink">
            <div class="tk-chat__peer" id="chatHeaderPresence" data-presence-user="">
              <h2 id="peerName"></h2>
              <span class="presence-dot presence-offline"></span>
            </div>
          </div>

          <%# Звонок и видеозвонок прямо из переписки. Корзинка отсюда убрана
              (23.09): удаление переписки — в меню её строки в списке слева,
              правым кликом или удержанием. %>
          <button type="button" class="tk-chat__tool" id="callAudio" aria-label="<%= ta('calls.audio') %>" data-i18n-aria="calls.audio" title="<%= ta('calls.audio') %>" data-i18n-title="calls.audio">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M6.5 3.5h3l1.5 4-2 1.5a12 12 0 006 6l1.5-2 4 1.5v3c0 1.1-.9 2-2 2A15.5 15.5 0 014.5 5.5c0-1.1.9-2 2-2z"></path></svg>
          </button>
          <button type="button" class="tk-chat__tool" id="callVideo" aria-label="<%= ta('calls.video') %>" data-i18n-aria="calls.video" title="<%= ta('calls.video') %>" data-i18n-title="calls.video">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M3.5 6.5h11v11h-11zM14.5 10.5l6-3v9l-6-3z"></path></svg>
          </button>
        </div>

        <%# Режим выбора: вместо шапки диалога — сколько выбрано и что с этим
            сделать. Включается пунктом «Выделить» в меню сообщения (chats.js). %>
        <div class="tk-chat__pickbar" id="pickBar" hidden>
          <button type="button" class="tk-chat__tool" id="pickCancel" aria-label="<%= ta('chats.pickCancel') %>" data-i18n-aria="chats.pickCancel" title="<%= ta('chats.pickCancel') %>" data-i18n-title="chats.pickCancel">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
          </button>
          <span class="tk-chat__pickcount" id="pickCount" aria-live="polite"></span>
          <button type="button" class="tk-btn tk-btn--ghost tk-btn--sm" data-pick="forward" data-i18n="chats.forward"><%- t('chats.forward') %></button>
          <button type="button" class="tk-btn tk-btn--ghost tk-btn--sm" data-pick="copy" data-i18n="chats.copy"><%- t('chats.copy') %></button>
          <button type="button" class="tk-btn tk-btn--primary tk-btn--sm" data-pick="delete" data-i18n="chats.delete"><%- t('chats.delete') %></button>
        </div>

        <div class="tk-chat__feed" id="feed"></div>

        <%# Поле ввода. Скрепка — файл (ещё: перетащить в ленту или вставить
            из буфера), микрофон — голосовое. Пока идёт запись, вместо поля —
            полоса записи. Файл уходит сразу, текст из поля — подписью к нему. %>
        <div class="tk-chat__compose">
          <form id="composeForm">
            <button type="button" class="tk-chat__tool tk-chat__clip" id="attachBtn" aria-label="<%= ta('chats.attach') %>" data-i18n-aria="chats.attach" title="<%= ta('chats.attach') %>" data-i18n-title="chats.attach">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M20 11.5l-8.2 8.2a5 5 0 01-7.1-7.1l8.5-8.5a3.3 3.3 0 014.7 4.7l-8.4 8.4a1.7 1.7 0 01-2.4-2.4l7.7-7.7"></path></svg>
            </button>
            <input type="file" id="attachInput" multiple hidden>
            <%# Исчезающее: выбор действует на следующее сообщение, файл,
                голосовое или кружок и после отправки сбрасывается. %>
            <button type="button" class="tk-chat__tool tk-chat__limit" id="limitBtn" aria-haspopup="menu" aria-expanded="false" aria-label="<%= ta('chats.limit.button') %>" data-i18n-aria="chats.limit.button" title="<%= ta('chats.limit.button') %>" data-i18n-title="chats.limit.button">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h14M5 21h14M7 3l5 9-5 9M17 3l-5 9 5 9"></path></svg>
              <span class="tk-chat__limit-badge" id="limitBadge" hidden></span>
            </button>
            <input type="text" id="messageInput" class="tk-field" placeholder="<%= ta('chats.messagePh') %>" data-i18n-placeholder="chats.messagePh" autocomplete="off" maxlength="5000" enterkeyhint="send">
            <%# Одно гнездо на две смены, как в WhatsApp (21.09): поле пустое —
                микрофон и кружок, в поле текст — «Отправить». Смена плавная
                (chats.css, .has-text). %>
            <div class="tk-chat__acts">
              <div class="tk-chat__media">
                <button type="button" class="tk-chat__tool tk-chat__mic" id="micBtn" aria-label="<%= ta('chats.voice') %>" data-i18n-aria="chats.voice" title="<%= ta('chats.voice') %>" data-i18n-title="chats.voice">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5.5 11a6.5 6.5 0 0013 0M12 17.5V21"></path></svg>
                </button>
                <button type="button" class="tk-chat__tool tk-chat__cam" id="roundBtn" aria-label="<%= ta('chats.round') %>" data-i18n-aria="chats.round" title="<%= ta('chats.round') %>" data-i18n-title="chats.round">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="3.5"></circle></svg>
                </button>
              </div>
              <button type="submit" class="tk-chat__send" id="sendBtn" tabindex="-1" aria-label="<%= ta('chats.send') %>" data-i18n-aria="chats.send" title="<%= ta('chats.send') %>" data-i18n-title="chats.send">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
              </button>
            </div>
            <%# Запись голосового — как в WhatsApp (21.09): нажали микрофон —
                поле уступает место полосе записи: отмена, время, живая волна,
                пауза и «Отправить». Держать палец больше не нужно. %>
            <div class="tk-rec" id="recBar" aria-hidden="true">
              <button type="button" class="tk-chat__tool tk-rec__cancel" id="recCancel" aria-label="<%= ta('chats.recCancel') %>" data-i18n-aria="chats.recCancel" title="<%= ta('chats.recCancel') %>" data-i18n-title="chats.recCancel">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"></path></svg>
              </button>
              <span class="tk-rec__dot" aria-hidden="true"></span>
              <span class="tk-rec__time" id="recTime" role="timer">0:00</span>
              <span class="tk-rec__wave" id="recWave" aria-hidden="true"></span>
              <button type="button" class="tk-chat__tool tk-rec__pause" id="recPause" aria-pressed="false" aria-label="<%= ta('chats.pause') %>" data-i18n-aria="chats.pause" title="<%= ta('chats.pause') %>" data-i18n-title="chats.pause">
                <svg class="tk-ico-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.5" height="14"></rect><rect x="14" y="5" width="3.5" height="14"></rect></svg>
                <svg class="tk-ico-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13L19 12z"></path></svg>
              </button>
              <button type="button" class="tk-chat__send" id="recSend" aria-label="<%= ta('chats.send') %>" data-i18n-aria="chats.send" title="<%= ta('chats.send') %>" data-i18n-title="chats.send">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
              </button>
            </div>
          </form>
          <p class="tk-chat__blocked" id="chatBlocked" hidden></p>
        </div>
        <div class="tk-chat__drop" id="dropZone" hidden><span data-i18n="chats.dropHere"><%- t('chats.dropHere') %></span></div>
      </section>

    </div>
  </main>
</div>

<%# Действия с сообщением или звонком в ленте: правый клик, на телефоне —
    удержание, с клавиатуры — Enter. У звонка — только «Выделить» и «Удалить»:
    data-for="message" chats.js прячет. %>
<div class="tk-msgmenu" id="msgMenu" role="menu" hidden>
  <button type="button" role="menuitem" data-act="forward" data-for="message" data-i18n="chats.forward"><%- t('chats.forward') %></button>
  <button type="button" role="menuitem" data-act="copy" data-for="message" data-i18n="chats.copy"><%- t('chats.copy') %></button>
  <button type="button" role="menuitem" data-act="select" data-i18n="chats.select"><%- t('chats.select') %></button>
  <button type="button" role="menuitem" data-act="delete" class="tk-msgmenu__danger" data-i18n="chats.delete"><%- t('chats.delete') %></button>
</div>

<%# Действия со строкой диалога в списке слева: правый клик, на телефоне —
    удержание. Кнопка жалобы несёт data-report — её открывает report.js,
    ему же chats.js подставляет id и имя собеседника. %>
<%# Меню человека: строка диалога, строка контакта, строка журнала звонков.
    data-in перечисляет, где пункт уместен: «удалить переписку» — только
    в списке диалогов, избранное — только в контактах. Прячет их chats.js. %>
<div class="tk-msgmenu" id="peerMenu" role="menu" hidden>
  <button type="button" role="menuitem" data-act="call" data-i18n="calls.audio"><%- t('calls.audio') %></button>
  <button type="button" role="menuitem" data-act="video" data-i18n="calls.video"><%- t('calls.video') %></button>
  <button type="button" role="menuitem" data-act="write" data-in="contact,call" data-i18n="contacts.write"><%- t('contacts.write') %></button>
  <button type="button" role="menuitem" data-act="favorite" data-in="contact" data-i18n="contacts.favorite"><%- t('contacts.favorite') %></button>
  <button type="button" role="menuitem" data-act="unfavorite" data-in="contact" data-i18n="contacts.unfavorite"><%- t('contacts.unfavorite') %></button>
  <button type="button" role="menuitem" data-act="contactAdd" data-i18n="contacts.add"><%- t('contacts.add') %></button>
  <button type="button" role="menuitem" data-act="contactRemove" data-i18n="contacts.remove"><%- t('contacts.remove') %></button>
  <button type="button" role="menuitem" data-act="report" data-report="user" data-report-id="" data-i18n="common.report"><%- t('common.report') %></button>
  <button type="button" role="menuitem" data-act="delete" data-in="dialog" class="tk-msgmenu__danger" data-i18n="chats.deleteChat"><%- t('chats.deleteChat') %></button>
</div>

<!-- Пересылка -->
<div class="tk-modal hidden" id="forwardModal">
  <div class="tk-modal__card">
    <div class="tk-modal__head">
      <h3 class="tk-modal__title" data-i18n="chats.forwardTitle"><%- t('chats.forwardTitle') %></h3>
      <button type="button" class="tk-modal__close" id="forwardClose" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>
    <div class="tk-modal__body">
      <p class="tk-fwd__quote" id="forwardQuote"></p>
      <%# Своё к пересылаемому: уходит первым, над пересланным. %>
      <textarea class="tk-field tk-fwd__comment" id="forwardComment" rows="2" maxlength="5000" placeholder="<%= ta('chats.forwardComment') %>" data-i18n-placeholder="chats.forwardComment"></textarea>
      <input type="text" class="tk-field" id="forwardSearch" placeholder="<%= ta('chats.forwardSearch') %>" data-i18n-placeholder="chats.forwardSearch" autocomplete="off">
      <div class="tk-fwd__list" id="forwardList"></div>
    </div>
    <div class="tk-modal__foot">
      <button type="button" class="tk-btn tk-btn--primary tk-btn--sm tk-btn--block" id="forwardSend" disabled>
        <span data-i18n="chats.forwardSend"><%- t('chats.forwardSend') %></span><span id="forwardCount"></span>
      </button>
    </div>
  </div>
</div>

<%# Выбор ограничения: значения — utils/messageLimit.js (OPTIONS).
    Восемь строк подряд читались одним списком, хотя условия разной природы:
    теперь «сколько раз» и «сколько времени» — два раздела с заголовками. %>
<div class="tk-msgmenu tk-limitmenu" id="limitMenu" role="menu" hidden>
  <p class="tk-limitmenu__title" data-i18n="chats.limit.title"><%- t('chats.limit.title') %></p>
  <button type="button" role="menuitemradio" aria-checked="true" data-limit="" data-i18n="chats.limit.none"><%- t('chats.limit.none') %></button>
  <% [
       { id: 'Count', title: 'chats.limit.group.count', opts: ['n1', 'n2', 'n3'] },
       { id: 'Time',  title: 'chats.limit.group.time',  opts: ['t10', 't60', 't600', 't3600'] }
     ].forEach(function (g) { %>
  <div class="tk-limitmenu__sec" role="group" aria-labelledby="limitGrp<%= g.id %>">
    <p class="tk-limitmenu__group" id="limitGrp<%= g.id %>" data-i18n="<%= g.title %>"><%- t(g.title) %></p>
    <% g.opts.forEach(function (v) { var key = 'chats.limit.' + v; %>
    <button type="button" role="menuitemradio" aria-checked="false" data-limit="<%= v %>" data-i18n="<%= key %>"><%- t(key) %></button>
    <% }); %>
  </div>
  <% }); %>
  <p class="tk-limitmenu__hint" data-i18n="chats.limit.hint"><%- t('chats.limit.hint') %></p>
</div>

<!-- Запись кружка -->
<div class="tk-roundrec hidden" id="roundRec" role="dialog" aria-modal="true" aria-label="<%= ta('chats.round') %>" data-i18n-aria="chats.round">
  <div class="tk-roundrec__stage">
    <video id="roundPreview" muted playsinline autoplay></video>
    <svg class="tk-roundrec__ring" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="48"></circle></svg>
  </div>
  <span class="tk-roundrec__time" id="roundTime">0:00</span>
  <%# На телефоне три текстовые кнопки не помещались в ширину — теперь
      значки: отмена, пауза/продолжить, отправить (21.09). Подписи — в
      aria-label; на широком экране слова рядом со значками остаются. %>
  <div class="tk-roundrec__acts">
    <button type="button" class="tk-btn tk-btn--ghost tk-btn--sm tk-roundrec__btn" id="roundCancel" aria-label="<%= ta('common.cancel') %>" data-i18n-aria="common.cancel">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      <span data-i18n="common.cancel"><%- t('common.cancel') %></span>
    </button>
    <button type="button" class="tk-btn tk-btn--outline tk-btn--sm tk-roundrec__btn" id="roundPause" aria-pressed="false" aria-label="<%= ta('chats.pause') %>" data-i18n-aria="chats.pause">
      <svg class="tk-ico-pause" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.5" height="14"></rect><rect x="14" y="5" width="3.5" height="14"></rect></svg>
      <svg class="tk-ico-play" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13L19 12z"></path></svg>
      <span data-i18n="chats.pause"><%- t('chats.pause') %></span>
    </button>
    <button type="button" class="tk-btn tk-btn--primary tk-btn--sm tk-roundrec__btn" id="roundSend" aria-label="<%= ta('chats.send') %>" data-i18n-aria="chats.send">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
      <span data-i18n="chats.send"><%- t('chats.send') %></span>
    </button>
  </div>
</div>

<%# Сколько осталось у исчезающего с таймером — поверх окна просмотра. %>
<span class="tk-oncetimer" id="onceTimer" role="timer" hidden></span>

<!-- Просмотр картинки из переписки -->
<div id="lightbox" class="tk-lightbox hidden" role="dialog" aria-modal="true">
  <button type="button" class="tk-lightbox__btn tk-lightbox__close" id="lightboxClose" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
  </button>
  <%# Без src: адрес подставляет chats.js при открытии. %>
  <img id="lightboxImg" alt="">
</div>

<!-- Просмотр видео: плеер Takebana, как у записей и галереи. Скрипт и стили
     плеера chats.js подгружает при первом открытии: в переписке видео редкость. -->
<div id="videoBox" class="tk-lightbox tk-videobox hidden" role="dialog" aria-modal="true"
     data-player-js="<%= asset('/tk-player.js') %>" data-player-css="<%= asset('/css/player.css') %>">
  <button type="button" class="tk-lightbox__btn tk-lightbox__close" id="videoBoxClose" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
  </button>
  <div class="tk-videobox__stage">
    <%- include('partials/player', { mode: 'vod' }) %>
  </div>
</div>

<script defer src="<%= asset('/chats.js') %>"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f1fe',
                            100: '#e3e5fd',
                            200: '#cccefa',
                            300: '#a7aaf5',
                            400: '#7c7aef',
                            500: '#666bcf',
                            600: '#5148b5',
                            700: '#453a93',
                            800: '#3a3178',
                            900: '#332b62'
                        }
                    }
                }
            }
        }
    </script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <title lng="214">Чаты - Takebana</title>
    <!-- escapeHtml для мест, где разметка собирается в браузере (чат, админка) -->
    <script src="/escape-html.js"></script>
</head>
<body class="font-inter bg-gray-50 overflow-hidden">
    <%- include('partials/header') %>

    <!-- Основной контейнер -->
    <div class="h-screen">
        <%- include('partials/leftBar') %>
        
        <!-- Основной контент -->
        <main class="lg:pl-72" style="height: calc(100vh - 80px);">
            <div class="h-full flex">
                
                <!-- Список диалогов -->
                <div class="w-full lg:w-96 bg-white border-r border-gray-200 flex flex-col h-full chat-list-panel">
                    <!-- Заголовок -->
                    <div class="p-3 lg:p-6 border-b border-gray-200 flex-shrink-0 chat-header">
                        <h1 class="text-lg lg:text-2xl font-bold text-gray-900" lng="215">Сообщения</h1>
                        <p class="text-xs lg:text-sm text-gray-500 mt-1" lng="216">Выберите диалог для просмотра</p>
                    </div>
                    
                    <!-- Список чатов -->
                    <div class="flex-1 overflow-y-auto" id="conversationsList">
                        <% conversations.forEach(conversation => { %>
                        <div 
                            class="chat__profile flex items-center gap-2 lg:gap-4 p-2 lg:p-4 hover:bg-gray-50 cursor-pointer border-b border-gray-100 transition-colors duration-200"
                            data-id="<%= conversation.interlocutor._id %>" 
                            data-avatar="<%= conversation.interlocutor.avatarStyle.url || conversation.interlocutor.avatarStyle.gradient %>"
                            data-name="<%= conversation.interlocutor.displayName %>"
                            onclick="selectConversation(this)"
                            data-presence-user="<%= conversation.interlocutor._id %>"
                        >
                            <!-- Аватар -->
                            <div class="flex-shrink-0 relative">
                                <% if (conversation.interlocutor.avatarStyle.url) { %>
                                    <img class="w-8 h-8 lg:w-12 lg:h-12 rounded-full object-cover border-2 border-gray-100 chat-avatar" 
                                         src="<%= conversation.interlocutor.avatarStyle.url %>" 
                                         alt="<%= conversation.interlocutor.displayName %>">
                                <% } else { %>
                                    <div class="w-8 h-8 lg:w-12 lg:h-12 rounded-full flex items-center justify-center text-white font-semibold text-xs lg:text-sm border-2 border-gray-100 chat-avatar"
                                         data-bg="<%= conversation.interlocutor.avatarStyle.gradient %>">
                                        <%= conversation.interlocutor.avatarStyle.initial %>
                                    </div>
                                <% } %>
                                <!-- Уведомление о непрочитанных -->
                                <% if (conversation.hasUnreadMessages) { %>
                                    <div class="absolute -top-1 -right-1 w-3 h-3 lg:w-4 lg:h-4 bg-red-500 rounded-full flex items-center justify-center">
                                        <div class="w-1.5 h-1.5 lg:w-2 lg:h-2 bg-white rounded-full"></div>
                                    </div>
                                <% } %>
                            </div>
                            
                            <!-- Информация о чате -->
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center justify-between mb-1">
                                    <div class="flex items-center gap-2" data-presence-user="<%= conversation.interlocutor._id %>">
                                        <h3 class="text-xs lg:text-sm font-semibold text-gray-900 truncate chat-name">
                                            <%= conversation.interlocutor.displayName %>
                                        </h3>
                                        <span class="inline-block w-2 h-2 rounded-full presence-dot <%= conversation.interlocutor.isOnline ? 'bg-green-500' : 'bg-gray-400' %>"></span>
                                    </div>
                                    <span class="text-xs text-gray-500 flex-shrink-0 ml-1 lg:ml-2 chat-time">
                                        <%= conversation.lastMessage ? timeAgo(conversation.lastMessage.sentAt) : timeAgo(conversation.createdAt) %>
                                    </span>
                                </div>
                                <p class="text-xs lg:text-sm text-gray-600 truncate chat-message">
                                    <% if (conversation.lastMessage) { %>
                                        <% let content = conversation.lastMessage.content; %>
                                        <% if (content.length > 30) { %>
                                            <%= content.substring(0, 30) + '...' %>
                                        <% } else { %>
                                            <%= content %>
                                        <% } %>
                                    <% } else { %>
                                        <span lng="107">Нет сообщений</span>
                                    <% } %>
                                </p>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                </div>
                
                <!-- Область чата -->
                <div class="flex-1 flex flex-col bg-white h-full chat-area-panel">
                    
                    <!-- Заголовок чата -->
                    <div class="p-2 lg:p-4 border-b border-gray-200 bg-white flex items-center gap-2 lg:gap-4 flex-shrink-0">
                        <!-- Кнопка назад (мобильная) -->
                        <button class="lg:hidden p-1.5 lg:p-2 hover:bg-gray-100 rounded-lg transition-colors button__back chat-button" onclick="showConversationsList()">
                            <svg class="w-4 h-4 lg:w-5 lg:h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                            </svg>
                        </button>
                        
                        <!-- Аватар и имя собеседника -->
                        <div class="flex items-center gap-2 lg:gap-3 flex-1">
                            <div class="w-8 h-8 lg:w-10 lg:h-10 bg-gray-100 rounded-full flex items-center justify-center cursor-pointer hover:ring-2 hover:ring-brand-300 transition-all duration-200 chat-avatar-large" onclick="goToUserProfile()">
                                <svg class="w-4 h-4 lg:w-5 lg:h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </div>
                            <div class="cursor-pointer hover:bg-gray-50 rounded-lg p-1 lg:p-2 -m-1 lg:-m-2 transition-colors duration-200" onclick="goToUserProfile()">
                                <div class="flex items-center gap-2" id="chatHeaderPresence" data-presence-user="">
                                    <h2 class="font-semibold text-gray-900 avatar__name text-sm lg:text-base chat-name" lng="108">Выберите диалог</h2>
                                    <span class="inline-block w-2 h-2 rounded-full presence-dot hidden" style="background-color:#9ca3af"></span>
                                </div>
                                <p class="text-xs lg:text-sm text-gray-500 chat-subtitle" lng="217">для начала переписки</p>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Область сообщений -->
                    <div class="flex-1 overflow-y-auto p-2 lg:p-4 space-y-2 lg:space-y-4 chat__messeg-box bg-gray-50">
                        <!-- Сообщения будут загружены здесь -->
                    </div>
                    
                    <!-- Поле ввода -->
                    <div class="p-2 lg:p-4 border-t border-gray-200 bg-white flex-shrink-0 chat-input-bar max-[500px]:mb-[90px]">
                        <form onsubmit="event.preventDefault(); sendMessage(); return false;">
                            <div class="flex items-end gap-2 lg:gap-3">
                                <div class="flex-1">
                                    <input 
                                        type="text" 
                                        id="messageInput"
                                        data-id=""
                                        placeholder="Введите сообщение..."
                                        lng="218"
                                        class="w-full px-3 py-2 lg:px-4 lg:py-3 border border-gray-200 rounded-lg lg:rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent resize-none text-sm lg:text-base chat-input"
                                        autocomplete="off"
                                    >
                                </div>
                                <button 
                                    type="submit"
                                    class="input__button-icons bg-brand-500 hover:bg-brand-600 text-white px-3 py-2 lg:px-6 lg:py-3 rounded-lg lg:rounded-xl font-medium transition-colors flex items-center gap-1 lg:gap-2 text-xs lg:text-sm chat-send-button"
                                    data-id=""
                                >
                                    <svg class="w-3 h-3 lg:w-4 lg:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                                    </svg>
                                    <span lng="109" class="hidden sm:inline">Отправить</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Стили для мобильной адаптации -->
    <style>
        /* Мобильная навигация - показываем только одну панель за раз */
        @media (max-width: 1023px) {
            .chat-list-panel {
                display: flex;
            }
            
            .chat-area-panel {
                display: none;
            }
            
            .chat-area-panel.active {
                display: flex;
            }
            
            .chat-list-panel.hidden {
                display: none;
            }
        }
        
        /* Desktop - показываем обе панели */
        @media (min-width: 1024px) {
            .chat-list-panel,
            .chat-area-panel {
                display: flex;
            }
        }
        
        /* Стили для сообщений */
        .messeg__friends-wrapper {
            display: flex;
            justify-content: flex-start;
            margin-bottom: 1rem;
        }
        
        .messeg__you-wrapper {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            margin-bottom: 1rem;
        }
        
        .messeg__friends {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            max-width: 70%;
        }
        
        .messeg__friends img,
        .messeg__friends > div:first-child {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        
        .content__messeg-fiends {
            background: white;
            border: 1px solid #e5e7eb;
            padding: 0.75rem 1rem;
            border-radius: 1rem;
            border-bottom-left-radius: 0.25rem;
            margin-bottom: 0.25rem;
            color: #374151;
            font-size: 0.875rem;
            line-height: 1.25rem;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
        }
        
        .you__messeg {
            background: #666bcf;
            color: white;
            padding: 0.75rem 1rem;
            border-radius: 1rem;
            border-bottom-right-radius: 0.25rem;
            max-width: 70%;
            margin-bottom: 0.25rem;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
        }
        
        .you__messeg-content {
            font-size: 0.875rem;
            line-height: 1.25rem;
            margin-bottom: 0.25rem;
        }
        
        .time__messeg {
            font-size: 0.75rem;
            color: #9ca3af;
            margin-top: 0.25rem;
        }
        
        /* Время для ваших сообщений (под пузырем, справа) */
        .messeg__you-wrapper .time__messeg {
            text-align: right;
            color: #9ca3af;
            margin-top: 0.25rem;
        }
        
        /* Адаптация для mobile */
        @media (max-width: 1023px) {
            .messeg__friends,
            .you__messeg {
                max-width: 85%;
            }
        }
        
        @media (max-width: 640px) {
            .messeg__friends,
            .you__messeg {
                max-width: 90%;
            }
            
            .content__messeg-fiends,
            .you__messeg {
                padding: 0.5rem 0.75rem;
                font-size: 0.8125rem;
            }
            
            .messeg__friends img,
            .messeg__friends > div:first-child {
                width: 28px;
                height: 28px;
            }
            
            /* Компактные отступы */
            .chat-header {
                padding: 0.75rem !important;
            }
            
            .chat-header h1 {
                font-size: 1.125rem !important;
            }
            
            .chat-header p {
                font-size: 0.75rem !important;
            }
            
            /* Компактные аватары */
            .chat-avatar {
                width: 2rem !important;
                height: 2rem !important;
            }
            
            .chat-avatar-large {
                width: 2.5rem !important;
                height: 2.5rem !important;
            }
            
            /* Компактный текст */
            .chat-name {
                font-size: 0.75rem !important;
            }
            
            .chat-message {
                font-size: 0.75rem !important;
            }
            
            .chat-time {
                font-size: 0.625rem !important;
            }
            
            /* Компактные кнопки */
            .chat-button {
                padding: 0.5rem !important;
            }
            
            .chat-button svg {
                width: 1rem !important;
                height: 1rem !important;
            }
            
            /* Компактное поле ввода */
            .chat-input {
                padding: 0.5rem 0.75rem !important;
                font-size: 0.875rem !important;
            }
            
            .chat-send-button {
                padding: 0.5rem 0.75rem !important;
                font-size: 0.75rem !important;
            }
            
            .chat-send-button svg {
                width: 1rem !important;
                height: 1rem !important;
            }
        }
        
        /* Ультра-компактные стили для экранов ≤350px */
        @media (max-width: 350px) {
            .chat-header {
                padding: 0.5rem !important;
            }
            
            .chat-header h1 {
                font-size: 1rem !important;
            }
            
            .chat-avatar {
                width: 1.75rem !important;
                height: 1.75rem !important;
            }
            
            .chat-avatar-large {
                width: 2rem !important;
                height: 2rem !important;
            }
            
            .chat-name {
                font-size: 0.6875rem !important;
            }
            
            .chat-message {
                font-size: 0.6875rem !important;
            }
            
            .chat-time {
                font-size: 0.5625rem !important;
            }
            
            .chat-button {
                padding: 0.375rem !important;
            }
            

    </style>

    <!-- JavaScript -->
    <script src="/lang.js"></script>
    <script>
        // i18n helpers for this page (uses localStorage.lang + window.langDict from /lang.js)
        const getUILang = () => {
          try {
            const v = localStorage.getItem('lang');
            return (v === 'en' || v === 'ru') ? v : 'ru';
          } catch (e) {
            return 'ru';
          }
        };
        const t = (key, fallbackRu, fallbackEn) => {
          const l = getUILang();
          try {
            if (window.langDict && window.langDict[key] && typeof window.langDict[key][l] !== 'undefined') {
              return window.langDict[key][l];
            }
          } catch (e) {}
          return l === 'en' ? fallbackEn : fallbackRu;
        };

        // Глобальные переменные
        let loadedMessages = [];
        let offset = 0;
        let lastMessageTimestamp = null;
        let currentRecipientId = null; // Добавляем переменную для текущего собеседника
        let currentRecipientName = ''; // Добавляем переменную для имени собеседника
        let currentRecipientAvatar = ''; // Добавляем переменную для аватара собеседника
        let messageCheckInterval = null;

        let profile = document.querySelector(".profile__box")
        let Avatar = document.querySelector(".AVATAR")
        let buttonExit = document.querySelector(".button__exit")
        let shodow = document.querySelector(".shodow")
        let chatMessegProfil = document.querySelectorAll(".chat__profile")
        let  chatListBox = document.getElementById("conversationsList").parentElement
        let  chatMesseg = document.querySelector(".flex-1.flex.flex-col.bg-white")
        let  buttonBackChat = document.querySelector(".button__back")
        let  serhButton = document.querySelector(".serh-button")
        let  serhWrapper = document.querySelector(".serh__wrapper")
        let  inputSerh = document.querySelector(".input__serh")
        let  buttonLine = document.querySelector(".button__line")
        let  categoriesBox = document.querySelector(".categories__box")
        let  titleCategories = document.querySelectorAll(".title__categories ")
        let  titleBox = document.querySelector(".title__box")
        let  profilName = document.querySelectorAll(".profil__name")
        let  priwMore = document.querySelector(".priw__more")

        console.log('conversations found:', chatMessegProfil.length);

        document.addEventListener('DOMContentLoaded', function() {

            // Обработчики для UI элементов
            if (Avatar) {
                Avatar.addEventListener( "click" , ()=>{
                    if (profile) profile.classList.add("display-block")
                    if (notification) notification.classList.remove("display-block")
                    if (shodow) shodow.classList.add("display-block")
                });
            }

            if (buttonExit) {
                buttonExit.addEventListener( "click" , ()=>{
                    if (profile) profile.classList.remove("display-block")
                    if (shodow) shodow.classList.remove("display-block")
                });
            }

            if (shodow) {
                shodow.addEventListener( "click" , ()=>{
                    if (notification) notification.classList.remove("display-block")
                    if (profile) profile.classList.remove("display-block")
                    shodow.classList.remove("display-block")
                    if (categoriesBox) categoriesBox.style = null;
                    if (titleBox) titleBox.style = null;
                    titleCategories.forEach((el)=>{
                        el.style = null;
                    });
                    profilName.forEach((el)=>{
                        el.style = null;
                    });
                    if (priwMore) priwMore.style = null;
                });
            }

            chatMessegProfil.forEach((el)=>{
                console.log('bind click for conversation:', el);
                el.addEventListener( "click" , ()=>{
                    console.log('conversation click');
                    if (window.innerWidth < 1024) { // Мобильная версия
                        if (chatListBox) chatListBox.classList.add("hidden")
                        if (chatMesseg) chatMesseg.classList.remove("hidden")
                    }
                })
            });

            if(buttonBackChat){
                buttonBackChat.addEventListener("click" , ()=>{
                    if (window.innerWidth < 1024) { // Мобильная версия
                        if (chatListBox) chatListBox.classList.remove("hidden")
                        if (chatMesseg) chatMesseg.classList.add("hidden")
                    }
                });
            }

            if (serhButton) {
                serhButton.addEventListener("click" , ()=>{
                    if (serhWrapper) serhWrapper.style.display="flex"
                    if (inputSerh) inputSerh.style.display="flex"
                    serhButton.style.display="none"
                });
            }

            if (buttonLine) {
                let leftMenu = document.querySelector('.categories__box');
                buttonLine.addEventListener('click', function() {
                    if (leftMenu) {
                        if (leftMenu.classList.contains('open')) {
                            leftMenu.classList.remove('open');
                        } else {
                            leftMenu.classList.add('open');
                        }
                    }
                });
            }
            
            // Enter для отправки сообщения
            const messageInput = document.getElementById('messageInput');
            if (messageInput) {
                messageInput.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter' && !event.shiftKey) {
                        event.preventDefault();
                        console.log('Enter нажат, отправляем сообщение');
                        sendMessage();
                    }
                });
                
                // Дополнительный обработчик на keypress для надежности
                messageInput.addEventListener('keypress', (event) => {
                    if (event.key === 'Enter' && !event.shiftKey) {
                        event.preventDefault();
                        console.log('Enter keypress, отправляем сообщение');
                        sendMessage();
                    }
                });
            }
        });

        // ВЫБОР ДИАЛОГА 
        // присвоение айди кнопке и текстареи отправкии собщения

        // Функция выбора диалога
        function selectConversation(element) {
            console.log('selectConversation вызвана!', element);
            
            const recipientId = element.getAttribute('data-id');
            const recipientAvatar = element.getAttribute('data-avatar');
            const recipientName = element.getAttribute('data-name');

            console.log('Выбранный ID оппонента:', recipientId);
            console.log('Аватар:', recipientAvatar);
            console.log('Имя:', recipientName);

            // Сохраняем текущие данные оппонента в глобальных переменных
            currentRecipientAvatar = recipientAvatar;
            currentRecipientName = recipientName;
            currentRecipientId = recipientId;

            markNotificationsAsRead(recipientId);

            // Присваиваем ID оппонента в атрибуты data-id текстового поля и кнопки
            document.getElementById('messageInput').setAttribute('data-id', recipientId);
            document.querySelector('.input__button-icons').setAttribute('data-id', recipientId);

            // Обновляем аватар и имя оппонента в блоке сверху
            updateAvatarAndName(recipientAvatar, recipientName);

            // Сбрасываем загруженные сообщения и смещение
            loadedMessages = [];
            offset = 0;
            loadingOldMessages = false;

            // Сбрасываем время последнего сообщения
            lastMessageTimestamp = null;

            const messagesContainer = document.querySelector('.chat__messeg-box');

            // Удаляем предыдущий обработчик события прокрутки, если он существует
            if (messagesContainerEventListener) {
                messagesContainer.removeEventListener('scroll', messagesContainerEventListener);
            }

            // Определяем новый обработчик события прокрутки
            messagesContainerEventListener = function() {
                handleScroll(messagesContainer, recipientId);
            };

            // Добавляем новый обработчик события прокрутки
            messagesContainer.addEventListener('scroll', messagesContainerEventListener);

            // Очищаем предыдущий интервал проверки новых сообщений
            if (messageCheckInterval) {
                clearInterval(messageCheckInterval);
            }

            // Запускаем новый интервал проверки новых сообщений каждые 5 секунд
            messageCheckInterval = setInterval(() => {
                checkForNewMessages(recipientId);
            }, 5000);

            // Загружаем сообщения для выбранного диалога
            loadMessages(recipientId, recipientAvatar, recipientName);
        }

        // Функция для пометки уведомлений как прочитанных
        async function markNotificationsAsRead(senderId) {
            try {
                const response = await fetch('/api/notifications/markAsRead', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ senderId }),
                });

                if (!response.ok) {
                    console.error('Ошибка при пометке уведомлений как прочитанных:', response.statusText);
                }
            } catch (error) {
                console.error('Ошибка при отправке запроса на пометку уведомлений:', error);
            }
        }

        // Функция для перехода на профиль пользователя
        function goToUserProfile() {
            if (currentRecipientId) {
                window.location.href = `/userPage/${currentRecipientId}`;
            } else {
                toast(t('219', 'Сначала выберите диалог для перехода к профилю собеседника.', 'First select a conversation to open the user profile.'));
            }
        }

        // Функция обновления аватара и имени
        function updateAvatarAndName(avatar, name) {
            const avatarContainer = document.querySelector('.flex.items-center.gap-3.flex-1');
            const nameElement = document.querySelector('.avatar__name');

            const existingAvatar = avatarContainer.querySelector('.dynamic-avatar');
            if (existingAvatar) {
                existingAvatar.remove();
            }

            let newAvatar;
            if (avatar.startsWith('http')) {
                newAvatar = document.createElement('img');
                newAvatar.src = avatar;
                newAvatar.alt = name;
                newAvatar.className = 'dynamic-avatar w-10 h-10 rounded-full object-cover cursor-pointer hover:ring-2 hover:ring-brand-300 transition-all duration-200';
                newAvatar.onclick = goToUserProfile;
            } else {
                newAvatar = document.createElement('div');
                newAvatar.className = 'dynamic-avatar w-10 h-10 rounded-full flex items-center justify-center text-white font-semibold text-sm cursor-pointer hover:ring-2 hover:ring-brand-300 transition-all duration-200';
                newAvatar.style.background = avatar;
                newAvatar.textContent = name.charAt(0).toUpperCase();
                newAvatar.onclick = goToUserProfile;
            }

            // Заменяем дефолтную иконку на аватар
            const defaultIcon = avatarContainer.querySelector('.w-10.h-10.bg-gray-100');
            if (defaultIcon) {
                defaultIcon.replaceWith(newAvatar);
            } else {
                avatarContainer.insertBefore(newAvatar, avatarContainer.firstChild);
            }
            
            nameElement.textContent = name;
            // Обновляем подпись
            const subtitle = nameElement.nextElementSibling;
            if (subtitle) {
                subtitle.textContent = t('220', 'в сети', 'online');
            }
        }

        function addMessagesToLoaded(newMessages) {
            const uniqueMessages = newMessages.filter(
                (message) => !loadedMessages.some((loaded) => loaded._id === message._id)
            );
            loadedMessages = loadedMessages.concat(uniqueMessages);
        }

        // Функция загрузки сообщений
        async function loadMessages(recipientId) {
            try {
                console.log('Loading messages for recipient:', recipientId);
                const response = await fetch(`/getMessages?recipientId=${recipientId}&offset=${offset}`);
                if (response.ok) {
                    const messages = await response.json();
                    console.log('Loaded messages from server:', messages);

                    addMessagesToLoaded(messages);
                    console.log('Total messages after adding:', loadedMessages.length);

                    renderMessages();
                    scrollToBottom();

                    // Обновляем время последнего сообщения
                    if (messages.length > 0) {
                        lastMessageTimestamp = messages[messages.length - 1].sentAt;
                    }
                } else {
                    console.error('Ошибка при загрузке сообщений:', response.statusText);
                }
            } catch (error) {
                console.error('Ошибка при загрузке сообщений:', error);
            }
        }

        // Функция отображения сообщений
        function renderMessages() {
            const messagesContainer = document.querySelector('.chat__messeg-box');
            messagesContainer.innerHTML = '';

            console.log('Rendering messages:', loadedMessages.length, 'messages');
            console.log('Current recipient ID:', currentRecipientId);
            console.log('Current recipient name:', currentRecipientName);

            if (loadedMessages.length === 0) {
                messagesContainer.innerHTML = `<div class="text-center text-gray-500 py-8">${t('221', 'Нет сообщений в этом диалоге', 'No messages in this conversation')}</div>`;
                return;
            }

            loadedMessages.forEach((message, index) => {
                const messageWrapper = document.createElement('div');
                const messageTime = new Date(message.sentAt).toLocaleString();

                console.log(`Message ${index}:`, message);

                if (message.sender === currentRecipientId) {
                    // Сообщение от собеседника
                    messageWrapper.className = 'messeg__friends-wrapper';
                    const messageContent = `
                        <div class="messeg__friends">
                            ${
                                currentRecipientAvatar.startsWith('http')
                                    ? `<img src="${escapeHtml(currentRecipientAvatar)}" alt="${escapeHtml(currentRecipientName)}" class="w-8 h-8 rounded-full object-cover cursor-pointer hover:ring-2 hover:ring-brand-300 transition-all duration-200" onclick="goToUserProfile()">`
                                    : `<div style="background: ${escapeHtml(currentRecipientAvatar)};" class="w-8 h-8 rounded-full flex items-center justify-center text-white font-semibold text-xs cursor-pointer hover:ring-2 hover:ring-brand-300 transition-all duration-200" onclick="goToUserProfile()">${currentRecipientName.charAt(0).toUpperCase()}</div>`
                            }
                            <div>
                                <p class="content__messeg-fiends">${escapeHtml(message.content)}</p>
                                <p class="time__messeg">${messageTime}</p>
                            </div>
                        </div>`;
                    messageWrapper.innerHTML = messageContent;
                } else {
                    // Ваше сообщение
                    messageWrapper.className = 'messeg__you-wrapper';
                    messageWrapper.innerHTML = `
                        <div class="you__messeg">
                            <p class="you__messeg-content">${escapeHtml(message.content)}</p>
                        </div>
                        <p class="time__messeg">${messageTime}</p>`;
                }

                messagesContainer.appendChild(messageWrapper);
            });
        }

        // Функция прокрутки до конца
        function scrollToBottom() {
            const messagesContainer = document.querySelector('.chat__messeg-box');
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        // Обработчик события прокрутки
        function handleScroll(container, recipientId) {
            if (container.scrollTop === 0 && !loadingOldMessages) {
                loadingOldMessages = true;
                loadMoreMessages(recipientId);
            }
        }

        // Функция загрузки старых сообщений
        async function loadMoreMessages(recipientId) {
            try {
                offset += 15;
                const response = await fetch(`/getMessages?recipientId=${recipientId}&offset=${offset}`);
                if (response.ok) {
                    const messages = await response.json();

                    const uniqueMessages = messages.filter(
                        (message) => !loadedMessages.some((loaded) => loaded._id === message._id)
                    );
                    loadedMessages = uniqueMessages.concat(loadedMessages);

                    renderMessages();
                    loadingOldMessages = false;
                } else {
                    console.error('Ошибка при загрузке старых сообщений:', response.statusText);
                }
            } catch (error) {
                console.error('Ошибка при загрузке старых сообщений:', error);
            }
        }

        // Функция отправки сообщения
        async function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const recipientId = messageInput.getAttribute('data-id');
            const messageContent = messageInput.value.trim();

            if (!recipientId || messageContent === '') {
                toast(t('222', 'Выберите диалог и введите сообщение.', 'Select a conversation and type a message.'), 'error');
                return;
            }

            try {
                const response = await fetch('/sendMessage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        recipientId: recipientId,
                        content: messageContent
                    })
                });

                if (response.ok) {
                    const newMessage = await response.json();
                    loadedMessages.push(newMessage);
                    renderMessages();
                    scrollToBottom();

                    messageInput.value = '';

                    // Обновляем время последнего сообщения
                    lastMessageTimestamp = newMessage.sentAt;
                } else {
                    toast(t('223', 'Ошибка при отправке сообщения.', 'Failed to send message.'), 'error');
                }
            } catch (error) {
                console.error('send message error:', error);
                toast(t('223', 'Ошибка при отправке сообщения.', 'Failed to send message.'), 'error');
            }
        }

        // Новая функция для проверки новых сообщений
        async function checkForNewMessages(recipientId) {
            try {
                let url = `/getNewMessages?recipientId=${recipientId}`;
                if (lastMessageTimestamp) {
                    url += `&after=${encodeURIComponent(lastMessageTimestamp)}`;
                }

                console.log('Checking for new messages, URL:', url);
                const response = await fetch(url);
                if (response.ok) {
                    const newMessages = await response.json();
                    console.log('New messages received:', newMessages.length, newMessages);
                    
                    if (newMessages.length > 0) {
                        console.log('Adding new messages to chat...');
                        addMessagesToLoaded(newMessages);
                        renderMessages();
                        scrollToBottom();

                        lastMessageTimestamp = newMessages[newMessages.length - 1].sentAt;
                        console.log('Updated last message timestamp:', lastMessageTimestamp);
                    }
                } else {
                    console.error('Ошибка при проверке новых сообщений:', response.statusText);
                }
            } catch (error) {
                console.error('Ошибка при проверке новых сообщений:', error);
            }
        }

        // Очищаем интервал при закрытии страницы
        window.addEventListener('beforeunload', () => {
            if (messageCheckInterval) {
                clearInterval(messageCheckInterval);
            }
        });

        // Мобильная навигация - показать список диалогов
        function showConversationsList() {
            const chatListPanel = document.querySelector('.chat-list-panel');
            const chatAreaPanel = document.querySelector('.chat-area-panel');
            
            if (window.innerWidth < 1024) {
                chatListPanel.classList.remove('hidden');
                chatAreaPanel.classList.remove('active');
                
                // Сбрасываем заголовок и подзаголовок чата
                const avatarName = document.querySelector('.avatar__name');
                const chatSubtitle = document.querySelector('.chat-subtitle');
                if (avatarName) {
                    avatarName.textContent = t('108', 'Выберите диалог', 'Select dialogue');
                }
                if (chatSubtitle) {
                    chatSubtitle.textContent = t('217', 'для начала переписки', 'to start chatting');
                }
                
                // Очищаем интервал проверки новых сообщений при возврате к списку
                if (messageCheckInterval) {
                    clearInterval(messageCheckInterval);
                    messageCheckInterval = null;
                    console.log('Stopped checking for new messages');
                }
            }
        }

        // Мобильная навигация - показать область чата
        function showChatArea() {
            const chatListPanel = document.querySelector('.chat-list-panel');
            const chatAreaPanel = document.querySelector('.chat-area-panel');
            
            if (window.innerWidth < 1024) {
                chatListPanel.classList.add('hidden');
                chatAreaPanel.classList.add('active');
            }
        }

        // Функция для удаления уведомлений о чате
        async function removeChatNotifications(recipientId) {
            try {
                const response = await fetch('/removeChatNotifications', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        recipientId: recipientId
                    })
                });

                if (response.ok) {
                    console.log('Уведомления о чате удалены');
                    
                    // Убираем индикатор непрочитанных сообщений из списка диалогов
                    const conversationElement = document.querySelector(`[data-id="${recipientId}"]`);
                    if (conversationElement) {
                        const unreadIndicator = conversationElement.querySelector('.unread-indicator');
                        if (unreadIndicator) {
                            unreadIndicator.style.display = 'none';
                        }
                    }
                    
                    // Обновляем индикатор уведомлений в хедере
                    const notificationIndicator = document.querySelector('.notification-btn .absolute');
                    if (notificationIndicator) {
                        // Проверяем, есть ли еще непрочитанные уведомления
                        const remainingUnread = document.querySelectorAll('.unread-indicator:not([style*="display: none"])').length;
                        if (remainingUnread === 0) {
                            notificationIndicator.style.display = 'none';
                        }
                    }
                } else {
                    console.error('Ошибка при удалении уведомлений:', response.statusText);
                }
            } catch (error) {
                console.error('Ошибка при удалении уведомлений:', error);
            }
        }

        // Обновленная функция выбора диалога
        function selectConversation(element) {
            const recipientId = element.getAttribute('data-id');
            const recipientName = element.getAttribute('data-name');
            const recipientAvatar = element.getAttribute('data-avatar');

            // Удаляем уведомления о данном чате
            removeChatNotifications(recipientId);

            // Устанавливаем текущего собеседника для навигации
            currentRecipientId = recipientId;
            currentRecipientName = recipientName;
            currentRecipientAvatar = recipientAvatar;

            // Обновляем заголовок чата
            const avatarName = document.querySelector('.avatar__name');
            if (avatarName) {
                avatarName.textContent = recipientName;
            }

            // Обновляем подзаголовок чата
            const chatSubtitle = document.querySelector('.chat-subtitle');
            if (chatSubtitle) {
                chatSubtitle.textContent = '';
            }

            // Обновляем аватар в заголовке
            const chatAvatar = document.querySelector('.chat-avatar-large');
            if (chatAvatar) {
                if (recipientAvatar.startsWith('http')) {
                    chatAvatar.innerHTML = `<img src="${escapeHtml(recipientAvatar)}" alt="${escapeHtml(recipientName)}" class="w-full h-full rounded-full object-cover cursor-pointer hover:ring-2 hover:ring-brand-300 transition-all duration-200" onclick="goToUserProfile()">`;
                } else {
                    chatAvatar.innerHTML = `<div style="background: ${escapeHtml(recipientAvatar)};" class="w-full h-full rounded-full flex items-center justify-center text-white font-semibold text-xs cursor-pointer hover:ring-2 hover:ring-brand-300 transition-all duration-200" onclick="goToUserProfile()">${recipientName.charAt(0).toUpperCase()}</div>`;
                }
            }

            // Привяжем presence к хедеру диалога
            const chatHeaderPresence = document.getElementById('chatHeaderPresence');
            if (chatHeaderPresence) {
                chatHeaderPresence.setAttribute('data-presence-user', recipientId);
                // Диалог открыли только что — подписываемся на статус собеседника.
                if (window.subscribePresence) window.subscribePresence([recipientId]);
                const dot = chatHeaderPresence.querySelector('.presence-dot');
                if (dot) dot.classList.remove('hidden');
                // Сразу подтянем стартовый статус
                fetch('/api/presence?ids=' + encodeURIComponent(recipientId))
                  .then(r => r.json())
                  .then(data => {
                    const u = (data.users || [])[0];
                    if (u && window) {
                      const ev = new CustomEvent('presence:init', { detail: u });
                      window.dispatchEvent(ev);
                    }
                  })
                  .catch(()=>{});
            }

            // Обновляем поле ввода
            const messageInput = document.getElementById('messageInput');
            const sendButton = document.querySelector('.input__button-icons');
            
            if (messageInput) {
                messageInput.setAttribute('data-id', recipientId);
                messageInput.placeholder = `${t('224', 'Сообщение для', 'Message to')} ${recipientName}...`;
            }
            
            if (sendButton) {
                sendButton.setAttribute('data-id', recipientId);
            }

            // Сбрасываем состояние
            loadedMessages = [];
            offset = 0;
            lastMessageTimestamp = null;

            // Очищаем предыдущий интервал проверки новых сообщений
            if (messageCheckInterval) {
                clearInterval(messageCheckInterval);
            }

            // Запускаем новый интервал проверки новых сообщений каждые 3 секунды
            messageCheckInterval = setInterval(() => {
                console.log('Checking for new messages...');
                checkForNewMessages(recipientId);
            }, 3000);

            // Загружаем сообщения
            loadMessages(recipientId);

            // На мобильных устройствах переключаемся на область чата
            showChatArea();
        }

        // Функция для обновления индикатора уведомлений в хедере
        function updateHeaderNotificationIndicator() {
            const unreadIndicators = document.querySelectorAll('.unread-indicator');
            const notificationIndicator = document.querySelector('.notification-btn .absolute');
            
            if (notificationIndicator) {
                const hasUnreadMessages = Array.from(unreadIndicators).some(indicator => 
                    indicator.style.display !== 'none'
                );
                
                if (!hasUnreadMessages) {
                    notificationIndicator.style.display = 'none';
                } else {
                    notificationIndicator.style.display = 'block';
                }
            }
        }

        // Инициализация при загрузке страницы
        document.addEventListener('DOMContentLoaded', function() {
            // На мобильных устройствах показываем только список диалогов
            if (window.innerWidth < 1024) {
                const chatAreaPanel = document.querySelector('.chat-area-panel');
                chatAreaPanel.classList.remove('active');
            }
            
            // Сбрасываем заголовок и подзаголовок чата при загрузке
            const avatarName = document.querySelector('.avatar__name');
            const chatSubtitle = document.querySelector('.chat-subtitle');
            if (avatarName) {
                avatarName.textContent = 'Выберите диалог';
            }
            if (chatSubtitle) {
                chatSubtitle.textContent = 'для начала переписки';
            }
            
            // Обновляем индикатор уведомлений в хедере
            updateHeaderNotificationIndicator();
        });
    </script>
</body>
</html>
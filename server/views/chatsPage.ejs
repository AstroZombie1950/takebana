<%#
  Переписка (/chatsPage): слева две вкладки — диалоги и журнал звонков,
  справа открытый диалог, где звонки стоят в ленте между сообщениями. Пока
  диалог не выбран, правая часть пустая. Маршрут — routes/streaming/messages.js,
  журнал — routes/calls.js, поведение — public/chats.js.
%>
<% var missed = typeof missedCalls !== 'undefined' ? missedCalls : 0; %>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.chats.title' }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/chats.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-chat" id="chat">

      <!-- Списки: диалоги и звонки. Вкладки — ссылки: без скрипта тоже работают. -->
      <section class="tk-chat__list">
        <div class="tk-chat__tabs" role="tablist">
          <a href="/chatsPage" class="tk-chat__tab" role="tab" id="tabMessages" data-tab="messages" aria-controls="conversationsList" aria-selected="<%= tab === 'messages' %>">
            <span data-i18n="app.messages"><%- t('app.messages') %></span>
          </a>
          <a href="/chatsPage?tab=calls" class="tk-chat__tab" role="tab" id="tabCalls" data-tab="calls" aria-controls="callsList" aria-selected="<%= tab === 'calls' %>">
            <span data-i18n="calls.title"><%- t('calls.title') %></span>
            <span class="tk-chat__badge<%= missed ? '' : ' hidden' %>" data-missed-calls><%= missed %></span>
          </a>
        </div>

        <%# Журнал звонков собирает chats.js из /api/calls: при открытии вкладки. %>
        <div class="tk-chat__scroll" id="callsList" role="tabpanel" aria-labelledby="tabCalls"<% if (tab !== 'calls') { %> hidden<% } %>></div>

        <div class="tk-chat__scroll" id="conversationsList" role="tabpanel" aria-labelledby="tabMessages"<% if (tab !== 'messages') { %> hidden<% } %>>
          <% conversations.forEach(function (c) { var p = c.interlocutor; %>
          <button
            type="button"
            class="tk-dialog"
            data-id="<%= p.id %>"
            data-name="<%= p.displayName %>"
            data-ava-url="<%= p.avatarStyle.url || '' %>"
            data-ava-bg="<%= p.avatarStyle.gradient || '' %>"
            data-ava-initial="<%= p.avatarStyle.initial || '' %>"
            data-presence-user="<%= p.id %>"
          >
            <span class="tk-dialog__ava"<% if (!p.avatarStyle.url) { %> data-bg="<%= p.avatarStyle.gradient %>"<% } %>>
              <% if (p.avatarStyle.url) { %><img src="<%= p.avatarStyle.url %>" alt="" loading="lazy"><% } else { %><%= p.avatarStyle.initial %><% } %>
            </span>

            <span class="tk-dialog__body">
              <span class="tk-dialog__top">
                <span class="tk-dialog__who">
                  <span class="tk-dialog__name"><%= p.displayName %></span>
                  <span class="presence-dot <%= p.isOnline ? 'presence-online' : 'presence-offline' %>"></span>
                </span>
                <%# Дата — для chats.js: он обновляет подпись со временем
                    и при смене языка. %>
                <span class="tk-dialog__when" data-time="<%= new Date(c.lastActivity).toISOString() %>"><%= timeAgo(c.lastActivity, lang) %></span>
              </span>

              <span class="tk-dialog__bottom">
                <span class="tk-dialog__last">
                  <% if (c.last) { %><% if (c.last.mine) { %><span data-i18n="chats.you"><%- t('chats.you') %></span> <% } %><%= c.last.content %><% } else { %><span data-i18n="chats.empty"><%- t('chats.empty') %></span><% } %>
                </span>
                <span class="tk-dialog__unread<%= c.unread ? '' : ' hidden' %>"><%= c.unread %></span>
              </span>
            </span>
          </button>
          <% }); %>
          <p class="tk-note tk-chat__empty-list<%= conversations.length ? ' hidden' : '' %>" id="conversationsEmpty" data-i18n="chats.empty"><%- t('chats.empty') %></p>
        </div>
      </section>

      <!-- Переписка: пока диалог не выбран, содержимое скрыто (chats.css) -->
      <section class="tk-chat__area">
        <div class="tk-chat__head">
          <button type="button" class="tk-chat__back" id="backToList" aria-label="<%= ta('chats.backToList') %>" data-i18n-aria="chats.backToList">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
          </button>

          <%# Имя, аватар и присутствие ставит chats.js при выборе диалога. %>
          <span class="tk-chat__ava-big" id="chatAvatar"></span>

          <div class="tk-chat__peer-wrap" id="peerLink">
            <div class="tk-chat__peer" id="chatHeaderPresence" data-presence-user="">
              <h2 id="peerName"></h2>
              <span class="presence-dot presence-offline"></span>
            </div>
          </div>

          <button type="button" class="tk-chat__tool" id="deleteChat" aria-label="<%= ta('chats.deleteChat') %>" data-i18n-aria="chats.deleteChat" title="<%= ta('chats.deleteChat') %>" data-i18n-title="chats.deleteChat">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"></path></svg>
          </button>
        </div>

        <%# Режим выбора: вместо шапки диалога — сколько выбрано и что с этим
            сделать. Включается пунктом «Выделить» в меню сообщения (chats.js). %>
        <div class="tk-chat__pickbar" id="pickBar" hidden>
          <button type="button" class="tk-chat__tool" id="pickCancel" aria-label="<%= ta('chats.pickCancel') %>" data-i18n-aria="chats.pickCancel" title="<%= ta('chats.pickCancel') %>" data-i18n-title="chats.pickCancel">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
          </button>
          <span class="tk-chat__pickcount" id="pickCount" aria-live="polite"></span>
          <button type="button" class="tk-btn tk-btn--ghost tk-btn--sm" data-pick="forward" data-i18n="chats.forward"><%- t('chats.forward') %></button>
          <button type="button" class="tk-btn tk-btn--ghost tk-btn--sm" data-pick="copy" data-i18n="chats.copy"><%- t('chats.copy') %></button>
          <button type="button" class="tk-btn tk-btn--primary tk-btn--sm" data-pick="delete" data-i18n="chats.delete"><%- t('chats.delete') %></button>
        </div>

        <div class="tk-chat__feed" id="feed"></div>

        <div class="tk-chat__compose">
          <form id="composeForm">
            <input type="text" id="messageInput" class="tk-field" placeholder="<%= ta('chats.messagePh') %>" data-i18n-placeholder="chats.messagePh" autocomplete="off" maxlength="5000">
            <button type="submit" class="tk-btn tk-btn--primary tk-btn--sm tk-chat__send">
              <span data-i18n="chats.send"><%- t('chats.send') %></span>
            </button>
          </form>
        </div>
      </section>

    </div>
  </main>
</div>

<%# Действия с сообщением или звонком в ленте: правый клик, на телефоне —
    удержание, с клавиатуры — Enter. У звонка — только «Выделить» и «Удалить»:
    data-for="message" chats.js прячет. %>
<div class="tk-msgmenu" id="msgMenu" role="menu" hidden>
  <button type="button" role="menuitem" data-act="forward" data-for="message" data-i18n="chats.forward"><%- t('chats.forward') %></button>
  <button type="button" role="menuitem" data-act="copy" data-for="message" data-i18n="chats.copy"><%- t('chats.copy') %></button>
  <button type="button" role="menuitem" data-act="select" data-i18n="chats.select"><%- t('chats.select') %></button>
  <button type="button" role="menuitem" data-act="delete" class="tk-msgmenu__danger" data-i18n="chats.delete"><%- t('chats.delete') %></button>
</div>

<!-- Пересылка -->
<div class="tk-modal hidden" id="forwardModal">
  <div class="tk-modal__card">
    <div class="tk-modal__head">
      <h3 class="tk-modal__title" data-i18n="chats.forwardTitle"><%- t('chats.forwardTitle') %></h3>
      <button type="button" class="tk-modal__close" id="forwardClose" aria-label="<%= ta('common.close') %>" data-i18n-aria="common.close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      </button>
    </div>
    <div class="tk-modal__body">
      <p class="tk-fwd__quote" id="forwardQuote"></p>
      <%# Своё к пересылаемому: уходит первым, над пересланным. %>
      <textarea class="tk-field tk-fwd__comment" id="forwardComment" rows="2" maxlength="5000" placeholder="<%= ta('chats.forwardComment') %>" data-i18n-placeholder="chats.forwardComment"></textarea>
      <input type="text" class="tk-field" id="forwardSearch" placeholder="<%= ta('chats.forwardSearch') %>" data-i18n-placeholder="chats.forwardSearch" autocomplete="off">
      <div class="tk-fwd__list" id="forwardList"></div>
    </div>
    <div class="tk-modal__foot">
      <button type="button" class="tk-btn tk-btn--primary tk-btn--sm tk-btn--block" id="forwardSend" disabled>
        <span data-i18n="chats.forwardSend"><%- t('chats.forwardSend') %></span><span id="forwardCount"></span>
      </button>
    </div>
  </div>
</div>

<script defer src="<%= asset('/chats.js') %>"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="ru">
<head>
<%- include('partials/tkHead', { title: title }) %>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/css/admin.css">
<%# escapeHtml обязателен: таблица собирается строкой и уходит в innerHTML,
    а значения полей вводит владелец заведения. %>
<script src="/escape-html.js"></script>
<script src="/toast.js"></script>
</head>
<body>

<div class="tk-panel-page">

  <div class="tk-adm__top">
    <div>
      <p class="tk-kicker">Takebana</p>
      <h1 class="tk-adm__h1">Панель администрирования</h1>
    </div>

    <div class="tk-adm__tools">
      <select id="statusFilter" class="tk-field tk-select">
        <option value="all">Все заведения</option>
        <option value="active">Только активные</option>
        <option value="inactive">Только неактивные</option>
      </select>

      <input type="search" id="searchInput" class="tk-field tk-field--search" placeholder="Поиск по названию" autocomplete="off">

      <button type="button" class="tk-btn tk-btn--outline tk-btn--xs" id="openRepass">Сменить пароль</button>
    </div>
  </div>

  <div class="tk-adm__grid" id="fields"></div>
</div>

<!-- Смена пароля администратора -->
<div class="tk-adm__modal hidden" id="repassModal">
  <div class="tk-adm__modal-card">
    <div class="tk-adm__modal-head">
      <h2>Смена пароля</h2>
      <button type="button" class="tk-btn tk-btn--outline tk-btn--xs" id="closeRepass" aria-label="Закрыть">Закрыть</button>
    </div>

    <form class="tk-adm__form" id="repassForm">
      <%# type="password", а не text: прежде все три пароля показывались
          на экране открытым текстом. %>
      <input type="password" id="oldPassword" class="tk-field" placeholder="Текущий пароль" autocomplete="current-password">
      <input type="password" id="newPassword" class="tk-field" placeholder="Новый пароль" autocomplete="new-password">
      <input type="password" id="confirmPassword" class="tk-field" placeholder="Повторите новый пароль" autocomplete="new-password">
      <button type="submit" class="tk-btn tk-btn--primary tk-btn--sm tk-btn--block" id="updatePasswordButton">Сохранить пароль</button>
    </form>
  </div>
</div>

<script src="/admin.js"></script>
</body>
</html>

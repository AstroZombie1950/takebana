<!DOCTYPE html>
<html lang="ru">
<head>
<%# Панель осознанно только на русском, переключателя языка в ней нет. %>
<%- include('partials/tkHead', { title: title }) %>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="<%= asset('/css/admin.css') %>">
<%# escapeHtml обязателен: таблицы собираются строками и уходят в innerHTML,
    а значения полей вводят посетители — от названия заведения до текста
    жалобы и сообщения об ошибке в чужом браузере. %>
<script defer src="<%= asset('/escape-html.js') %>"></script>
<script defer src="<%= asset('/toast.js') %>"></script>
</head>
<body class="tk-panel">

<aside class="tk-panel__side">
  <a class="tk-panel__brand" href="/">Takebana</a>
  <p class="tk-panel__kicker">Панель</p>

  <%# Что показывать, решает сервер: вкладки журнала, ошибок, расходов,
      системы и заведений отдают 403 модератору, и рисовать их ему — значит
      обещать то, чего он не получит. %>
  <nav class="tk-panel__nav" id="nav"></nav>

  <div class="tk-panel__me">
    <p class="tk-panel__me-name"><%= me.displayName %></p>
    <p class="tk-panel__me-role"><%= isAdmin ? 'администратор' : 'модератор' %></p>
    <a class="tk-panel__exit" href="/">На сайт</a>
  </div>
</aside>

<main class="tk-panel__main">
  <header class="tk-panel__head">
    <div>
      <h1 class="tk-panel__h1" id="viewTitle">Сводка</h1>
      <p class="tk-panel__sub" id="viewSub"></p>
    </div>
    <div class="tk-panel__tools" id="viewTools"></div>
  </header>

  <div class="tk-panel__view" id="view"></div>
</main>

<%# Всё, что панели нужно знать заранее: её права, закрытые списки каталога
    (иначе она разойдётся с фильтрами карты) и подписи действий журнала —
    они же список для его фильтра. %>
<script>
window.TKPanel = <%- JSON.stringify({
  isAdmin: isAdmin,
  me: me,
  catalog: { cities: catalog.CITIES, types: catalog.VENUE_TYPES, categories: catalog.CATEGORIES },
  actions: actions
}).replace(/</g, '\\u003c') %>;
</script>
<script defer src="<%= asset('/panel.js') %>"></script>
</body>
</html>

                        </div>
                    `;
                });
                // listenEstates();
            })
            .catch((error) => {
                console.error('Error:', error);
                alert('Ошибка: ' + error.message); // Выводим сообщение об ошибке
            });

});





window.addEventListener('scroll', function() {
    if (window.innerHeight + window.scrollY >= document.body.offsetHeight) {
        // пользователь прокрутил страницу до конца, загружаем следующую порцию данных
        page++;
        loadEstablishments(page);
    }
});

document.querySelector('#statusFilter').addEventListener('change', function() {
    // при изменении фильтра сбрасываем страницу и загружаем заведения заново
    page = 1;
    loadEstablishments(page);
});


function loadEstablishments(page) {
    const statusFilter = document.querySelector('#statusFilter').value;
    fetch(`/admin/establishments?page=${page}&perPage=${perPage}&status=${statusFilter}`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
    }).then(response => {
        if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
        }
        return response.json();
    })
    .then(data => {
        console.log(data);

        let fieldsDiv = document.querySelector('.fields');
        if (page === 1) {
            fieldsDiv.innerHTML = ''; // если это первая страница, очищаем предыдущие элементы
        }
        data.forEach(establishment => {
            let status = establishment.status ? 'checked' : '';
            fieldsDiv.innerHTML += `
                <div class="estate item" data-id="${establishment._id}">
                    <div class="inp"><input type="text" class="name" placeholder="name" value="${escapeHtml(establishment.name || '')}"></div>
                    <div class="inp"><input type="text" class="country" placeholder="country" value="${escapeHtml(establishment.country || '')}"></div>
                    <div class="inp"><input type="text" class="city" placeholder="city" value="${escapeHtml(establishment.city || '')}"></div>
                    <div class="inp"><input type="text" class="address" placeholder="address" value="${escapeHtml(establishment.address || '')}"></div>
                    <div class="inp"><input type="text" class="email" placeholder="email" value="${escapeHtml(establishment.email || '')}"></div>
                    <div class="inp"><input type="text" class="phone" placeholder="phone" value="${escapeHtml(establishment.phone || '')}"></div>
                    <div class="inp"><input type="text" class="lat" placeholder="lat" value="${escapeHtml(establishment.location && establishment.location.lat || '')}"></div>
                    <div class="inp"><input type="text" class="lng" placeholder="lng" value="${escapeHtml(establishment.location && establishment.location.lng || '')}"></div>
                    <button class="btn save">Сохранить</button>
                    <button class="btn delete">Удалить</button>
                    <label>Активно: <input type="checkbox" class="status" ${status}></label>
                </div>
            `;
        });
        // listenEstates();
        // ... ваш код для добавления элементов ...
    })
    .catch((error) => {
        console.error('Error:', error);
        alert('Ошибка: ' + error.message); // Выводим сообщение об ошибке
    });
}

// загружаем первую порцию данных при загрузке страницы
loadEstablishments(page);




document.querySelector('.fields').addEventListener('click', function(event) {
    let target = event.target;

    // Обработка клика по кнопке сохранения
    if (target.classList.contains('save') && target.classList.contains('active')) {
        let itemDiv = target.closest('.item');
        console.log(itemDiv)
        let establishmentId = itemDiv.dataset.id; // Получаем идентификатор заведения
        let establishment = {
            name: itemDiv.querySelector('.name').value,
            country: itemDiv.querySelector('.country').value,
            city: itemDiv.querySelector('.city').value,
            address: itemDiv.querySelector('.address').value,
            email: itemDiv.querySelector('.email').value,
            phone: itemDiv.querySelector('.phone').value,
            location: {
                lat: parseFloat(itemDiv.querySelector('.lat').value),
                lng: parseFloat(itemDiv.querySelector('.lng').value)
            }
        };
        console.log(establishment)

        fetch(`/admin/updEstablishment/${establishmentId}`, { // Используем идентификатор заведения в URL
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(establishment)
        }).then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            console.log(data);
            this.classList.remove('active');
            alert('Заведение успешно обновлено!'); // Выводим сообщение об успешном обновлении
        })
        .catch((error) => {
            console.error('Error:', error);
            alert('Ошибка: ' + error.message); // Выводим сообщение об ошибке
        });
    }

    // Обработка клика по кнопке удаления
    if (target.classList.contains('delete')) {
        let itemId = target.parentElement.dataset.id;
        fetch(`/admin/deleteEstablishment/${itemId}`, {
            method: 'DELETE',
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            console.log(data);
            // Удалите элемент из DOM
            target.parentElement.remove();
            alert('Заведение успешно удалено!'); // Выводим сообщение об успешном удалении
        })
        .catch(error => {
            console.error('Ошибка:', error);
            alert('Ошибка: ' + error.message); // Выводим сообщение об ошибке
        });
    }
});


document.querySelector('.fields').addEventListener('change', function(event) {
    let target = event.target;

    // Обработка изменения статуса
    if (target.classList.contains('status')) {
        let itemId = target.parentElement.parentElement.dataset.id;
        fetch(`/admin/updateEstablishmentStatus/${itemId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                status: target.checked
            })
        })
        .then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            console.log(data);
            alert('Статус заведения успешно обновлен!'); // Выводим сообщение об успешном обновлении
        })
        .catch(error => {
            console.error('Ошибка:', error);
            alert('Ошибка: ' + error.message); // Выводим сообщение об ошибке
        });
    }
});

document.querySelector('.fields').addEventListener('input', function(event) {
    let target = event.target;

    // Обработка ввода в поле
    if (target.tagName === 'INPUT') {
        target.closest('.item').querySelector('.btn').classList.add('active');
    }
});



    // repassword admin 

    // button open modal
    let btnRepass = document.querySelector('section.main .category .item.repass');
    btnRepass.addEventListener('click', function(e) {
        e.stopPropagation();
        repassModal.classList.add('active');
    });

    // modal
    let repassModal = document.querySelector('.repass_modal');

    document.addEventListener('click', function() {
        repassModal.classList.remove('active');
    });

    repassModal.addEventListener('click', function(e) {
        e.stopPropagation();
    })


    document.querySelector('#updatePasswordButton').addEventListener('click', function() {
        const oldPasswordInput = document.querySelector('#oldPassword');
        const newPasswordInput = document.querySelector('#newPassword');
        const confirmPasswordInput = document.querySelector('#confirmPassword');

        const oldPassword = oldPasswordInput.value;
        const newPassword = newPasswordInput.value;
        const confirmPassword = confirmPasswordInput.value;

        // Валидация паролей
        if (!oldPassword || !newPassword || !confirmPassword) {
            alert('Все поля должны быть заполнены');
            return;
        }
        if (newPassword !== confirmPassword) {
            alert('Новый пароль и подтверждение пароля не совпадают');
            return;
        }
        if (newPassword.length < 8) {
            alert('Новый пароль должен содержать не менее 8 символов');
            return;
        }

        // Отправка запроса на сервер
        fetch('/admin/updatePassword', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                oldPassword: oldPassword,
                newPassword: newPassword
            })
        }).then(response => {
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            return response.json();
        })
        .then(data => {
            alert(data.message); // Выводим сообщение от сервера
        })
        .catch(error => {
            console.error('Error:', error);
            if (error.message.includes('400')) {
                alert('Ошибка: Старый пароль не совпадает');
            } else if (error.message.includes('401')) {
                alert('Ошибка: Неверный текущий пароль');
            } else {
                alert('Ошибка: ' + error.message); // Выводим сообщение об ошибке
            }
        });
    });

    </script>
</body>

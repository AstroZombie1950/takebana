<%#
  Общая обложка юридических страниц: /terms, /privacy, /cookies.
  Маршруты — routes/streaming/legal.js.

  Текст документа лежит отдельным файлом на каждый язык: views/legal/<doc>.<lang>.ejs.
  В общий словарь эти тексты не кладутся намеренно — он едет с каждой страницей
  сайта, а документы читают редко. Поэтому же язык здесь переключается
  перезагрузкой: рвать нечего, звонка и эфира на странице нет.
%>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%# Документы в поиске не нужны, но ссылки из них — пусть робот ходит. %>
<%- include('partials/tkHead', { titleKey: 'page.' + doc + '.title', descriptionKey: 'page.' + doc + '.description', robots: 'noindex, follow' }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/prose.css') %>">
</head>
<body class="tk-app tk-app--wide">

<%- include('partials/header') %>
<%- include('partials/leftBar') %>

<div class="tk-shell">

<main class="tk-prose" data-bg="paper">
  <div class="tk-prose__inner">
    <span class="tk-prose__kicker" data-i18n="legal.kicker"><%- t('legal.kicker') %></span>
    <h1 class="tk-prose__title" data-i18n="page.<%= doc %>.title"><%- t('page.' + doc + '.title') %></h1>
    <div class="tk-prose__body">
      <%# Расширение указано явно: в имени «terms.ru» EJS принял бы «.ru»
          за расширение файла и искал бы terms.ru вместо terms.ru.ejs. %>
      <%- include('legal/' + doc + '.' + lang + '.ejs') %>
    </div>
  </div>
</main>

<%- include('partials/tkFooter') %>
</div>

<script>document.addEventListener('tk:lang', function () { location.reload(); });</script>
</body>
</html>

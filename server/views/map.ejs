function drawMiniStars(rating) {
  let st = document.querySelector('.stars_wrap .stars');
  st.innerHTML = "";
  for (var i = 1; i <= 5; i++) {
  var star = document.createElement('i');
  if (rating >= i) {
    star.className = 'fas fa-star'; // Полная звезда
  } else if (rating > i - 1) {
    star.className = 'fas fa-star-half-alt'; // Половинная звезда
  } else {
    star.className = 'far fa-star'; // Пустая звезда
  }

  if (st) {
    st.appendChild(star);
  }
  
}
}



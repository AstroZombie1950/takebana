    <script>
      // Камера заведения: гость смотрит то, что показывает владелец
      // (routes/venueLive.js). Раньше поток шёл через публичный сервер PeerJS
      // напрямую между браузерами и за NAT мобильного оператора часто не доходил.
      // Обработчик кнопки один на страницу: прежде он навешивался заново при
      // каждом открытии карточки, и после пятой карточки один щелчок
      // подключался пять раз.
      (function () {
        var frame = document.querySelector('.streamingFrame');
        var video = frame.querySelector('video');
        var watchBtn = document.querySelector('.stream_btn .btn');
        var watching = null;

        function stopWatching() {
          if (watching) { watching.leave(); watching = null; }
          video.srcObject = null;
          frame.classList.remove('active');
        }

        watchBtn.addEventListener('click', function () {
          if (!this.classList.contains('active')) return;
          var id = this.getAttribute('data-id');
          var media = new MediaStream();
          stopWatching();
          video.srcObject = media;
          frame.classList.add('active');
          watching = TKDaily.connect({
            send: false,
            access: function () { return TKDaily.requestAccess('/api/venues/' + id + '/watch'); },
            onTrack: function (track, p, on) {
              if (p.local) return;
              if (on) media.addTrack(track); else media.removeTrack(track);
              video.srcObject = media;
              video.play().catch(function () {});
            },
            onState: function (s) {
              if (s !== 'ended') return;
              stopWatching();
              toast('Заведение сейчас не показывает камеру');
            }
          });
        });

        frame.querySelector('img').addEventListener('click', stopWatching);
      })();
    </script>








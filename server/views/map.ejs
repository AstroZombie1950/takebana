function loadData() {
  console.log('pens')
    var extent = map2.getView().calculateExtent(map2.getSize());
    var bottomLeft = ol.proj.toLonLat([extent[0], extent[1]]);
    var topRight = ol.proj.toLonLat([extent[2], extent[3]]);

    fetch(`/establishmentsLocation?bl_lat=${bottomLeft[1]}&bl_lng=${bottomLeft[0]}&tr_lat=${topRight[1]}&tr_lng=${topRight[0]}`)
        .then(response => response.json())
        .then(data => {
            // Удалите все старые маркеры
            source.clear();

            // Добавьте новые маркеры
            data.forEach(establishment => {
                var marker = new ol.Feature(
                    new ol.geom.Point(
                        ol.proj.fromLonLat([establishment.location.lng, establishment.location.lat])
                    )
                );
                marker.set('image', './img/mark.svg');
                marker.set('name', establishment.name);
                marker.set('id', establishment._id); // Добавьте идентификатор заведения
                source.addFeature(marker);
            });
        });
}



    <script>


      // BURGER & LEFT MENU
      let burg = document.querySelector('.burger');
      let left_menu = document.querySelector('.left_menu');
      let close_left_menu = document.querySelector('.left_menu .close');
      if (burg) {
        left_menu.addEventListener('click', function(e) {
          e.stopPropagation();
        });
        burg.addEventListener('click', function(e) {
          e.stopPropagation();
          if (left_menu.classList.contains('active')) {
            left_menu.classList.remove('active');
          } else {
            left_menu.classList.add('active');
          }
        });
        close_left_menu.addEventListener('click', function() {
          left_menu.classList.remove('active');
        });
      }
      document.addEventListener('click', function() {
        left_menu.classList.remove('active');
      });


      // PROFILE CHARS 
        document.addEventListener('DOMContentLoaded', function() {
        const userLogin = "<%= userLogin %>"; // Получаем логин пользователя из EJS
        let initials = 'anon';

        if (userLogin) {
          const words = userLogin.split(' ');
          if (words.length > 1) {
            // Если имя пользователя состоит из двух слов, берем по одной букве из каждого слова
            initials = words[0][0] + words[1][0];
          } else {
            // Если имя пользователя состоит из одного слова, берем первые две буквы
            initials = userLogin.slice(0, 2);
          }
        }

        const profileElement = document.querySelector('.prof p');
        profileElement.textContent = initials.toUpperCase();
      });



      // Создаем слой для карты
      var mapLayer = new ol.layer.Tile({
        source: new ol.source.OSM()
      });

      // Создаем источник для маркеров
      var source = new ol.source.Vector();



      // Создаем источник для кластеров, используя источник маркеров
      var clusterSource = new ol.source.Cluster({
        distance: 40, // Расстояние в пикселях для группировки маркеров
        source: source
      });

      // Создаем слой для кластеров

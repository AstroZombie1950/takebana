

<!-- 


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Stream Player</title>
    <style>
        .player-container {
            margin: 20px;
            max-width: 800px;
        }
        .controls {
            margin: 10px 0;
            padding: 10px;
            background: #f5f5f5;
            border-radius: 4px;
        }
        .mode-switch {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .status {
            margin-top: 10px;
            font-size: 14px;
            color: #666;
        }
        .error {
            color: #ff0000;
        }
        #videoPlayer {
            width: 100%;
            background: #000;
        }
    </style>
</head>
<body>
    <div class="player-container">
        <video id="videoPlayer" controls autoplay muted></video>
        <div class="controls">
            <div class="mode-switch">
                <input type="checkbox" id="recordingMode">
                <label for="recordingMode">Режим записи (возможность перемотки)</label>
            </div>
            <div id="status" class="status"></div>
        </div>
    </div>

    <script>
class StreamPlayer {
    constructor(videoElement, options = {}) {
        this.video = videoElement;
        this.mediaSource = new MediaSource();
        this.video.src = URL.createObjectURL(this.mediaSource);
        this.sourceBuffer = null;
        this.isInitialized = false;
        this.processedSegments = new Set();
        this.currentlyProcessing = new Set();
        this.checkInterval = null;
        this.lastKnownSegments = [];
        this.retryTimeout = null;
        this.statusElement = document.getElementById('status');
        this.failedSegments = new Map();
        this.maxRetries = 2;
        this.skipAfterFailure = true;

        // Настройки
        this.isRecordingMode = options.recordingMode ?? false;
        this.bufferSize = this.isRecordingMode ? Infinity : 30;
        this.checkIntervalTime = 2000;
        
        this.loadProcessedSegmentsFromStorage();
        this.mediaSource.addEventListener('sourceopen', () => this.initialize());
        this.setupEventListeners();
    }

    setupEventListeners() {
        this.video.addEventListener('timeupdate', () => {
            if (!this.isRecordingMode) {
                this.removeOldSegments();
            }
            this.updateStatus();
        });

        this.video.addEventListener('waiting', () => {
            this.updateStatus('Буферизация...');
        });

        this.video.addEventListener('playing', () => {
            this.updateStatus('Воспроизведение');
        });

        this.video.addEventListener('error', (e) => {
            this.handleError('Ошибка воспроизведения', e);
        });

        this.video.addEventListener('pause', () => {
            if (!this.video.ended && !this.video.seeking) {
                setTimeout(() => {
                    this.video.play().catch(this.handleError);
                }, 1000);
            }
        });
    }

    updateStatus(message = '') {
        if (this.statusElement) {
            const buffered = this.sourceBuffer?.buffered;
            let status = message;
            
            if (buffered && buffered.length > 0) {
                const bufferSize = buffered.end(buffered.length - 1) - buffered.start(0);
                status += ` | Буфер: ${bufferSize.toFixed(1)}s`;
            }
            
            this.statusElement.textContent = status;
        }
    }

    handleError(message, error = null) {
        console.error(message, error);
        this.updateStatus(`Ошибка: ${message}`);
        
        if (this.video.paused && !this.video.seeking) {
            const buffered = this.sourceBuffer?.buffered;
            if (buffered && buffered.length > 0) {
                const currentEnd = buffered.end(buffered.length - 1);
                this.video.currentTime = Math.max(currentEnd - 1, 0);
                this.video.play().catch(console.error);
            }
        }
    }

    async initialize() {
        console.log('Инициализация MediaSource');
        const mimeCodec = 'video/mp4; codecs="avc1.42001e,mp4a.40.2"';
        
        if (!MediaSource.isTypeSupported(mimeCodec)) {
            this.handleError('Кодек не поддерживается');
            return;
        }

        try {
            this.sourceBuffer = this.mediaSource.addSourceBuffer(mimeCodec);
            this.sourceBuffer.mode = 'sequence';
            this.isInitialized = true;

            await this.initialSegmentLoad();
            this.startSegmentCheck();
        } catch (e) {
            this.handleError('Ошибка инициализации', e);
        }
    }

    async initialSegmentLoad() {
        try {
            const response = await fetch('/segments');
            const data = await response.json();
            
            if (data.segments.length < 2) {
                this.updateStatus('Ожидание сегментов...');
                return;
            }

            const segments = data.segments.slice(1);
            console.log('Начальная загрузка сегментов:', segments);

            for (const segment of segments) {
                await this.loadAndAppendSegment(segment);
            }

            this.video.play().catch(e => console.warn('Autoplay prevented:', e));
        } catch (e) {
            this.handleError('Ошибка начальной загрузки', e);
        }
    }

    async checkAndLoadSegments() {
        try {
            const response = await fetch('/segments');
            const data = await response.json();
            const segments = data.segments;

            const newSegments = segments.filter(segment => 
                !this.processedSegments.has(segment) && 
                !this.currentlyProcessing.has(segment) &&
                (this.failedSegments.get(segment) || 0) < this.maxRetries
            );

            if (newSegments.length > 0) {
                console.log('Новые сегменты:', newSegments);
                const recentSegments = newSegments.slice(-2);
                
                for (const segment of recentSegments) {
                    const success = await this.loadAndAppendSegment(segment);
                    
                    if (!success && this.skipAfterFailure) {
                        console.log(`Пропускаем проблемный сегмент: ${segment}`);
                        this.processedSegments.add(segment);
                        this.saveProcessedSegmentsToStorage();
                    }
                }
            }
        } catch (e) {
            this.handleError('Ошибка проверки сегментов', e);
        }
    }

    async loadAndAppendSegment(segmentName) {
        if (this.currentlyProcessing.has(segmentName)) {
            return false;
        }

        this.currentlyProcessing.add(segmentName);
        const attempts = (this.failedSegments.get(segmentName) || 0) + 1;
        this.failedSegments.set(segmentName, attempts);

        try {
            console.log(`Загрузка сегмента: ${segmentName} (попытка ${attempts}/${this.maxRetries})`);
            const response = await fetch(`/streams/test_stream_key/${segmentName}`);
            
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const buffer = await response.arrayBuffer();
            await this.appendBuffer(buffer);
            
            console.log(`Сегмент успешно добавлен: ${segmentName}`);
            this.processedSegments.add(segmentName);
            this.failedSegments.delete(segmentName);
            this.saveProcessedSegmentsToStorage();

            if (this.video.paused && !this.video.seeking) {
                this.video.play().catch(console.error);
            }
            
            return true;
        } catch (e) {
            console.error(`Ошибка загрузки сегмента ${segmentName}:`, e);
            return false;
        } finally {
            this.currentlyProcessing.delete(segmentName);
        }
    }

    appendBuffer(buffer) {
        return new Promise((resolve, reject) => {
            if (this.sourceBuffer.updating) {
                reject(new Error('SourceBuffer updating'));
                return;
            }

            const updateEndHandler = () => {
                this.sourceBuffer.removeEventListener('updateend', updateEndHandler);
                this.sourceBuffer.removeEventListener('error', errorHandler);
                resolve();
            };

            const errorHandler = (error) => {
                this.sourceBuffer.removeEventListener('updateend', updateEndHandler);
                this.sourceBuffer.removeEventListener('error', errorHandler);
                reject(error);
            };

            this.sourceBuffer.addEventListener('updateend', updateEndHandler);
            this.sourceBuffer.addEventListener('error', errorHandler);

            try {
                this.sourceBuffer.appendBuffer(buffer);
            } catch (e) {
                errorHandler(e);
            }
        });
    }

    removeOldSegments() {
        if (!this.sourceBuffer || this.sourceBuffer.updating) {
            return;
        }

        const buffered = this.sourceBuffer.buffered;
        if (buffered.length > 0) {
            const currentTime = this.video.currentTime;
            const start = buffered.start(0);
            const removeEnd = Math.max(start, currentTime - this.bufferSize);

            if (removeEnd > start) {
                try {
                    this.sourceBuffer.remove(start, removeEnd);
                    console.log(`Удалены старые данные: ${start} - ${removeEnd}`);
                } catch (e) {
                    console.error('Ошибка при очистке буфера:', e);
                }
            }
        }
    }

    startSegmentCheck() {
        if (this.checkInterval) {
            clearInterval(this.checkInterval);
        }
        
        this.checkInterval = setInterval(() => {
            this.checkAndLoadSegments().catch(e => {
                this.handleError('Ошибка проверки сегментов', e);
            });
        }, this.checkIntervalTime);
    }

    setRecordingMode(enabled) {
        this.isRecordingMode = enabled;
        this.bufferSize = enabled ? Infinity : 30;
        
        if (!enabled) {
            this.removeOldSegments();
        }
        
        this.updateStatus(`Режим ${enabled ? 'записи' : 'реального времени'}`);
    }

    loadProcessedSegmentsFromStorage() {
        try {
            const stored = localStorage.getItem('processedSegments');
            if (stored) {
                const segments = JSON.parse(stored);
                this.processedSegments = new Set(segments);
            }
        } catch (e) {
            console.error('Ошибка загрузки из localStorage:', e);
        }
    }

    saveProcessedSegmentsToStorage() {
        try {
            const segments = Array.from(this.processedSegments);
            localStorage.setItem('processedSegments', JSON.stringify(segments));
        } catch (e) {
            console.error('Ошибка сохранения в localStorage:', e);
        }
    }

    stop() {
        if (this.checkInterval) {
            clearInterval(this.checkInterval);
        }
        if (this.retryTimeout) {
            clearTimeout(this.retryTimeout);
        }
        this.video.pause();
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('videoPlayer');
    const recordingModeCheckbox = document.getElementById('recordingMode');
    
    const player = new StreamPlayer(video, {
        recordingMode: recordingModeCheckbox.checked
    });

    recordingModeCheckbox.addEventListener('change', (e) => {
        player.setRecordingMode(e.target.checked);
        
        if (!e.target.checked) {
            const buffered = player.sourceBuffer?.buffered;
            if (buffered && buffered.length > 0) {
                video.currentTime = Math.max(buffered.end(buffered.length - 1) - 5, 0);
            }
        }
    });

    window.addEventListener('beforeunload', () => {
        player.stop();
    });
});
    </script>
</body>
</html> -->










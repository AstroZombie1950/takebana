<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.ended.title' }) %>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/status.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-status">
      <span class="tk-status__kicker" data-i18n="ended.kicker"><%- t('ended.kicker') %></span>
      <h1 class="tk-status__title" data-i18n="ended.title"><%- t('ended.title') %></h1>
      <p class="tk-status__text" data-i18n="ended.text"><%- t('ended.text') %></p>

      <div class="tk-status__acts">
        <a href="/" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="age.back"><%- t('age.back') %></a>
      </div>
    </div>
  </main>
</div>
</body>
</html>

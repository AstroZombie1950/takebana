<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<%- include('partials/tkHead', { titleKey: 'page.ended.title' }) %>
<meta name="robots" content="noindex">
<link rel="stylesheet" href="/css/status.css">
</head>
<body>

<div class="tk-shell">
<%- include('partials/tkHeader') %>

<main class="tk-status">
  <span class="tk-status__kicker" data-i18n="ended.kicker"><%- t('ended.kicker') %></span>
  <h1 class="tk-status__title" data-i18n="ended.title"><%- t('ended.title') %></h1>
  <p class="tk-status__text" data-i18n="ended.text"><%- t('ended.text') %></p>
</main>

<%- include('partials/tkFooter') %>
</div>

<%- include('partials/tkMenu') %>

<script defer src="/tk-i18n-<%= lang %>.js"></script>
<script defer src="/tk-i18n.js"></script>
<script defer src="/tk.js"></script>
</body>
</html>

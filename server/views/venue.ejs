<%#
  Страница заведения /venue/:id (29.09) — маршрут в routes/establishmentsRouter.js.
  Гостю: логотип, название, адрес, часы, оценка, описание, фото и камера —
  идёт она сейчас или нет. Владельцу (и администратору) сверху ещё пульт:
  запустить трансляцию, настройки, удалить, что сейчас на проверке.
  Оценить — здесь же (с 29.09; до того — в карточке на карте): public/tk-venue.js.
  Встречи «хочу сюда» (07.10) — partials/venueMeetups.ejs, public/tk-meetups.js.
  Своё заведение владелец не оценивает (30.09) — звёзд у него нет.
  Действия пульта — public/tk-venue-edit.js, вид — css/venue.css.
%>
<% var meta = [placeLabel('type', venue.type, venue.typeOther), placeLabel('city', venue.city, venue.cityOther)].filter(Boolean).join(' · ');
   var photos = venue.photos || [];
   // Картинка эфира: обложка камеры, без неё первое фото.
   var shot = venue.cover || photos[0];
   var letter = (String(venue.name || '').match(/[\p{L}\p{N}]/u) || ['•'])[0].toUpperCase();
   var approved = venue.status === true;
   var draftAt = venue.pending && venue.pending.at;
   var votes = plural(rating.count, 'venues.votes'); %>
<!DOCTYPE html>
<html lang="<%= lang %>" data-theme="<%= themeOn %>"<% if (theme === 'auto') { %> data-theme-auto<% } %>>
<head>
<%# В индекс — одобренное заведение с описанием (docs/VENUES.md, п. 5): без
    него страница — название и адрес, поиску в ней нечего взять. Фото, видео
    и эфиры в условие не входят нарочно: они появляются и пропадают, и
    страница выпадала бы из индекса при каждом удалении. %>
<%# Описание для поиска (04.10): «Бар · Белград: {описание заведения}»;
    без описания страница вне индекса, там хватает типа, города и адреса. %>
<%# Title (04.10, задача 31): «{название} — Бар, Белград — Takebana» — тип
    и город в выдаче отвечают на запрос «бар в Белграде». Разметка —
    заведение по его типу и крошки (utils/jsonld.js, venue). %>
<% var described = meaningful(venue.about); // то же правило, что utils/venuePage.js, indexableVenue
   var city = placeLabel('city', venue.city, venue.cityOther);
   var kind = placeLabel('type', venue.type, venue.typeOther);
   // «Бар «Тэкэбана»» — тип уже в названии, второй раз его не пишем.
   if (kind && String(venue.name).toLowerCase().indexOf(kind.toLowerCase()) !== -1) kind = '';
   var typeCity = [kind, city].filter(Boolean).join(', ');
   var pageDesc = described ? snippet((meta ? meta + ': ' : '') + venue.about) : [meta, venue.address].filter(Boolean).join(' · '); %>
<%- include('partials/tkHead', { title: venue.name + (typeCity ? ' — ' + typeCity : '') + ' — Takebana',
      description: pageDesc,
      seo: { path: '/venue/' + venue._id, robots: !approved ? 'noindex, nofollow' : described ? '' : 'noindex, follow', image: venue.cover || photos[0] || venue.avatar, imageAlt: venue.name,
             jsonld: [ld.venue({ v: venue, description: pageDesc, city: city, country: venue.countryOther }),
                      ld.crumbs([['Takebana', '/'], [ta('app.venues'), '/venues'], [venue.name, '/venue/' + venue._id]])] } }) %>
<link rel="stylesheet" href="<%= asset('/css/app.css') %>">
<link rel="stylesheet" href="<%= asset('/css/venue.css') %>">
</head>
<body class="tk-app">

<%- include('partials/header') %>

<div>
  <%- include('partials/leftBar') %>

  <main class="tk-app-main">
    <div class="tk-vp" data-venue="<%= venue._id %>" data-name="<%= venue.name %>">

      <a href="/venues?venue=<%= venue._id %>" class="tk-page__back">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        <span data-i18n="venue.page.back"><%- t('venue.page.back') %></span>
      </a>

      <header class="tk-vp__head">
        <div class="tk-vp__ava"><% if (venue.avatar) { %><img src="<%= venue.avatar %>" alt=""><% } else { %><%= letter %><% } %></div>
        <div class="tk-vp__id">
          <% if (meta) { %><p class="tk-kicker"><%= meta %></p><% } %>
          <h1 class="tk-vp__name" data-user-content><%= venue.name %></h1>
          <% if (venue.address) { %><p class="tk-vp__line" data-user-content><%= venue.address %></p><% } %>
          <% if (hours) { %><p class="tk-vp__line" data-i18n="venues.today" data-i18n-vars='<%= JSON.stringify({ from: hours.from, to: hours.to }) %>'><%- t('venues.today', { from: hours.from, to: hours.to }) %></p><% } %>
          <%# Оценка и место на карте — у одобренного: заявку не оценить и в выдаче её нет. %>
          <% if (approved) { %>
          <p class="tk-vp__rating">
            <span class="tk-vp__score" id="venueScore"><%= rating.average.toFixed(1) %></span>
            <span class="tk-stars" id="venueStars" style="--v: <%= rating.average %>" aria-hidden="true"></span>
            <span><span id="venueVotesN"><%= num(rating.count) %></span> <span id="venueVotesWord" data-i18n="<%= votes.key %>"><%= votes.text %></span></span>
          </p>
          <%# Звёзды в обратном порядке: при наведении подсвечиваются наведённая
              и все «младшие» — это делает селектор ~ в CSS. %>
          <% if (!own) { %>
          <div class="tk-vp__vote">
            <span class="tk-form__label" id="venueVoteLabel" data-i18n="venues.yourRating"><%- t('venues.yourRating') %></span>
            <div class="tk-rate" id="venueRate" role="group" aria-labelledby="venueVoteLabel">
              <% for (var n = 5; n >= 1; n--) { %>
              <button type="button" data-value="<%= n %>" class="<%= rating.mine === n ? 'is-on' : '' %>" aria-label="<%= ta('venues.starN', { n: n }) %>" data-i18n-aria="venues.starN" data-i18n-vars='{"n": <%= n %>}'>★</button>
              <% } %>
            </div>
          </div>
          <% } %>
          <% } %>
        </div>
      </header>

      <%- include('partials/venueTabs', { tab: 'about' }) %>

      <%# Эфир от имени заведения (29.09) — первым: его ведут, камера лишь смотрит в зал. %>
      <% if (tabs.live) { %>
      <a href="/stream/<%= tabs.live._id %>" class="tk-vp__live">
        <% if (tabs.live.thumbnail) { %><img src="<%= tabs.live.thumbnail %>" alt="<%= ta('alt.venueCam', { name: venue.name }) %>"><% } %>
        <span class="tk-vp__badge"><i class="tk-vp__dot" aria-hidden="true"></i><span data-i18n="venues.onAir"><%- t('venues.onAir') %></span></span>
        <span class="tk-vp__live-title" data-user-content><%= tabs.live.title %></span>
        <span class="tk-btn tk-btn--primary tk-btn--sm tk-vp__watch" data-i18n="venue.page.watchStream"><%- t('venue.page.watchStream') %></span>
      </a>
      <% } %>

      <%# Камера: идёт — картинкой и кнопкой «Смотреть», нет — строкой. %>
      <% if (approved && venue.online) { %>
      <a href="/venue/<%= venue._id %>/live" class="tk-vp__live">
        <% if (shot) { %><img src="<%= shot %>" alt="<%= ta('alt.venuePhoto', { name: venue.name }) %>"><% } %>
        <span class="tk-vp__badge"><i class="tk-vp__dot" aria-hidden="true"></i><span data-i18n="venues.onAir"><%- t('venues.onAir') %></span></span>
        <span class="tk-btn tk-btn--primary tk-btn--sm tk-vp__watch" data-i18n="venues.watch"><%- t('venues.watch') %></span>
      </a>
      <% } else if (approved) { %>
      <p class="tk-vp__off" data-i18n="vlive.off"><%- t('vlive.off') %></p>
      <% } %>

      <% if (approved) { %>
      <div class="tk-vp__acts">
        <a href="/venues?venue=<%= venue._id %>" class="tk-btn tk-btn--outline tk-btn--sm tk-vp__onmap" data-i18n="vlive.onMap"><%- t('vlive.onMap') %></a>
      </div>
      <% } %>

      <%# Встречи (07.10): «Хочу сюда» и «Я тоже» — у одобренного заведения. %>
      <% if (approved) { %><%- include('partials/venueMeetups', { venue: venue, viewer: viewer, meet: meet }) %><% } %>

      <% if (manage) { %>
      <%# Пульт владельца. Сверху — что ждёт проверки: от этого зависит, что
          можно. Одобренное без правки строки не несёт (30.09): что оно на
          месте, видно по самому пульту. %>
      <section class="tk-panel tk-vp__own">
        <p class="tk-panel__title" data-i18n="venue.page.manage"><%- t('venue.page.manage') %></p>
        <% if (!approved) { %>
        <p class="tk-vp__state is-wait"><b data-i18n="venues.pending"><%- t('venues.pending') %></b> — <span data-i18n="venues.pendingNote"><%- t('venues.pendingNote') %></span></p>
        <% } else if (draftAt) { %>
        <p class="tk-vp__state is-wait"><b data-i18n="venue.page.draft"><%- t('venue.page.draft') %></b> — <span data-i18n="venue.page.draftNote" data-i18n-vars='<%= JSON.stringify({ date: date(draftAt, { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" }) }) %>'><%- t('venue.page.draftNote', { date: date(draftAt, { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) }) %></span>
          <button type="button" class="tk-vp__link" data-venue-withdraw data-i18n="venue.page.withdraw"><%- t('venue.page.withdraw') %></button></p>
        <% } %>
        <div class="tk-vp__own-acts">
          <% if (approved) { %><a href="/venue/<%= venue._id %>/live" class="tk-btn tk-btn--primary tk-btn--sm" data-i18n="<%= venue.online ? 'vlive.open' : 'venues.startLive' %>"><%- t(venue.online ? 'vlive.open' : 'venues.startLive') %></a><% } %>
          <%# Эфир и видео от имени заведения (29.09) — только своего: вести
              за чужое заведение не может и администратор. %>
          <% if (approved && own) { %>
          <a href="/studio?venue=<%= venue._id %>" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="venue.page.goLive"><%- t('venue.page.goLive') %></a>
          <a href="/upload?venue=<%= venue._id %>" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="venue.page.upload"><%- t('venue.page.upload') %></a>
          <% } %>
          <%# «Удалить» — в настройках (05.10): здесь, рядом с ежедневными
              кнопками, его нажимали бы случайно. %>
          <a href="/venue/<%= venue._id %>/edit" class="tk-btn tk-btn--outline tk-btn--sm" data-i18n="venue.tab.settings"><%- t('venue.tab.settings') %></a>
        </div>
        <% if (approved) { %><p class="tk-note" data-i18n="venue.page.liveHint"><%- t('venue.page.liveHint') %></p><% } %>
      </section>
      <% } %>

      <% if (venue.about) { %>
      <section class="tk-vp__sec">
        <h2 class="tk-kicker" data-i18n="venue.page.about"><%- t('venue.page.about') %></h2>
        <p class="tk-vp__about" data-user-content><%= venue.about %></p>
      </section>
      <% } %>

      <% if (photos.length) { %>
      <section class="tk-vp__sec">
        <h2 class="tk-kicker" data-i18n="venue.page.photos"><%- t('venue.page.photos') %></h2>
        <div class="tk-vp__photos">
          <% photos.forEach(function (src, i) { %>
          <a href="<%= src %>" target="_blank" rel="noopener"><img src="<%= src %>" alt="<%= ta('alt.venuePhotoN', { name: venue.name, n: i + 1 }) %>" loading="lazy"></a>
          <% }); %>
        </div>
      </section>
      <% } %>

    </div>
  </main>
</div>
<% if (approved && !own) { %><script defer src="<%= asset('/tk-venue.js') %>"></script><% } %>
<% if (approved) { %><script defer src="<%= asset('/tk-meetups.js') %>"></script><% } %>
<% if (manage) { %><script defer src="<%= asset('/tk-venue-edit.js') %>"></script><% } %>
</body>
</html>
